# === [LANG-DETECT C1] §7.2 跨 Phase 整合：P1 正名（key-changing：語系 token en→it）
# → P2 glossary 分桶捕參同基準；對照組英文全鏈仍 en ===
def test_seam_lang_p1_to_p2_glossary_bucket_integration(monkeypatch, tmp_path):
    # ① P1：義文文件（拉丁字元 → 啟發式 catch-all en；cover-prompt 正名 it）
    llm_json = _json.dumps({
        "title": "Notizia", "authors": [], "date": "", "publisher": "",
        "url": "", "language": "it",
    })
    _setup_p1_mocks(monkeypatch, tmp_path, llm_json=llm_json)
    spec1 = LiteDocPipeline().run_phase1(_p1_ctx(tmp_path, paper_id="itx"))
    assert spec1.source_lang == "it"

    # ② P2：以 P1 spec 值建 ctx（single source of truth 直通、零轉換）
    _setup_p2_mocks(monkeypatch, tmp_path, _tiles_2())
    monkeypatch.setattr(settings, "LLM_USE_GLOSSARY_ALIGN", True)
    captured = {}

    class _CapGM:
        def build_termmap(self, full_text, abstract, translated_abstract,
                          source_lang, target_lang, domain, **kw):
            captured["source_lang"] = source_lang
            captured["target_lang"] = target_lang
            return {}

    monkeypatch.setattr(lp, "GlossaryManager", _CapGM)
    LiteDocPipeline().run_phase2(_p2_ctx(_tiles_2(), source_lang=spec1.source_lang))
    assert captured["source_lang"] == "it"        # glossary 以 it 桶寫入（污染根治）
    assert captured["target_lang"] == "zh-tw"
    assert not spec1.source_lang.startswith("zh")  # P3 gate 謂詞：不 bypass、照走翻譯

    # ③ 對照組：英文文件（language=en）全鏈仍 en
    llm_json_en = _json.dumps({"title": "News", "authors": [], "language": "en"})
    _setup_p1_mocks(monkeypatch, tmp_path, llm_json=llm_json_en)
    spec_en = LiteDocPipeline().run_phase1(_p1_ctx(tmp_path, paper_id="enx"))
    assert spec_en.source_lang == "en"
    _setup_p2_mocks(monkeypatch, tmp_path, _tiles_2())
    monkeypatch.setattr(settings, "LLM_USE_GLOSSARY_ALIGN", True)
    monkeypatch.setattr(lp, "GlossaryManager", _CapGM)
    LiteDocPipeline().run_phase2(_p2_ctx(_tiles_2(), source_lang=spec_en.source_lang))
    assert captured["source_lang"] == "en"        # en 桶回歸、跨文件不互污


# ──────────────────────────────────────────────────────────────────────────
# FITZ-HOTFIX-1 C2：R6 時序前移 + meta 值集合 / R7 數字為主短行清理
# ──────────────────────────────────────────────────────────────────────────
class TestR7ShortNumberLines:
    """R7：≤3 token 且數字過半 → 剝除（改空行、行數不變）；守衛防誤殺。"""

    @staticmethod
    def _clean(text):
        return lp._clean_short_number_lines(text)

    def test_number_dominated_lines_stripped(self):
        assert self._clean("53 82 Share") == ""      # 2/3 過半（block 併行型）
        assert self._clean("561") == ""              # 1/1（獨行純數字型）
        assert self._clean("1,234 5.6") == ""        # 千分位/小數皆算數字

    def test_body_and_short_text_kept(self):
        for keep in (
            "Chapter 5",                                   # 1/2 不過半
            "561 Likes and more",                          # 4 token 超上限
            "This is a complete body sentence with 3 numbers 4 5.",
        ):
            assert self._clean(keep) == keep

    @pytest.mark.parametrize("line", ["- 1", "# 1", "![alt](src)", "| 1 |",
                                      "> 1", "* 1 2"])
    def test_markdown_syntax_lines_never_stripped(self, line):
        """markdown 語法行首守衛：列表/標題/圖行/表格/引用一律不碰。"""
        assert self._clean(line) == line

    @pytest.mark.parametrize("token", ["v1.2", "M1", "A4", "3rd"])
    def test_alphanumeric_tokens_not_counted_as_numeric(self, token):
        """含字母 token 不計數字 → 不過半 → 整行保留。"""
        line = f"{token} spec"
        assert self._clean(line) == line

    def test_line_count_invariant(self):
        text = "Title\n\n53 82 Share\n\nBody line.\n561\n"
        out = self._clean(text)
        assert out.count("\n") == text.count("\n")     # 行數不變（改空行不刪行）
        assert out.splitlines()[2] == ""               # 命中行原位變空
        assert "Body line." in out


class TestR6MetaValuesCollection:
    """R6 呼叫端值集合：authors 逐項＋合併型、publisher、date 及其列印變體。"""

    def test_collect_authors_publisher_date(self):
        meta = {
            "authors": ["Marc Andreessen", "Michael McGuiness"],
            "publisher": "a16z",
            "date": "2026-06-15",
        }
        values = LiteDocPipeline._collect_meta_values(meta)
        assert "Marc Andreessen" in values and "Michael McGuiness" in values
        assert "Marc Andreessen and Michael McGuiness" in values   # 合併型整行
        assert "a16z" in values
        assert "2026-06-15" in values
        assert "Jun 15" in values and "June 15" in values          # 列印變體
        assert "06/15/2026" in values

    def test_missing_or_bad_fields_are_skipped(self):
        assert LiteDocPipeline._collect_meta_values({}) == set()
        assert LiteDocPipeline._collect_meta_values(
            {"authors": [], "publisher": "", "date": "not-a-date"}
        ) == {"not-a-date"}      # 非 ISO → 無變體、原值仍入集合

    def test_date_variants_non_iso_returns_empty(self):
        assert lp._date_variants("") == set()
        assert lp._date_variants("June 15") == set()
        assert lp._date_variants("2026-13-99") == set()   # 月份越界 → 空


class TestR6TimingOrder:
    """R6 時序：`_extract_litedoc_metadata` 必須先於 `assemble`（值方能注入）。"""

    def test_metadata_extraction_precedes_assemble(self, monkeypatch, tmp_path):
        _setup_p1_mocks(monkeypatch, tmp_path,
                        llm_json='{"title":"T","authors":["A B"],"date":"2026-06-15"}')
        calls = []

        real_extract = LiteDocPipeline._extract_litedoc_metadata

        def _spy_extract(self, markdown_text):   # [FITZ-ANCHOR C2 U3] hints 參數退場、恢復單參
            calls.append("meta")
            return real_extract(self, markdown_text)

        real_assemble = lp.ingestion_engine.assemble

        def _spy_assemble(*a, **kw):
            calls.append("assemble")
            calls.append(("meta_values", kw.get("meta_values")))
            return real_assemble(*a, **kw)

        monkeypatch.setattr(LiteDocPipeline, "_extract_litedoc_metadata", _spy_extract)
        monkeypatch.setattr(lp.ingestion_engine, "assemble", _spy_assemble)

        LiteDocPipeline().run_phase1(_p1_ctx(tmp_path, paper_id="order"))

        order = [c for c in calls if isinstance(c, str)]
        assert order.index("meta") < order.index("assemble")   # 時序前移生效
        injected = dict(c for c in calls if isinstance(c, tuple))["meta_values"]
        assert injected and "A B" in injected                  # 值確實注入 assemble

    def test_build_tiles_meta_values_default_none_regression(self, tmp_path):
        """`_build_tiles` 未傳 meta_values → assemble 收到 None（等價回歸）。"""
        import json as _json

        md = tmp_path / "doc.md"
        md.write_text("# T\n\nBody text here.\n", encoding="utf-8")
        (tmp_path / "doc_doc_structure.json").write_text(
            _json.dumps({"structure": [{"start": 0, "end": 0, "type": "title"}]}),
            encoding="utf-8",
        )
        out = tmp_path / "out"
        out.mkdir()
        seen = {}
        real_assemble = lp.ingestion_engine.assemble

        def _spy(*a, **kw):
            seen["meta_values"] = kw.get("meta_values")
            return real_assemble(*a, **kw)

        lp.ingestion_engine.assemble = _spy
        try:
            LiteDocPipeline()._build_tiles(md, out, "doc", "news")
        finally:
            lp.ingestion_engine.assemble = real_assemble
        assert seen["meta_values"] is None


# ──────────────────────────────────────────────────────────────────────────
# FITZ-HOTFIX-1 C3：R4 譯題去後綴 / R8 P3 原文圖片過濾 + 雙語對稱不變式
# ──────────────────────────────────────────────────────────────────────────
import re as _re  # noqa: E402 — C3 段落圖片斷言用


def _png(path, w, h):
    """header-only PNG（image_filter 以 stdlib 解析 IHDR、無需真圖資料）。"""
    import struct as _st
    path.parent.mkdir(parents=True, exist_ok=True)
    ihdr = _st.pack(">II", w, h) + b"\x08\x02\x00\x00\x00"
    path.write_bytes(
        b"\x89PNG\r\n\x1a\n" + _st.pack(">I", 13) + b"IHDR" + ihdr + b"\x00" * 8
    )


def _four_figure_text():
    """4 圖：頭像 ×2（72×72）／分隔線（1456×5）／正文圖（1456×1442）。"""
    return "\n".join([
        "# Doc Title", "",
        "![](images/avatar_a.png)",       # 垃圾（面積 5184）
        "![](images/avatar_b.png)",       # 垃圾（面積 5184）
        "![](images/divider.png)",        # 垃圾（長寬比 291）
        "Body paragraph stays here.", "",
        "![](images/hero.png)",           # 內容（2.1M）
        "More body text.",
    ])


def _seed_four_images(tmp_path, paper_id="p3"):
    root = tmp_path / "out" / "1" / paper_id / "images"
    _png(root / "avatar_a.png", 72, 72)
    _png(root / "avatar_b.png", 72, 72)
    _png(root / "divider.png", 1456, 5)
    _png(root / "hero.png", 1456, 1442)
    return root


def _figs(text):
    return set(_re.findall(r"!\[.*?\]\((images/[^)]+)\)", text))


def _zh_en(spec):
    """合約③ 交付檔案路徑 → (zh 全文, en 全文)。"""
    return (Path(spec.final_zh_path).read_text(encoding="utf-8"),
            Path(spec.final_en_path).read_text(encoding="utf-8"))


def _ttitle(ctx):
    """translated_title 走 raw_metadata 旁路（PIPE-SLIDES-HOTFIX-1b 三欄 dict）。"""
    return (ctx.raw_metadata.get("translated_title") or {}).get("value") or ""


class TestR4ShadowTitleSuffix:
    """R4：譯題輸入不含後綴；影子成品恰一個 ` (測試)`。"""

    def test_translate_unit_receives_bare_title(self, monkeypatch, tmp_path):
        _setup_p3_mocks(monkeypatch, tmp_path, "Body text.")
        seen = []
        real_unit = lp.section_engine.translate_unit

        def _spy(text, inj, tr, text_type="content"):
            if text_type == "title":
                seen.append(text)
            return real_unit(text, inj, tr, text_type)

        monkeypatch.setattr(lp.section_engine, "translate_unit", _spy)
        ctx = _p3_ctx(_tiles_p3(), title="Headline (測試)")
        LiteDocPipeline().run_phase3(ctx)
        assert seen and all(" (測試)" not in t for t in seen)   # LLM 不見後綴
        assert _ttitle(ctx).count("(測試)") == 1                # 成品恰一個

    def test_non_shadow_title_gets_no_suffix(self, monkeypatch, tmp_path):
        _setup_p3_mocks(monkeypatch, tmp_path, "Body text.")
        ctx = _p3_ctx(_tiles_p3(), title="Headline")
        LiteDocPipeline().run_phase3(ctx)
        assert "(測試)" not in _ttitle(ctx)

    def test_translator_variant_output_still_single_suffix(self, monkeypatch, tmp_path):
        """LLM 回傳全形變體時，仍只有本處重貼之半形後綴恰一個（防雙後綴根因）。"""
        _setup_p3_mocks(monkeypatch, tmp_path, "Body text.")
        monkeypatch.setattr(
            lp.section_engine, "translate_unit",
            lambda text, inj, tr, text_type="content": f"譯：{text}（測試）"
            if text_type == "title" else f"ZH::{text}",
        )
        ctx = _p3_ctx(_tiles_p3(), title="Headline (測試)")
        LiteDocPipeline().run_phase3(ctx)
        assert _ttitle(ctx).count(" (測試)") == 1               # 半形後綴唯一


class TestR8SourceFigureFilter:
    """R8：P3 單點行級過濾 → is_zh／whole／en_text 三通道同收。"""

    def test_whole_mode_drops_junk_keeps_hero(self, monkeypatch, tmp_path):
        _seed_four_images(tmp_path)
        _setup_p3_mocks(monkeypatch, tmp_path, _four_figure_text())
        monkeypatch.setattr(settings, "IMG_FILTER_ENABLED", True)
        spec = LiteDocPipeline().run_phase3(_p3_ctx([]))    # 無 tiles → whole mode
        for side in _zh_en(spec):
            assert _figs(side) == {"images/hero.png"}       # 三垃圾全 DROP
            assert "Body paragraph stays here." in side

    def test_flag_off_is_noop_byte_equivalent(self, monkeypatch, tmp_path):
        _seed_four_images(tmp_path)
        src = _four_figure_text()
        _setup_p3_mocks(monkeypatch, tmp_path, src)
        monkeypatch.setattr(settings, "IMG_FILTER_ENABLED", False)
        spec = LiteDocPipeline().run_phase3(_p3_ctx([]))
        _, en = _zh_en(spec)
        assert _figs(en) == _figs(src)                      # 四圖原樣（no-op）
        assert len(_figs(en)) == 4

    def test_fail_open_on_filter_exception(self, monkeypatch, tmp_path):
        _seed_four_images(tmp_path)
        _setup_p3_mocks(monkeypatch, tmp_path, _four_figure_text())
        monkeypatch.setattr(settings, "IMG_FILTER_ENABLED", True)

        def _boom(*a, **k):
            raise RuntimeError("filter boom")

        monkeypatch.setattr(lp.image_filter, "make_figure_filter", _boom)
        spec = LiteDocPipeline().run_phase3(_p3_ctx([]))
        assert len(_figs(_zh_en(spec)[1])) == 4             # fail-open 全保留

    def test_is_zh_branch_also_filtered(self, monkeypatch, tmp_path):
        _seed_four_images(tmp_path)
        _setup_p3_mocks(monkeypatch, tmp_path, _four_figure_text())
        monkeypatch.setattr(settings, "IMG_FILTER_ENABLED", True)
        spec = LiteDocPipeline().run_phase3(_p3_ctx([], source_lang="zh"))
        assert _figs(_zh_en(spec)[0]) == {"images/hero.png"}  # zh 路同收

    def test_missing_image_file_fail_open_keeps_line(self, monkeypatch, tmp_path):
        """圖檔缺失（尺寸解析不出）→ filter fail-open KEEP、該行保留。"""
        (tmp_path / "out" / "1" / "p3" / "images").mkdir(parents=True)
        _setup_p3_mocks(monkeypatch, tmp_path,
                        "# T\n\n![](images/ghost.png)\n\nBody.")
        monkeypatch.setattr(settings, "IMG_FILTER_ENABLED", True)
        spec = LiteDocPipeline().run_phase3(_p3_ctx([]))
        assert "images/ghost.png" in _zh_en(spec)[1]


class TestR8BilingualFigureSymmetry:
    """R8 不變式：section mode 下 final_en 圖集 ≡ final_zh 圖集 ≡ tiles 過濾後圖集。"""

    def test_section_mode_en_zh_figure_sets_identical(self, monkeypatch, tmp_path):
        _seed_four_images(tmp_path)
        _setup_p3_mocks(monkeypatch, tmp_path, _four_figure_text())
        monkeypatch.setattr(settings, "IMG_FILTER_ENABLED", True)

        # section mode：多 section 且未退化（tiles 圖為過濾後之 hero）
        def _sec(t, body, fig=None):
            content = [{"type": "text", "content": body}]
            if fig:
                content.append({"type": "figure", "src": fig,
                                "content": f"![]({fig})"})
            return {"title": t, "content": content, "children": []}

        tiles = [
            _sec("Intro", "intro body text here", "images/hero.png"),
            _sec("Detail", "detail body text here"),
            _sec("Extra", "extra body text here"),
        ]
        ctx = _p3_ctx(tiles)
        spec = LiteDocPipeline().run_phase3(ctx)

        zh, en = _zh_en(spec)
        tiles_figs = {"images/hero.png"}                    # tiles 過濾後圖集
        assert _figs(en) == tiles_figs                      # en 側＝過濾後
        assert _figs(zh) == tiles_figs                      # zh 側＝tiles 重建
        assert _figs(en) == _figs(zh)                       # **雙語對稱不變式**


# ──────────────────────────────────────────────────────────────────────────
# FITZ-HOTFIX-1 §7.2 跨 Phase 整合測試（Checkout 必驗、WORKFLOW_SOP §7.2）
# key-changing transform＝真實 PDF → md（FitzProcessor 直抽）；串接 P1 全鏈 → P3
# ──────────────────────────────────────────────────────────────────────────
def _build_noisy_born_digital_pdf(path):
    """生成含八刀全部靶點之 born-digital PDF（模擬瀏覽器列印網頁）。"""
    import fitz as _fitz

    TITLE = "SpaceX and the Sentient Sun"
    doc = _fitz.open()
    for page_idx in range(2):
        page = doc.new_page()
        # R2 靶：每頁列印頁首 chrome（7.0pt、與真標題同文、落頂 band）
        page.insert_text(_fitz.Point(72, 22), TITLE, fontsize=7.0)
        page.insert_text(_fitz.Point(72, 830), f"Page {page_idx + 1} of 2", fontsize=7.0)
        if page_idx == 0:
            # R2 靶：真標題（25.6pt、亦落頂 band → 純文字 key 會被誤殺）
            page.insert_text(_fitz.Point(72, 72), TITLE, fontsize=25.6)
            # R6 靶：作者 meta 行（與 cover-prompt 抽出值同）
            page.insert_text(_fitz.Point(72, 108), "MARC ANDREESSEN", fontsize=15.2)
            # R5 靶：nav 導覽列（5 個獨立 link 平鋪）
            page.insert_text(_fitz.Point(72, 130),
                             "America Tech Opinion Culture Charts", fontsize=15.2)
            for i in range(5):
                page.insert_link({
                    "kind": _fitz.LINK_URI,
                    "from": _fitz.Rect(72 + i * 40, 120, 72 + i * 40 + 38, 138),
                    "uri": "https://example.com",
                })
            # R7 靶：計數短行（同 block 併行、帶詞逃過純數字規則）
            page.insert_text(_fitz.Point(72, 152), "53 82 Share", fontsize=15.2)
            # R3 靶：二級標題
            page.insert_text(_fitz.Point(72, 190), "Working Back from the Future",
                             fontsize=20.9)
            for j in range(4):
                page.insert_text(_fitz.Point(72, 220 + j * 22),
                                 f"Body sentence {j} carrying the bulk of characters "
                                 f"for body size detection purposes.", fontsize=15.2)
            # R8 靶：垃圾小圖（72×72 → 面積 5184 < 100k）
            junk = _fitz.Pixmap(_fitz.csRGB, _fitz.IRect(0, 0, 72, 72))
            junk.clear_with(180)
            page.insert_image(_fitz.Rect(72, 320, 144, 392), pixmap=junk)
            # R1 靶：內容圖 + 圖框內黏字（重疊 100% → 應剔除）
            hero = _fitz.Pixmap(_fitz.csRGB, _fitz.IRect(0, 0, 400, 300))
            hero.clear_with(210)
            page.insert_image(_fitz.Rect(72, 420, 472, 720), pixmap=hero)
            page.insert_text(_fitz.Point(120, 560), "SpaceXHasLaunchedMorePayloads",
                             fontsize=25.5)      # 黏字、字級大於真標題次級 → 會搶 heading
        else:
            # R3 靶：三級標題（小節）
            page.insert_text(_fitz.Point(72, 110), "The Industrial Moon", fontsize=17.1)
            for j in range(8):
                page.insert_text(_fitz.Point(72, 150 + j * 22),
                                 f"Second page body sentence {j} with enough text "
                                 f"to dominate the character weight map.", fontsize=15.2)
    doc.save(str(path))
    doc.close()
    return TITLE


def test_seam_fitz_hotfix1_r1_to_r8_end_to_end(monkeypatch, tmp_path):
    """§7.2：真實 PDF → 真 FitzProcessor → 真清洗鏈 → 真 _build_tiles → 真 P3。

    接縫不變式（八刀）：R1 圖框黏字不入正文／R2 真標題存活為 `#` 且 chrome 全剝／
    R3 `##`+`###` 三級成立／R5 nav 行剝除／R6 meta 值行不入 tiles／R7 計數短行剝除／
    R4 譯題恰一個 `(測試)`／R8 垃圾圖 DROP 且**雙語圖片對稱**。
    """
    from processor.fitz_processor import FitzProcessor
    from processor.md_cleaner import MarkdownCleaner
    from pipelines.ligature_repair import repair_ligatures

    monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path / "out")
    monkeypatch.setattr(settings, "IMG_FILTER_ENABLED", True)
    monkeypatch.setattr(settings, "LITEDOC_LIGATURE_REPAIR_ENABLED", True)
    out_dir = tmp_path / "out" / "1" / "p3"
    out_dir.mkdir(parents=True)

    # ── ① 真實 born-digital PDF → 真 FitzProcessor（key-changing transform）──
    pdf = tmp_path / "story.pdf"
    title_text = _build_noisy_born_digital_pdf(pdf)
    md_path = FitzProcessor().parse(str(pdf), str(out_dir))
    md_after_parse = md_path.read_text(encoding="utf-8")

    # R2：真標題存活為 `#`；chrome（同文 7.0pt、跨 2 頁）與頁碼全剝
    assert f"# {title_text}" in md_after_parse
    assert md_after_parse.count(title_text) == 1
    assert "Page 1 of 2" not in md_after_parse and "Page 2 of 2" not in md_after_parse
    # R3：三級階梯成立
    assert "## Working Back from the Future" in md_after_parse
    assert "### The Industrial Moon" in md_after_parse
    # R1：圖框內黏字未入正文（且未搶 heading）
    assert "SpaceXHasLaunchedMorePayloads" not in md_after_parse
    # R5：nav 導覽列剝除
    assert "America Tech Opinion Culture Charts" not in md_after_parse

    # ── ② 真清洗鏈（md_cleaner → 連字修復 → R7 數字短行）──
    MarkdownCleaner().clean(md_path)
    md_path.write_text(
        repair_ligatures(md_path.read_text(encoding="utf-8")), encoding="utf-8"
    )
    before_r7 = md_path.read_text(encoding="utf-8")
    md_path.write_text(lp._clean_short_number_lines(before_r7), encoding="utf-8")
    md_after_clean = md_path.read_text(encoding="utf-8")
    # R7：計數短行剝除、**行數不變式**、正文零損
    assert "53 82 Share" not in md_after_clean
    assert md_after_clean.count("\n") == before_r7.count("\n")
    assert "Body sentence 0" in md_after_clean

    # ── ③ 真 _build_tiles（R6 meta 值注入；判型 sidecar 以清洗後行號建）──
    lines = md_after_clean.split("\n")
    title_idx = lines.index(f"# {title_text}")
    (out_dir / f"{md_path.stem}_doc_structure.json").write_text(
        _json.dumps({"structure": [
            {"start": title_idx, "end": title_idx, "type": "title"},
        ]}), encoding="utf-8",
    )
    meta = {"authors": ["Marc Andreessen"], "publisher": "a16z", "date": "2026-06-15"}
    tiles = LiteDocPipeline()._build_tiles(
        md_path, out_dir, md_path.stem, "news",
        meta_values=LiteDocPipeline._collect_meta_values(meta),
    )
    tile_texts, tile_figs = [], []
    _walk_tiles(tiles, tile_texts, tile_figs)
    body_all = "\n".join(tile_texts)
    # R6：作者 meta 行經值比對剝除（判型僅標 title、靠兜底）
    assert "MARC ANDREESSEN" not in body_all
    # R1/R5/R7 於 tiles 層同樣零殘留；正文完整
    assert "SpaceXHasLaunchedMorePayloads" not in body_all
    assert "America Tech Opinion Culture Charts" not in body_all
    assert "53 82 Share" not in body_all
    assert "Body sentence 0" in body_all
    # R8（P1 側）：tiles 圖集僅剩內容圖（垃圾小圖已由 figure_filter DROP）
    tiles_fig_srcs = {f["src"] for f in tile_figs}
    assert tiles_fig_srcs and all("images/" in s for s in tiles_fig_srcs)

    # ── ④ 真 run_phase3（R4 譯題 / R8 原文圖片過濾、雙語對稱）──
    tr = _DetTr3()
    monkeypatch.setattr(lp, "Translator", lambda *a, **k: tr)
    monkeypatch.setattr(settings, "LLM_MAX_CONCURRENT", 4)
    ctx = PipelineContext(doc_type="news", paper_id="p3",
                          pdf_path=str(pdf), owner_id=1)
    ctx.ingestion = _Ing(title=f"{title_text} (測試)", authors=["Marc Andreessen"],
                         venue="a16z", source_lang="en", tiles=tiles)
    ctx.glossary_ready = _GR(abstract="a", lcc="general", glossary={},
                             translated_abstract="譯摘要", section_summaries={},
                             domain_name="News")
    ctx.raw_metadata = {}
    spec = LiteDocPipeline().run_phase3(ctx)
    zh, en = _zh_en(spec)

    # R4：譯題恰一個 `(測試)`（LLM 未見後綴、由 P3 唯一重貼）
    assert _ttitle(ctx).count("(測試)") == 1
    # R8：雙語圖片**對稱**（en 走過濾後原文、zh 走過濾後 tiles）
    assert _figs(en) == _figs(zh)
    # 八刀雜訊於最終雙語產物零殘留
    for side in (zh, en):
        assert "SpaceXHasLaunchedMorePayloads" not in side
        assert "America Tech Opinion Culture Charts" not in side
        assert "53 82 Share" not in side


# ──────────────────────────────────────────────────────────────────────────
# FITZ-HOTFIX-2：K1 報頭行界收窄 / K2 sidecar 定位與雙語圖片對稱恢復
# ──────────────────────────────────────────────────────────────────────────
class TestK1HeaderBoundaryNarrowing:
    """K1：行界只計 meta 型塊 → SpaceX v3 真 sidecar 由 119 收窄為 10。"""

    # v3 實物形狀：title/authors/publication_info 集中於前段，
    # DocAnalyzer 另把正文判成 intro_text/other 並一路延伸至 line 119。
    _V3_STRUCT = {"structure": [
        {"start": 0, "end": 0, "type": "title"},
        {"start": 2, "end": 4, "type": "authors"},
        {"start": 6, "end": 10, "type": "publication_info"},
        {"start": 12, "end": 60, "type": "intro_text"},     # 非 meta（元凶）
        {"start": 62, "end": 119, "type": "other"},         # 非 meta（元凶）
    ]}

    @staticmethod
    def _md_with_figures_at(line_map, total=130):
        lines = [""] * total
        for idx, src in line_map.items():
            lines[idx] = f"![]({src})"
        return "\n".join(lines)

    def test_boundary_narrowed_to_meta_blocks(self):
        """hdr_end 由 max(全部)=119 收窄為 max(meta)=10。"""
        md = self._md_with_figures_at({
            4: "images/avatar.png",     # ≤10 報頭內（仍中規則③）
            6: "images/logo.png",       # ≤10 報頭內
            15: "images/cover.png",     # >10 封面大圖 → **獲救**
            91: "images/falcon9.png",   # >10 正文照片 → **獲救**
        })
        srcs = LiteDocPipeline._collect_header_srcs(md, self._V3_STRUCT)
        assert srcs == {"images/avatar.png", "images/logo.png"}
        assert "images/cover.png" not in srcs        # 封面大圖獲救（K1 核心）
        assert "images/falcon9.png" not in srcs      # Falcon 9 照片獲救

    def test_old_behaviour_would_have_swallowed_everything(self):
        """對照組：舊行界（全部塊 max end=119）會把四張圖全掃進報頭。"""
        all_ends = [int(b["end"]) for b in self._V3_STRUCT["structure"]]
        assert max(all_ends) == 119                            # 舊行界
        meta_ends = [int(b["end"]) for b in self._V3_STRUCT["structure"]
                     if b["type"] in LiteDocPipeline._HEADER_META_TYPES]
        assert max(meta_ends) == 10                            # K1 新行界

    def test_no_meta_block_returns_empty(self):
        """無 meta 型塊 → 回 set()、規則③自然停用（①②照跑）。"""
        struct = {"structure": [{"start": 0, "end": 50, "type": "other"}]}
        md = self._md_with_figures_at({3: "images/x.png"}, total=60)
        assert LiteDocPipeline._collect_header_srcs(md, struct) == set()

    def test_header_meta_types_sourced_from_meta_types(self):
        """同源守衛：`_HEADER_META_TYPES` 由 `_META_TYPES` 導出（防常數漂移）。"""
        assert set(LiteDocPipeline._META_TYPES) <= LiteDocPipeline._HEADER_META_TYPES
        assert "title" in LiteDocPipeline._HEADER_META_TYPES


class TestK2SidecarLocationAndSymmetry:
    """K2：sidecar 三級定位（影子軌無後綴）+ 規則③注入 → 雙語對稱恢復。"""

    _STRUCT = _json.dumps({"structure": [
        {"start": 0, "end": 0, "type": "title"},
        {"start": 2, "end": 3, "type": "authors"},
        {"start": 20, "end": 99, "type": "other"},   # 非 meta、不撐行界
    ]})

    @staticmethod
    def _ctx_shadow(tmp_path):
        ctx = PipelineContext(doc_type="news", paper_id="p3_shadow",
                              pdf_path="/x/SpaceX_the_Sentient_Sun.pdf", owner_id=1)
        return ctx

    def test_primary_path_by_pdf_stem_not_paper_id(self, monkeypatch, tmp_path):
        """主路以 PDF stem 定位——影子軌 paper_id 帶 `_shadow` 而實體檔沒有。"""
        monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path / "out")
        out = tmp_path / "out" / "1" / "p3_shadow"
        out.mkdir(parents=True)
        (out / "SpaceX_the_Sentient_Sun_doc_structure.json").write_text(
            self._STRUCT, encoding="utf-8")
        md = "\n".join(["# T", "", "![](images/a.png)", "BY", "", "body"])
        srcs = LiteDocPipeline()._load_header_srcs(self._ctx_shadow(tmp_path), out, md)
        assert srcs == {"images/a.png"}          # 主路命中（非 paper_id 拼接）

    def test_glob_fallback_when_stem_mismatch(self, monkeypatch, tmp_path):
        """備路 glob：stem 對不上時仍能取到目錄內唯一 sidecar。"""
        monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path / "out")
        out = tmp_path / "out" / "1" / "p3_shadow"
        out.mkdir(parents=True)
        (out / "totally_other_name_doc_structure.json").write_text(
            self._STRUCT, encoding="utf-8")
        md = "\n".join(["# T", "", "![](images/a.png)", "BY", "", "body"])
        srcs = LiteDocPipeline()._load_header_srcs(self._ctx_shadow(tmp_path), out, md)
        assert srcs == {"images/a.png"}          # 備路 glob 命中

    def test_missing_sidecar_fail_open_empty(self, monkeypatch, tmp_path):
        """三級兜底：無 sidecar → set()（規則③兩通道同步停用、對稱維持）。"""
        monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path / "out")
        out = tmp_path / "out" / "1" / "p3_shadow"
        out.mkdir(parents=True)
        assert LiteDocPipeline()._load_header_srcs(
            self._ctx_shadow(tmp_path), out, "# T") == set()

    def test_corrupt_sidecar_fail_open_empty(self, monkeypatch, tmp_path):
        monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path / "out")
        out = tmp_path / "out" / "1" / "p3_shadow"
        out.mkdir(parents=True)
        (out / "x_doc_structure.json").write_text("{ not json", encoding="utf-8")
        assert LiteDocPipeline()._load_header_srcs(
            self._ctx_shadow(tmp_path), out, "# T") == set()

    def test_rule3_drop_applies_to_source_text_channel(self, monkeypatch, tmp_path):
        """K2 核心：規則③於原文通道生效——報頭內圖 DROP、界外大圖 KEEP。"""
        out = tmp_path / "out" / "1" / "p3"
        out.mkdir(parents=True)
        # 兩張圖尺寸皆足以逃過規則①②（面積 >100k、長寬比正常）→ 只有 ③ 能殺
        _png(out / "images" / "hdr_big.png", 400, 300)
        _png(out / "images" / "body_big.png", 400, 300)
        (out / "in_doc_structure.json").write_text(_json.dumps({"structure": [
            {"start": 0, "end": 0, "type": "title"},
            {"start": 2, "end": 2, "type": "authors"},   # meta 行界＝2
        ]}), encoding="utf-8")
        src_text = "\n".join([
            "# T", "", "![](images/hdr_big.png)", "",     # line 2 ≤2 → ③ DROP
            "Body text.", "![](images/body_big.png)",     # line 5 >2 → KEEP
        ])
        _setup_p3_mocks(monkeypatch, tmp_path, src_text)
        monkeypatch.setattr(settings, "IMG_FILTER_ENABLED", True)
        spec = LiteDocPipeline().run_phase3(_p3_ctx([]))
        zh, en = _zh_en(spec)
        assert _figs(en) == {"images/body_big.png"}   # 報頭大圖被 ③ 剝
        assert "images/hdr_big.png" not in en

    def test_bilingual_symmetry_under_rule3(self, monkeypatch, tmp_path):
        """**對稱不變式**：規則③會殺的情境下，final_en 圖集 ≡ final_zh 圖集。

        HOTFIX-2 前：原文通道未傳 header_srcs → ③ 恆停用；tiles 通道有 ③
        → 同一圖兩通道判定不同、雙語不對稱（v3 實測 en21 vs zh19）。
        """
        out = tmp_path / "out" / "1" / "p3"
        out.mkdir(parents=True)
        _png(out / "images" / "hdr_big.png", 400, 300)
        _png(out / "images" / "body_big.png", 400, 300)
        (out / "in_doc_structure.json").write_text(_json.dumps({"structure": [
            {"start": 0, "end": 0, "type": "title"},
            {"start": 2, "end": 2, "type": "authors"},
        ]}), encoding="utf-8")
        src_text = "\n".join([
            "# T", "", "![](images/hdr_big.png)", "",
            "Body text.", "![](images/body_big.png)",
        ])
        _setup_p3_mocks(monkeypatch, tmp_path, src_text)
        monkeypatch.setattr(settings, "IMG_FILTER_ENABLED", True)

        # tiles 側亦僅含界外大圖（＝tiles 路規則③過濾後之結果）
        tiles = [{"title": "S1", "content": [
            {"type": "text", "content": "Body text."},
            {"type": "figure", "src": "images/body_big.png",
             "content": "![](images/body_big.png)"},
        ], "children": []}]
        spec = LiteDocPipeline().run_phase3(_p3_ctx(tiles))
        zh, en = _zh_en(spec)
        assert _figs(en) == _figs(zh)                    # **雙語對稱不變式**
        assert "images/hdr_big.png" not in en and "images/hdr_big.png" not in zh


# ──────────────────────────────────────────────────────────────────────────
# FITZ-HOTFIX-3 K3：full_text 行級 meta 歸零（K2 sidecar hint 加載已於
# FITZ-ANCHOR C2 U3 退場——見 TestAnchorAndReinject 的 U1/U3 覆蓋）
# ──────────────────────────────────────────────────────────────────────────
class TestK3MetaSourceLineStripping:
    """K3：full_text 行級 meta 歸零（雙判據）+ 時序 + 雙語文字對稱。"""

    _META_LEAK_MD = "\n".join([
        "# Doc Title",                                   # 0 title
        "",                                              # 1
        "MARC ANDREESSEN AND MICHAEL MCGUINESS",         # 2 authors meta 洩漏
        "",                                              # 3
        "JUN 15, 2026",                                  # 4 date meta 洩漏
        "",                                              # 5
        "Body paragraph about Marc Andreessen and the future.",  # 6 正文（含作者名·不剝）
        "More body text here.",                          # 7
    ])

    @staticmethod
    def _ctx(tmp_path, source_lang="en"):
        out = tmp_path / "out" / "1" / "p3"
        out.mkdir(parents=True, exist_ok=True)
        (out / "in_doc_structure.json").write_text(_json.dumps({"structure": [
            {"start": 0, "end": 0, "type": "title"},
            {"start": 2, "end": 2, "type": "authors"},
            {"start": 4, "end": 4, "type": "publication_info"},
        ]}), encoding="utf-8")
        ctx = PipelineContext(doc_type="news", paper_id="p3",
                              pdf_path="/x/in.pdf", owner_id=1)
        ctx.ingestion = _Ing(title="Doc Title",
                             authors=["Marc Andreessen", "Michael McGuiness"],
                             venue="a16z", source_lang=source_lang, tiles=[])
        ctx.glossary_ready = _GR(abstract="a", lcc="general", glossary={},
                                 translated_abstract="譯摘要", section_summaries={},
                                 domain_name="News")
        ctx.raw_metadata = {"date": {"value": "2026-06-15"}}
        return ctx

    def test_meta_lines_stripped_body_mention_kept(self, monkeypatch, tmp_path):
        monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path / "out")
        ctx = self._ctx(tmp_path)
        out = LiteDocPipeline()._strip_meta_source_lines(ctx, self._META_LEAK_MD)
        assert "MARC ANDREESSEN AND MICHAEL MCGUINESS" not in out   # span 判據剝
        assert "JUN 15, 2026" not in out                           # span 判據剝
        assert "Body paragraph about Marc Andreessen" in out       # 正文提及不誤殺

    def test_value_pass_without_sidecar(self, monkeypatch, tmp_path):
        """sidecar 缺 → 僅值比對仍剝整行等於 meta 值者。"""
        monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path / "out")
        out_dir = tmp_path / "out" / "1" / "p3"
        out_dir.mkdir(parents=True)          # 無 sidecar
        ctx = PipelineContext(doc_type="news", paper_id="p3",
                              pdf_path="/x/in.pdf", owner_id=1)
        ctx.ingestion = _Ing(title="T", authors=["Marc Andreessen and Michael McGuiness"],
                             venue="", source_lang="en", tiles=[])
        ctx.raw_metadata = {}
        md = "# T\n\nMarc Andreessen and Michael McGuiness\n\nBody stays."
        out = LiteDocPipeline()._strip_meta_source_lines(ctx, md)
        assert "Marc Andreessen and Michael McGuiness" not in out
        assert "Body stays." in out

    def test_no_judgement_noop(self, monkeypatch, tmp_path):
        """兩判據皆缺（無 sidecar、無 meta 值）→ no-op byte 等價。"""
        monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path / "out")
        out_dir = tmp_path / "out" / "1" / "p3"
        out_dir.mkdir(parents=True)
        ctx = PipelineContext(doc_type="news", paper_id="p3",
                              pdf_path="/x/in.pdf", owner_id=1)
        ctx.ingestion = _Ing(title="T", authors=[], venue="", source_lang="en", tiles=[])
        ctx.raw_metadata = {}
        md = "# T\n\nBody text.\n"
        assert LiteDocPipeline()._strip_meta_source_lines(ctx, md) == md

    def test_image_lines_not_touched(self, monkeypatch, tmp_path):
        """圖片行歸 R8、K3 不碰（即使落在 meta span 內）。"""
        monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path / "out")
        out_dir = tmp_path / "out" / "1" / "p3"
        out_dir.mkdir(parents=True)
        (out_dir / "in_doc_structure.json").write_text(_json.dumps({"structure": [
            {"start": 0, "end": 3, "type": "title"},
        ]}), encoding="utf-8")
        ctx = PipelineContext(doc_type="news", paper_id="p3",
                              pdf_path="/x/in.pdf", owner_id=1)
        ctx.ingestion = _Ing(title="T", authors=[], venue="", source_lang="en", tiles=[])
        ctx.raw_metadata = {}
        md = "# T\n\n![](images/logo.png)\ntext line"
        out = LiteDocPipeline()._strip_meta_source_lines(ctx, md)
        assert "![](images/logo.png)" in out          # 圖片行保留（歸 R8）

    def test_k3_precedes_echo_strip_and_r8(self, monkeypatch, tmp_path):
        """順序斷言：K3 於 echo-strip 與 R8 之前執行（行號位移前）。"""
        _setup_p3_mocks(monkeypatch, tmp_path, "body")
        calls = []
        monkeypatch.setattr(LiteDocPipeline, "_strip_meta_source_lines",
                            lambda self, ctx, t: (calls.append("k3"), t)[1])
        monkeypatch.setattr(lp.section_engine, "strip_title_echo",
                            lambda t, title: (calls.append("echo"), t)[1])
        monkeypatch.setattr(LiteDocPipeline, "_filter_source_figures",
                            lambda self, ctx, t: (calls.append("r8"), t)[1])
        LiteDocPipeline().run_phase3(_p3_ctx(_tiles_p3()))
        assert calls.index("k3") < calls.index("echo") < calls.index("r8")

    def test_bilingual_text_meta_symmetry(self, monkeypatch, tmp_path):
        """雙語文字對稱：whole 模式 final_en 與 final_zh 之 meta 原文行皆已歸零。"""
        monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path / "out")
        ctx = self._ctx(tmp_path)
        _setup_p3_mocks(monkeypatch, tmp_path, self._META_LEAK_MD)
        spec = LiteDocPipeline().run_phase3(ctx)            # 無 tiles → whole mode
        zh, en = _zh_en(spec)
        for side in (zh, en):
            assert "MARC ANDREESSEN" not in side
            assert "JUN 15, 2026" not in side              # 雙語 meta 行皆空、對稱


# ──────────────────────────────────────────────────────────────────────────
# FITZ-ANCHOR C2：U1 錨定前移 / U2 標題回注 promote-else-inject / U3 sidecar 退場
# ──────────────────────────────────────────────────────────────────────────
class TestC2AnchorText:
    """U1 `_read_anchor_text`：裸抽前 N 頁原始文字層（含 chrome URL）；截頁；失敗 fallback。"""

    def test_reads_front_pages_with_chrome_url(self, monkeypatch, tmp_path):
        monkeypatch.setattr(settings, "LITEDOC_ANCHOR_MAX_PAGES", 2)
        pdf = tmp_path / "a.pdf"
        doc = _fitz.open()
        for i, body in enumerate(["PAGE ONE anchor body", "PAGE TWO anchor body",
                                  "PAGE THREE excluded"]):
            page = doc.new_page()
            page.insert_text(_fitz.Point(72, 40),
                             "https://site.example/story", fontsize=8)   # chrome URL
            page.insert_text(_fitz.Point(72, 120), body, fontsize=12)
        doc.save(str(pdf))
        doc.close()
        anchor = LiteDocPipeline._read_anchor_text(pdf)
        assert "PAGE ONE anchor body" in anchor
        assert "PAGE TWO anchor body" in anchor
        assert "https://site.example/story" in anchor      # 裸文字天然含 chrome URL（U3 吸收）
        assert "PAGE THREE excluded" not in anchor          # MAX_PAGES=2 截頁

    def test_respects_max_pages_setting(self, monkeypatch, tmp_path):
        monkeypatch.setattr(settings, "LITEDOC_ANCHOR_MAX_PAGES", 1)
        pdf = tmp_path / "b.pdf"
        doc = _fitz.open()
        for body in ["ONLY FIRST kept", "SECOND dropped"]:
            page = doc.new_page()
            page.insert_text(_fitz.Point(72, 120), body, fontsize=12)
        doc.save(str(pdf))
        doc.close()
        anchor = LiteDocPipeline._read_anchor_text(pdf)
        assert "ONLY FIRST kept" in anchor
        assert "SECOND dropped" not in anchor

    def test_bad_path_fails_open_to_empty(self, tmp_path):
        """掃描件/加密/壞檔 → 回 ""（呼叫端 fallback md 文首、行為等價、不成 SPOF）。"""
        bad = tmp_path / "not.pdf"
        bad.write_bytes(b"%PDF-1.4 not really a pdf")
        assert LiteDocPipeline._read_anchor_text(bad) == ""


class TestC2ReinjectTitle:
    """U2 `_reinject_title`：promote-else-inject 三分支 + 空 title 跳過（整類標題誤殺保底）。"""

    def _md(self, tmp_path, text):
        p = tmp_path / "doc.md"
        p.write_text(text, encoding="utf-8")
        return p

    def test_heading_already_present_unchanged(self, tmp_path, caplog):
        md = self._md(tmp_path, "# Ohtani Report\n\nBody paragraph here.\n")
        before = md.read_text(encoding="utf-8")
        LiteDocPipeline._reinject_title(md, "Ohtani Report")
        assert md.read_text(encoding="utf-8") == before      # 不動、不重複注入
        assert not any("標題回注" in r.getMessage() for r in caplog.records)

    def test_body_line_promoted_in_place(self, tmp_path, caplog):
        import logging as _logging
        md = self._md(tmp_path, "Ohtani Report\n\nBody paragraph here.\n")
        with caplog.at_level(_logging.WARNING):
            LiteDocPipeline._reinject_title(md, "Ohtani Report")
        out = md.read_text(encoding="utf-8")
        assert "# Ohtani Report" in out                      # 就地升級為 heading
        assert out.count("Ohtani Report") == 1               # 不重複（promote 非 inject）
        assert any("case=promote" in r.getMessage() for r in caplog.records)

    def test_absent_title_injected_at_top(self, tmp_path, caplog):
        import logging as _logging
        md = self._md(tmp_path, "Unrelated opening line.\n\nBody paragraph.\n")
        with caplog.at_level(_logging.WARNING):
            LiteDocPipeline._reinject_title(md, "Ohtani Report")
        out = md.read_text(encoding="utf-8")
        assert out.startswith("# Ohtani Report\n\n")           # 頂部注入
        assert "Unrelated opening line." in out               # 原文保留
        assert any("case=inject" in r.getMessage() for r in caplog.records)

    def test_empty_title_skips(self, tmp_path, caplog):
        md = self._md(tmp_path, "Body only, no title.\n")
        before = md.read_text(encoding="utf-8")
        LiteDocPipeline._reinject_title(md, "   ")
        assert md.read_text(encoding="utf-8") == before        # 空 title → 整步跳過
        assert not any("標題回注" in r.getMessage() for r in caplog.records)

    def test_normalization_ignores_whitespace_case(self, tmp_path):
        """正規化（去空白 casefold）：`#  ohtani   REPORT` 視為已存在、不重複注入。"""
        md = self._md(tmp_path, "#  ohtani   REPORT\n\nBody.\n")
        before = md.read_text(encoding="utf-8")
        LiteDocPipeline._reinject_title(md, "Ohtani Report")
        assert md.read_text(encoding="utf-8") == before


class TestC2SidecarRetired:
    """U3：HOTFIX-3 K2 sidecar 消費端 dead code 清除斷言（生產端見 test_fitz_processor）。"""

    def test_load_source_hints_symbol_removed(self):
        assert not hasattr(LiteDocPipeline, "_load_source_hints")

    def test_extract_metadata_is_single_param(self):
        import inspect
        sig = inspect.signature(LiteDocPipeline._extract_litedoc_metadata)
        # self + markdown_text（hints 參數已退場）
        assert list(sig.parameters) == ["self", "markdown_text"]

    def test_publisher_resolvable_from_anchor_chrome_url(self, monkeypatch, tmp_path):
        """U3 移除後 publisher 回歸：錨定裸文字含 chrome URL → cover-prompt 輸入含之、
        LLM 據以解 publisher（此處捕 LLM 輸入斷言 URL 入窗）。"""
        captured = {}

        class _CapLLM:
            def chat(self, messages=None, **kw):
                captured["user"] = (messages or [{}])[-1].get("content", "")
                return '{"title":"T","publisher":"NHK"}'

        import llm.client
        monkeypatch.setattr(llm.client.LLMClient, "get_instance",
                            classmethod(lambda cls: _CapLLM()))
        monkeypatch.setattr(settings, "LLM_DOMAIN_MODEL", "x", raising=False)
        anchor = "NHK NEWS WEB\nhttps://www3.nhk.or.jp/news/story\nBody."
        meta = LiteDocPipeline()._extract_litedoc_metadata(anchor)
        assert "https://www3.nhk.or.jp/news/story" in captured["user"]  # chrome URL 入 cover-prompt
        assert meta.get("publisher") == "NHK"


# === [FITZ-ANCHOR C2] §7.2 跨 Phase 整合：實體 PDF（描邊 ×N 標題/QA＋2/N 重複段＋全頁
# chrome URL）→ 真 FitzProcessor（C1 U4/U5 幾何）→ 真 cleaner → 錨定裸讀 → U2 回注 →
# 真 _build_tiles；key-changing transform＝PDF→md（fitz 直抽）。斷言標題經回注存活入
# heading、14 組 QA 成對、chrome URL 已剪、meta 零重播。===
def test_seam_c2_anchor_reinject_key_changing_integration(monkeypatch, tmp_path):
    from processor.md_cleaner import MarkdownCleaner as _RealCleaner

    monkeypatch.setattr(settings, "LITEDOC_ANCHOR_MAX_PAGES", 2)
    TITLE = "Ohtani Season Report"
    CHROME_URL = "https://www3.nhk.or.jp/news/ohtani"

    # ⓪ 實體 PDF：標題與 QA 皆 11pt（幾何層不判 heading——考驗 U2 回注救回）；描邊 ×2
    # 同位重繪（考驗 U4 去重）；全頁頂 band chrome URL（考驗 U5 跨頁剝除、2/2 命中）。
    pdf = tmp_path / "nhk.pdf"
    doc = _fitz.open()
    qa_lines = []
    for i in range(14):
        qa_lines.append((f"Q{i}: question about data point {i} here?",
                         f"A{i}: answer regarding data point {i} explained."))
    per_page = 7
    for pg in range(2):
        page = doc.new_page()
        # 全頁 chrome（頂 band、跨頁重複 → U5 剝除；含 publisher URL）
        for dx in (0.0, 0.5):                                 # 描邊 ×2
            page.insert_text(_fitz.Point(72 + dx, 22), f"NHK NEWS {CHROME_URL}", fontsize=8)
        y = 120
        if pg == 0:                                           # 標題僅首頁、11pt 同正文
            for dx in (0.0, 0.5):                             # 描邊 ×2（U4 去重為 1）
                page.insert_text(_fitz.Point(72 + dx, 90), TITLE, fontsize=11)
        for q, a in qa_lines[pg * per_page:(pg + 1) * per_page]:
            for dx in (0.0, 0.5):                             # 每行描邊 ×2
                page.insert_text(_fitz.Point(72 + dx, y), q, fontsize=11)
            y += 26
            for dx in (0.0, 0.5):
                page.insert_text(_fitz.Point(72 + dx, y), a, fontsize=11)
            y += 26
    doc.save(str(pdf))
    doc.close()

    # ① 真 FitzProcessor 直抽（key-changing：PDF → 同形 md；U4 去重、U5 chrome 剝除）
    out = tmp_path / "out"
    md_path = _fp.FitzProcessor().parse(str(pdf), str(out))
    # ② 真 cleaner
    _RealCleaner().clean(md_path)
    md_before = md_path.read_text(encoding="utf-8")
    assert f"# {TITLE}" not in md_before                      # 幾何層未判 heading（11pt 同正文）
    assert md_before.count(TITLE) == 1                        # U4：描邊 ×2 已去重為 1
    assert CHROME_URL not in md_before                        # U5：全頁 chrome 跨頁剝除

    # ③ 錨定裸讀（含 chrome URL、天然吸收 sidecar 職能）
    anchor = LiteDocPipeline._read_anchor_text(pdf)
    assert TITLE in anchor and CHROME_URL in anchor

    # ④ U2 標題回注（幾何漏判 → promote 救回、單點終局保底）
    LiteDocPipeline._reinject_title(md_path, TITLE)
    md_after = md_path.read_text(encoding="utf-8")

    assert f"# {TITLE}" in md_after                           # 標題經回注存活入 heading
    assert md_after.count(TITLE) == 1                         # 回注不重複
    for i in range(14):                                       # 14 組 QA 完整成對
        assert f"Q{i}:" in md_after, f"Q{i} 缺失"
        assert f"A{i}:" in md_after, f"A{i} 缺失"
    assert CHROME_URL not in md_after                         # chrome URL 未重播進正文
