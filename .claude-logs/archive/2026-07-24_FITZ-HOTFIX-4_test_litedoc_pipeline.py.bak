# ──────────────────────────────────────────────────────────────────────────
# PIPE-INGEST-FITZ C3：P1 文字層閘門 + 連字修復接線 + §7.2 整合
# ──────────────────────────────────────────────────────────────────────────
import fitz as _fitz  # noqa: E402

from processor import fitz_processor as _fp  # noqa: E402


def _gate_spies(monkeypatch, tmp_path, *, median):
    """閘門路由 spy：記錄 fitz/mineru 何者被呼；median 可為值或 raising callable。"""
    called = {}

    class _SpyFitz:
        def parse(self, pdf, outdir):
            called["fitz"] = True
            md = Path(outdir) / f"{Path(pdf).stem}.md"
            md.parent.mkdir(parents=True, exist_ok=True)
            md.write_text("# Sample Headline\n\nBody text here.", encoding="utf-8")
            return str(md)

    class _SpyMinerU:
        def parse(self, pdf, outdir):
            called["mineru"] = True
            md = Path(outdir) / "doc.md"
            md.parent.mkdir(parents=True, exist_ok=True)
            md.write_text("# Sample Headline\n\nBody text here.", encoding="utf-8")
            return str(md)

    monkeypatch.setattr(lp.fitz_processor, "FitzProcessor", _SpyFitz)
    med_fn = median if callable(median) else (lambda p: float(median))
    monkeypatch.setattr(lp.fitz_processor, "median_page_chars", med_fn)
    monkeypatch.setattr(lp, "PDFProcessor", _SpyMinerU)
    return called


def test_p1_gate_born_digital_routes_fitz(monkeypatch, tmp_path):
    """閘門三態①：中位數 ≥ 門檻 → FitzProcessor、MinerU 不被呼。"""
    _setup_p1_mocks(monkeypatch, tmp_path, llm_json='{"title":"T","authors":[]}')
    monkeypatch.setattr(settings, "LITEDOC_FITZ_ENABLED", True)
    called = _gate_spies(monkeypatch, tmp_path, median=500.0)
    spec = LiteDocPipeline().run_phase1(_p1_ctx(tmp_path))
    assert called == {"fitz": True}
    assert isinstance(spec, IngestionMetadataSpec)


def test_p1_gate_sparse_routes_mineru(monkeypatch, tmp_path):
    """閘門三態②：中位數 < 門檻（掃描/稀疏）→ 既有 MinerU 路。"""
    _setup_p1_mocks(monkeypatch, tmp_path, llm_json='{"title":"T","authors":[]}')
    monkeypatch.setattr(settings, "LITEDOC_FITZ_ENABLED", True)
    called = _gate_spies(monkeypatch, tmp_path, median=10.0)
    LiteDocPipeline().run_phase1(_p1_ctx(tmp_path))
    assert called == {"mineru": True}


def test_p1_gate_fitz_failure_fails_open_to_mineru(monkeypatch, tmp_path, caplog):
    """閘門三態③：fitz 直抽拋例外 → warning（exc_info）fail-open 退 MinerU、攝入不中斷。"""
    import logging as _logging

    _setup_p1_mocks(monkeypatch, tmp_path, llm_json='{"title":"T","authors":[]}')
    monkeypatch.setattr(settings, "LITEDOC_FITZ_ENABLED", True)
    called = _gate_spies(monkeypatch, tmp_path, median=500.0)

    class _BoomFitz:
        def parse(self, pdf, outdir):
            raise RuntimeError("boom: 直抽爆炸")

    monkeypatch.setattr(lp.fitz_processor, "FitzProcessor", _BoomFitz)
    with caplog.at_level(_logging.WARNING, logger="pipelines.litedoc_pipeline"):
        spec = LiteDocPipeline().run_phase1(_p1_ctx(tmp_path))
    assert called == {"mineru": True}
    assert isinstance(spec, IngestionMetadataSpec)
    warn = [r for r in caplog.records if "fail-open" in r.getMessage()]
    assert warn and warn[0].exc_info  # warning 且帶 exc_info


def test_p1_flags_off_byte_equivalent_regression(monkeypatch, tmp_path):
    """雙 flag off → MinerU 被呼、閘門零觸碰（median 不得被諮詢）、md byte 原樣。"""
    _setup_p1_mocks(monkeypatch, tmp_path, llm_json='{"title":"T","authors":[]}')
    monkeypatch.setattr(settings, "LITEDOC_FITZ_ENABLED", False)
    monkeypatch.setattr(settings, "LITEDOC_LIGATURE_REPAIR_ENABLED", False)
    raw = "# T\n\nthe ;rst Pro1les body."
    md_holder = {}

    class _SpyMinerU:
        def parse(self, pdf, outdir):
            md = Path(outdir) / "doc.md"
            md.parent.mkdir(parents=True, exist_ok=True)
            md.write_text(raw, encoding="utf-8")
            md_holder["path"] = md
            return str(md)

    def _boom_median(p):
        raise AssertionError("flag off 時 median_page_chars 不得被呼叫")

    monkeypatch.setattr(lp.fitz_processor, "median_page_chars", _boom_median)
    monkeypatch.setattr(lp, "PDFProcessor", _SpyMinerU)
    LiteDocPipeline().run_phase1(_p1_ctx(tmp_path))
    # byte 等價：連字損毀原樣保留（修復步關閉、cleaner 為 fake 直通）
    assert md_holder["path"].read_text(encoding="utf-8") == raw


def test_p1_ligature_repair_wired_after_clean(monkeypatch, tmp_path):
    """修復接線：fitz off + repair on → MinerU 產出之 md 連字被行內修復。"""
    _setup_p1_mocks(monkeypatch, tmp_path, llm_json='{"title":"T","authors":[]}')
    monkeypatch.setattr(settings, "LITEDOC_FITZ_ENABLED", False)
    monkeypatch.setattr(settings, "LITEDOC_LIGATURE_REPAIR_ENABLED", True)
    md_holder = {}

    class _SpyMinerU:
        def parse(self, pdf, outdir):
            md = Path(outdir) / "doc.md"
            md.parent.mkdir(parents=True, exist_ok=True)
            md.write_text("# T\n\nthe ;rst Pro1les of de1ning firms.",
                          encoding="utf-8")
            md_holder["path"] = md
            return str(md)

    monkeypatch.setattr(lp, "PDFProcessor", _SpyMinerU)
    LiteDocPipeline().run_phase1(_p1_ctx(tmp_path))
    fixed = md_holder["path"].read_text(encoding="utf-8")
    assert "the first Profiles of defining firms." in fixed
    assert ";rst" not in fixed and "Pro1les" not in fixed


# === [PIPE-INGEST-FITZ C3] §7.2 跨 Phase 整合：實體 PDF → 真 fitz 直抽 → 真 clean/修復
# → 判型行界（修復前行號建 sidecar、行數不變式保證對齊）→ 真 _build_tiles 端到端 ===
def test_seam_fitz_ingest_key_changing_integration(monkeypatch, tmp_path):
    import json as _json

    from processor.md_cleaner import MarkdownCleaner as _RealCleaner

    monkeypatch.setattr(settings, "IMG_FILTER_ENABLED", True)
    monkeypatch.setattr(settings, "LITEDOC_LIGATURE_REPAIR_ENABLED", True)

    # ⓪ 實體 born-digital PDF：H1 標題＋連字損毀正文＋跨頁頁首 URL＋400×300 內容圖
    pdf = tmp_path / "story.pdf"
    doc = _fitz.open()
    for i in range(2):
        page = doc.new_page()
        page.insert_text(_fitz.Point(72, 30),
                         "https://site.example/story - printed", fontsize=8)
        if i == 0:
            page.insert_text(_fitz.Point(72, 120), "Company Report", fontsize=24)
            page.insert_text(_fitz.Point(72, 180),
                             "the ;rst quarter Pro1les showed growth.", fontsize=11)
            pix = _fitz.Pixmap(_fitz.csRGB, _fitz.IRect(0, 0, 400, 300))
            pix.clear_with(180)
            page.insert_image(_fitz.Rect(72, 220, 472, 520), pixmap=pix)
            page.insert_text(_fitz.Point(72, 560), "More body after image.",
                             fontsize=11)
        else:
            page.insert_text(_fitz.Point(72, 120), "Second Heading", fontsize=24)
            page.insert_text(_fitz.Point(72, 180), "Closing body paragraph.",
                             fontsize=11)
    doc.save(str(pdf))
    doc.close()

    # ① 真 FitzProcessor 直抽（key-changing：PDF → 同形 md）
    out = tmp_path / "out"
    md_path = _fp.FitzProcessor().parse(str(pdf), str(out))
    # ② 真 cleaner → 修復（行數不變式：修復前後行數全等）
    _RealCleaner().clean(md_path)
    before = md_path.read_text(encoding="utf-8")
    from pipelines.ligature_repair import repair_ligatures as _repair
    after = _repair(before)
    assert after.count("\n") == before.count("\n")  # 行數不變式
    md_path.write_text(after, encoding="utf-8")

    # ③ 判型 sidecar 以「修復前行號」建（行數不變 ⇒ 修復後行界仍同基準）
    title_idx = before.split("\n").index("# Company Report")
    (md_path.parent / f"{md_path.stem}_doc_structure.json").write_text(
        _json.dumps({"structure": [
            {"start": title_idx, "end": title_idx, "type": "title"},
        ]}), encoding="utf-8")

    # ④ 真 _build_tiles（真 ingestion_engine + image_filter + TilingProcessor bypass）
    tiles = LiteDocPipeline()._build_tiles(md_path, out, md_path.stem, "news")
    texts, figs = [], []
    _walk_tiles(tiles, texts, figs)
    body = "\n".join(texts)

    assert "first quarter Profiles" in body          # 連字已修（跨 producer 消費）
    assert ";rst" not in body and "Pro1les" not in body
    assert "site.example" not in body                # 跨頁頁首 URL 已剪
    assert "Company Report" not in body              # 行界對齊：title 行判型分離未移位
    assert "More body after image." in body and "Closing body paragraph." in body
    srcs = {f["src"] for f in figs}
    assert any(s.startswith("images/page_") for s in srcs)  # 400×300=120k 穿透 image_filter KEEP


