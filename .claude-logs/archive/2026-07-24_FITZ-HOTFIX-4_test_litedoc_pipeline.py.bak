# LANG-DETECT C1：cover-prompt language 欄 + _resolve_source_lang 合成 + §7.2 整合
# ──────────────────────────────────────────────────────────────────────────
def test_lang_prompt_contract_has_language_field():
    """prompt 契約：Fields 含 language ISO 欄、Rule 5 主體語言判定、keys 清單含 language。"""
    p = lp._LITEDOC_META_SYSTEM_PROMPT
    assert "language (str: ISO 639-1" in p
    assert "main body language" in p
    assert "keys title, authors, date, publisher, url, language" in p


@pytest.mark.parametrize("heuristic", ["zh", "hans", "ja", "ko"])
@pytest.mark.parametrize("llm_lang", ["it", "en", "zh", "Italian", "", None])
def test_lang_resolve_non_catchall_keeps_heuristic(heuristic, llm_lang):
    """合成矩陣①：啟發式非 en（字元證據確定）→ LLM 任意值不得翻案。"""
    meta = {} if llm_lang is None else {"language": llm_lang}
    assert LiteDocPipeline._resolve_source_lang(meta, heuristic) == heuristic


@pytest.mark.parametrize("llm_lang,expected", [
    ("it", "it"), ("de", "de"), ("fr", "fr"),      # 拉丁語系正名（破口修復）
    ("ita", "ita"), ("deu", "deu"),                # ISO 639-2 三字碼合法
    ("IT", "it"), (" fr ", "fr"),                  # strip+lower 正規化
    ("zh", "en"), ("zh-tw", "en"), ("zho", "en"),  # 拒 zh 前綴（HOTFIX-1 鎖一）
    ("Chinese", "en"), ("italian", "en"),          # 非 ISO token 退 en
    ("en-US", "en"), ("a", "en"), ("", "en"),      # 格式白名單退 en
    (None, "en"), (123, "en"),                     # 缺欄/非字串退 en
])
def test_lang_resolve_catchall_whitelist_matrix(llm_lang, expected):
    """合成矩陣②：啟發式 en → 雙重白名單（^[a-z]{2,3}$ 且拒 zh 前綴）。"""
    meta = {} if llm_lang is None else {"language": llm_lang}
    assert LiteDocPipeline._resolve_source_lang(meta, "en") == expected


