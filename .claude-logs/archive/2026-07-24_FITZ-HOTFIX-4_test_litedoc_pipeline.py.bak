# ──────────────────────────────────────────────────────────────────────────
# C6：P4 Async RAG（rag_indexer ≥10 + 雙語標題）
# ──────────────────────────────────────────────────────────────────────────
from pipelines.contracts import RagDbSpec, BilingualMarkdownSpec as _Bil


def _p4_ctx():
    ctx = PipelineContext(doc_type="news", paper_id="p4", pdf_path="/x/in.pdf", owner_id=1)
    ctx.ingestion = _Ing(title="Orig Title", source_lang="en",
                         tiles=[{"title": "Sec1", "content": [], "children": []}])
    ctx.glossary_ready = _GR(abstract="a", lcc="general", glossary={}, translated_abstract="t",
                             section_summaries={"Sec1": "摘要"}, domain_name="News")
    ctx.bilingual = _Bil(final_zh_path="/z", final_en_path="/e", translated_abstract="t",
                         rag_tree_json=None)
    ctx.rag_sections = [{"title": "譯：Sec1", "level": 2, "summary_key": "Sec1",
                         "content": [{"type": "text", "content": "body"}], "children": []}]
    ctx.raw_metadata = {"translated_title": {"value": "ZH::Orig Title"}}
    return ctx


def _patch_rag_indexer(monkeypatch, captured):
    from processor import rag_indexer

    def _fake_index(rag_sections, section_summaries, doc_type, vectors_dir, **kw):
        captured["doc_type"] = doc_type
        captured["title"] = kw.get("title")
        captured["translated_title"] = kw.get("translated_title")
        captured["section_summaries"] = section_summaries
        return RagDbSpec(vectors_path=str(vectors_dir), paper_chunk_count=3,
                         index_meta={"chunks_total": 3})

    monkeypatch.setattr(rag_indexer, "index", _fake_index)


def test_p4_calls_rag_indexer_with_litedoc(monkeypatch):
    """P4 呼 rag_indexer.index 傳 doc_type='litedoc'（門檻走 else 預設 ≥10）+ 雙語標題。"""
    cap = {}
    _patch_rag_indexer(monkeypatch, cap)
    spec = LiteDocPipeline().run_phase4(_p4_ctx())
    assert isinstance(spec, RagDbSpec)
    assert cap["doc_type"] == "litedoc"
    assert cap["title"] == "Orig Title"
    assert cap["translated_title"] == "ZH::Orig Title"     # 讀 P3 旁路、非捷徑同取
    assert cap["section_summaries"] == {"Sec1": "摘要"}      # 消費 P2 section_summaries


def test_p4_threshold_is_default_10_rag_indexer_untouched():
    """litedoc 不在 rag_indexer ≥3 tuple、走預設 ≥10；且 rag_indexer.py 未被本路修改。"""
    from processor import rag_indexer
    import inspect
    src = inspect.getsource(rag_indexer.is_chunk_meaningful)
    assert 'doc_type in ("resume", "slides")' in src        # ≥3 僅 resume/slides
    assert "litedoc" not in src                              # litedoc 未入 ≥3 tuple（引擎零改）


def test_p4_failure_raises_not_blocks(monkeypatch):
    """P4 異常拋出（交 Orchestrator 標 rag_status='failed'、不靜默吞）。"""
    from processor import rag_indexer

    def _boom(*a, **k):
        raise RuntimeError("embedding down")

    monkeypatch.setattr(rag_indexer, "index", _boom)
    with pytest.raises(RuntimeError):
        LiteDocPipeline().run_phase4(_p4_ctx())


# === [PIPE-LITEDOC C7 START] §7.2 P2→P3→P4 key-changing 接縫整合測試（雙鎖） ===
def test_seam_p2_p3_p4_key_changing_integration(monkeypatch, tmp_path):
    """§7.2 接縫不變式（雙鎖·堵 RAG-ASYNC-HOTFIX-1）：

    真翻譯改變標題文字（key-changing），但 P2 section_summaries 之 key 與 P3 rag_sections 之
    summary_key 譯後仍**同基準＝原文標題 path**（譯文 title 僅供顯示）；P4 以同一份 section_summaries
    消費、下游可 match。純 mock 同 key 兩端不足以照出退化，此處 _KeyChangeTr 真把「Intro」→「ZH::Intro」。
    """
    monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path / "out")
    monkeypatch.setattr(settings, "LLM_USE_GLOSSARY_ALIGN", False)
    monkeypatch.setattr(settings, "LLM_MAX_CONCURRENT", 4)
    monkeypatch.setattr(lp, "normalize_to_lcc", lambda raw, context_text=None: "general")
    monkeypatch.setattr(LiteDocPipeline, "_resolve_domain_name", lambda self, lcc: "News")
    monkeypatch.setattr(LiteDocPipeline, "_read_source_text", lambda self, ctx: "x" * 16000)  # 強制 P3 section mode

    class _KeyChangeTr:
        def __init__(self, *a, **k):
            pass
        def translate(self, text, ctx, mode, text_type="content"):
            return f"ZH::{text}"

    monkeypatch.setattr(lp, "Translator", _KeyChangeTr)
    import llm.client
    monkeypatch.setattr(llm.client.LLMClient, "get_instance", classmethod(lambda cls: _FakeP2LLM()))

    tiles = [
        {"title": "Intro", "content": [{"type": "text", "content": "intro body"}], "children": []},
        {"title": "Body", "content": [{"type": "text", "content": "main body"}], "children": []},
    ]
    ctx = PipelineContext(doc_type="news", paper_id="seam", pdf_path="/x/in.pdf", owner_id=1)
    ctx.ingestion = _Ing(title="Headline", source_lang="en", tiles=tiles)
    ctx.raw_metadata = {}

    pipe = LiteDocPipeline()

    # P2 → section_summaries（key=原文標題 path）
    gspec = pipe.run_phase2(ctx)
    ctx.glossary_ready = gspec
    p2_keys = set(gspec.section_summaries.keys())

    # P3 → rag_sections（summary_key=原文標題 path、譯後 title 另存）
    bspec = pipe.run_phase3(ctx)
    ctx.bilingual = bspec
    p3_summary_keys = {s["summary_key"] for s in ctx.rag_sections}
    p3_titles = {s["title"] for s in ctx.rag_sections}

    # 接縫不變式：P2 key == P3 summary_key == 原文標題 path（跨譯零位移）
    assert p2_keys == {"Intro", "Body"}
    assert p3_summary_keys == p2_keys
    # key-changing 真實發生（譯後 title 變、key 不變）→ 非自洽同 key 假象
    assert p3_titles == {"ZH::Intro", "ZH::Body"}

    # P4 → 消費同一份 section_summaries、下游可 match（堵 RAG-ASYNC-HOTFIX-1 靜默退化）
    cap = {}
    _patch_rag_indexer(monkeypatch, cap)
    pipe.run_phase4(ctx)
    assert cap["doc_type"] == "litedoc"
    assert cap["section_summaries"] == gspec.section_summaries        # 同一份、key 對齊
    for s in ctx.rag_sections:
        assert s["summary_key"] in cap["section_summaries"]           # 下游 match 成功
# === [PIPE-LITEDOC C7 END] ===


