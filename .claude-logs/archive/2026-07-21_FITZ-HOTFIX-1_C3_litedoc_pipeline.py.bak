    "嚴格逐行輸出，每行格式為「[編號] 繁體中文摘要」，編號與輸入對應，不要任何額外說明或前後綴。"
)
# === [PIPE-LITEDOC C4 END] ===


@PipelineFactory.register("litedoc")
@PipelineFactory.register("news")
@PipelineFactory.register("web")
class LiteDocPipeline(DocumentStrategy):
    """第 3 路策略：news / web / unknown（fallback）。

    `rag_char_threshold=10`：litedoc 為長篇散文型、非 Vision 短文（slides/resume ≥3），
    走一般文檔門檻 ≥10（對齊 master plan v10 L183、rag_indexer `is_chunk_meaningful` 預設）。
    """

    rag_char_threshold: int = 10

    _STUB_MSG = (
        "LiteDocPipeline C2 骨架階段——四 Phase 具體實作屬 PIPE-LITEDOC C3-C6"
        "（P1 MinerU 攝入 / P2 六步 / P3 size-gate 翻譯 / P4 Async RAG）"
    )

    # === [PIPE-LITEDOC C3 START] P1 MinerU 攝入與 metadata 旁路 ===
    def run_phase1(self, ctx: PipelineContext) -> IngestionMetadataSpec:
        """P1 Ingestion：MinerU 文字攝入 + 原文元數據 + 物理分組 Tiles（合約①）。

        全鏈（plan U2/U3、消費既有 processor、零改）：
          ① pdf2md：PDFProcessor（MinerU）→ ② 強制 md_cleaner 清洗
          ③ analyze：DocAnalyzer（**U2.1 doc_type 映射**：news/web 原樣、其餘→'web' 扁平 prompt、
             防 doc_analyzer fallback academic 深層論文結構分析）
          ④⑤⑥ md2json → json_process → tiling → 物理分組 Tiles
          ⑦ B 軌原生文字 LLM 抽 metadata（含 URL→publisher 解碼）→ venue 承接 publisher、
             date/url/organization 走 ctx.raw_metadata 旁路（meta_normalizer 正規化欄名）。
        交付 IngestionMetadataSpec（🚫 零 Abstract/LCC/Glossary、零翻譯）。
        """
        if not ctx.pdf_path:
            raise ValueError("PIPE-LITEDOC P1：ctx.pdf_path 缺失，無法定位輸入 PDF")
        pdf_path = Path(ctx.pdf_path)
        if not pdf_path.exists():
            raise FileNotFoundError(f"PIPE-LITEDOC P1：PDF 不存在 {pdf_path}")

        output_dir = paper_manager.paper_dir(settings.OUTPUT_DIR, ctx.owner_id, ctx.paper_id)
        output_dir.mkdir(parents=True, exist_ok=True)
        paper_name = pdf_path.stem

        # ① pdf2md：文字層閘門（PIPE-INGEST-FITZ C3）——born-digital 走 fitz 本地直抽、
        #    未達標/失敗 fail-open 退既有 MinerU 路；flag off 時行為與現行等價。
        md_path = self._ingest_markdown(ctx, pdf_path, output_dir)
        # ② 強制 md_cleaner（非 resume/slides 跳過；浮水印/純數字行清理）
        MarkdownCleaner().clean(md_path)
        # ②' 連字壞字修復（清洗後、③判型前——行內替換行數不變、行索引同基準）
        if settings.LITEDOC_LIGATURE_REPAIR_ENABLED:
            md_path.write_text(
                ligature_repair.repair_ligatures(
                    md_path.read_text(encoding="utf-8")
                ),
                encoding="utf-8",
            )
        # === [FITZ-HOTFIX-1 C2 START] R7 數字為主短行清理（同清洗步、兩來源同享）===
        md_path.write_text(
            _clean_short_number_lines(md_path.read_text(encoding="utf-8")),
            encoding="utf-8",
        )
        # === [FITZ-HOTFIX-1 C2 END] ===
        markdown_text = md_path.read_text(encoding="utf-8")

        # ③ analyze：DocAnalyzer + U2.1 映射（soft-fail）
        analyzer_doc_type = ctx.doc_type if ctx.doc_type in ("news", "web") else "web"
        try:
            DocAnalyzer().analyze(md_path, analyzer_doc_type)
            markdown_text = md_path.read_text(encoding="utf-8")
        except Exception as exc:  # noqa: BLE001 — analyze 失敗不阻斷 P1
            logger.warning(
                "[PIPE-LITEDOC P1] %s analyze 失敗（soft、doc_type=%s）: %s",
                ctx.paper_id, analyzer_doc_type, exc, exc_info=True,
            )

        # === [FITZ-HOTFIX-1 C2 START] R6 時序前移：metadata 抽取移至 tiles 組裝之前 ===
        # ⑦→前移 metadata：B 軌原生文字抽取（方案 A）。`_extract_litedoc_metadata`
        # 僅唯讀吃 `markdown_text`（簽名單參數、零 tiles 依賴）→ 調序安全無副作用；
        # 目的＝把已抽出之 meta **值**注入 `_build_tiles`→`assemble` 作確定性兜底（R6）。
        meta = self._extract_litedoc_metadata(markdown_text)

        # ④⑤⑥ md2json → json_process → tiling（產物理分組 Tiles；帶 R6 meta 值集合）
        tiles = self._build_tiles(
            md_path, output_dir, paper_name, ctx.doc_type,
            meta_values=self._collect_meta_values(meta),
        )
        # === [FITZ-HOTFIX-1 C2 END] ===

        title = self._resolve_title(meta, markdown_text, paper_name)
        # === [PIPE-LITEDOC-HOTFIX-1 START] 二元繁中偵測（取內文樣本不取封面；簡體不給 zh* 契約）===
        # 鎖二：偵測器放 section_engine 共用；鎖三：取 tiles 內文樣本（跳封面）；鎖一：非繁回非 zh* token。
        _lang_sample = section_engine.sample_body_text(tiles) or markdown_text[:2000]
        source_lang = section_engine.classify_source_lang(_lang_sample)
        # === [PIPE-LITEDOC-HOTFIX-1 END] ===
        # === [LANG-DETECT C1] catch-all 限定合成：僅啟發式 'en' 時採信白名單過濾後的
        # cover-prompt language 欄（it/de/fr 拉丁語系正名）；CJK/繁中判定權威不讓渡。===
        source_lang = self._resolve_source_lang(meta, source_lang)
        publisher = str(meta.get("publisher") or "").strip()

        if ctx.paper_id.endswith("_shadow"):
            title = f"{title} (測試)"

        # 旁路：合約無欄之 date/url/organization 走 ctx.raw_metadata（meta_normalizer 正規化欄名、
        # 旗標 LLM_USE_META_NORM；publisher 另由 venue 承接、不重複入旁路）。INFRA-4 後收合。
        raw_fields = {
            k: str(meta.get(k) or "").strip()
            for k in ("date", "url", "organization")
            if str(meta.get(k) or "").strip()
        }
        normalized = meta_normalizer.normalize_fields(raw_fields, context=title) if raw_fields else {}
        ctx.raw_metadata = {
            key: {"value": val, "source": "litedoc_p1", "confidence": "medium"}
            for key, val in normalized.items()
        }
        if publisher:
            ctx.raw_metadata["publisher"] = {
                "value": publisher, "source": "litedoc_p1", "confidence": "medium",
            }

        spec = IngestionMetadataSpec(
            title=title,
            authors=[str(a) for a in (meta.get("authors") or []) if str(a).strip()],
            venue=publisher or None,   # venue 承接 publisher（現成合約欄）
            doi=None,
            source_lang=source_lang,
            tiles=tiles,
        )
        logger.info(
            "[PIPE-LITEDOC P1] %s title=%r source_lang=%s tiles=%d publisher=%r authors=%d",
            ctx.paper_id, title, source_lang, len(tiles), publisher, len(spec.authors),
        )
        return spec

    # ── P1 私有輔助 ──
    # === [PIPE-INGEST-FITZ C3 START] 文字層閘門（born-digital 快速道）===
    def _ingest_markdown(self, ctx, pdf_path: Path, output_dir: Path) -> Path:
        """P1 ① pdf2md 閘門：中位數頁字元數 ≥ 門檻走 fitz 直抽、否則既有 MinerU 路。

        fail-open 鐵律：閘門判定或 fitz 直抽任何異常 → warning（exc_info）退 MinerU、
        絕不讓新 impl 阻斷攝入；flag off → 直走 MinerU、行為與現行 byte 等價。
        """
        if settings.LITEDOC_FITZ_ENABLED:
            try:
                median = fitz_processor.median_page_chars(str(pdf_path))
                if median >= settings.LITEDOC_FITZ_MIN_CHARS_PER_PAGE:
                    md_path = Path(
                        fitz_processor.FitzProcessor().parse(
                            str(pdf_path), str(output_dir)
                        )
                    )
                    logger.info(
                        "[PIPE-INGEST-FITZ P1] %s 閘門判定 born-digital"
                        "（median=%.0f ≥ %d）→ fitz 直抽",
                        ctx.paper_id, median,
                        settings.LITEDOC_FITZ_MIN_CHARS_PER_PAGE,
                    )
                    return md_path
                logger.info(
                    "[PIPE-INGEST-FITZ P1] %s 閘門判定文字層不足"
                    "（median=%.0f < %d）→ 退 MinerU",
                    ctx.paper_id, median,
                    settings.LITEDOC_FITZ_MIN_CHARS_PER_PAGE,
                )
            except Exception as exc:  # noqa: BLE001 — fail-open 退 MinerU
                logger.warning(
                    "[PIPE-INGEST-FITZ P1] %s fitz 快速道失敗（fail-open 退 MinerU）: %s",
                    ctx.paper_id, exc, exc_info=True,
                )
        return Path(PDFProcessor().parse(str(pdf_path), str(output_dir)))
    # === [PIPE-INGEST-FITZ C3 END] ===

    # === [PIPE-INGEST C2 START] P1 攝入組裝切換 ingestion_engine ===
    # litedoc 之 meta 判型集（route-specific 注入、引擎零字面量；對齊 doc_structure 判型 schema）
    _META_TYPES = ("title", "authors", "publication_info")

    def _build_tiles(
        self, md_path: Path, output_dir: Path, paper_name: str, doc_type: str,
        meta_values: Optional[Set[str]] = None,
    ) -> List[Dict[str, Any]]:
        """ingestion_engine 組裝 → TextTiling（PIPE-INGEST C2、litedoc 不 opt-out）。

        cleaned md + doc_structure 判型 → `ingestion_engine.assemble`（title 不丟 / meta 行
        分離不受連續性限制 / figure 帶 `content=![alt](src)`）→ 寫 processed 相容 JSON →
        `TilingProcessor` 零改續用（index/part 由 tiling 自補）。A 軌 md2json／行級分塊
        借用鏈於 litedoc 退場；`_structured.json` 不再產出。
        doc_structure 讀取失敗 → structure=None soft（引擎退化為無 meta 分離、不阻斷）。
        `meta_values`（[FITZ-HOTFIX-1 C2 R6]、預設 None 行為等價）：P1 已抽出之 meta
        值集合，貫穿至 `assemble` 作整行比對之確定性兜底（判型失準時仍能剝除 meta 重播）。
        """
        markdown_text = md_path.read_text(encoding="utf-8")
        structure: Optional[Dict[str, Any]] = None
        sidecar = md_path.parent / f"{md_path.stem}_doc_structure.json"
        try:
            structure = json.loads(sidecar.read_text(encoding="utf-8"))
        except Exception as exc:  # noqa: BLE001 — sidecar 缺失/壞損不阻斷 P1
            logger.warning(
                "[PIPE-INGEST P1] %s doc_structure 讀取失敗（soft、無 meta 分離）: %s",
                paper_name, exc, exc_info=True,
            )
        # === [IMG-FILTER C3] 報頭預掃 + 三規則過濾注入（ENABLED=false 時 filter=None 零過濾）===
        header_srcs = self._collect_header_srcs(markdown_text, structure)
        fig_filter = image_filter.make_figure_filter(
            md_path.parent / "images", header_srcs
        )
        result = ingestion_engine.assemble(
            markdown_text, structure, meta_types=self._META_TYPES,
            figure_filter=fig_filter,
            meta_values=meta_values,   # [FITZ-HOTFIX-1 C2 R6] 確定性兜底
        )
        processed = output_dir / f"{paper_name}_processed.json"
        processed.write_text(
            json.dumps(
                {"title": result["title"], "sections": result["sections"]},
                ensure_ascii=False, indent=2,
            ),
            encoding="utf-8",
        )
        tiled = output_dir / f"{paper_name}_tiled.json"
        TilingProcessor().process(str(processed), str(tiled), doc_type=doc_type)
        return self._load_tiles(tiled)
    # === [PIPE-INGEST C2 END] ===

    # === [IMG-FILTER C3 START] 報頭區圖片預掃（規則③之 producer）===
    @staticmethod
    def _collect_header_srcs(
        markdown_text: str, structure: Optional[Dict[str, Any]]
    ) -> set:
        """掃「報頭行界」內之 `![](src)` 行、收集 src 集合（IMG-FILTER plan v2 §2.3）。

        報頭行界＝doc_structure 判型 blocks 之 `max(end)`（**收窄界定**、非整個孤兒容器
        ——首 heading 前可能有正文 hero 圖、plan §2.6）；src 以與 engine `_FIGURE_RE`
        同語意之 regex 自 markdown 原文行抽出、**零轉換**（§4 接縫契約）。
        structure 缺失／格式異常 → 回 ∅（規則③自然停用、①②照跑、soft）。
        """
        try:
            blocks = structure.get("structure") if isinstance(structure, dict) else None
            if not isinstance(blocks, list) or not blocks:
                return set()
            hdr_end = max(int(b["end"]) for b in blocks)
        except Exception as exc:  # noqa: BLE001 — 判型異常 soft、規則③停用
            logger.warning(
                "[img-filter] 報頭行界解析失敗（規則③停用、①②照跑）: %s",
                exc, exc_info=True,
            )
            return set()
        srcs: set = set()
        for line in markdown_text.split("\n")[: hdr_end + 1]:
            m = re.match(r"^!\[.*?\]\((.*?)\)", line.strip())
            if m and m.group(1):
                srcs.add(m.group(1))
        return srcs
    # === [IMG-FILTER C3 END] ===

    @staticmethod
    def _load_tiles(tiled_path: Path) -> List[Dict[str, Any]]:
        """讀 tiled JSON；dict→取 sections list、list→直接用；失敗回 []（soft）。"""
        try:
            data = json.loads(Path(tiled_path).read_text(encoding="utf-8"))
        except Exception as exc:  # noqa: BLE001
            logger.warning("[PIPE-LITEDOC P1] 讀取 tiled JSON 失敗（tiles=[]）: %s", exc, exc_info=True)
            return []
        if isinstance(data, dict):
            sections = data.get("sections")
            return sections if isinstance(sections, list) else [data]
        return data if isinstance(data, list) else []

    def _extract_litedoc_metadata(self, markdown_text: str) -> Dict[str, Any]:
        """B 軌原生文字 cover-prompt（方案 A）抽 title/authors/date/publisher/url + URL→組織解碼。

        soft-fail → 空 dict（不阻斷 P1）。temp=0 求確定性轉錄。
        """
        from llm.client import LLMClient  # 惰性 import 避免模組載入期重量級依賴

        head = (markdown_text or "")[:_META_INPUT_CHARS]
        if not head.strip():
            return {}
        messages = [
            {"role": "system", "content": _LITEDOC_META_SYSTEM_PROMPT},
            {"role": "user", "content": head},
        ]
        try:
            out = LLMClient.get_instance().chat(
                messages=messages, temperature=0.0, stream=False, model=settings.LLM_DOMAIN_MODEL,
            )
            data = json.loads(_strip_json_fence(out))
            return data if isinstance(data, dict) else {}
        except Exception as exc:  # noqa: BLE001 — 非致命：空 metadata、不阻斷
            logger.warning("[PIPE-LITEDOC P1] metadata 抽取失敗（soft、空）: %s", exc, exc_info=True)
            return {}

    # === [LANG-DETECT C1 START] source_lang 合成（catch-all 限定、雙重白名單）===
    # === [FITZ-HOTFIX-1 C2 START] R6 meta 值集合（供 assemble 確定性兜底）===
    @staticmethod
    def _collect_meta_values(meta: Dict[str, Any]) -> Set[str]:
        """由 cover-prompt 已抽出之 meta 組值集合（authors 逐項 + date + publisher）。

        比對正規化與變體展開分工：**大小寫/分隔符差異**由 `ingestion_engine`
        之 `_normalize_meta_text`（casefold + 僅留 alphanumeric）吸收；本函式只負責
        **語意變體**——① authors list 逐項 + 全項合併（`A and B` 型整行）；
        ② date 展開常見列印變體（`2026-06-15` → `Jun 15` / `June 15` / `06/15/2026`…），
        因扉頁重播多為人類可讀格式、與 ISO 原值字面不同。
        取不到值/型別異常 → 略過該欄（不阻斷、集合可為空 → 兜底自然停用）。
        """
        values: Set[str] = set()

        authors = meta.get("authors")
        if isinstance(authors, list):
            names = [str(a).strip() for a in authors if str(a or "").strip()]
            values.update(names)
            if len(names) > 1:                      # 整行合併型（`A AND B`）
                values.add(" and ".join(names))
                values.add(", ".join(names))
        elif isinstance(authors, str) and authors.strip():
            values.add(authors.strip())

        for key in ("publisher", "date"):
            val = str(meta.get(key) or "").strip()
            if val:
                values.add(val)

        values.update(_date_variants(str(meta.get("date") or "").strip()))
        return {v for v in values if v}
    # === [FITZ-HOTFIX-1 C2 END] ===

    @staticmethod
    def _resolve_source_lang(meta: Dict[str, Any], heuristic: str) -> str:
        """合成 source_lang：僅啟發式 catch-all 'en' 時嘗試採信 LLM language 欄。

        - 啟發式 zh/hans/ja/ko（字元證據確定）→ 維持原判、LLM 不得翻案（繁中 bypass 權威不動搖）。
        - 白名單雙閘：格式 `^[a-z]{2,3}$`（ISO 639-1/2、strip+lower 後）且**拒 zh 前綴**
          （HOTFIX-1 鎖一契約於 producer 端強制——非繁嚴禁 zh* token、防 LLM 值繞過翻譯 gate）。
        - 缺欄／怪值 → 退 'en'（與現行行為 100% 等價）。
        """
        if heuristic != "en":
            return heuristic
        lang = str(meta.get("language") or "").strip().lower()
        if re.match(r"^[a-z]{2,3}$", lang) and not lang.startswith("zh"):
            return lang
        return "en"
    # === [LANG-DETECT C1 END] ===

    def _resolve_title(
        self, meta: Dict[str, Any], markdown_text: str, paper_name: str
    ) -> str:
        """title = metadata.title → markdown 首個 # 行 → paper_name。"""
        t = str(meta.get("title") or "").strip()
        if t:
            return t
        for line in markdown_text.splitlines():
            s = line.strip()
            if s.startswith("#"):
                return s.lstrip("#").strip() or paper_name
        return paper_name

    # === [PIPE-INGEST C3] 原 source_lang 啟發式 dead code 已移除
    #（PIPE-LITEDOC-HOTFIX-1 起由 section_engine.classify_source_lang 接替、全庫零 caller）===
    # === [PIPE-LITEDOC C3 END] ===

    # === [PIPE-LITEDOC C4 START] P2 六步（消費 section_engine + 三真理源）===
    def run_phase2(self, ctx: PipelineContext) -> GlossaryReadySpec:
        """P2 Glossary & Context Prep：摘要 / LCC / Glossary 自癒 / 摘要翻譯 / 節點摘要（合約②）。

        六步（plan U4、消費三大共用真理源 + section_engine）：
          ① 全文摘要（原文 abstract）② normalize_to_lcc（context=全文、內容判定）
          ③ Glossary 級聯自癒（旗標 LLM_USE_GLOSSARY_ALIGN 閘門）④ Translator(DEEP_THINK) 翻 abstract
          → translated_abstract（雙用：交付 + glossary 抽詞樣本）⑤ lcc→Domains.name → domain_name
          ⑥ section_engine.build_section_summaries → section_summaries（key=原文標題 path）

        交易邊界（database SOP）：所有 LLM 呼叫皆在 DB 交易外；domain_name 為 Domains PK 唯讀檢索。
        """
        from llm.client import LLMClient  # 惰性 import

        source_lang = (ctx.ingestion.source_lang if ctx.ingestion else None) or "en"
        full_text = self._read_source_text(ctx)

        # ① 全文摘要（原文）
        abstract = self._make_summary(full_text) or full_text[:_ABSTRACT_FALLBACK_CHARS]
        # ② LCC（litedoc 無 P1 domain 欄、raw_domain="" → normalize_to_lcc 以全文內容判定）
        lcc = normalize_to_lcc("", context_text=full_text) or "general"

        # ④ 翻摘要（DEEP_THINK）→ translated_abstract（雙用：交付 + ③ glossary 抽詞樣本）
        translator = Translator()
        summary_ctx = InjectionContext(lcc=lcc, glossary={}, doc_type=ctx.doc_type or "litedoc")
        translated_abstract = translator.translate(
            abstract, summary_ctx, TranslateMode.DEEP_THINK, "abstract"
        )

        # ③ Glossary 事前定案術語表（旗標閘門；GLOSSARY-TERMMAP C2：census→分流→定案、
        #    廢早退飛輪滾動；LLM 全在 DB 交易外、upsert 冪等）
        glossary: Dict[str, str] = {}
        if settings.LLM_USE_GLOSSARY_ALIGN:
            glossary = self._heal_glossary(
                full_text, source_lang, _TARGET_LANG, lcc, abstract, translated_abstract
            )

        # ⑤ lcc → Domains.name（PK 唯讀免交易）
        domain_name = self._resolve_domain_name(lcc)

        # ⑥ 節點摘要（消費共用 section_engine、key=原文標題 path、三安全鎖、LLM 交易外）
        section_summaries = section_engine.build_section_summaries(
            (ctx.ingestion.tiles if ctx.ingestion else []) or [],
            llm=LLMClient.get_instance(),
            abstract=abstract,
            source_lang=source_lang,
            summary_model=settings.LLM_DOMAIN_MODEL,
            translate_model=settings.TRANSLATE_MODEL,
            summary_system_prompt=_SECTION_SUMMARY_SYSTEM_PROMPT,
            translate_system_prompt=_SECTION_SUMMARY_TRANSLATE_SYSTEM_PROMPT,
            input_chars_cap=_SECTION_SUMMARY_INPUT_CHARS,
            max_chars=_ABSTRACT_MAX_CHARS,
            paper_id=ctx.paper_id,
        )

        spec = GlossaryReadySpec(
            abstract=abstract,
            lcc=lcc,
            glossary=glossary,
            translated_abstract=translated_abstract,
            section_summaries=section_summaries or None,
            domain_name=domain_name,
        )
        logger.info(
            "[PIPE-LITEDOC P2] %s lcc=%r glossary=%d domain_name=%r abstract=%dchars "
            "translated=%dchars section_summaries=%d",
            ctx.paper_id, lcc, len(glossary), domain_name,
            len(abstract), len(translated_abstract or ""), len(section_summaries or {}),
        )
        return spec

    # ── P2 私有輔助 ──
    def _read_source_text(self, ctx: PipelineContext) -> str:
        """讀 P1 產出原文 markdown；失敗 fallback 由 tiles 重組。"""
        output_dir = paper_manager.paper_dir(settings.OUTPUT_DIR, ctx.owner_id, ctx.paper_id)
        md_path = output_dir / f"{Path(ctx.pdf_path).stem}.md"
        try:
            return md_path.read_text(encoding="utf-8")
        except Exception as exc:  # noqa: BLE001
            logger.warning(
                "[PIPE-LITEDOC P2] 讀原文 md 失敗，改由 tiles 重組: %s", exc, exc_info=True
            )
            return self._tiles_to_text(ctx.ingestion.tiles if ctx.ingestion else [])

    @staticmethod
    def _tiles_to_text(tiles: List[Dict[str, Any]]) -> str:
        """由 Tiles 重組純文字（fallback）。"""
        parts: List[str] = []
        for sec in tiles or []:
            if isinstance(sec, dict):
                for item in sec.get("content", []) or []:
                    if isinstance(item, dict) and item.get("type") == "text":
                        parts.append(str(item.get("content", "")))
        return "\n".join(parts)

    def _make_summary(self, full_text: str) -> str:
        """全文摘要（原文語言、LLM、交易外；失敗回空 → 兜底原文截斷）。"""
        from llm.client import LLMClient

        messages = [
            {"role": "system", "content": _LITEDOC_SUMMARY_SYSTEM_PROMPT},
            {"role": "user", "content": full_text[:_ABSTRACT_MAX_CHARS]},
        ]
        try:
            out = LLMClient.get_instance().chat(
                messages=messages, temperature=0.2, stream=False, model=settings.LLM_DOMAIN_MODEL,
            )
            return (out or "").strip()
        except Exception as exc:  # noqa: BLE001 — 摘要失敗不阻斷
            logger.warning("[PIPE-LITEDOC P2] 全文摘要失敗（兜底截斷）: %s", exc, exc_info=True)
            return ""

    # === [GLOSSARY-TERMMAP C2 START] P2 術語自癒收斂共用 build_termmap ===
    def _heal_glossary(
        self, full_text: str, source_lang: str, target_lang: str, lcc: str,
        abstract: str, translated_abstract: str,
    ) -> Dict[str, str]:
        """事前定案術語表（plan v2 §2.2）：全文 census → 分流（已知 ∪ 未知、廢早退）→
        僅未知批次翻譯 → 定案 upsert。委派共用 `GlossaryManager.build_termmap`（五路單一實作源）。
        """
        return GlossaryManager().build_termmap(
            full_text, abstract, translated_abstract,
            source_lang, target_lang, lcc,
        )
    # === [GLOSSARY-TERMMAP C2 END] ===

    def _resolve_domain_name(self, lcc: str) -> Optional[str]:
        """lcc → Domains.name（PK 唯讀檢索、無寫交易；database SOP）。"""
        if not lcc:
            return None
        try:
            from db import SessionLocal
            from models import Domains

            with SessionLocal() as session:  # 唯讀
                row = session.get(Domains, lcc)
                return row.name if row else None
        except Exception as exc:  # noqa: BLE001
            logger.warning(
                "[PIPE-LITEDOC P2] Domains.name 解析失敗（domain_name=None）: %s", exc, exc_info=True
            )
            return None
    # === [PIPE-LITEDOC C4 END] ===

    # === [PIPE-LITEDOC C5 START] P3 size-gate 翻譯與 HTML 扉頁還原（含雙語標題鏈）===
    def run_phase3(self, ctx: PipelineContext) -> BilingualMarkdownSpec:
        """P3 Translation & Restore：size-gate 翻譯 + HTML 扉頁還原（合約③、plan U5/U5b/U5c）。

        流程：
          ① InjectionContext（lcc/glossary/zh_summary/domain_name/doc_type）。
          ② size-gate：is_zh→不重譯;否則 `len(full_text)<門檻 或 無 section 或 heading 退化`→
             `translate_whole`（一鍵）;否則 `restore_sections_markdown`（逐 section 並行）。
          ③ translated_title 唯一源＝P1 title（PIPE-INGEST C3、slot 撈題廢除）：
             is_zh→title 原樣；分段/一鍵→皆 translate_unit(title) 同式。
          ④ rag 旁路：collect_rag_sections（分段/zh）或 single_container_sections（一鍵/兜底）→ ctx.rag_sections。
          ⑤ HTML 扉頁：`# 標題` + `render_meta_header_html` prepend final_zh（譯題）/ final_en（原題）。
          ⑥ translated_title 經 ctx.raw_metadata 旁路傳 P4（既有旁路、不動凍結合約）。
        交付 BilingualMarkdownSpec（rag_tree_json=None、P4 才建）。
        """
        if ctx.glossary_ready is None:
            raise ValueError("PIPE-LITEDOC P3：ctx.glossary_ready 缺失（P2 未交付）")
        gspec = ctx.glossary_ready
        source_lang = (ctx.ingestion.source_lang if ctx.ingestion else None) or "en"
        is_zh = source_lang.startswith("zh")
        sections = (ctx.ingestion.tiles if ctx.ingestion else []) or []
        full_text = self._read_source_text(ctx)
        title = (ctx.ingestion.title if ctx.ingestion else "") or ""
        # === [PIPE-LITEDOC-HOTFIX-1 START] ① pre-strip：原文層剝標題回聲（en 全模式 + zh whole/is_zh，exact）===
        _title_bare = title.replace(" (測試)", "").strip()
        full_text = section_engine.strip_title_echo(full_text, _title_bare)
        # === [PIPE-LITEDOC-HOTFIX-1 END] ===

        inj = InjectionContext(
            lcc=gspec.lcc,
            glossary=gspec.glossary,
            zh_summary=gspec.translated_abstract,
            domain_name=gspec.domain_name,
            doc_type=ctx.doc_type or "litedoc",   # news/web → 對應 STYLE_HINTS
        )
        tr = Translator()
        threshold = getattr(settings, "LITEDOC_WHOLE_TRANSLATE_THRESHOLD", 15000)

        rag_sections: List[Dict[str, Any]] = []
        if is_zh:
            # zh edge：原文即繁中、不重譯（同 RAG-ASYNC-HOTFIX-3 範式）
            mode = "zh"
            zh_text = full_text
            if sections:
                slots = section_engine.collect_render_slots(sections, 0)
                section_engine.collect_rag_sections(slots, {}, False, rag_sections)
            else:
                rag_sections = section_engine.single_container_sections(full_text, title or "全文")
            translated_title = title
        else:
            degraded = bool(sections) and section_engine.is_heading_degraded(sections)
            whole_mode = (len(full_text) < threshold) or (not sections) or degraded
            if whole_mode:
                mode = "whole"
                if degraded:
                    logger.warning(
                        "[PIPE-LITEDOC P3] %s heading 退化 → 整檔翻譯 fallback（sections=%d）",
                        ctx.paper_id, len(sections),
                    )
                zh_text = section_engine.translate_whole(full_text, inj, tr, True)
                rag_sections = section_engine.single_container_sections(zh_text, title or "全文")
                # U5c ③：一鍵/退化 → 對 title 額外單元翻一次（成本極低）
                translated_title = section_engine.translate_unit(title, inj, tr, "title") if title else title
            else:
                mode = "section"
                # === [GLOSSARY-TERMMAP C4] 摘要型滑窗：per-section 注入前一鄰近摘要（容缺）===
                zh_text, slots, zh_by_index = section_engine.restore_sections_markdown(
                    sections, inj, tr, True, max_workers=settings.LLM_MAX_CONCURRENT,
                    slot_context_fn=self._make_slot_context_fn(
                        inj, gspec.section_summaries or {}
                    ),
                )
                section_engine.collect_rag_sections(slots, zh_by_index, True, rag_sections)
                # === [PIPE-INGEST C3] U5c ② slot 撈題廢除：譯題唯一源＝P1 title（與 whole 分支同式；
                # 根治標題錯置三受害者——zh 扉頁 # 標題 / HTML <title> / PDF /Title）===
                translated_title = section_engine.translate_unit(title, inj, tr, "title") if title else title

        en_text = full_text
        ctx.rag_sections = rag_sections

        # === [PIPE-LITEDOC-HOTFIX-1 START] ② post-strip：補 section 模式（zh_text 由 tiles 重建、譯後標題 exact）===
        # rag_sections 已於上行定案（早於本剝與扉頁 prepend）→ RAG 不受影響。
        # en_text 已由 ① pre-strip 處理（=full_text）；此處僅補 zh_text。
        zh_text = section_engine.strip_title_echo(
            zh_text, (translated_title or "").replace(" (測試)", "").strip()
        )
        # === [PIPE-LITEDOC-HOTFIX-1 END] ===

        # ⑥ translated_title handoff → P4（既有 raw_metadata 旁路、PIPE-SLIDES-HOTFIX-1b 三欄 dict 範式）
        ctx.raw_metadata["translated_title"] = {
            "value": translated_title or title, "source": "litedoc_p3", "confidence": "high",
        }

        # ⑤ HTML 扉頁（# 標題：zh 用譯題 / en 用原題；render_meta_header_html 純格式化器）
        header_zh, header_en = self._render_meta_headers(ctx, title, translated_title)
        zh_text = header_zh + zh_text
        en_text = header_en + en_text

        zh_path = paper_manager.article_zh_path(settings.OUTPUT_DIR, ctx.owner_id, ctx.paper_id)
        en_path = paper_manager.article_en_path(settings.OUTPUT_DIR, ctx.owner_id, ctx.paper_id)
        zh_path.parent.mkdir(parents=True, exist_ok=True)
        zh_path.write_text(zh_text, encoding="utf-8")
        en_path.write_text(en_text, encoding="utf-8")

        spec = BilingualMarkdownSpec(
            final_zh_path=str(zh_path),
            final_en_path=str(en_path),
            translated_abstract=gspec.translated_abstract,
            rag_tree_json=None,
        )
        logger.info(
            "[PIPE-LITEDOC P3] %s mode=%s source_lang=%s sections=%d zh=%dchars en=%dchars "
            "translated_title=%r",
            ctx.paper_id, mode, source_lang, len(sections), len(zh_text), len(en_text),
            translated_title,
        )
        return spec

    # ── P3 私有輔助 ──
    # === [GLOSSARY-TERMMAP C4 START] 摘要型滑窗上下文工廠（parallel-safe、容缺）===
    @staticmethod
    def _make_slot_context_fn(
        inj: InjectionContext, section_summaries: Dict[str, str]
    ) -> Optional[Any]:
        """P3 摘要型滑窗（plan v2 §2.7）：依 slot 所屬 section（原文標題 path、與 P2/P4 同基準）
        注入**前一鄰近 section** 之繁中摘要。

        - **parallel-safe**：摘要 P2 已算、factory 純讀零跨執行緒狀態；InjectionContext frozen
          → `model_copy(update=...)` 產新實例、共用 inj 不受污染。
        - **注入路徑**：translator `_build_user_prompt` 以 `zh_summary` 優先於 `preceding`
          （既有順序）——故鄰近摘要**合併入 zh_summary**（全文摘要＋鄰近段摘要＝BOOK 三層
          滑窗語意）確保實際浮出、`preceding` 同步攜帶原始鄰近摘要（語意欄位）。
        - **容缺**：無 summaries → 回 None（引擎走預設共用 inj、行為零變）；slot 之 key 無前鄰
          或前鄰摘要缺 → 沿用共用 inj。
        - **嚴禁譯文型 preceding**（跨 section 逼序列、破壞並行收益）——本 factory 僅用 P2 摘要。
        """
        if not section_summaries:
            return None
        keys = list(section_summaries.keys())
        prev_of = {k: keys[i - 1] for i, k in enumerate(keys) if i > 0}

        def _slot_context(index: int, slot: Dict[str, Any]) -> InjectionContext:
            prev_key = prev_of.get(slot.get("key") or "")
            prev_sum = section_summaries.get(prev_key) if prev_key else None
            if not prev_sum:
                return inj
            combined = ((inj.zh_summary or "") + f"\n\n鄰近前段摘要參考：{prev_sum}").strip()
            return inj.model_copy(
                update={"preceding": prev_sum, "zh_summary": combined}
            )

        return _slot_context
    # === [GLOSSARY-TERMMAP C4 END] ===

    # === [PIPE-INGEST C3] 原 U5c ② slot 撈題方法已廢除（譯題唯一源＝P1 title、雙源歸一）===
    def _render_meta_headers(
        self, ctx: PipelineContext, title: str, translated_title: str
    ) -> tuple:
        """組 zh/en HTML 扉頁：`# 標題`（zh 譯題 / en 原題）+ render_meta_header_html（純格式化器）。

        欄位抽取留呼叫端（Zero Schema Coupling）：authors/venue（publisher）取自 ingestion、
        date 取自 ctx.raw_metadata 旁路。
        """
        authors = list(ctx.ingestion.authors) if ctx.ingestion else []
        venue = (ctx.ingestion.venue if ctx.ingestion else None) or ""
        raw = ctx.raw_metadata or {}
        date_v = raw.get("date")
        date = (date_v.get("value") if isinstance(date_v, dict) else date_v) or ""

        zh = (f"# {translated_title}\n\n" if translated_title else "") + \
            section_engine.render_meta_header_html(authors=authors, venue=venue, date=date, is_zh=True)
        en = (f"# {title}\n\n" if title else "") + \
            section_engine.render_meta_header_html(authors=authors, venue=venue, date=date, is_zh=False)
        return zh, en
    # === [PIPE-LITEDOC C5 END] ===

    # === [PIPE-LITEDOC C6 START] P4 Async RAG（消費共用 rag_indexer ≥10 + 雙語標題）===
    def run_phase4(self, ctx: PipelineContext) -> RagDbSpec:
        """P4 Async RAG：向量化落庫（合約④、非阻塞、plan U6）。

        流程（消費 B 軌共用 rag_indexer、零依賴 A 軌、零改引擎）：
          ① 輸入＝P3 旁路 `ctx.rag_sections` + P2 `ctx.glossary_ready.section_summaries`。
          ② `rag_indexer.index(rag_sections, section_summaries, 'litedoc', vectors_dir, paper_db_id,
             rag_tree_path, title, translated_title)`——**門檻走 is_chunk_meaningful 預設 ≥10**
             （litedoc 不在 resume/slides ≥3 tuple、rag_indexer 零改）；四產物。
          ③ 雙語標題：title=ctx.ingestion.title、translated_title 讀 P3 旁路 raw_metadata["translated_title"]。
          ④ 交付 RagDbSpec。

        錯誤隔離（plan U6 / database SOP）：異常 logger.warning(exc_info=True) 後**拋出**，
        交 Orchestrator 標 rag_status='failed'、**絕不阻塞 reading_ready**；Embedding 於 DB 交易外、
        paper_db_id None → rag_indexer 內部優雅降級。
        """
        if ctx.bilingual is None:
            raise ValueError("PIPE-LITEDOC P4：ctx.bilingual 缺失（P3 未交付）")
        from processor import rag_indexer  # 惰性 import（B 軌自有、零 rag_processor）

        rag_sections = ctx.rag_sections or []
        section_summaries = (
            ctx.glossary_ready.section_summaries if ctx.glossary_ready else None
        ) or {}
        vectors_dir = paper_manager.vectors_path(settings.OUTPUT_DIR, ctx.owner_id, ctx.paper_id)
        rag_tree_path = paper_manager.rag_tree_path(settings.OUTPUT_DIR, ctx.owner_id, ctx.paper_id)

        # 雙語標題（U5c/U6）：title=原文標題、translated_title 讀 P3 旁路（非 resume 捷徑同取）
        title = (ctx.ingestion.title if ctx.ingestion else None) or ctx.paper_id
        _tt = (ctx.raw_metadata or {}).get("translated_title")
        translated_title = (_tt.get("value") if isinstance(_tt, dict) else _tt) or title

        paper_db_id = paper_manager.get_paper_db_id(ctx.owner_id, ctx.paper_id)
        if paper_db_id is None:
            logger.warning(
                "[PIPE-LITEDOC P4] %s paper_db_id 未取得（DB 寫入降級、僅 FAISS + index_meta）",
                ctx.paper_id,
            )

        try:
            spec = rag_indexer.index(
                rag_sections, section_summaries, "litedoc", vectors_dir,
                paper_db_id=paper_db_id,
                rag_tree_path=str(rag_tree_path),
                title=title, translated_title=translated_title,
            )
            logger.info(
                "[PIPE-LITEDOC P4] %s RAG 完成 chunks=%d paper_chunks=%d vectors=%s "
                "title=%r translated_title=%r",
                ctx.paper_id, int(spec.index_meta.get("chunks_total", 0)),
                spec.paper_chunk_count, vectors_dir.name, title, translated_title,
            )
            return spec
        except Exception as exc:  # noqa: BLE001 — 拋出由 Orchestrator 標 rag_status='failed'
            logger.warning(
                "[PIPE-LITEDOC P4] %s RAG 向量化失敗（不阻主鏈、Orchestrator 將標 "
                "rag_status='failed'）: %s",
                ctx.paper_id, exc, exc_info=True,
            )
            raise
    # === [PIPE-LITEDOC C6 END] ===
# === [PIPE-LITEDOC C2 END] ===
