)


# === [FITZ-HOTFIX-1 C2 START] R7 數字為主短行清理（兩來源同享、保守版）===
# markdown 語法行首：一律跳過（防誤殺 `- 1` 列表項／`# 1` 標題／`![alt](src)` 圖行／
# `| 1 |` 表格列／`> 1` 引用／`* 1` 列表）
_MD_SYNTAX_PREFIXES = ("#", "!", ">", "-", "*", "|")
# 數字 token 精確匹配：整數／千分位／小數；含字母者（`v1.2`／`M1`）自動不計為數字
_NUMERIC_TOKEN_RE = re.compile(r"^\d+([.,]\d+)*$")
# 短行 token 數上限（超過即視為正文句、不碰）
_SHORT_LINE_MAX_TOKENS = 3


def _is_number_dominated(line: str) -> bool:
    """R7 判定：≤3 token 且數字 token **過半** → 計數/統計類雜訊行。

    設計依據（plan §3.7 block 分組運氣）：源 PDF 之 `53`/`82`/`Share` 同 block →
    直抽併為一行 `53 82 Share`（帶詞、逃過既有純數字行規則）；`561` 獨立 block →
    獨行純數字（既有規則可殺）。本判定對 block 分組**不敏感**、兩形態同收。
    誠實邊界：`561 Likes` 型（1/2 不過半）會逃——保守版先行、寧漏勿誤殺。
    """
    stripped = line.strip()
    if not stripped or stripped.startswith(_MD_SYNTAX_PREFIXES):
        return False
    tokens = stripped.split()
    if not tokens or len(tokens) > _SHORT_LINE_MAX_TOKENS:
        return False
    numeric = sum(1 for tok in tokens if _NUMERIC_TOKEN_RE.match(tok))
    return numeric * 2 > len(tokens)


_MONTHS_ABBR = ("Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
_MONTHS_FULL = ("January", "February", "March", "April", "May", "June",
                "July", "August", "September", "October", "November", "December")


def _date_variants(iso_date: str) -> Set[str]:
    """R6 輔助：ISO 日期 → 常見列印變體集合（扉頁重播多為人類可讀格式）。

    `2026-06-15` → `Jun 15` / `June 15` / `Jun 15, 2026` / `June 15, 2026` /
    `06/15/2026` / `2026/06/15`。非 ISO 格式或解析失敗 → 空集合（不阻斷）。
    """
    m = re.match(r"^(\d{4})-(\d{2})-(\d{2})$", (iso_date or "").strip())
    if not m:
        return set()
    year, month, day = int(m.group(1)), int(m.group(2)), int(m.group(3))
    if not (1 <= month <= 12):
        return set()
    abbr, full = _MONTHS_ABBR[month - 1], _MONTHS_FULL[month - 1]
    return {
        f"{abbr} {day}", f"{full} {day}",
        f"{abbr} {day}, {year}", f"{full} {day}, {year}",
        f"{month:02d}/{day:02d}/{year}", f"{year}/{month:02d}/{day:02d}",
    }


def _clean_short_number_lines(text: str) -> str:
    """剝除數字為主之短行（**行數不變式**：命中行改為空行、不刪行）。

    行數不變 → 下游 doc_structure 判型行索引與 `assemble`／`_collect_header_srcs`
    行界維持同基準（與連字修復同一哲學）。
    """
    lines = text.split("\n")
    for i, line in enumerate(lines):
        if _is_number_dominated(line):
            logger.debug("[PIPE-LITEDOC P1] R7 剝除數字短行: %.40s", line.strip())
            lines[i] = ""
    return "\n".join(lines)
# === [FITZ-HOTFIX-1 C2 END] ===


def _strip_json_fence(text: str) -> str:
    """剝除 LLM 輸出的 ```json ... ``` 圍欄（容錯、不耦合 A 軌）。"""
    s = (text or "").strip()
    s = re.sub(r"^```(?:json)?\s*", "", s)
    s = re.sub(r"\s*```$", "", s)
    return s.strip()
# === [PIPE-LITEDOC C3 END] ===

# === [PIPE-LITEDOC C4 START] P2 常數 ===
_TARGET_LANG = "zh-tw"           # 系統固定目標語（繁中；GlobalGlossary 聯合鍵）
_ABSTRACT_MAX_CHARS = 8000       # 摘要輸入截斷（防 token 爆）
_ABSTRACT_FALLBACK_CHARS = 600   # 摘要 LLM 失敗的原文截斷兜底
_SECTION_SUMMARY_INPUT_CHARS = 1500

_LITEDOC_SUMMARY_SYSTEM_PROMPT = (
    "你是專業文件摘要器。請將以下新聞／網頁文章濃縮為一段精簡摘要，"
    "保留原文語言、涵蓋主旨與重點；只輸出摘要本文，不要任何前言或標題。"
)
# 節點摘要 prompt 通用（非文體專屬、與 resume 同款語意、litedoc 自有副本不跨 import）。
_SECTION_SUMMARY_SYSTEM_PROMPT = (
    "你是文件分析助手。下面是一份文件的多個區塊，每個區塊以「[編號] 標題」開頭、其後為內文。"
    "請為每個區塊產生一句精簡的「原文語言」摘要（捕捉該區塊核心、約 30-60 字）。"
    "嚴格逐行輸出，每行格式為「[編號] 摘要」，編號與輸入對應，不要任何額外說明或前後綴。"
