"""PIPE-RESUME ResumePipeline 策略管線（plan_v1、PIPE 縱向五路絞殺第 1 路）。

Resume（履歷）文體的四 Phase 策略插件，繼承 PIPE-CORE `DocumentStrategy`，以
`@PipelineFactory.register('resume')` 註冊；主幹（Orchestrator）零 doc_type 分支、
僅以 `PipelineFactory.get_strategy('resume')` 取得本策略。

四 Phase 對映落地 ABC 抽象方法：
- run_phase1 → IngestionMetadataSpec（P1 Vision 整份解析 + 原文元數據 + 物理分組 Tiles）
- run_phase2 → GlossaryReadySpec（P2 LCC 分類 / 摘要 / Glossary 自癒 / 摘要翻譯）
- run_phase3 → BilingualMarkdownSpec（P3 100% Bypass 翻譯與還原）
- run_phase4 → RagDbSpec（P4 非同步 RAG、門檻 ≥3 技能詞保護）

交付歷程：
- C1（策略骨架與工廠註冊）：註冊插件 + 四方法 stub。
- C2（P1 Ingestion）：實作 run_phase1——全鏈編排 ResumeProcessor（Vision md）+ Metadata
  Stage A + doc_analyzer 雙保險 + md2json/json_process/tiling（產 Tiles），交付
  IngestionMetadataSpec（零 Abstract/LCC/Glossary）。
- C3/C4/C5：P2/P3/P4 實作。

> custom_metadata 硬前置（tasks §9）：P1 履歷專屬欄 phone/email/domain 於凍結合約
> `IngestionMetadataSpec`（extra="forbid"）尚未具備落點前，暫存於本策略實例
> 整包原始 metadata 走 `ctx.raw_metadata`（v9 C2/C3、PIPE-SPEC §1.1.1）穿線給 P2/寫庫；
> 取代早期 `self._raw_meta` 實例暫存（已於 C3 廢除）與 custom_metadata-in-Spec defer。
> phone/email 既有 metadata_extractor 無對應欄，C2 以 markdown regex 自足抽取（不動既有檔）。
"""

# === [PIPE-RESUME C1 START] ===
from __future__ import annotations

import logging
from typing import Any, Dict

from pipelines.base_strategy import DocumentStrategy
from pipelines.context import PipelineContext
from pipelines.contracts import (
    BilingualMarkdownSpec,
    GlossaryReadySpec,
    IngestionMetadataSpec,
    RagDbSpec,
)
from pipelines.factory import PipelineFactory

# === [PIPE-RESUME C2 START] P1 全鏈編排所需既有模組（複用、零改動）===
import json
import re
from pathlib import Path
from typing import List, Optional, Tuple

import paper_manager
import settings
from processor.doc_analyzer import DocAnalyzer
from processor.json_processor import JsonProcessor
from processor.md_processor import MarkdownProcessor
from processor.metadata_extractor import (
    create_empty_metadata,
    extract_metadata_from_first_page_llm,
    extract_pdf_metadata,
    fill_from_llm_page1,
    fill_from_pdf_metadata,
    merge_stage_a,
)
from processor.resume_processor import ResumeProcessor
from processor.tiling_processor import TilingProcessor
# === [PIPE-RESUME C2 END] ===

# === [PIPE-RESUME C3 START] P2 共用真理源（消費既有落地簽名、零改動）===
from processor.domain_normalizer import normalize_to_lcc
from processor.glossary_extractor import GlossaryManager
from processor.translator import InjectionContext, TranslateMode, Translator
# === [PIPE-RESUME C3 END] ===

# === [RAG-ASYNC C6 START] 砍 A 軌耦合：P4 改呼 B 軌自有 processor.rag_indexer（惰性 import 於 run_phase4）===
# （原 PIPE-RESUME C5 `from processor.rag_processor import RagProcessor` 已移除；B 軌全鏈零依賴 A 軌）
# === [RAG-ASYNC C6 END] ===
# === [RESUME-PERF-1 C2 START] 逐 section 翻譯受限並行（受既有 LLMClient._api_semaphore 限流）===
from concurrent.futures import ThreadPoolExecutor
from settings import LLM_MAX_CONCURRENT
# === [RESUME-PERF-1 C2 END] ===

logger = logging.getLogger(__name__)

# C2-C5 各 Phase 實作前的統一佔位訊息（明示尚未落地之 Phase）。
_NOT_IMPLEMENTED_MSG = (
    "ResumePipeline.{phase} 尚未實作（PIPE-RESUME {commit}）；"
    "本 Commit 僅交付既有 Phase。"
)

# === [PIPE-RESUME C2 START] P1 欄位抽取常數 ===
# Email / 電話 regex（自 Vision markdown 抽取；既有 metadata_extractor 無 phone/email 欄）。
_EMAIL_RE = re.compile(r"[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}")
_PHONE_RE = re.compile(r"\+?\d[\d\-\s()]{6,}\d")
# source_lang 啟發式門檻（CJK 顯著佔比 → 原文判為中文）。
_CJK_MIN = 20
_CJK_RATIO = 0.2
# === [PIPE-RESUME C2 END] ===

# === [PIPE-RESUME C3 START] P2 常數 ===
_TARGET_LANG = "zh-tw"          # 系統固定目標語（繁體中文；GlobalGlossary 聯合鍵）
_ABSTRACT_MAX_CHARS = 8000      # 摘要輸入截斷（防 token 爆）
_ABSTRACT_FALLBACK_CHARS = 600  # 摘要 LLM 失敗時的原文截斷兜底
# === [RAG-ASYNC C5 START] 統一 P2 六步 section_summaries 常數 ===
_SECTION_SUMMARY_INPUT_CHARS = 1500   # 每節點送摘要的內文截斷（控批次 token）
_SECTION_SUMMARY_SYSTEM_PROMPT = (
    "你是文件分析助手。下面是一份文件的多個區塊，每個區塊以「[編號] 標題」開頭、其後為內文。"
    "請為每個區塊產生一句精簡的「原文語言」摘要（捕捉該區塊核心、約 30-60 字）。"
    "嚴格逐行輸出，每行格式為「[編號] 摘要」，編號與輸入對應，不要任何額外說明或前後綴。"
)
_SECTION_SUMMARY_TRANSLATE_SYSTEM_PROMPT = (
    "你是專業翻譯。將下列各區塊摘要翻譯為流暢的繁體中文，專有名詞與術語沿用慣例、風格與所給全文摘要一致。"
    "嚴格逐行輸出，每行格式為「[編號] 繁體中文摘要」，編號與輸入對應，不要任何額外說明或前後綴。"
)
# === [RAG-ASYNC C5 END] ===
_SUMMARY_SYSTEM_PROMPT = (
    "你是專業履歷摘要器。請將以下履歷濃縮為一段精簡摘要，"
    "保留原文語言、涵蓋姓名／專業領域／核心技能與資歷重點；"
    "只輸出摘要本文，不要任何前言或標題。"
)
# === [PIPE-RESUME C3 END] ===

# === [PIPE-RESUME v9 C4 START] P3 履歷業務翻譯約束 ===
# 履歷專屬翻譯規則：由 run_phase3 經 InjectionContext.constraints 逐路注入共用 Translator
# （`_build_system_prompt` ⑤ 貼為「【額外譯文約束】」、PIPE-SPEC §1.2.3.1 翻譯策略隔離原則）。
# 規則由策略擁有、引擎共用執行；不為各路 fork prompt 或污染 Translator 核心。
_RESUME_CONSTRAINTS = [
    # === [PIPE-RESUME SHADOW-HOTFIX-2 START] ===
    # 移除「公司名稱保留原文」：公司/機構交回母提示詞 L5 統一「翻譯 (原文)」，
    # 消除與母提示詞反向覆寫的矛盾；本約束只留履歷專屬、母提示詞未涵蓋的產品名。
    "產品名稱保留原文（如 iPhone／OLED 等）",
    # === [PIPE-RESUME SHADOW-HOTFIX-2 END] ===
    "Email／電話／URL 原樣保留",
    "專業技能詞（Python/Docker 等）保留英文",
    "專有名詞（如專利、期刊等名稱）保留原文並在中譯中附加對照",
]
# === [PIPE-RESUME v9 C4 END] ===


@PipelineFactory.register("resume")
class ResumePipeline(DocumentStrategy):
    """Resume 文體四 Phase 策略（C1 骨架 + C2 P1；P2-P4 待 C3-C5）。"""

    # SPEC §3.1：Vision 短文檔（resume/slides）RAG 入庫字數門檻放寬至 3（保 Python/Docker 等技能詞）。
    rag_char_threshold: int = 3

    # === [PIPE-RESUME v9 C3 START] ===
    # （v9 C3 廢除 self._raw_meta 實例暫存——改以 C2 導入的 ctx.raw_metadata 為唯一穿線載體；
    #   無實例狀態、移除 __init__。）
    # === [PIPE-RESUME v9 C3 END] ===

    # === [PIPE-RESUME C2 START] P1 Ingestion 全鏈編排 ===
    def run_phase1(self, ctx: PipelineContext) -> IngestionMetadataSpec:
        """P1 Ingestion：Vision 整份解析 + 原文元數據 + 物理分組 Tiles（合約①）。

        全鏈編排（忠實 PIPE-SPEC §1.1①，複用既有 processor、零改動）：
          ① Metadata Stage A（fitz + LLM 第一頁、soft-fail）→ 原文 Title/candidate_name/domain
          ② pdf2md：ResumeProcessor Vision 整份解析（resume 跳過 md_cleaner）
          ③ analyze：doc_analyzer 雙保險 heading fix（baron Q6）
          ④ md2json → ⑤ json_process → ⑥ tiling → 物理分組 Tiles
        交付 IngestionMetadataSpec（🚫 零 Abstract/LCC/Glossary、零翻譯）。
        整包原始 metadata（含 phone/email/domain）寫 ctx.raw_metadata（v9 C2、供 P2/寫庫）。
        """
        if not ctx.pdf_path:
            raise ValueError("PIPE-RESUME P1：ctx.pdf_path 缺失，無法定位輸入 PDF")
        pdf_path = Path(ctx.pdf_path)
        if not pdf_path.exists():
            raise FileNotFoundError(f"PIPE-RESUME P1：PDF 不存在 {pdf_path}")

        # per-paper 輸出目錄：output/{owner_id}/{paper_id}/（shadow 靠 _shadow 後綴物理隔離）
        output_dir = paper_manager.paper_dir(settings.OUTPUT_DIR, ctx.owner_id, ctx.paper_id)
        output_dir.mkdir(parents=True, exist_ok=True)
        paper_name = pdf_path.stem

        # ① Metadata Stage A（soft-fail、不阻斷）
        meta = self._extract_metadata(pdf_path)

        # ② pdf2md：ResumeProcessor Vision 忠實轉錄（複用、resume 不跑 md_cleaner）
        md_path = Path(ResumeProcessor().parse(str(pdf_path), str(output_dir)))
        markdown_text = md_path.read_text(encoding="utf-8")

        # ③ analyze：doc_analyzer 雙保險（resume heading fix；soft-fail）
        try:
            DocAnalyzer().analyze(md_path, "resume")
            markdown_text = md_path.read_text(encoding="utf-8")
        except Exception as exc:  # noqa: BLE001 — 雙保險失敗不阻斷 P1
            logger.warning(
                "[PIPE-RESUME P1] %s analyze 雙保險失敗（soft）: %s",
                ctx.paper_id, exc, exc_info=True,
            )

        # ④⑤⑥ md2json → json_process → tiling（產物理分組 Tiles）
        tiles = self._build_tiles(md_path, output_dir, paper_name)

        # ⑦ 解析交付欄位
        title = self._resolve_title(meta, markdown_text, paper_name)
        source_lang = self._detect_source_lang(markdown_text)
        phone, email = self._extract_contact(markdown_text)
        domain = self._meta_value(meta, "domain") or ""
        # === [PIPE-RESUME v9 C3 START] ===
        # （v9 C3：移除 self._raw_meta 過渡雙寫——P2 改讀 ctx.raw_metadata、不再需實例暫存。）
        # === [PIPE-RESUME v9 C3 END] ===

        # === [PIPE-RESUME v9 C2 START] ===
        # 影子標題後綴：_shadow 時 title 加綴 (測試)，使前端列表（顯示 DB title）肉眼可辨。
        # title 不入內容翻譯（P2 用 source_lang / P3 讀 .md full_text），僅影響 DB 顯示與 Early Emit、
        # 不污染影子內容與 Golden Diff。Flip 時隨 web_server 影子開關與本包裹一併移除（母 plan v11 Cleanup）。
        if ctx.paper_id.endswith("_shadow"):
            title = f"{title} (測試)"

        # raw_metadata 旁路穿線（PIPE-SPEC §1.1.1）：整包原始 metadata（含 confidence/source）
        # + regex 抽出的 phone/email，供影子/正式寫庫端組 Paper.metadata_json、對齊 A 軌保真。
        ctx.raw_metadata = dict(meta)
        ctx.raw_metadata["phone"] = {"value": phone, "source": "regex", "confidence": "high"}
        ctx.raw_metadata["email"] = {"value": email, "source": "regex", "confidence": "high"}
        # === [PIPE-RESUME v9 C2 END] ===

        spec = IngestionMetadataSpec(
            title=title,
            authors=[],
            venue=None,
            doi=None,
            source_lang=source_lang,
            tiles=tiles,
        )
        logger.info(
            "[PIPE-RESUME P1] %s title=%r source_lang=%s tiles=%d domain=%r "
            "(phone=%s email=%s)",
            ctx.paper_id, title, source_lang, len(tiles), domain,
            bool(phone), bool(email),
        )
        return spec

    # ── P1 私有輔助（全鏈編排各步驟）──

    def _extract_metadata(self, pdf_path: Path) -> Dict[str, Any]:
        """Metadata Stage A：fitz + LLM 第一頁雙來源合併（soft-fail → 空 metadata）。"""
        try:
            pdf_meta = extract_pdf_metadata(pdf_path)
            llm_meta = extract_metadata_from_first_page_llm(pdf_path, doc_type="resume")
            a = fill_from_pdf_metadata(create_empty_metadata(), pdf_meta)
            b = fill_from_llm_page1(create_empty_metadata(), llm_meta)
            return merge_stage_a(a, b)
        except Exception as exc:  # noqa: BLE001 — Stage A 全程 soft-fail
            logger.warning(
                "[PIPE-RESUME P1] Metadata Stage A 失敗（soft，空 metadata）: %s",
                exc, exc_info=True,
            )
            return create_empty_metadata()

    def _build_tiles(
        self, md_path: Path, output_dir: Path, paper_name: str
    ) -> List[Dict[str, Any]]:
        """md2json → json_process → (履歷 opt-out TextTiling)，回 heading section Tiles。

        履歷 opt-out（RESUME-P3 C1、plan v3 Q3）：履歷只需 heading section（`###` 分組），
        不需學術式語意切塊；P1 不跑 TextTiling embedding（保全 ### 結構、源頭滅 429）。
        """
        structured = output_dir / f"{paper_name}_structured.json"
        MarkdownProcessor().process(str(md_path), str(structured))
        processed = output_dir / f"{paper_name}_processed.json"
        JsonProcessor().process(str(structured), str(processed))
        tiled = output_dir / f"{paper_name}_tiled.json"
        # === [RESUME-P3 C1 START] ===
        # 履歷 opt-out TextTiling（plan v3 Q3）：直接以 JsonProcessor 的 processed JSON 作為
        # tiled（保全 ###/title/content/children heading 結構），**不呼叫 TilingProcessor 向量計算**。
        # → P1 不跑 TextTiling embedding：源頭消滅履歷 429 配額隱患（TILING-HOTFIX-1 根源），
        #   且 tiles 即乾淨 heading section、供 P3（C3）逐 section 翻譯。
        #   （通用化動態 tiling 開關歸 INFRA-3；TilingProcessor 演算法本體不動。）
        tiled.write_text(processed.read_text(encoding="utf-8"), encoding="utf-8")
        # === [RESUME-P3 C1 END] ===
        return self._load_tiles(tiled)

    @staticmethod
    def _load_tiles(tiled_path: Path) -> List[Dict[str, Any]]:
        """讀 tiled JSON；dict→取 sections list、list→直接用；失敗回 []（soft）。"""
        try:
            data = json.loads(Path(tiled_path).read_text(encoding="utf-8"))
        except Exception as exc:  # noqa: BLE001
            logger.warning(
                "[PIPE-RESUME P1] 讀取 tiled JSON 失敗（tiles=[]）: %s",
                exc, exc_info=True,
            )
            return []
        if isinstance(data, dict):
            sections = data.get("sections")
            return sections if isinstance(sections, list) else [data]
        return data if isinstance(data, list) else []

    @staticmethod
    def _meta_value(meta: Dict[str, Any], field: str) -> Optional[Any]:
        """安全取 metadata 欄位 value（三軸融合結構 {field: {value, source, confidence}}）。"""
        v = meta.get(field)
        return v.get("value") if isinstance(v, dict) else v

    def _resolve_title(
        self, meta: Dict[str, Any], markdown_text: str, paper_name: str
    ) -> str:
        """title = candidate_name（最可信）→ markdown 首個 # 行 → title 欄 → paper_name。"""
        cand = self._meta_value(meta, "candidate_name")
        if cand and str(cand).strip():
            return str(cand).strip()
        for line in markdown_text.splitlines():
            s = line.strip()
            if s.startswith("#"):
                return s.lstrip("#").strip() or paper_name
        t = self._meta_value(meta, "title")
        return str(t).strip() if t and str(t).strip() else paper_name

    @staticmethod
    def _detect_source_lang(markdown_text: str) -> str:
        """source_lang 啟發式：CJK 顯著佔比 → 'zh'，否則 'en'（無落地偵測器、保留原語言）。"""
        cjk = sum(1 for ch in markdown_text if "一" <= ch <= "鿿")
        letters = sum(1 for ch in markdown_text if ch.isascii() and ch.isalpha())
        if cjk >= _CJK_MIN and cjk >= letters * _CJK_RATIO:
            return "zh"
        return "en"

    def _extract_contact(self, markdown_text: str) -> Tuple[str, str]:
        """自 markdown regex 抽 phone/email（既有 metadata_extractor 無此二欄）。"""
        email_match = _EMAIL_RE.search(markdown_text)
        phone_match = _PHONE_RE.search(markdown_text)
        email = email_match.group(0) if email_match else ""
        phone = phone_match.group(0).strip() if phone_match else ""
        return phone, email
    # === [PIPE-RESUME C2 END] ===

    # === [PIPE-RESUME C3 START] P2 Glossary & Context Prep（四步循序自癒）===
    def run_phase2(self, ctx: PipelineContext) -> GlossaryReadySpec:
        """P2 Glossary & Context Prep：LCC / 摘要 / Glossary 自癒 / 摘要翻譯（合約②）。

        四步循序（plan §2 U3、消費三大共用真理源）：
          ① normalize_to_lcc(raw_domain=P1 domain, context_text=履歷全文) → 標準 LCC
          ② 做整份履歷摘要（原文 abstract）
          ③ Glossary 自癒（旗標 LLM_USE_GLOSSARY_ALIGN 閘門；query_cascade→缺詞 extract_terms→upsert）
          ④ Translator(DEEP_THINK) 翻 abstract → translated_abstract；lcc→Domains.name → domain_name

        交易邊界（database SOP）：所有 LLM 呼叫（normalize/summary/translate/extract_terms）皆在
        DB 交易外；domain_name 為 Domains 表 PK 唯讀檢索（無 session.begin() 寫交易）。

        實作必然序（extract_terms 簽名所迫，保留 baron 意圖）：extract_terms 需 (source, translated)
        雙語樣本，P2 唯一可用譯文為 translated_abstract，故 DEEP_THINK 翻摘要先於 ③ glossary 抽詞、
        且**一次翻譯雙用**（交付 translated_abstract + 作 glossary 抽詞樣本），不重複翻譯。
        """
        if not ctx.pdf_path:
            raise ValueError("PIPE-RESUME P2：ctx.pdf_path 缺失，無法定位原文")
        source_lang = (ctx.ingestion.source_lang if ctx.ingestion else None) or "en"
        full_text = self._read_source_text(ctx)
        # === [PIPE-RESUME v9 C3 START] ===
        # raw_domain 改讀 ctx.raw_metadata（C2 穿線載體；廢 self._raw_meta 死路）
        raw_domain = (self._meta_value(ctx.raw_metadata, "domain") or "") if ctx.raw_metadata else ""

        # ① 做整份履歷摘要（原文）——v10 摘要先行（跨路統一；與 LCC 互不依賴、功能等價）
        abstract = self._make_summary(full_text) or full_text[:_ABSTRACT_FALLBACK_CHARS]

        # ② LCC 分類（旗標 False 時回 raw_domain、不查 DB 不呼 LLM）
        lcc = normalize_to_lcc(raw_domain, context_text=full_text) or "general"
        # === [PIPE-RESUME v9 C3 END] ===

        # 翻摘要（DEEP_THINK）→ translated_abstract（雙用：交付 + ③ glossary 抽詞樣本）
        translator = Translator()
        summary_ctx = InjectionContext(lcc=lcc, glossary={}, doc_type="resume")
        translated_abstract = translator.translate(
            abstract, summary_ctx, TranslateMode.DEEP_THINK, "abstract"
        )

        # ③ Glossary 自癒（旗標閘門；LLM 在 DB 交易外、回寫冪等）
        glossary: Dict[str, str] = {}
        if settings.LLM_USE_GLOSSARY_ALIGN:
            glossary = self._heal_glossary(
                source_lang, _TARGET_LANG, lcc, abstract, translated_abstract
            )

        # ④ lcc → Domains.name（PK 唯讀免交易）
        domain_name = self._resolve_domain_name(lcc)

        # === [RAG-ASYNC C5 START] 統一 P2 六步：⑤產各節點摘要 + ⑥批次翻 → section_summaries ===
        # ⑤ 產各節點原文摘要（resume 非 book → 1 次批次 LLM、非 N 次）→ ⑥ 以全文摘要 abstract
        # 引導、1 次批次翻為繁中 → section_summaries（key 對位巢狀樹）。三安全鎖：批次（②⑥ 各 1 次）/
        # 非致命（失敗該節點留空、不阻 reading_ready、不拋）/ 可量測（performance_metric phase=P2）。
        # LLM 全在 DB 交易外（與 ①②③④ 一致）。
        section_summaries = self._build_section_summaries(ctx, abstract, source_lang)
        # === [RAG-ASYNC C5 END] ===

        spec = GlossaryReadySpec(
            abstract=abstract,
            lcc=lcc,
            glossary=glossary,
            translated_abstract=translated_abstract,
            # === [RAG-ASYNC C5 START] section_summaries 由統一六步實落（C2 更名、C5 產出）===
            section_summaries=section_summaries or None,
            # === [RAG-ASYNC C5 END] ===
            domain_name=domain_name,
        )
        logger.info(
            "[PIPE-RESUME P2] %s lcc=%r glossary=%d domain_name=%r "
            "abstract=%dchars translated=%dchars section_summaries=%d",
            ctx.paper_id, lcc, len(glossary), domain_name,
            len(abstract), len(translated_abstract or ""), len(section_summaries or {}),
        )
        return spec

    # ── P2 私有輔助 ──

    def _read_source_text(self, ctx: PipelineContext) -> str:
        """讀 P1 產出的原文 markdown（路徑由 ctx 解析）；失敗 fallback 由 tiles 重組。"""
        output_dir = paper_manager.paper_dir(settings.OUTPUT_DIR, ctx.owner_id, ctx.paper_id)
        md_path = output_dir / f"{Path(ctx.pdf_path).stem}.md"
        try:
            return md_path.read_text(encoding="utf-8")
        except Exception as exc:  # noqa: BLE001
            logger.warning(
                "[PIPE-RESUME P2] 讀原文 md 失敗，改由 tiles 重組: %s", exc, exc_info=True
            )
            tiles = ctx.ingestion.tiles if ctx.ingestion else []
            return self._tiles_to_text(tiles)

    @staticmethod
    def _tiles_to_text(tiles: List[Dict[str, Any]]) -> str:
        """由物理分組 Tiles 重組純文字（fallback；walk sections→content→text）。"""
        parts: List[str] = []
        for sec in tiles or []:
            if not isinstance(sec, dict):
                continue
            for item in sec.get("content", []) or []:
                if isinstance(item, dict) and item.get("type") == "text":
                    parts.append(str(item.get("content", "")))
        return "\n".join(parts)

    def _make_summary(self, full_text: str) -> str:
        """做整份履歷摘要（原文語言、直接 LLM 摘要；失敗回空）。"""
        from llm.client import LLMClient  # 惰性 import 避免模組載入期重量級依賴

        messages = [
            {"role": "system", "content": _SUMMARY_SYSTEM_PROMPT},
            {"role": "user", "content": full_text[:_ABSTRACT_MAX_CHARS]},
        ]
        try:
            out = LLMClient.get_instance().chat(
                messages=messages, temperature=0.2, stream=False,
                model=settings.LLM_DOMAIN_MODEL,
            )
            return (out or "").strip()
        except Exception as exc:  # noqa: BLE001 — 摘要失敗不阻斷（兜底原文截斷）
            logger.warning(
                "[PIPE-RESUME P2] 履歷摘要生成失敗（兜底原文截斷）: %s", exc, exc_info=True
            )
            return ""

    # === [RAG-ASYNC C5 START] section_summaries 批次產出與翻譯（三安全鎖）===
    def _build_section_summaries(
        self, ctx: PipelineContext, abstract: str, source_lang: str
    ) -> Dict[str, str]:
        """⑤ 產 + ⑥ 批次翻 section_summaries（繁中、key 對位巢狀樹）。

        三安全鎖：批次（⑤⑥ 各 1 次 LLM、非 N 次）/ 非致命（失敗留空、不阻 reading_ready、不拋）/
        可量測（performance_metric phase=P2 stage=section_summary）。LLM 全在 DB 交易外。
        回 {node_key: 繁中摘要}（空節點/失敗則該 key 不入、降級為缺）。
        """
        import time

        t0 = time.perf_counter()
        sections = (ctx.ingestion.tiles if ctx.ingestion else []) or []
        targets: List[Tuple[str, str, str]] = []
        self._collect_summary_targets(sections, "", targets)
        raw_by_idx = self._generate_section_summaries(targets) if targets else {}
        zh_by_key = self._translate_section_summaries(raw_by_idx, targets, abstract, source_lang)
        logger.info(
            "[PIPE-RESUME P2] section_summaries 完成 sections=%d produced=%d translated=%d",
            len(targets), len(raw_by_idx), len(zh_by_key),
            extra={"extra_fields": {
                "event": "performance_metric",
                "phase": "P2",
                "stage": "section_summary",
                "paper_id": ctx.paper_id,
                "duration_seconds": round(time.perf_counter() - t0, 4),
                "sections": len(targets),
                "translated": len(zh_by_key),
            }},
        )
        return zh_by_key

    def _collect_summary_targets(
        self, sections: List[Dict[str, Any]], path_prefix: str,
        out: List[Tuple[str, str, str]],
    ) -> None:
        """DFS 收集有實質內文之節點 (node_key, title, content)；key 對位巢狀樹。"""
        for sec in sections or []:
            if not isinstance(sec, dict):
                continue
            title = (sec.get("title") or "").strip()
            node_key = f"{path_prefix}/{title}" if (path_prefix and title) else (title or path_prefix)
            content = self._node_content_text(sec)
            if title and content.strip():
                out.append((node_key, title, content))
            self._collect_summary_targets(sec.get("children", []) or [], node_key, out)

    @staticmethod
    def _node_content_text(sec: Dict[str, Any]) -> str:
        parts: List[str] = []
        for item in sec.get("content", []) or []:
            if isinstance(item, dict):
                c = item.get("content", "") or ""
                if c:
                    parts.append(c)
            elif isinstance(item, str) and item.strip():
                parts.append(item)
        return "\n\n".join(parts)

    def _generate_section_summaries(self, targets: List[Tuple[str, str, str]]) -> Dict[int, str]:
        """⑤ 1 次批次 LLM 產各節點原文摘要 → {index: 摘要}；失敗→{} 非致命（不阻 reading_ready）。"""
        from llm.client import LLMClient

        blocks = [
            f"[{i}] {title}\n{content[:_SECTION_SUMMARY_INPUT_CHARS]}"
            for i, (_k, title, content) in enumerate(targets)
        ]
        messages = [
            {"role": "system", "content": _SECTION_SUMMARY_SYSTEM_PROMPT},
            {"role": "user", "content": "\n\n".join(blocks)[:_ABSTRACT_MAX_CHARS]},
        ]
        try:
            out = LLMClient.get_instance().chat(
                messages=messages, temperature=0.2, stream=False,
                model=settings.LLM_DOMAIN_MODEL,
            )
            return self._parse_indexed(out, len(targets))
        except Exception as exc:  # noqa: BLE001 — 非致命：留空、不阻 reading_ready
            logger.warning(
                "[PIPE-RESUME P2] section 摘要批次生成失敗（非致命、留空）: %s", exc,
                exc_info=True,
                extra={"extra_fields": {"event": "section_summary_fallback", "stage": "generate"}},
            )
            return {}

    def _translate_section_summaries(
        self, raw_by_idx: Dict[int, str], targets: List[Tuple[str, str, str]],
        abstract: str, source_lang: str,
    ) -> Dict[str, str]:
        """⑥ 1 次批次翻各節點摘要為繁中（全文摘要引導）→ {node_key: 繁中}；失敗→{} 非致命。

        source_lang zh* → 原文即繁中、不重譯。
        """
        items = [(i, s) for i, s in raw_by_idx.items() if (s or "").strip()]
        if not items:
            return {}
        if (source_lang or "").startswith("zh"):
            return {
                targets[i][0]: s.strip()
                for i, s in items if 0 <= i < len(targets)
            }
        from llm.client import LLMClient

        user = (
            "全文摘要（翻譯風格與術語引導）：\n" + (abstract or "")[:500]
            + "\n\n待譯各區塊摘要（逐行保留 [編號]）：\n"
            + "\n".join(f"[{i}] {s}" for i, s in items)
        )
        messages = [
            {"role": "system", "content": _SECTION_SUMMARY_TRANSLATE_SYSTEM_PROMPT},
            {"role": "user", "content": user[:_ABSTRACT_MAX_CHARS]},
        ]
        try:
            out = LLMClient.get_instance().chat(
                messages=messages, temperature=0.2, stream=False,
                model=settings.TRANSLATE_MODEL,
            )
            parsed = self._parse_indexed(out, len(targets))
            return {
                targets[i][0]: t.strip()
                for i, t in parsed.items() if (t or "").strip() and 0 <= i < len(targets)
            }
        except Exception as exc:  # noqa: BLE001 — 非致命：留空、不阻 reading_ready
            logger.warning(
                "[PIPE-RESUME P2] section 摘要批次翻譯失敗（非致命、留空）: %s", exc,
                exc_info=True,
                extra={"extra_fields": {"event": "section_summary_fallback", "stage": "translate"}},
            )
            return {}

    @staticmethod
    def _parse_indexed(out: Optional[str], n: int) -> Dict[int, str]:
        """解析 LLM 批次輸出 `[i] 文字` 逐行 → {i: 文字}（容錯：缺漏項自然留空、越界丟棄）。"""
        result: Dict[int, str] = {}
        for line in (out or "").splitlines():
            m = re.match(r"^\s*\[(\d+)\]\s*(.+?)\s*$", line)
            if m:
                idx = int(m.group(1))
                if 0 <= idx < n:
                    result[idx] = m.group(2)
        return result
    # === [RAG-ASYNC C5 END] ===

    def _heal_glossary(
        self, source_lang: str, target_lang: str, lcc: str,
        abstract: str, translated_abstract: str,
    ) -> Dict[str, str]:
        """Glossary 級聯查詢 + 缺詞自癒（LLM 在 DB 交易外、upsert 冪等回寫）。"""
        gm = GlossaryManager()
        existing = gm.query_cascade(source_lang, target_lang, domain=lcc)
        if existing:
            return existing
        # 缺詞：以 (abstract, translated_abstract) 雙語樣本抽詞（LLM 交易外）→ 冪等回寫
        pairs = gm.extract_terms(
            abstract, translated_abstract, source_lang, target_lang, domain=lcc
        )
        if pairs:
            gm.upsert_terms(pairs, source_lang, target_lang, domain=lcc)
        return {key: val for key, val in pairs}

    def _resolve_domain_name(self, lcc: str) -> Optional[str]:
        """lcc → Domains.name（PK 唯讀檢索、無 session.begin() 寫交易；database SOP）。"""
        if not lcc:
            return None
        try:
            from db import SessionLocal
            from models import Domains

            with SessionLocal() as session:  # 唯讀、不開寫交易
                row = session.get(Domains, lcc)
                return row.name if row else None
        except Exception as exc:  # noqa: BLE001 — 解析失敗不阻斷（domain_name=None）
            logger.warning(
                "[PIPE-RESUME P2] Domains.name 解析失敗（domain_name=None）: %s",
                exc, exc_info=True,
            )
            return None
    # === [PIPE-RESUME C3 END] ===

    # === [PIPE-RESUME C4 START] P3 Translation & Restore ===
    # === [RESUME-P3 C3 START] 廢 100% Bypass → 逐 heading section 翻譯與還原 ===
    def run_phase3(self, ctx: PipelineContext) -> BilingualMarkdownSpec:
        """P3 Translation & Restore：逐 heading section 翻譯 + 結構還原（合約③、plan v3 Q1）。

        流程：
          ① 建 InjectionContext（lcc / glossary / zh_summary←P2 translated_abstract /
             domain_name / doc_type='resume' / constraints=_RESUME_CONSTRAINTS）。
          ② 逐 heading section（C1 後 ctx.ingestion.tiles=heading sections）遞迴走訪：
             標題→text_type="title"、正文 text→"content" 分流翻譯；formula/figure/table 保留原文；
             按 section level 還原 Markdown 重組 final_zh（pipelines/ 內私有方法、**不耦合 A 軌**）。
          ③ final_en=原著（.md）、final_zh=逐 section 重組譯文；無 section（退化）→ 整檔翻譯
             （_translate_whole；C4 擴充更完整的退化偵測）。
          ④ 交付 BilingualMarkdownSpec（translated_abstract 沿用 P2、必填）。

        source_lang='zh*'：原文已中文、zh=原文不重譯。
        """
        if ctx.glossary_ready is None:
            raise ValueError("PIPE-RESUME P3：ctx.glossary_ready 缺失（P2 未交付）")
        gspec = ctx.glossary_ready
        source_lang = (ctx.ingestion.source_lang if ctx.ingestion else None) or "en"
        is_zh = source_lang.startswith("zh")
        sections = (ctx.ingestion.tiles if ctx.ingestion else []) or []
        full_text = self._read_source_text(ctx)  # 原著 markdown（en + zh* 用）

        # ① InjectionContext（doc_type='resume' + 履歷業務 constraints）
        inj = InjectionContext(
            lcc=gspec.lcc,
            glossary=gspec.glossary,
            zh_summary=gspec.translated_abstract,
            domain_name=gspec.domain_name,
            doc_type="resume",
            constraints=_RESUME_CONSTRAINTS,
        )
        tr = Translator()  # 單一實例、逐單元共用

        # === [RESUME-P3 C4 START] ===
        # heading 退化偵測（plan v3 Q9）：履歷無 # 標題時 md_processor 會塌成單一巨 section，
        # 逐 section 翻譯將退化為接近整檔（doubling 風險）。偵測 heading 數 < 2 或單一 section
        # 文字佔總字數 > 85% → 降級走整檔翻譯 fallback，保證極限情況仍完整交付。
        degraded = (not is_zh) and bool(sections) and self._is_heading_degraded(sections)
        if degraded:
            logger.warning(
                "[PIPE-RESUME P3] %s heading 退化（sections=%d / 單一巨 section 佔比過高）→ "
                "降級整檔翻譯 fallback",
                ctx.paper_id, len(sections),
            )
        # === [RESUME-P3 C4 END] ===

        # ②③ final_zh：zh* 不重譯；有正常 section → 逐 heading 重組；無/退化 section → 整檔 fallback
        # === [RAG-ASYNC C6 START] 旁路封存譯後 section 結構供 P4 rag_indexer（不改既有 final_zh/en 輸出）===
        rag_sections: List[Dict[str, Any]] = []
        # === [RAG-ASYNC C6 END] ===
        if is_zh:
            zh_text = full_text
            # === [RAG-ASYNC C6 START] zh*：整檔為單一容器（size-cap 由 rag_indexer 子切）===
            rag_sections = self._single_container_sections(full_text, ctx)
            # === [RAG-ASYNC C6 END] ===
        # === [RESUME-P3 C4 START] ===
        elif sections and not degraded:
        # === [RESUME-P3 C4 END] ===
            # === [RAG-ASYNC C6 START] rag_sink 旁路捕捉譯後結構（rendered/return byte 不變）===
            zh_text = self._restore_sections_markdown(
                sections, inj, tr, translate=True, rag_sink=rag_sections
            )
            # === [RAG-ASYNC C6 END] ===
        else:
            zh_text = self._translate_whole(full_text, inj, tr, translate=True)
            # === [RAG-ASYNC C6 START] 退化 fallback：整檔單一容器 ===
            rag_sections = self._single_container_sections(zh_text, ctx)
            # === [RAG-ASYNC C6 END] ===
        en_text = full_text
        # === [RAG-ASYNC C6 START] 封存供 P4（P3→P4 ctx 旁路；不入凍結合約）===
        ctx.rag_sections = rag_sections
        # === [RAG-ASYNC C6 END] ===

        # === [RESUME-P3 META-HOTFIX-1 START] prepend 文件 meta header（render 缺口治標、走旁路）===
        zh_text = self._render_meta_header(ctx, gspec, lang="zh") + zh_text
        en_text = self._render_meta_header(ctx, gspec, lang="en") + en_text
        # === [RESUME-P3 META-HOTFIX-1 END] ===

        zh_path = paper_manager.article_zh_path(
            settings.OUTPUT_DIR, ctx.owner_id, ctx.paper_id
        )
        en_path = paper_manager.article_en_path(
            settings.OUTPUT_DIR, ctx.owner_id, ctx.paper_id
        )
        zh_path.parent.mkdir(parents=True, exist_ok=True)
        zh_path.write_text(zh_text, encoding="utf-8")
        en_path.write_text(en_text, encoding="utf-8")

        # ④ 交付（translated_abstract 沿用 P2、必填、防 ValidationError）
        spec = BilingualMarkdownSpec(
            final_zh_path=str(zh_path),
            final_en_path=str(en_path),
            translated_abstract=gspec.translated_abstract,
            rag_tree_json=None,
        )
        logger.info(
            "[PIPE-RESUME P3] %s 逐 heading 翻譯完成 source_lang=%s sections=%d "
            "zh=%dchars en=%dchars (zh=%s / en=%s)",
            ctx.paper_id, source_lang, len(sections), len(zh_text), len(en_text),
            zh_path.name, en_path.name,
        )
        return spec

    # ── P3 私有逐單元翻譯與還原（pipelines 內重建、不耦合 A 軌即將棄用的逐段翻譯處理器）──

    # === [RESUME-PERF-1 C1 START] 收集-組裝解耦（仍序列；C2 將「翻譯」改受限並行）===
    def _restore_sections_markdown(
        self, sections: List[Dict[str, Any]], inj: "InjectionContext",
        tr: "Translator", translate: bool,
        rag_sink: Optional[List[Dict[str, Any]]] = None,
    ) -> str:
        """逐 section：收集有序 render slot → 翻譯 → 按序組裝，重組為單一字串。

        RESUME-PERF-1 C1：將原「邊遞迴邊翻邊組」拆為三段——① `_collect_render_slots`
        序列收集有序 slot（title/content/raw）；② 逐 slot 翻譯（C1 仍序列、C2 換 ThreadPool）；
        ③ 按 slot 原序組裝（title 套 HEADING 層級、content 套 PARA 正規化、raw 原文）。
        輸出與序列版 byte 等價（slot 順序 = 原 DFS pre-order；翻譯/後處理邏輯不變）。
        """
        slots: List[Dict[str, Any]] = []
        self._collect_render_slots(sections, 0, slots)

        # === [RESUME-PERF-1 C2 START] ② 並行翻譯（受限並行、保序回填、單 unit 異常隔離）===
        # 對 title/content slot 提交 _t 至執行緒池（max_workers=LLM_MAX_CONCURRENT）；實際 API
        # 併發再受既有 LLMClient._api_semaphore 限流（不新增鎖）。結果以 slot index 保序回填（raw 不翻）。
        # 單 slot future 拋例外 → 退回原文 slot["text"] + warning，不污染其餘、保 BilingualMarkdownSpec 交付。
        zh_by_index: Dict[int, str] = {}
        if translate:
            todo = [
                (i, slot, "title" if slot["kind"] == "title" else "content")
                for i, slot in enumerate(slots)
                if slot["kind"] in ("title", "content")
            ]
            if todo:
                with ThreadPoolExecutor(max_workers=max(1, LLM_MAX_CONCURRENT)) as ex:
                    fut_to_idx = {
                        ex.submit(self._t, slot["text"], inj, tr, ttype): i
                        for i, slot, ttype in todo
                    }
                    for fut, i in fut_to_idx.items():
                        try:
                            zh_by_index[i] = fut.result()
                        except Exception as exc:  # noqa: BLE001 — 單 unit 隔離、退原文保交付
                            zh_by_index[i] = slots[i]["text"]
                            logger.warning(
                                "[RESUME-PERF-1] 單元翻譯失敗、退回原文",
                                extra={'extra_fields': {
                                    'event': 'resume_translate_unit_fallback',
                                    'reason': str(exc)[:200],
                                }},
                            )
        # ③ 按 slot 原序組裝（title → HEADING 層級前綴；content → PARA 正規化；raw → 原文）
        rendered: List[str] = []
        for i, slot in enumerate(slots):
            kind = slot["kind"]
            if kind == "raw":
                rendered.append(slot["text"])
                continue
            zh = zh_by_index.get(i, slot["text"]) if translate else slot["text"]
            if kind == "title":
                rendered.append(f"{'#' * slot['level']} {zh}")
            else:
                rendered.append(self._normalize_paragraph_breaks(zh))
        # === [RAG-ASYNC C6 START] 旁路封存譯後 section 結構（用同一 slots+zh_by_index；不改 return）===
        if rag_sink is not None:
            self._collect_rag_sections(slots, zh_by_index, translate, rag_sink)
        # === [RAG-ASYNC C6 END] ===
        return ("\n\n".join(p for p in rendered if p)).strip() + "\n"
        # === [RESUME-PERF-1 C2 END] ===

    # === [RAG-ASYNC C6 START] P3→P4 旁路：譯後 section 結構建構 ===
    @staticmethod
    def _collect_rag_sections(
        slots: List[Dict[str, Any]], zh_by_index: Dict[int, str],
        translate: bool, sink: List[Dict[str, Any]],
    ) -> None:
        """由（已翻譯）slots 重組扁平譯後 section 清單供 rag_indexer：title slot 起新 section，
        其後 content/raw slot 歸入該 section.content（type=text/raw）。不重譯、複用 zh_by_index。"""
        cur: Optional[Dict[str, Any]] = None
        for i, slot in enumerate(slots):
            kind = slot["kind"]
            text = zh_by_index.get(i, slot["text"]) if translate else slot["text"]
            if kind == "title":
                cur = {
                    "title": text, "level": slot.get("level", 2),
                    # === [RAG-ASYNC-HOTFIX-1 HOTFIX-1 START] ===
                    # 原文標題 path（譯後 title 仍存於 "title" 供顯示）；P4 以此跨譯查 section_summaries
                    "summary_key": slot.get("key", ""),
                    # === [RAG-ASYNC-HOTFIX-1 HOTFIX-1 END] ===
                    "content": [], "children": [],
                }
                sink.append(cur)
            else:
                if cur is None:  # 容錯：標題前的內容 → 匿名容器
                    cur = {"title": "", "level": 2, "content": [], "children": []}
                    sink.append(cur)
                cur["content"].append(
                    {"type": ("raw" if kind == "raw" else "text"), "content": text}
                )

    @staticmethod
    def _single_container_sections(text: str, ctx: PipelineContext) -> List[Dict[str, Any]]:
        """is_zh / 退化 fallback：整檔為單一容器 section（size-cap 由 rag_indexer 子切）。"""
        title = (ctx.ingestion.title if ctx.ingestion else "") or "履歷全文"
        return [{
            "title": title, "level": 2,
            "content": [{"type": "text", "content": text or ""}], "children": [],
        }]
    # === [RAG-ASYNC C6 END] ===

    def _collect_render_slots(
        self, sections: List[Dict[str, Any]], depth: int, out: List[Dict[str, Any]],
        # === [RAG-ASYNC-HOTFIX-1 HOTFIX-1 START] ===
        path_prefix: str = "",
        # === [RAG-ASYNC-HOTFIX-1 HOTFIX-1 END] ===
    ) -> None:
        """遞迴收集有序 render slot（不翻譯）。順序＝原 `_restore_one_section` 的 DFS pre-order。

        slot 型態：
        - title  ：{"kind":"title","text":標題,"level":HEADING 層級,"key":原文標題 path}（HEADING-HOTFIX-1 邏輯、值不變）
        - content：{"kind":"content","text":待翻正文}（組裝時套 PARA-HOTFIX-1 正規化）
        - raw    ：{"kind":"raw","text":原文}（formula/figure/table，不翻、passthrough）

        RAG-ASYNC-HOTFIX-1：title slot 附加 `key`＝原文標題 path（slot 在翻譯前收集、text 即原文），
        與 P2 `_collect_summary_targets` 之 node_key **同式同基準**，供 P4 跨譯查 section_summaries。
        """
        for sec in sections or []:
            if not isinstance(sec, dict):
                continue
            title = (sec.get("title") or "").strip()
            # === [RAG-ASYNC-HOTFIX-1 HOTFIX-1 START] ===
            node_key = f"{path_prefix}/{title}" if (path_prefix and title) else (title or path_prefix)
            # === [RAG-ASYNC-HOTFIX-1 HOTFIX-1 END] ===
            if title:
                # HEADING-HOTFIX-1：頂層 h2、每下潛 children +1、上限 h6（值不變、僅由此處記錄）
                out.append({
                    "kind": "title", "text": title, "level": min(2 + depth, 6),
                    # === [RAG-ASYNC-HOTFIX-1 HOTFIX-1 START] ===
                    "key": node_key,  # 原文標題 path，譯後 title 另存於組裝端 "title" 供顯示
                    # === [RAG-ASYNC-HOTFIX-1 HOTFIX-1 END] ===
                })

            for item in sec.get("content", []) or []:
                if isinstance(item, dict):
                    itype = item.get("type")
                    content = item.get("content", "") or ""
                    if itype == "text":
                        out.append({"kind": "content", "text": content})
                    else:
                        # formula / figure / table 等：保留原文結構、不翻
                        if content:
                            out.append({"kind": "raw", "text": content})
                else:
                    # 容錯：content 為純字串 list（md_processor 原始型態）
                    txt = str(item).strip()
                    if txt:
                        out.append({"kind": "content", "text": txt})

            for child in sec.get("children", []) or []:
                if isinstance(child, dict):
                    # === [RAG-ASYNC-HOTFIX-1 HOTFIX-1 START] ===
                    self._collect_render_slots([child], depth + 1, out, node_key)
                    # === [RAG-ASYNC-HOTFIX-1 HOTFIX-1 END] ===
    # === [RESUME-PERF-1 C1 END] ===

    def _translate_whole(
        self, full_text: str, inj: "InjectionContext", tr: "Translator", translate: bool,
    ) -> str:
        """退化 fallback 基礎：整檔一次翻譯（C4 接此為單一巨 section 降級路徑）。"""
        if not translate:
            return full_text
        return tr.translate(full_text, inj, TranslateMode.NORMAL, "content")

    @staticmethod
    def _t(text: str, inj: "InjectionContext", tr: "Translator", text_type: str) -> str:
        """單元翻譯（空白略過、不浪費呼叫）。"""
        t = (text or "").strip()
        if not t:
            return text
        return tr.translate(t, inj, TranslateMode.NORMAL, text_type)

    # === [RESUME-P3 META-HOTFIX-1 START] ===
    @staticmethod
    def _render_meta_header(
        ctx: PipelineContext, gspec: "GlossaryReadySpec", *, lang: str
    ) -> str:
        """組文件開頭 meta header：`# 姓名` + 領域/機構/電話/Email 無序列表。

        render 缺口治標（META-HOTFIX-1）：P1 抽的 meta 原本只到 DB（raw_metadata 旁路終點），
        本 helper 在 P3 渲染端**讀同一條現有旁路 ctx.raw_metadata + ctx.ingestion.title**，
        組出文件 header 讓 final 立刻有 meta（不動凍結合約；合約轉正屬 INFRA-4 遠期）。

        - lang='zh'|'en' 控制 label 語言與分隔符；缺項靜默省略；整包空 → 回 ''。
        - meta 採**無序列表（`- `）**：每欄為獨立 list item、CommonMark 規範保證各自一行，
          不依賴行尾空格 / 不怕 strip、根治 RAG-10 類軟換行（取代脆弱的 blockquote+尾隨空格）。
        - 姓名沿用 ctx.ingestion.title 原值（含影子 ' (測試)' 後綴、便於觀察、不另去除）。
        - 讀取源未來由 INFRA-4 從 ctx.raw_metadata 轉為 spec 擴展欄（本 helper 唯一改動點）。
        """
        raw = ctx.raw_metadata or {}
        title = ((ctx.ingestion.title if ctx.ingestion else "") or "").strip()
        domain = ResumePipeline._meta_value(raw, "domain") or ""
        if lang == "en":
            domain = (gspec.domain_name if gspec else "") or domain   # en 優先用 LCC 英文領域名
        org = ResumePipeline._meta_value(raw, "organization") or ""
        phone = ResumePipeline._meta_value(raw, "phone") or ""
        email = ResumePipeline._meta_value(raw, "email") or ""
        label = {
            "zh": {"domain": "領域", "org": "機構", "phone": "電話", "email": "Email"},
            "en": {"domain": "Domain", "org": "Organization", "phone": "Phone", "email": "Email"},
        }[lang]
        sep = "：" if lang == "zh" else ": "
        lines: List[str] = []
        if title:
            lines.append(f"# {title}")
            lines.append("")
        items: List[str] = []
        for key, val in (("domain", domain), ("org", org), ("phone", phone), ("email", email)):
            if str(val).strip():
                items.append(f"- **{label[key]}**{sep}{val}")   # 無序列表：規範保證每欄獨立一行
        if items:
            lines.extend(items)
            lines.append("")
        if not lines:
            return ""
        return "\n".join(lines).rstrip("\n") + "\n\n"
    # === [RESUME-P3 META-HOTFIX-1 END] ===

    # === [RESUME-P3 PARA-HOTFIX-1 START] ===
    @staticmethod
    def _normalize_paragraph_breaks(text: str) -> str:
        """段落邊界正規化（pipe-table-safe 單 \\n → \\n\\n）。

        移植自 A 軌既有的 pipe-table-safe 段落正規化邏輯、於 pipelines/ 內重建、
        **不 import、不耦合 A 軌 restore 處理器**（RESUME-P3「pipelines/ 內重建、不耦合即將棄用 A 軌」原則）。
        真因：B 軌逐 section 還原只在不同 part 間放 \\n\\n，段內單 \\n 不處理 →
        CommonMark soft break → 兩段黏一起（A 軌靠 _write_to_md 補 \\n\\n + 本邏輯升級單 \\n）。

        規則：一般段落單 \\n 升級 \\n\\n（製造段落空行）；pipe table 區塊
        （以 | 開頭連續行）rows 之間單 \\n 保留（否則 table 渲染破碎）。
        """
        import re
        if not text:
            return text
        lines = text.split("\n")
        out_lines: List[str] = []
        in_table = False
        for line in lines:
            is_table_row = bool(re.match(r"^\s*\|", line))
            if is_table_row:
                if not in_table and out_lines and out_lines[-1].strip():
                    out_lines.append("")          # 進 table 前補空行作 paragraph 邊界
                in_table = True
                out_lines.append(line)
            elif in_table:
                in_table = False
                if line.strip():
                    out_lines.append("")          # table 結束補空行作分隔
                out_lines.append(line)
            else:
                out_lines.append(line)
        text = "\n".join(out_lines)
        # table 區塊外一般 paragraph：單 \n 轉 \n\n（避開 | 開頭行）
        text = re.sub(r"(?<!\|)(?<!\n)\n(?![\n\|])", "\n\n", text)
        return text
    # === [RESUME-P3 PARA-HOTFIX-1 END] ===
    # === [RESUME-P3 C3 END] ===

    # === [RESUME-P3 C4 START] heading 退化偵測（單一巨 section 降級防護）===
    @staticmethod
    def _is_heading_degraded(
        sections: List[Dict[str, Any]],
        ratio_threshold: float = 0.85,
        min_sections: int = 2,
    ) -> bool:
        """heading 退化判定（plan v3 Q9）：

        攤平所有 heading（top + children 遞迴），以每個 heading **自身** content 文字長度計：
        - heading 總數 < min_sections（履歷幾乎無 # 標題、結構塌陷）→ 退化
        - 單一 heading 自身文字佔全部文字 > ratio_threshold（全文塞進單一巨 section）→ 退化
        """
        flat: List[Dict[str, Any]] = []
        ResumePipeline._flatten_sections(sections, flat)
        if len(flat) < min_sections:
            return True
        sizes = [ResumePipeline._own_text_len(s) for s in flat]
        total = sum(sizes)
        if total <= 0:
            return False
        return (max(sizes) / total) > ratio_threshold

    @staticmethod
    def _flatten_sections(sections: List[Dict[str, Any]], out: List[Dict[str, Any]]) -> None:
        """遞迴攤平 sections（含 children）至 out。"""
        for sec in sections or []:
            if isinstance(sec, dict):
                out.append(sec)
                ResumePipeline._flatten_sections(sec.get("children", []) or [], out)

    @staticmethod
    def _own_text_len(sec: Dict[str, Any]) -> int:
        """單一 section **自身**（不含 children）的 text item 文字長度累加。"""
        n = 0
        for item in sec.get("content", []) or []:
            if isinstance(item, dict):
                if item.get("type") == "text":
                    n += len(item.get("content", "") or "")
            else:
                n += len(str(item))
        return n
    # === [RESUME-P3 C4 END] ===
    # === [PIPE-RESUME C4 END] ===

    # === [PIPE-RESUME C5 START] P4 Async RAG（門檻 ≥3 技能詞保護）===
    def run_phase4(self, ctx: PipelineContext) -> RagDbSpec:
        """P4 Async RAG：向量化落庫、門檻 ≥3 技能詞保護（合約④，非阻塞）。

        流程（plan v2 §2 U4/U5、RAG-ASYNC C6 改呼 B 軌自有 rag_indexer、零依賴 A 軌）：
          ① 輸入＝P3 旁路封存之譯後 section 結構 `ctx.rag_sections` + P2 交付之
             `ctx.glossary_ready.section_summaries`（**不再餵 reading-view final_zh.md**）。
          ② `rag_indexer.index(rag_sections, section_summaries, 'resume', vectors_dir, paper_db_id)`
             一站式：Strategy B 摘要增強分塊 + size-cap 子切 → `is_chunk_meaningful`(≥3、保
             email/phone/url) 過濾 → Embedding → FAISS save_local → paper_chunks 批量 → index_meta。
          ③ 交付 `RagDbSpec`（vectors_path / paper_chunk_count / index_meta）。

        DB 交易邊界（database SOP）：Embedding 於 `FAISS.from_documents`（DB 交易外）；
        `paper_chunks` 寫庫委由 `paper_manager.replace_paper_chunks`（內部極短交易）。
        paper_db_id 為 None → rag_indexer 內部優雅降級（僅 FAISS + index_meta）。

        錯誤隔離（plan U5 / SPEC R4.2）：P4 異常僅 logger.warning(exc_info=True) 後**拋出**，
        交 Orchestrator `_default_dispatch_p4` 設 rag_status='failed'，**絕不阻塞 reading_ready**。
        """
        if ctx.bilingual is None:
            raise ValueError("PIPE-RESUME P4：ctx.bilingual 缺失（P3 未交付）")
        # === [RAG-ASYNC C6 START] 改呼 B 軌自有 rag_indexer（輸入＝P3 旁路譯後結構 + P2 section_summaries；
        # 不再餵 reading-view final_zh.md；零依賴 A 軌 rag_processor）===
        from processor import rag_indexer  # 惰性 import（B 軌自有、零 rag_processor）

        rag_sections = ctx.rag_sections or []
        section_summaries = (
            ctx.glossary_ready.section_summaries if ctx.glossary_ready else None
        ) or {}
        vectors_dir = paper_manager.vectors_path(
            settings.OUTPUT_DIR, ctx.owner_id, ctx.paper_id
        )
        # paper_db_id：None → rag_indexer.index 內部優雅降級（僅 FAISS、跳過 paper_chunks）
        paper_db_id = paper_manager.get_paper_db_id(ctx.owner_id, ctx.paper_id)
        if paper_db_id is None:
            logger.warning(
                "[PIPE-RESUME P4] %s paper_db_id 未取得（DB 寫入降級、僅 FAISS + index_meta）",
                ctx.paper_id,
            )

        try:
            # ② B 軌一站式：Strategy B 分塊 + size-cap → 過濾 → Embedding → FAISS → paper_chunks
            #    → index_meta → RagDbSpec（Embedding 於 DB 交易外、paper_db_id None 降級）
            spec = rag_indexer.index(
                rag_sections, section_summaries, "resume", vectors_dir,
                paper_db_id=paper_db_id,
            )
            logger.info(
                "[PIPE-RESUME P4] %s RAG 完成 chunks=%d paper_chunks=%d vectors=%s",
                ctx.paper_id, int(spec.index_meta.get("chunks_total", 0)),
                spec.paper_chunk_count, vectors_dir.name,
            )
            return spec
        except Exception as exc:  # noqa: BLE001 — 拋出由 Orchestrator 標 rag_status='failed'
            logger.warning(
                "[PIPE-RESUME P4] %s RAG 向量化失敗（不阻主鏈、Orchestrator 將標 "
                "rag_status='failed'）: %s",
                ctx.paper_id, exc, exc_info=True,
            )
            raise
        # === [RAG-ASYNC C6 END] ===
    # === [RAG-ASYNC-HOTFIX-1 HOTFIX-1] #3 移除 dead code _load_index_meta
    #     （RAG-ASYNC C6 後 run_phase4 改呼 rag_indexer.index、已無 caller；grep 證實 0 引用）===
    # === [PIPE-RESUME C5 END] ===
# === [PIPE-RESUME C1 END] ===
