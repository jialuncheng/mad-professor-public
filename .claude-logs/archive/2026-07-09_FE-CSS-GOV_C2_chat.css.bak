/* ==========================================================================
   chat.css — 右欄 chat / 訊息泡泡(.msg-* content-visibility 遺產) / 輸入區 / hashtag
   [FE-CSS-GOV C1] inline <style> 零改寫等價遷出（基準 index.html@d4ce75a）；
   規則內容物理搬遷、零改寫。@layer 化屬 C2；主題去重屬 C3；作用域收斂屬 C5-C7。
   ========================================================================== */
  /* ── 右欄 chat ── */
  #chat-panel {
    width: 380px;
    flex-shrink: 0;
    background: var(--color-bg);
    border-left: var(--divider-w) solid var(--color-divider);
    display: flex; flex-direction: column;
    overflow: hidden;
    transition: width 180ms ease;
  }
  #chat-header {
    height: var(--toolbar-h);
    flex-shrink: 0;
    padding: 0 var(--pad-panel);
    border-bottom: 1px solid var(--color-border);
    display: flex; align-items: center;
    gap: var(--gap-btn-loose);
    font-size: var(--font-base);
    font-weight: 600;
  }
  #chat-header > .h-title {
    /* 字體 / 字距 → 由主題覆寫 */
    flex: 1; min-width: 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  /* 痛點 7：右欄三按鈕進入同一個 flex 容器，normal 間距 */
  #chat-header-actions {
    display: flex; align-items: center;
    gap: var(--gap-btn-normal);
  }
  /* 開啟搜尋 / 匯出 MD：皆為 icon-only.bordered；只額外定義 active 反白狀態 */
  #web-search-toggle.active {
    background: var(--color-text);
    color: #fff;
    border-color: var(--color-text);
  }
  #web-search-toggle.active:hover {
    background: var(--color-accent-hover);
  }

  #chat-messages {
    flex: 1;
    overflow-y: auto;
    scrollbar-gutter: stable;                                     /* 永遠保留捲軸位、左右視覺對稱 */
    padding: 0 var(--chat-pad-x, var(--space-5)) var(--space-5);  /* 頂部設為 0，防置頂穿透（RAG-14）*/
    display: flex; flex-direction: column;
    gap: var(--space-6);                                             /* qa-group 外部間距（C1 RAG-14）*/
  }
  .qa-group {
    display: flex; flex-direction: column;
    gap: var(--space-4);                                             /* user/ai 內部間距（C1 RAG-14）*/
  }
  .qa-group:first-child {
    margin-top: var(--space-5);                                      /* 首個 QA 組補回頂部留白（RAG-14）*/
  }
  .msg-user {
    /* [FE-PERF-2 C4] 視窗外訊息跳過 layout/paint；auto 記憶尺寸防上捲跳動（U8·Safari 18+ 基線內） */
    content-visibility: auto;
    contain-intrinsic-size: auto 120px;
    background: var(--color-accent);
    color: #fff;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--font-base);
    line-height: 1.6;
    align-self: stretch;                                             /* 滿寬（C1 RAG-14）*/
    max-width: 100%;                                                 /* 滿寬（C1 RAG-14）*/
    white-space: pre-wrap;
    position: sticky;                                                /* Q&A sticky header（C1 RAG-14）*/
    top: 0;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  }
  /* attach 到 broker 的 stream 時 ai msg 末尾的閃爍游標
     （sendMessage 用純字「▋」、attach 模式統一帶 blink 動畫）*/
  .cursor-blink {
    animation: blink-cursor 1s step-end infinite;
    margin-left: 2px;
    opacity: 0.7;
  }
  @keyframes blink-cursor {
    0%, 50% { opacity: 0.7; }
    51%, 100% { opacity: 0; }
  }
  .msg-ai {
    /* [FE-PERF-2 C4] 視窗外訊息跳過 layout/paint；auto 記憶尺寸防上捲跳動（U8·Safari 18+ 基線內） */
    content-visibility: auto;
    contain-intrinsic-size: auto 120px;
    position: relative;
    background: var(--color-bg);
    color: var(--color-text);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--font-base);
    line-height: 1.8;
    align-self: stretch;                                             /* 滿寬（C1 RAG-14）*/
    max-width: 100%;                                                 /* 滿寬（C1 RAG-14）*/
    border: 1px solid var(--color-border);
  }
  /* AI 訊息動作鈕：右下角 hover 顯示 copy / regenerate */
  .msg-ai-actions {
    position: absolute;
    right: 6px;
    bottom: -14px;
    display: flex;
    gap: 2px;
    opacity: 0;
    transition: opacity var(--transition);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 1px;
  }
  .msg-ai:hover .msg-ai-actions { opacity: 1; }
  .msg-ai-actions button {
    width: 24px; height: 24px;
    min-width: 0; padding: 0;
    border: 0; background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    transition: background var(--transition), color var(--transition);
  }
  .msg-ai-actions button:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }
  .msg-ai-actions svg {
    width: 13px; height: 13px;
    stroke: currentColor; stroke-width: var(--btn-icon-stroke);
    fill: none; stroke-linecap: round; stroke-linejoin: round;
  }
  .msg-ai-actions button.copied {
    color: var(--color-accent);
  }
  @media (hover: none) {
    .msg-ai-actions { opacity: 1; }
  }
  .msg-ai p { margin-bottom: var(--space-2); }
  .msg-ai p:last-child { margin-bottom: 0; }
  .msg-sources {
    font-size: var(--font-sm);
    color: var(--color-text-subtle);
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px dashed var(--color-border);
  }
  .msg-sources a { color: var(--color-text-muted); text-decoration: underline; }
  .msg-sources a:hover { color: var(--color-text); }
  .msg-system {
    font-size: var(--font-sm);
    color: var(--color-text-subtle);
    text-align: center;
    padding: var(--space-3);
  }

  /* 右欄輸入區：與 chat-messages 共用水平 padding（--chat-pad-x），
     textarea 撐滿剩餘寬度，左右邊緣 = 訊息泡泡容器邊緣 */
  #chat-input-area {
    flex-shrink: 0;
    padding: var(--pad-panel) var(--chat-pad-x, var(--space-5));
    border-top: 1px solid var(--color-border);
    /* autocomplete dropdown 定位錨點（P2-3 §3.3.5-#4） */
    position: relative;
  }
  #chat-input {
    width: 100%;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--font-base);
    line-height: 1.5;
    /* BUG-F1 Bug 3（ui-fixes-batch C1）：預留 placeholder 兩行高度、避免 type 時容器跳動
       原 min-height: var(--btn-h) (38px) 不夠容納兩行；改 56px = 兩行 line-height(1.5*14=21) + padding */
    min-height: 56px;
    max-height: 240px;                    /* 約 10 行；contenteditable 自然撐高 */
    overflow-y: auto;
    outline: none;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: inherit;
    display: block;
    /* contenteditable div 需顯式設 word-break、避免長字串撐破容器 */
    word-break: break-word;
    white-space: pre-wrap;
  }
  #chat-input:focus { border-color: var(--color-accent); }
  /* contenteditable div 無原生 placeholder（P2-3 §3.3.5-#1）：
     用 :empty::before + data-placeholder 模擬；display:block 確保排版正確 */
  #chat-input:empty::before {
    content: attr(data-placeholder);
    /* BUG-F1 Bug 3（ui-fixes-batch C1）：讓 data-placeholder 內 &#10; / \n 顯示為實際換行 */
    white-space: pre-wrap;
    color: var(--color-text-subtle);
    pointer-events: none;
    display: block;
  }
  #chat-input:empty:focus::before { opacity: 0.5; }
  /* disabled 視覺契約對齊既有 textarea[disabled]（P2-3 §3.3.5-#2）：
     contenteditable="false" 替代 disabled 屬性、需顯式樣式維持 UX */
  #chat-input[contenteditable="false"] {
    background: var(--color-surface);
    color: var(--color-text-subtle);
    cursor: not-allowed;
    user-select: none;
  }
  #chat-input[contenteditable="false"]:empty::before { opacity: 0.4; }

  /* Hashtag Token 樣式（P2-3 §3.3.2 + design/docs/components.md §11.2） */
  .hashtag-token {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0 var(--space-2);
    background: var(--color-accent);
    color: white;
    border-radius: var(--radius-sm);
    font-size: var(--font-sm);
    user-select: none;
    cursor: default;
    /* 跟周圍純文字基線對齊、避免 token 跳行錯位 */
    vertical-align: baseline;
    line-height: 1.5;
    /* 確保 contenteditable 把整顆 token 當原子單元、Backspace 一次刪整顆 */
  }
  .hashtag-token-remove {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    padding: 0;
    margin-left: 2px;
    font-size: inherit;
    line-height: 1;
  }
  .hashtag-token-remove:hover { color: white; }
  [data-theme="dark"] .hashtag-token { background: var(--color-accent); }

  /* autocomplete dropdown 綁容器、非綁 cursor（P2-3 §3.3.5-#4）
     永遠在 input 正上方展開、避免溢出畫面與多行抖動 */
  #hashtag-autocomplete.hashtag-popup {
    position: absolute;
    bottom: 100%;
    left: var(--chat-pad-x, var(--space-5));
    right: var(--chat-pad-x, var(--space-5));
    max-height: 240px;
    overflow-y: auto;
    margin-bottom: var(--space-2);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-1) 0;
    z-index: 100;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }
  #hashtag-autocomplete.hashtag-popup[hidden] { display: none; }
  .hashtag-popup-item {
    padding: var(--space-1) var(--space-3);
    font-size: var(--font-base);
    color: var(--color-text);
    cursor: pointer;
    line-height: 1.6;
  }
  .hashtag-popup-item:hover,
  .hashtag-popup-item.active {
    background: var(--color-surface);
  }
  .hashtag-popup-more {
    padding: var(--space-1) var(--space-3);
    font-size: var(--font-sm);
    color: var(--color-text-subtle);
    cursor: default;
    font-style: italic;
  }

  .chat-empty {
    text-align: center;
    color: var(--color-text-subtle);
    font-size: var(--font-sm);
    margin-top: var(--space-8);
  }

