ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))


# ── C1（U6）：資料庫連接池與防鎖死配置 ──

def test_db_busy_timeout_and_pool():
    """db.engine 配 QueuePool(pool_size=5, max_overflow=10, pool_pre_ping=True)；
    SQLite 連線 busy_timeout=30000（U6）。"""
    from sqlalchemy.pool import QueuePool

    import db

    # 連接池型別與容量
    assert isinstance(db.engine.pool, QueuePool)
    assert db.engine.pool.size() == 5            # pool_size
    assert db.engine.pool._max_overflow == 10    # max_overflow
    assert db.engine.pool._pre_ping is True       # pool_pre_ping

    # 運行期 PRAGMA busy_timeout = 30000（僅 sqlite）
    if db._IS_SQLITE:
        db._ensure_sqlite_dir()
        with db.engine.connect() as conn:
            val = conn.exec_driver_sql("PRAGMA busy_timeout").scalar()
        assert int(val) == 30000


def test_db_pragma_foreign_keys_and_wal_preserved():
    """既有 PRAGMA（foreign_keys / WAL）未被 C1 破壞（不可動防線）。"""
    import db

    if not db._IS_SQLITE:
        return
    db._ensure_sqlite_dir()
    with db.engine.connect() as conn:
        fk = conn.exec_driver_sql("PRAGMA foreign_keys").scalar()
        journal = conn.exec_driver_sql("PRAGMA journal_mode").scalar()
    assert int(fk) == 1
    assert str(journal).lower() == "wal"


# ── C2（U4 Streaming + U5 Real IP）──

import asyncio  # noqa: E402

import pytest  # noqa: E402


class _FakeUpload:
    """記錄 read(size) 呼叫的假 UploadFile（驗證 1MB 分塊讀取）。"""

    def __init__(self, chunks, filename="t.pdf"):
        self._chunks = list(chunks)
        self.filename = filename
        self.read_sizes = []

    async def read(self, size=-1):
        self.read_sizes.append(size)
        return self._chunks.pop(0) if self._chunks else b""


class _FakeBG:
    def add_task(self, fn, *a, **k):
        pass


class _User:
    id = 778001


class _FakeReq:
    def __init__(self, xff=None, client_host="9.9.9.9"):
        self.headers = {"X-Forwarded-For": xff} if xff else {}
        self.client = type("C", (), {"host": client_host})()
        self.session = {}


_ONE_MB = 1024 * 1024


def test_upload_file_streaming_constant_ram(tmp_path, monkeypatch):
    """U4：非 PDF 首塊魔術字節 → 415；read 以 1MB 分塊；空檔 → 415。"""
    import web_server

    monkeypatch.setattr(web_server, "OUTPUT_DIR", tmp_path)

    # 非 PDF → 415，且 read 以 1MB(1048576) 分塊（非一次性）
    up = _FakeUpload([b"NOTAPDF" + b"0" * 100])
    resp = asyncio.run(web_server.upload_paper(_FakeBG(), file=up, doc_type="academic", current_user=_User()))
    assert resp.status_code == 415
    assert up.read_sizes and up.read_sizes[0] == _ONE_MB   # 1MB 分塊讀取

    # 空檔 → 415
    up2 = _FakeUpload([])
    resp2 = asyncio.run(web_server.upload_paper(_FakeBG(), file=up2, doc_type="academic", current_user=_User()))
    assert resp2.status_code == 415


def test_upload_oversize_returns_413(tmp_path, monkeypatch):
    """U4：累計超 100MB 立即截斷 → 413，且 partial 檔被清理。"""
    import web_server
    import paper_manager

    monkeypatch.setattr(web_server, "OUTPUT_DIR", tmp_path)

    first = b"%PDF-1.5\n" + b"0" * (_ONE_MB - 9)        # 首塊合法 %PDF、1MB
    rest = [b"0" * _ONE_MB for _ in range(100)]          # 100×1MB → 總 101MB > 100MB
    up = _FakeUpload([first, *rest])
    resp = asyncio.run(web_server.upload_paper(_FakeBG(), file=up, doc_type="academic", current_user=_User()))
    assert resp.status_code == 413

    paper_id = paper_manager.sanitize_paper_id("t.pdf")
    pdf_path = tmp_path / str(_User.id) / paper_id / f"{paper_id}.pdf"
    assert not pdf_path.exists()                          # partial 檔已清理


def test_x_forwarded_for_parsing(monkeypatch):
    """U5：X-Forwarded-For 最左 IP 作為鎖定鍵；無 XFF 才降級 client.host。"""
    import web_server

    # 有 XFF → 鎖定鍵為最左真實 IP（非代理鏈後段、非 client.host）
    web_server._login_attempts.pop("1.2.3.4", None)
    asyncio.run(web_server.login(_FakeReq(xff="1.2.3.4, 10.0.0.1"), username="wrong_user", password="x"))
    assert "1.2.3.4" in web_server._login_attempts
    assert "9.9.9.9" not in web_server._login_attempts    # 代理閘道 IP 未被鎖
    web_server._login_attempts.pop("1.2.3.4", None)

    # 無 XFF → 降級 client.host
    web_server._login_attempts.pop("5.5.5.5", None)
    asyncio.run(web_server.login(_FakeReq(xff=None, client_host="5.5.5.5"), username="wrong_user", password="x"))
    assert "5.5.5.5" in web_server._login_attempts
    web_server._login_attempts.pop("5.5.5.5", None)


# ── C3（U3 Lazy Load + LRU）──

def test_lru_vector_store_eviction(monkeypatch):
    """U3：vector_stores 超過上限 5 時 LRU 淘汰最久未使用；命中 move_to_end 保活躍。"""
    import rag_retriever

    monkeypatch.setattr(rag_retriever, "RAG_MAX_CACHE", 5)
    r = rag_retriever.RagRetriever()
    # mock 實際 FAISS 載入 → 回非 None 哨兵（避免真實磁碟/embedding 依賴）
    monkeypatch.setattr(r, "load_vector_store", lambda p: object())

    for i in range(6):
        r.add_paper(1, f"p{i}", f"/fake/vec{i}")

    assert len(r.vector_stores) == 5            # 上限 5
    assert (1, "p0") not in r.vector_stores     # 最久未使用 p0 被淘汰
    assert (1, "p5") in r.vector_stores
    # paper_vector_paths 全保留（供惰性重載，淘汰不丟路徑）
    assert (1, "p0") in r.paper_vector_paths

    # LRU 序：觸碰 p1（命中 move_to_end）後再加 p6 → 應淘汰 p2（非剛觸碰的 p1）
    assert r._get_vector_store(1, "p1") is not None
    r.add_paper(1, "p6", "/fake/vec6")
    assert (1, "p1") in r.vector_stores
    assert (1, "p2") not in r.vector_stores


def test_lru_evicted_vector_lazy_reloads(monkeypatch):
    """U3：被 LRU 淘汰的向量庫，下次存取經 paper_vector_paths 惰性重載（retrieve 不斷）。"""
    import rag_retriever

    monkeypatch.setattr(rag_retriever, "RAG_MAX_CACHE", 5)
    r = rag_retriever.RagRetriever()
    monkeypatch.setattr(r, "load_vector_store", lambda p: object())

    for i in range(6):
        r.add_paper(1, f"p{i}", f"/fake/vec{i}")
    assert (1, "p0") not in r.vector_stores      # 已淘汰
    # 再次取 p0 → 由 paper_vector_paths 惰性重載成功
    assert r._get_vector_store(1, "p0") is not None
    assert (1, "p0") in r.vector_stores


# ── C4（U1 Semaphore + U2 Nice）──

def test_concurrency_semaphore_queue(monkeypatch):
    """U1：信號量已滿時第二任務進 queued，前一任務釋放後自動啟動並完成。"""
    import web_server

    class _StubPipeline:
        def __init__(self, on_progress=None):
            pass

        def process(self, *a, **k):
            return {}

    monkeypatch.setattr(web_server, "PipelineCore", _StubPipeline)
    monkeypatch.setattr(web_server.paper_manager, "load_paper_resources", lambda *a, **k: None)
    monkeypatch.setattr(web_server, "PIPELINE_SEMAPHORE", asyncio.Semaphore(1))

    tk = (779001, "pq")

    async def scenario():
        with web_server.tasks_lock:
            web_server.processing_tasks[tk] = {"status": "processing", "progress": {}}
        # 佔用信號量（模擬任務 1 運行中）
        await web_server.PIPELINE_SEMAPHORE.acquire()
        # 任務 2 派發 → 應卡在信號量、狀態 queued
        t = asyncio.create_task(
            web_server.run_pipeline(779001, "pq", "/x.pdf", "academic", "x.pdf")
        )
        await asyncio.sleep(0.05)
        with web_server.tasks_lock:
            queued = web_server.processing_tasks[tk]["status"]
        # 釋放 → 任務 2 取得許可、自動啟動並完成
        web_server.PIPELINE_SEMAPHORE.release()
        await t
        with web_server.tasks_lock:
            final = web_server.processing_tasks[tk]["status"]
        web_server.processing_tasks.pop(tk, None)
        return queued, final

    queued, final = asyncio.run(scenario())
    assert queued == "queued"      # 排隊中
    assert final == "done"          # 釋放後自動完成


def test_subprocess_nice_soft_fail():
    """U2：子進程降優 helper 可呼叫且不拋（Windows 無 os.nice 時 soft-fail）。"""
    import processor.pdf_processor as pp

    pp._lower_subprocess_priority()  # 不應拋例外
    # POSIX 有 os.nice → preexec 為 callable；Windows 無 → None
    assert pp._NICE_PREEXEC is None or callable(pp._NICE_PREEXEC)


# ── C5（U7 結構化計時埋點 + CLI）──

def test_performance_metric_phase_keyed(caplog):
    """U7：Orchestrator 附加埋點——performance_metric 含 (phase,stage) 二維鍵、
    pipeline_finished 產 phases_breakdown（不含 P4）、P4 走獨立 rag_finished。"""
    import logging as _logging
    from pipelines import Orchestrator, PipelineContext, PipelineFactory
    from pipelines.base_strategy import DocumentStrategy
    from pipelines.contracts import (
        IngestionMetadataSpec, GlossaryReadySpec, BilingualMarkdownSpec, RagDbSpec,
    )

    class _Stub(DocumentStrategy):
        def run_phase1(self, ctx):
            return IngestionMetadataSpec(title="t", source_lang="en")
        def run_phase2(self, ctx):
            return GlossaryReadySpec(abstract="a", lcc="BF", glossary={}, translated_abstract="b")
        def run_phase3(self, ctx):
            return BilingualMarkdownSpec(final_zh_path="z", final_en_path="e", translated_abstract="b")
        def run_phase4(self, ctx):
            return RagDbSpec(vectors_path="v")

    snapshot = dict(PipelineFactory._registry)
    PipelineFactory._registry.clear()
    PipelineFactory._registry["academic"] = _Stub
    try:
        with caplog.at_level(_logging.INFO, logger="pipelines.orchestrator"):
            Orchestrator().run(PipelineContext(doc_type="academic", paper_id="pX"))
        events = [getattr(r, "extra_fields", {}) for r in caplog.records]
        events = [e for e in events if isinstance(e, dict) and e.get("event")]
        pm = [e for e in events if e["event"] == "performance_metric"]
        pf = [e for e in events if e["event"] == "pipeline_finished"]
        rf = [e for e in events if e["event"] == "rag_finished"]

        assert pm and all("phase" in e and "stage" in e for e in pm)   # 二維鍵
        assert {e["phase"] for e in pm} >= {"P1", "P2", "P3"}
        assert len(pf) == 1 and "phases_breakdown" in pf[0]
        assert "P4" not in pf[0]["phases_breakdown"]                   # 主鏈不含 P4
        assert len(rf) == 1 and rf[0]["phase"] == "P4" and "rag_status" in rf[0]  # P4 獨立
    finally:
        PipelineFactory._registry.clear()
        PipelineFactory._registry.update(snapshot)


def test_analyze_performance_cli(tmp_path):
    """U7：CLI 流式解析 JSON 日誌並聚合 (phase,stage) / doc_type / rag。"""
    import sys
    ROOT_ = Path(__file__).resolve().parents[1]
    sys.path.insert(0, str(ROOT_ / "scripts"))
    import analyze_performance as ap

    log = tmp_path / "pipeline.log"
    log.write_text("\n".join([
        '{"event":"performance_metric","phase":"P1","stage":"pdf2md","duration_seconds":1.0}',
        '{"event":"performance_metric","phase":"P1","stage":"pdf2md","duration_seconds":3.0}',
        '{"event":"pipeline_finished","doc_type":"academic","duration_seconds":5.0,"phases_breakdown":{"P1":{"pdf2md":2.0}}}',
        '{"event":"rag_finished","rag_status":"ready","duration_seconds":2.0}',
        "純文字 console 行（應被略過）",
    ]), encoding="utf-8")

    stage_d, doctype_t, rag_d = ap.parse_log(str(log))
    assert ("P1", "pdf2md") in stage_d and len(stage_d[("P1", "pdf2md")]) == 2
    n, mean, mx, sd = ap._stat_row(stage_d[("P1", "pdf2md")])
    assert n == 2 and mean == 2.0 and mx == 3.0
    assert "academic" in doctype_t and "ready" in rag_d
    # render 不拋例外
    report = ap.render_report(stage_d, doctype_t, rag_d)
    assert "效能剖析報表" in report
