    # 覆蓋 setup_logging() 配置的 root logger handlers（依評估報告 v4 §4.14）
    uvicorn.run(
        app,
        host="0.0.0.0",
        port=8080,
        reload=False,
        log_level="warning",
        access_log=False,
        log_config=None,
    )