"""PIPE-LITEDOC 測試（第 3 路 news/web/unknown）。

C2：策略分派——`get_strategy('litedoc'/'news'/'web')` 回 LiteDocPipeline、未知 doc_type
經 factory fallback 亦回 LiteDocPipeline。後續 C3-C7 追加 P1-P4 契約 + §7.2 key-changing 整合。
"""

import pytest

import pipelines  # 觸發 __init__ 註冊（litedoc_pipeline import）  # noqa: F401
from pipelines.factory import PipelineFactory
from pipelines.litedoc_pipeline import LiteDocPipeline


# ──────────────────────────────────────────────────────────────────────────
# C2：三 key 註冊 + unknown fallback 分派
# ──────────────────────────────────────────────────────────────────────────
@pytest.mark.parametrize("doc_type", ["litedoc", "news", "web"])
def test_litedoc_registered_keys_dispatch(doc_type):
    """litedoc / news / web 三 key 皆分派至 LiteDocPipeline。"""
    strat = PipelineFactory.get_strategy(doc_type)
    assert isinstance(strat, LiteDocPipeline)


def test_unknown_doc_type_falls_back_to_litedoc():
    """未知 doc_type → factory fallback（_FALLBACK_DOC_TYPE='litedoc'）→ LiteDocPipeline。"""
    strat = PipelineFactory.get_strategy("某種未註冊文體_xyz")
    assert isinstance(strat, LiteDocPipeline)


def test_litedoc_rag_char_threshold_is_10():
    """litedoc 為長篇散文型、RAG 門檻 ≥10（非 slides/resume ≥3）。"""
    assert LiteDocPipeline().rag_char_threshold == 10


# ──────────────────────────────────────────────────────────────────────────
# C3：P1 MinerU 攝入與 metadata 旁路（DocAnalyzer 映射 + URL publisher 解碼）
# ──────────────────────────────────────────────────────────────────────────
import json as _json
from pathlib import Path

import settings
from pipelines import litedoc_pipeline as lp
from pipelines.context import PipelineContext
from pipelines.contracts import IngestionMetadataSpec


def _setup_p1_mocks(monkeypatch, tmp_path, *, llm_json, capture=None):
    """patch 攝入 processor + LLM + 旗標；capture dict 記 DocAnalyzer 收到的 doc_type。"""
    md = tmp_path / "doc.md"

    class _FakePDF:
        def parse(self, pdf, outdir):
            md.write_text("# Sample Headline\n\nBody text here.", encoding="utf-8")
            return str(md)

    class _FakeCleaner:
        def clean(self, p):
            return p

    class _FakeAnalyzer:
        def analyze(self, p, doc_type):
            if capture is not None:
                capture["analyzer_doc_type"] = doc_type
            return p

    # === [PIPE-INGEST C2] Md/Json fake 移除——攝入組裝改走真 ingestion_engine（純函式、直跑）===
    class _FakeTiling:
        def process(self, a, b, doc_type=""):
            Path(b).write_text(
                _json.dumps({"sections": [
                    {"title": "Sample Headline",
                     "content": [{"type": "text", "content": "Body text here."}], "children": []}
                ]}), encoding="utf-8")
            return Path(b)

    class _FakeLLM:
        def chat(self, messages=None, **kw):
            return llm_json

    monkeypatch.setattr(lp, "PDFProcessor", _FakePDF)
    monkeypatch.setattr(lp, "MarkdownCleaner", _FakeCleaner)
    monkeypatch.setattr(lp, "DocAnalyzer", _FakeAnalyzer)
    monkeypatch.setattr(lp, "TilingProcessor", _FakeTiling)
    import llm.client
    monkeypatch.setattr(llm.client.LLMClient, "get_instance", classmethod(lambda cls: _FakeLLM()))
    monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path / "out")
    monkeypatch.setattr(settings, "LLM_USE_META_NORM", False)   # 飛輪關：normalize_fields 直回原樣


def _p1_ctx(tmp_path, doc_type="news", paper_id="p1"):
    pdf = tmp_path / "in.pdf"
    pdf.write_bytes(b"%PDF-1.4 fake")
    return PipelineContext(doc_type=doc_type, paper_id=paper_id, pdf_path=str(pdf), owner_id=1)


def test_p1_delivers_ingestion_spec(monkeypatch, tmp_path):
    """P1 交付 IngestionMetadataSpec：title/authors/venue（publisher）/source_lang/tiles。"""
    llm_json = _json.dumps({
        "title": "Big AI News", "authors": ["John Doe", "Jane Roe"],
        "date": "2026-06-19", "publisher": "CNN", "url": "https://cnn.com/x",
    })
    _setup_p1_mocks(monkeypatch, tmp_path, llm_json=llm_json)
    spec = LiteDocPipeline().run_phase1(_p1_ctx(tmp_path))
    assert isinstance(spec, IngestionMetadataSpec)
    assert spec.title == "Big AI News"
    assert spec.authors == ["John Doe", "Jane Roe"]
    assert spec.venue == "CNN"                       # publisher 承接 venue
    assert spec.source_lang == "en"
    assert len(spec.tiles) == 1


def test_p1_raw_metadata_sidechannel(monkeypatch, tmp_path):
    """date/url/organization 走 ctx.raw_metadata 旁路；publisher 亦入旁路（值 dict）。"""
    llm_json = _json.dumps({
        "title": "T", "authors": [], "date": "2026-06-19",
        "publisher": "Reuters", "url": "https://reuters.com/a",
    })
    _setup_p1_mocks(monkeypatch, tmp_path, llm_json=llm_json)
    ctx = _p1_ctx(tmp_path)
    LiteDocPipeline().run_phase1(ctx)
    assert ctx.raw_metadata["date"]["value"] == "2026-06-19"
    assert ctx.raw_metadata["url"]["value"] == "https://reuters.com/a"
    assert ctx.raw_metadata["publisher"]["value"] == "Reuters"


def test_p1_url_publisher_decode(monkeypatch, tmp_path):
    """URL→publisher 解碼：LLM 由 nytimes.com 解出 publisher（cover-prompt 指引），承接 venue。"""
    llm_json = _json.dumps({
        "title": "T", "authors": [], "date": "",
        "publisher": "The New York Times", "url": "https://nytimes.com/x",
    })
    _setup_p1_mocks(monkeypatch, tmp_path, llm_json=llm_json)
    spec = LiteDocPipeline().run_phase1(_p1_ctx(tmp_path))
    assert spec.venue == "The New York Times"


@pytest.mark.parametrize("doc_type,expected", [
    ("news", "news"), ("web", "web"), ("litedoc", "web"), ("某未知", "web"),
])
def test_p1_docanalyzer_mapping(monkeypatch, tmp_path, doc_type, expected):
    """U2.1：news/web 原樣傳 DocAnalyzer；litedoc/unknown → 'web' 扁平 prompt（防 fallback academic）。"""
    cap = {}
    _setup_p1_mocks(monkeypatch, tmp_path, llm_json='{"title":"T","authors":[]}', capture=cap)
    LiteDocPipeline().run_phase1(_p1_ctx(tmp_path, doc_type=doc_type))
    assert cap["analyzer_doc_type"] == expected


def test_p1_shadow_title_suffix(monkeypatch, tmp_path):
    """_shadow paper_id → title 綴 (測試)。"""
    _setup_p1_mocks(monkeypatch, tmp_path, llm_json='{"title":"News X","authors":[]}')
    spec = LiteDocPipeline().run_phase1(_p1_ctx(tmp_path, paper_id="p1_shadow"))
    assert spec.title == "News X (測試)"


# ──────────────────────────────────────────────────────────────────────────
# PIPE-INGEST C2：P1 攝入組裝切換 ingestion_engine
# ──────────────────────────────────────────────────────────────────────────
def _walk_tiles(sections, texts, figs):
    for s in sections:
        for it in s.get("content", []):
            if isinstance(it, dict):
                if it.get("type") == "text":
                    texts.append(str(it.get("content", "")))
                elif it.get("type") == "figure":
                    figs.append(it)
        _walk_tiles(s.get("children", []), texts, figs)


def test_p1_build_tiles_via_ingestion_engine(tmp_path):
    """C2：_build_tiles 走 ingestion_engine——meta 行分離不入 tiles、title 不入內文、
    figure 帶 content（真 TilingProcessor bypass 路徑、零 API）。"""
    md = tmp_path / "doc.md"
    md.write_text("\n".join([
        "# Doc Title",                    # 0 title
        "",                               # 1
        "Epigraph line stays in body.",   # 2 intro（非 meta、夾於 meta 塊之間）
        "",                               # 3
        "BYLINE AUTHOR ONE",              # 4 authors
        "",                               # 5
        "PUB HOUSE NEWS",                 # 6 publication_info
        "",                               # 7
        "## Alpha",                       # 8
        "Alpha body.",                    # 9
        "![a](images/x.jpg)",             # 10
    ]), encoding="utf-8")
    (tmp_path / "doc_doc_structure.json").write_text(_json.dumps({
        "structure": [
            {"start": 0, "end": 0, "type": "title"},
            {"start": 4, "end": 4, "type": "authors"},
            {"start": 6, "end": 6, "type": "publication_info"},
        ]
    }), encoding="utf-8")
    out = tmp_path / "out"
    out.mkdir()
    tiles = LiteDocPipeline()._build_tiles(md, out, "doc", "news")
    texts, figs = [], []
    _walk_tiles(tiles, texts, figs)
    body = "\n".join(texts)
    # meta 行（authors/publication_info 判型、非連續）不入 tiles
    assert "BYLINE AUTHOR ONE" not in body
    assert "PUB HOUSE NEWS" not in body
    # 文件標題不入內文；非 meta 行（epigraph）保留
    assert "Doc Title" not in body
    assert "Epigraph line stays in body." in body
    # figure 帶可重建 content（缺陷② 全鏈）
    assert figs and figs[0].get("content") == "![a](images/x.jpg)"
    # processed 相容檔產出、_structured.json 不再產
    assert (out / "doc_processed.json").exists()
    assert not (out / "doc_structured.json").exists()


def test_p1_build_tiles_soft_fail_without_structure(tmp_path):
    """C2：doc_structure sidecar 缺失 → soft 退化（無 meta 分離、不阻斷、body 全保留）。"""
    md = tmp_path / "doc.md"
    md.write_text("# T\n\nBYLINE X\n\n## S\nBody.", encoding="utf-8")
    out = tmp_path / "out"
    out.mkdir()
    tiles = LiteDocPipeline()._build_tiles(md, out, "doc", "news")
    texts, figs = [], []
    _walk_tiles(tiles, texts, figs)
    body = "\n".join(texts)
    assert "BYLINE X" in body       # 無判型 → 不分離（回現況行為）
    assert "Body." in body


def test_p1_borrowed_chain_retired():
    """C2：A 軌組裝借用鏈於 litedoc 退場（模組層零 import、引擎已接線）。"""
    import inspect
    src = inspect.getsource(lp)
    assert "MarkdownProcessor" not in src
    assert "JsonProcessor" not in src
    assert "ingestion_engine" in src


# ──────────────────────────────────────────────────────────────────────────
# IMG-FILTER C3：litedoc 報頭預掃接線
# ──────────────────────────────────────────────────────────────────────────
_HDR_MD = "\n".join([
    "# Doc Title",                    # 0  title
    "",                               # 1
    "![](images/hdr1.jpg)",           # 2  報頭區圖（判型行界內）
    "",                               # 3
    "BYLINE",                         # 4  authors
    "![](images/hdr2.jpg)",           # 5  報頭區圖
    "",                               # 6
    "Intro line.",                    # 7
    "![](images/hero.jpg)",           # 8  行界外（Hero、不得入 header_srcs）
    "## S",                           # 9
    "Body.",                          # 10
])
_HDR_STRUCT = {"structure": [
    {"start": 0, "end": 0, "type": "title"},
    {"start": 4, "end": 4, "type": "authors"},
    {"start": 2, "end": 5, "type": "other"},   # 行界 max(end)=5
]}


def test_collect_header_srcs_line_boundary():
    """C3：行界（max end=5）內圖入 header_srcs、行界外 Hero 圖不入（plan §2.6 收窄）。"""
    srcs = LiteDocPipeline._collect_header_srcs(_HDR_MD, _HDR_STRUCT)
    assert srcs == {"images/hdr1.jpg", "images/hdr2.jpg"}
    assert "images/hero.jpg" not in srcs


def test_collect_header_srcs_soft_fallbacks():
    """C3：sidecar 缺失／格式異常 → ∅（規則③停用、①②照跑）。"""
    assert LiteDocPipeline._collect_header_srcs(_HDR_MD, None) == set()
    assert LiteDocPipeline._collect_header_srcs(_HDR_MD, {}) == set()
    assert LiteDocPipeline._collect_header_srcs(
        _HDR_MD, {"structure": [{"type": "authors"}]}) == set()   # 缺 end


def test_build_tiles_filter_disabled_none_regression(monkeypatch, tmp_path):
    """C3：IMG_FILTER_ENABLED=False → assemble 收 figure_filter=None（零過濾回歸）。"""
    monkeypatch.setattr(settings, "IMG_FILTER_ENABLED", False)
    md = tmp_path / "doc.md"
    md.write_text(_HDR_MD, encoding="utf-8")
    (tmp_path / "doc_doc_structure.json").write_text(
        _json.dumps(_HDR_STRUCT), encoding="utf-8")
    out = tmp_path / "out"
    out.mkdir()
    captured = {}
    import pipelines.ingestion_engine as ie_mod
    real_assemble = ie_mod.assemble

    def _spy(md_text, structure=None, **kw):
        captured["figure_filter"] = kw.get("figure_filter", "missing")
        return real_assemble(md_text, structure, **kw)

    monkeypatch.setattr(lp.ingestion_engine, "assemble", _spy)
    tiles = LiteDocPipeline()._build_tiles(md, out, "doc", "news")
    assert captured["figure_filter"] is None      # 開關關 → None、行為零變
    texts, figs = [], []
    _walk_tiles(tiles, texts, figs)
    # 全保留 3 張（hdr1/hdr2 判型 "other" 不在 meta_types、留 body；hero 行界外）
    assert len(figs) == 3


# ──────────────────────────────────────────────────────────────────────────
# C4：P2 六步（消費 section_engine + 三真理源）
# ──────────────────────────────────────────────────────────────────────────
from pipelines.contracts import GlossaryReadySpec, IngestionMetadataSpec as _Ing


class _FakeP2LLM:
    """chat：節點摘要回 `[i] 摘要i`；全文摘要回固定句。"""
    def chat(self, messages=None, **kw):
        import re
        user = (messages or [{}])[-1].get("content", "")
        idxs = sorted({int(m) for m in re.findall(r"\[(\d+)\]", user)})
        if idxs:                                  # 節點摘要批次
            return "\n".join(f"[{i}] 摘要{i}" for i in idxs)
        return "全文摘要句"                        # _make_summary


def _setup_p2_mocks(monkeypatch, tmp_path, tiles):
    monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path / "out")
    monkeypatch.setattr(settings, "LLM_USE_GLOSSARY_ALIGN", False)   # glossary skip（預設路）
    # normalize_to_lcc / Translator / domain_name patch（隔離三真理源 LLM/DB）
    monkeypatch.setattr(lp, "normalize_to_lcc", lambda raw, context_text=None: "general")

    class _FakeTr:
        def __init__(self, *a, **k): pass
        def translate(self, text, ctx, mode, text_type="content"):
            return f"譯：{text}"

    monkeypatch.setattr(lp, "Translator", _FakeTr)
    monkeypatch.setattr(LiteDocPipeline, "_resolve_domain_name", lambda self, lcc: "News")
    monkeypatch.setattr(LiteDocPipeline, "_read_source_text", lambda self, ctx: "EN FULL TEXT")
    import llm.client
    monkeypatch.setattr(llm.client.LLMClient, "get_instance", classmethod(lambda cls: _FakeP2LLM()))


def _p2_ctx(tiles, source_lang="en", doc_type="news"):
    ctx = PipelineContext(doc_type=doc_type, paper_id="p2", pdf_path="/x/in.pdf", owner_id=1)
    ctx.ingestion = _Ing(title="Headline", source_lang=source_lang, tiles=tiles)
    ctx.raw_metadata = {}
    return ctx


def _tiles_2():
    def _s(t, c):
        return {"title": t, "content": [{"type": "text", "content": c}], "children": []}
    return [_s("Intro", "intro body"), _s("Detail", "detail body")]


def test_p2_delivers_glossary_ready_spec(monkeypatch, tmp_path):
    """P2 交付 GlossaryReadySpec：abstract / lcc / translated_abstract / domain_name。"""
    _setup_p2_mocks(monkeypatch, tmp_path, _tiles_2())
    spec = LiteDocPipeline().run_phase2(_p2_ctx(_tiles_2()))
    assert isinstance(spec, GlossaryReadySpec)
    assert spec.abstract == "全文摘要句"
    assert spec.lcc == "general"
    assert spec.translated_abstract == "譯：全文摘要句"
    assert spec.domain_name == "News"


def test_p2_section_summaries_key_is_original_title_path(monkeypatch, tmp_path):
    """⑥ section_summaries key 完全對齊**原文標題 path**（接縫基準、繼承 section_engine）。"""
    _setup_p2_mocks(monkeypatch, tmp_path, _tiles_2())
    spec = LiteDocPipeline().run_phase2(_p2_ctx(_tiles_2(), source_lang="en"))
    assert isinstance(spec.section_summaries, dict)
    assert set(spec.section_summaries.keys()) == {"Intro", "Detail"}   # 原文標題 path
    assert all(v.startswith("摘要") for v in spec.section_summaries.values())


# === [GLOSSARY-TERMMAP C2 START] P2 glossary 段收斂 build_termmap ===
def test_p2_glossary_flag_on_calls_build_termmap(monkeypatch, tmp_path):
    """C2：旗標開 → P2 glossary 段走共用 build_termmap（傳 full_text＋摘要對、廢 _heal 早退鏈）。"""
    _setup_p2_mocks(monkeypatch, tmp_path, _tiles_2())
    monkeypatch.setattr(settings, "LLM_USE_GLOSSARY_ALIGN", True)
    captured = {}

    class _FakeGM:
        def build_termmap(self, full_text, abstract, translated_abstract,
                          source_lang, target_lang, domain, **kw):
            captured.update(full_text=full_text, abstract=abstract,
                            translated=translated_abstract,
                            source_lang=source_lang, target_lang=target_lang,
                            domain=domain)
            return {"spacex": "SpaceX"}

    monkeypatch.setattr(lp, "GlossaryManager", _FakeGM)
    spec = LiteDocPipeline().run_phase2(_p2_ctx(_tiles_2()))
    assert spec.glossary == {"spacex": "SpaceX"}          # 定案表入交付合約
    assert captured["full_text"] == "EN FULL TEXT"        # census 吃全文（非僅摘要）
    assert captured["abstract"] == "全文摘要句"
    assert captured["translated"] == "譯：全文摘要句"
    assert captured["domain"] == "general"


def test_p2_heal_glossary_no_early_return_source(monkeypatch, tmp_path):
    """C2：litedoc 模組層早退鏈已廢（`if existing` 靜態掃描歸零、委派單一實作源）。"""
    import inspect
    src = inspect.getsource(lp)
    assert "if existing" not in src
    assert "build_termmap" in src
