# === [GLOSSARY-TERMMAP C4 START] P3 摘要型滑窗注入 ===
class _CtxCapTr4:
    """記錄每單元 InjectionContext 的確定性翻譯器（滑窗斷言用）。"""
    def __init__(self):
        self.ctx_by_text = {}
    def translate(self, text, ctx, mode, text_type="content"):
        self.ctx_by_text[text] = ctx
        return f"ZH::{text}"


def _p3_ctx_with_summaries(tiles, summaries, title="Headline"):
    ctx = _p3_ctx(tiles, title=title)
    ctx.glossary_ready = _GR(
        abstract="a", lcc="general", glossary={}, translated_abstract="譯摘要",
        section_summaries=summaries, domain_name="News",
    )
    return ctx


def test_p3_sliding_window_injects_prev_neighbor_summary(monkeypatch, tmp_path):
    """C4：section 模式滑窗——後段單元收到前一鄰近 section 繁中摘要（zh_summary 合併＋preceding）。"""
    _setup_p3_mocks(monkeypatch, tmp_path, "x" * 16000)
    cap = _CtxCapTr4()
    monkeypatch.setattr(lp, "Translator", lambda *a, **k: cap)
    ctx = _p3_ctx_with_summaries(_tiles_p3(), {"Sec1": "摘一", "Sec2": "摘二"})
    LiteDocPipeline().run_phase3(ctx)
    # Sec1（首段）：無前鄰 → 共用 inj（零滑窗）
    c1 = cap.ctx_by_text["body one"]
    assert c1.preceding is None
    assert c1.zh_summary == "譯摘要"
    # Sec2：前鄰＝Sec1 摘要 → preceding 攜帶 + zh_summary 合併浮出（translator 注入路徑）
    c2 = cap.ctx_by_text["body two"]
    assert c2.preceding == "摘一"
    assert "譯摘要" in c2.zh_summary and "鄰近前段摘要參考：摘一" in c2.zh_summary
    # 嚴禁譯文型 preceding：注入內容為 P2 摘要、非任何 slot 譯文
    assert not str(c2.preceding).startswith("ZH::")


def test_p3_sliding_window_gap_tolerant_and_empty_fallback(monkeypatch, tmp_path):
    """C4 容缺：summaries 缺 key → 該段沿用共用 inj；summaries 空 → factory 不啟用（行為零變）。"""
    _setup_p3_mocks(monkeypatch, tmp_path, "x" * 16000)
    cap = _CtxCapTr4()
    monkeypatch.setattr(lp, "Translator", lambda *a, **k: cap)
    # 缺 Sec1 摘要（前鄰摘要缺席）→ Sec2 無可注入、沿用共用 inj
    ctx = _p3_ctx_with_summaries(_tiles_p3(), {"Sec2": "摘二"})
    LiteDocPipeline().run_phase3(ctx)
    assert cap.ctx_by_text["body two"].preceding is None
    # summaries 空 → factory 回 None（引擎預設路、全段共用 inj）
    cap2 = _CtxCapTr4()
    monkeypatch.setattr(lp, "Translator", lambda *a, **k: cap2)
    ctx2 = _p3_ctx_with_summaries(_tiles_p3(), None)
    LiteDocPipeline().run_phase3(ctx2)
    assert all(c.preceding is None for c in cap2.ctx_by_text.values())


def test_p3_size_gate_branches_untouched_by_window(monkeypatch, tmp_path):
    """C4 回歸：whole／is_zh 分支零滑窗（size-gate 三分支結構零動）。"""
    _setup_p3_mocks(monkeypatch, tmp_path, "short")
    cap = _CtxCapTr4()
    monkeypatch.setattr(lp, "Translator", lambda *a, **k: cap)
    ctx = _p3_ctx_with_summaries(_tiles_p3(), {"Sec1": "摘一", "Sec2": "摘二"})
    LiteDocPipeline().run_phase3(ctx)                # <15k → whole 模式
    assert all(c.preceding is None for c in cap.ctx_by_text.values())
