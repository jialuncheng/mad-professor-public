"""SlidePipeline —— 簡報（slides）策略管線（PIPE 縱向五路絞殺第 2 路、PIPE-SLIDES）。

`@PipelineFactory.register('slides')` 註冊；主幹（Orchestrator）零 doc_type 分支、
僅透過 DocumentStrategy 四方法合約呼叫本策略。

四 Phase 規格（PIPE-SLIDES plan v1〔v1.1〕U1-U11；後續 commit 逐步落地）：
- P1 Ingestion（C2）：每頁整頁存圖（fitz get_pixmap、自建不耦合 A 軌 slides_processor）
  + Vision 忠實轉錄（SPEC §1.3.1：LLM_VISION_TEMPERATURE=0）+ 條件式滾動（預設關）
  + 封面判定（title fallback 檔名、簡報欄走 ctx.raw_metadata 旁路）+ 跨頁統計去重（排除封面）。
- P2 Glossary & Context Prep（C3）：統一六步（section=頁；① 順產 raw_domain、
  ② 順產缺失頁標題；key＝p{頁序}_{原文頁標題}——三方同基準、根除重複標題覆蓋）。
- P3 Translation & Restore（C4）：逐頁並行翻譯（RESUME-PERF-1 範式）+ 圖片 alt 對齊
  （雙 Caption 物理根除、MD-RESTORE slides 部分）+ ctx.rag_sections 旁路 + zh 來源 path
  + 退化 fallback；不渲染 meta header。
- P4 Async RAG（C5）：rag_indexer 共用真理源（四產物、零 A 軌依賴）。

C1（本檔現階段）僅交付：註冊 + 四方法合約 stub + rag_char_threshold=3（U11、
保 'SiC'/'THD' 級短關鍵詞）。strict 合約：未落地 Phase 拋 NotImplementedError、
由 Orchestrator 對齊 NullStrategy 行為攔截（影子 B 軌、線上 0 風險）。
"""
import json
import logging
import re
from pathlib import Path

from pipelines.base_strategy import DocumentStrategy
from pipelines.context import PipelineContext
from pipelines.contracts import (
    BilingualMarkdownSpec,
    GlossaryReadySpec,
    IngestionMetadataSpec,
    RagDbSpec,
)
from pipelines.factory import PipelineFactory

logger = logging.getLogger(__name__)

# === [PIPE-SLIDES C2 START] P1 常數 ===
# source_lang 啟發式門檻（鏡像 resume：CJK 顯著佔比 → 原文判為中文）。
_CJK_MIN = 20
_CJK_RATIO = 0.2
# Q2 跨頁統計去重：短行（≤20 字）出現於 ≥60% 非封面頁 → 判頁眉頁腳剔除。
_DEDUPE_MAX_LEN = 20
_DEDUPE_PAGE_RATIO = 0.6
# === [PIPE-SLIDES-HOTFIX-2 HOTFIX-2 E START] === 母片日期頁眉：整行僅日期（格式寬鬆）
_DATE_LINE_RE = re.compile(r"^\s*\d{1,4}\s*[/\-.]\s*\d{1,2}\s*[/\-.]\s*\d{1,4}\s*$")
# === [PIPE-SLIDES-HOTFIX-2 HOTFIX-2 E END] ===
# Q1 條件式滾動觸發：頁標題含延續標記、或前頁表格截斷（前頁尾/當頁首皆為 '|' 行）。
_ROLLING_MARKERS = ("(續)", "（續）", "cont'd", "continued")

# Vision 忠實轉錄 prompt（SPEC §1.3.1 鐵律 + U9 cell 禁標題語法）。
_VISION_PROMPT = """你是簡報忠實轉錄器。請將這一頁簡報的內容忠實轉錄為 JSON，嚴格遵守：
1. 嚴禁重組、摘要、補完或改寫——只忠實轉錄頁面上實際出現的文字與結構。
2. markdown_content 用 markdown 保留階層/條列/表格；表格儲存格（cell）內嚴禁使用 ### 等標題語法。
3. 圖表/示意圖/照片：用一兩句話描述放 figure_description 欄，嚴禁混入 markdown_content。
4. 頁面有明確標題放 title；沒有就空字串。
# === [PIPE-SLIDES-HOTFIX-4 HOTFIX-4 START] ===（HOTFIX-5 釐清第 5 條：過場/分隔頁納入 is_blank=true）
5. is_blank：若整頁**無任何實質教學內容** → is_blank=true；否則 false。涵蓋：
   (a) 空白頁、僅裝飾性橫條/分隔線/純背景/頁碼；
   (b) 純過場/章節分隔/裝飾頁（僅一張裝飾圖、或僅「過場/Transition/Section」之類字樣，無條列正文與實質資料）
       —— **即使你判讀出『過場投影片』之類標題，這類頁仍 is_blank=true**。
   **含真實圖表/照片/示意圖/資料/條列正文之頁一律 is_blank=false**（勿把有資訊的圖表頁誤判為過場）。
只輸出 JSON：
{"title": "", "subtitle": "", "markdown_content": "", "figure_description": "", "is_blank": true|false}
# === [PIPE-SLIDES-HOTFIX-4 HOTFIX-4 END] ===
其中 title 放頁面**大標題**、subtitle 放緊接其下的**次級小標題**（如有；無則空字串）；
正文（條列/段落/表格）一律放 markdown_content、不要把小標題塞進正文。"""

# 第 1 頁追加封面判定欄（U2）。
# === [META-NORM C3 START] === 封面 prompt 改開放抽取 + 判定放寬（容主視覺圖之學術封面·U6）
_COVER_PROMPT = _VISION_PROMPT + """
此外這是文件第一頁，請追加判定它是否為「封面頁」（標題頁：大標題 + 作者/課程/機構/日期等
識別資訊；**即使含一張主視覺圖或示意圖、只要具備上述標題頁特徵仍判為封面**）：
{"title": "", "markdown_content": "", "figure_description": "", "is_cover": true|false,
 "cover": {"title": "", "company": "", "date": "", "authors": [],
           "metadata": {"欄名": "值"}}}
其中 cover.metadata 為**開放式鍵值對**：請自由列出你在封面上識別到的所有額外 metadata
（如 課程/課程代碼、講師、機構、發表期刊、DOI、日期、版本等；欄名可中可英、依封面實際標示）。
company/date/authors 維持既有欄位填寫（向後相容）；無對應則留空。非封面時 is_cover=false 且各欄空。"""
# === [META-NORM C3 END] ===
# === [PIPE-SLIDES C2 END] ===

# === [PIPE-SLIDES C3 START] P2 六步常數 ===
_TARGET_LANG = "zh-tw"
_ABSTRACT_MAX_CHARS = 8000
_ABSTRACT_FALLBACK_CHARS = 600

# ① 全文摘要 + 同呼叫順產 raw_domain（plan U5 ①、零增量 LLM）。
_SUMMARY_DOMAIN_PROMPT = (
    "你是簡報摘要器。請用原文語言為整份簡報寫 3-5 句摘要（忠於內容、不臆測）。\n"
    "最後另起一行、以「domain: 」開頭，用 2-5 個英文字標註此簡報的專業領域"
    "（如 domain: Power Electronics）。"
)
# ②⑤ 批次每頁摘要 + 對無標題頁順產標題（1 次 LLM、plan U5 ②）。
_PAGE_SUMMARY_PROMPT = (
    "你是簡報頁摘要器。以下是各頁內容（[i] 起頭）。對每一頁：\n"
    "1. 用原文語言寫一句摘要（summary）。\n"
    "2. 該頁若無標題（title 為空），依內容補一個簡短原文標題；有標題則原樣回填。\n"
    "只輸出 JSON 陣列：[{\"i\": 1, \"title\": \"...\", \"summary\": \"...\"}, ...]"
)
# ⑥ 全文摘要引導、批次翻頁摘要為繁中（1 次 LLM、plan U5 ⑥）。
_PAGE_TRANSLATE_PROMPT = (
    "將以下各行頁摘要翻譯為繁體中文（台灣用語），逐行對應、行首保留「i. 」編號、"
    "只輸出翻譯後的編號行。\n全文摘要（風格與術語引導）：\n{abstract}\n\n{lines}"
)
# === [PIPE-SLIDES C3 END] ===

# === [PIPE-SLIDES C4 START] P3 常數 ===
# Q4 slides 翻譯約束（規則由策略擁有、引擎共用執行——SPEC §1.2.3.1）。
_SLIDE_CONSTRAINTS = [
    "品牌名與產品名一律保留原文、不翻譯。",
    "專業術語首次出現採中英並列：中文 (English)。",
    "表格儲存格（cell）內嚴禁使用 ### 等標題語法。",
    "數字、單位、型號維持原樣。",
]
# Q5 退化 fallback：頁數 ≤1、或內容為空的頁佔比 > 50% → 整檔單發兜底。
_FALLBACK_EMPTY_RATIO = 0.5
# === [PIPE-SLIDES C4 END] ===


@PipelineFactory.register('slides')
class SlidePipeline(DocumentStrategy):
    """簡報策略：Vision 每頁解析、逐頁翻譯、頁級 RAG。"""

    # U11：Vision 短文檔門檻放寬（保 'SiC'/'THD'/'LLC' 級短技術詞；資料庫 SOP ≥3 先例同 resume）
    rag_char_threshold: int = 3

    # === [PIPE-SLIDES C2 START] P1 Vision Ingestion（U1-U4）===
    def run_phase1(self, ctx: PipelineContext) -> IngestionMetadataSpec:
        """P1 Ingestion：每頁存圖 + Vision 轉錄（temp=0、條件滾動）+ 封面判定 + 統計去重。

        零 A 軌依賴（演算法參照 slides_processor 渲染/裁切/空白跳過、自建）；
        零衍生語境（無 Abstract/LCC/Glossary/翻譯/Embedding）。
        """
        import paper_manager
        import settings

        if not ctx.pdf_path:
            raise ValueError("SlidePipeline.run_phase1 需要 ctx.pdf_path")

        output_dir = Path(paper_manager.paper_dir(
            settings.OUTPUT_DIR, ctx.owner_id, ctx.paper_id))
        images_dir = output_dir / "images"
        images_dir.mkdir(parents=True, exist_ok=True)

        # ① 渲染（每頁/裁切單位 → jpeg bytes）
        page_images = self._render_pages(ctx.pdf_path)
        logger.info("[PIPE-SLIDES P1] %s 渲染 %d 個頁面單位", ctx.paper_id, len(page_images))

        # ② Vision 並行轉錄（Q1 預設關滾動 → 各單位獨立；第 1 單位帶封面判定）
        from concurrent.futures import ThreadPoolExecutor
        results: list = [None] * len(page_images)
        with ThreadPoolExecutor(max_workers=settings.LLM_MAX_CONCURRENT) as ex:
            futs = {
                ex.submit(self._transcribe_page, img, i == 0, None): i
                for i, img in enumerate(page_images)
            }
            for fut, i in futs.items():
                results[i] = fut.result()

        # ③ Q1 條件式滾動補救：偵測延續標記/表格截斷 → 該頁注入前頁重轉錄（序列、少量）
        for i in range(1, len(results)):
            if self._needs_rolling(results[i - 1], results[i]):
                prev_text = (results[i - 1] or {}).get("markdown_content", "")
                logger.info("[PIPE-SLIDES P1] 頁面單位 %d 觸發滾動重轉錄（注入前頁）", i + 1)
                results[i] = self._transcribe_page(page_images[i], False, prev_text)

        # ④ 空白單位跳過 + 存圖（僅保留單位、檔名=頁序）
        units = []
        for img, r in zip(page_images, results):
            if not r:
                continue
            # === [PIPE-SLIDES-HOTFIX-5 HOTFIX-5 START] === 放寬：is_blank 且「無條列正文」即跳
            #   真因：過場/分隔頁被 Vision 賦予標題（如「過場投影片」）→ HOTFIX-4「title 須空」不成立 → 漏網。
            #   改為僅看 markdown_content 空（容許 title/figure_description 非空，過場頁特徵＝裝飾圖+可能標題、無正文）。
            #   安全網：is_blank 但有 markdown_content 實質正文（自相矛盾）→ 不跳，防誤殺；
            #   真圖表/資料頁依 prompt is_blank=false → 第一項即不成立、不跳；舊 golden 無 is_blank → None falsy → 不跳。
            if r.get("is_blank") and not (r.get("markdown_content") or "").strip():
                continue
            # === [PIPE-SLIDES-HOTFIX-5 HOTFIX-5 END] ===
            if not (r.get("title") or r.get("markdown_content")
                    or r.get("figure_description")):
                continue  # 空白頁跳過（A 軌同款、既有三欄全空）
            n = len(units) + 1
            img_file = f"page-{n:02d}.jpg"
            (images_dir / img_file).write_bytes(img)
            units.append({
                "page": n,
                "title": (r.get("title") or "").strip(),
                # === [META-NORM C4] === 次級小標題（解 D；無則空字串）
                "subtitle": (r.get("subtitle") or "").strip(),
                # === [PIPE-SLIDES-HOTFIX-1 HOTFIX-1 F1] === 原文層去標題回聲（閱讀視圖/rag_sections/chunk 三處同淨）
                "content": self._strip_title_echo(
                    (r.get("title") or "").strip(),
                    (r.get("markdown_content") or "").strip()),
                "figure_description": (r.get("figure_description") or "").strip(),
                "image_file": f"images/{img_file}",
                "is_cover": bool(r.get("is_cover")) and n == 1,
            })

        # ⑤ U2 封面判定 → title / raw_metadata 旁路；非封面 → title fallback 檔名
        title = Path(ctx.pdf_path).stem
        authors: list = []
        # === [META-NORM C3 START] === 凍結合約欄（venue/doi）由 reserved 回填、預設 None
        venue = None
        doi = None
        # === [META-NORM C3 END] ===
        if units and units[0]["is_cover"]:
            cover = (results[0] or {}).get("cover") or {}
            if (cover.get("title") or "").strip():
                title = cover["title"].strip()
            authors = [a for a in (cover.get("authors") or []) if isinstance(a, str) and a.strip()]
            # === [META-NORM C3 START] === 開放抽取 + 自癒飛輪對齊（旗標 on）；off 退寫死路徑
            import settings
            if settings.LLM_USE_META_NORM:
                from processor import meta_normalizer
                raw_meta = dict(cover.get("metadata") or {})
                # 既有 company/date 併入開放抽取池（飛輪統一收斂、避免漏抓）
                for k, src in (("company", cover.get("company")), ("date", cover.get("date"))):
                    if (src or "").strip() and k not in raw_meta:
                        raw_meta[k] = src.strip()
                normalized = meta_normalizer.normalize_fields(raw_meta, context=title)
                # reserved 回填凍結合約（不入旁路·U7.1/BS1）
                _RP = "__reserved__:"
                rt = normalized.pop(f"{_RP}title", None)
                if (rt or "").strip():
                    title = rt.strip()
                ra = normalized.pop(f"{_RP}authors", None)
                if ra:
                    authors = ra if isinstance(ra, list) else re.split(r"[,;，；\n]+", ra)
                    authors = [a.strip() for a in authors if a and a.strip()]
                venue = (normalized.pop(f"{_RP}venue", None) or "").strip() or None
                doi = (normalized.pop(f"{_RP}doi", None) or "").strip() or None
                # 其餘 canonical 欄 → 三欄 dict 旁路（HOTFIX-1b 契約·U7）
                for ckey, cval in normalized.items():
                    if (cval or "").strip():
                        ctx.raw_metadata[ckey] = {
                            "value": cval.strip(), "source": "meta_normalizer",
                            "confidence": "high"}
            else:
                # 旗標 off：原寫死路徑（向後相容）
                ctx.raw_metadata.update({
                    k: v for k, v in (
                        ("company", (cover.get("company") or "").strip()),
                        ("date", (cover.get("date") or "").strip()),
                    ) if v
                })
            # === [META-NORM C3 END] ===
        else:
            logger.info("[PIPE-SLIDES P1] %s 無封面、title fallback 檔名", ctx.paper_id)

        # ⑥ U3 跨頁統計去重（排除封面）
        self._dedupe_headers(units)
        # === [PIPE-SLIDES-HOTFIX-2 HOTFIX-2 E] === 母片日期頁眉洗除（補統計去重格式變異漏網）
        self._strip_master_date(units)

        # ⑦ source_lang 啟發式（鏡像 resume）+ 影子標題後綴
        all_text = "\n".join(u["content"] for u in units)
        source_lang = self._detect_source_lang(all_text)
        if ctx.paper_id.endswith("_shadow"):
            title = f"{title} (測試)"

        logger.info(
            "[PIPE-SLIDES P1] %s title=%r source_lang=%s units=%d cover=%s",
            ctx.paper_id, title, source_lang, len(units),
            bool(units and units[0]["is_cover"]),
        )
        return IngestionMetadataSpec(
            title=title, authors=authors, source_lang=source_lang, tiles=units,
            # === [META-NORM C3] === reserved 回填之 venue/doi（旗標 off 時為 None、向後相容）
            venue=venue, doi=doi,
        )

    # ── P1 私有群 ──
    @staticmethod
    def _render_pages(pdf_path: str) -> list:
        """fitz 逐頁渲染 jpeg bytes（2x、直向 A4 上下裁半、橫向整頁——參照 A 軌、自建）。"""
        import fitz  # 惰性 import
        out = []
        with fitz.open(pdf_path) as doc:
            for page in doc:
                rect = page.rect
                mat = fitz.Matrix(2.0, 2.0)
                if rect.width < rect.height * 0.8:   # 直向 → 上下裁半
                    mid = rect.height / 2
                    clips = [fitz.Rect(0, 0, rect.width, mid),
                             fitz.Rect(0, mid, rect.width, rect.height)]
                else:                                 # 橫向 → 整頁一張
                    clips = [rect]
                for clip in clips:
                    out.append(page.get_pixmap(matrix=mat, clip=clip).tobytes("jpeg"))
        return out

    @staticmethod
    def _transcribe_page(img_bytes: bytes, is_first: bool, prev_text) -> dict:
        """單頁 Vision 忠實轉錄（§1.3.1：temperature=LLM_VISION_TEMPERATURE）。

        prev_text 非 None ＝滾動模式（注入前頁內容保跨頁連貫）。解析失敗回 {}（該單位跳過）。
        """
        import settings
        from llm.client import LLMClient
        prompt = _COVER_PROMPT if is_first else _VISION_PROMPT
        if prev_text:
            prompt += f"\n\n（上一頁內容、僅供跨頁延續對齊、勿重複轉錄）：\n{prev_text[:2000]}"
        try:
            out = LLMClient.get_instance().chat_with_images(
                messages=[{"role": "user", "content": prompt}],
                images=[(img_bytes, "image/jpeg")],
                temperature=settings.LLM_VISION_TEMPERATURE,
            )
            m = re.search(r"\{.*\}", out or "", re.DOTALL)
            return json.loads(m.group(0)) if m else {}
        except Exception as e:  # 非致命：壞頁跳過、不阻整份
            logger.warning("[PIPE-SLIDES P1] Vision 轉錄失敗（單位跳過）: %s", e)
            return {}

    @staticmethod
    def _needs_rolling(prev: dict, cur: dict) -> bool:
        """Q1 滾動觸發：當頁標題含延續標記、或前頁尾/當頁首皆為表格列（截斷）。"""
        if not prev or not cur:
            return False
        title = (cur.get("title") or "").lower()
        if any(mk in title for mk in _ROLLING_MARKERS):
            return True
        prev_lines = [ln for ln in (prev.get("markdown_content") or "").splitlines() if ln.strip()]
        cur_lines = [ln for ln in (cur.get("markdown_content") or "").splitlines() if ln.strip()]
        return bool(prev_lines and cur_lines
                    and prev_lines[-1].lstrip().startswith("|")
                    and cur_lines[0].lstrip().startswith("|"))

    @staticmethod
    def _dedupe_headers(units: list) -> None:
        """Q2 跨頁統計去重：短行（≤_DEDUPE_MAX_LEN 字）出現於 ≥60% 非封面頁 → 全數剔除。

        統計與剔除均排除封面頁（封面公司名＝metadata 非雜訊）；剔除清單入 log 供審計。
        """
        body = [u for u in units if not u["is_cover"]]
        if len(body) < 3:   # 頁數過少、統計無意義
            return
        from collections import Counter
        counts = Counter()
        for u in body:
            seen = {ln.strip() for ln in u["content"].splitlines()
                    if ln.strip() and len(ln.strip()) <= _DEDUPE_MAX_LEN}
            counts.update(seen)
        noise = {ln for ln, c in counts.items() if c / len(body) >= _DEDUPE_PAGE_RATIO}
        if not noise:
            return
        logger.info("[PIPE-SLIDES P1] 統計去重剔除 %d 短行: %s", len(noise), sorted(noise))
        for u in body:
            u["content"] = "\n".join(
                ln for ln in u["content"].splitlines() if ln.strip() not in noise)

    # === [PIPE-SLIDES-HOTFIX-2 HOTFIX-2 E START] ===
    @staticmethod
    def _strip_master_date(units: list) -> None:
        """母片日期頁眉洗除（HOTFIX-2 E）：整行僅為日期、且出現於 ≥2 頁 → 母片日期欄位
        （投影片匯出 PDF 烙進每頁、非投影片內容）剔除。補 _dedupe_headers 之不足——
        日期 OCR 格式逐頁飄（4/28/2026 vs 2026/4/28 vs 4/28/26）、各變體 <60% 門檻全漏網；
        本法以「整行即日期」語意判定、不依賴格式一致。單頁日期（可能是真內容如時間軸）不洗、
        句中夾帶日期不動（只剔整行就是日期者）。剔除清單入 log。"""
        hit_pages = sum(
            1 for u in units
            if any(_DATE_LINE_RE.match(ln) for ln in u["content"].splitlines()))
        if hit_pages < 2:
            return
        removed = 0
        for u in units:
            lines = u["content"].splitlines()
            kept = [ln for ln in lines if not _DATE_LINE_RE.match(ln)]
            removed += len(lines) - len(kept)
            u["content"] = "\n".join(kept).strip()
        logger.info("[PIPE-SLIDES P1] 母片日期頁眉洗除 pages=%d lines=%d", hit_pages, removed)
    # === [PIPE-SLIDES-HOTFIX-2 HOTFIX-2 E END] ===

    @staticmethod
    def _detect_source_lang(text: str) -> str:
        """CJK 顯著佔比 → zh（鏡像 resume 啟發式）。"""
        cjk = len(re.findall(r"[一-鿿]", text or ""))
        total = len(re.findall(r"\S", text or "")) or 1
        return "zh" if (cjk >= _CJK_MIN and cjk / total >= _CJK_RATIO) else "en"

    # === [PIPE-SLIDES-HOTFIX-1 HOTFIX-1 F1 START] ===
    @staticmethod
    def _strip_title_echo(title: str, content: str) -> str:
        """P1 物理去標題回聲（HOTFIX-1 問題 1 選 C、原文層）。

        真因：Vision 忠實轉錄使頁大標題同時進 title 欄與 markdown_content 首行 →
        P3 兩欄各自獨立翻譯 → 同句雙譯相鄰渲染（實件 p1/p6×3/p8/p16 實證）。
        原文層比對（兩欄同源同字、遠比譯文層 fuzzy 穩）：正規化（去空白/標點/lower）
        後 content 開頭連續行 ≈ title 即剔除（cap 2 行、防 ×3 案例之副標重抄）。
        """
        if not title or not content:
            return content

        def _norm(s: str) -> str:
            return re.sub(r"[\s\W]+", "", s).lower()

        t = _norm(title)
        if not t:
            return content
        lines = content.splitlines()
        stripped = 0
        while lines and stripped < 2:
            first = lines[0].strip()
            if not first:
                lines.pop(0)
                continue
            f = _norm(re.sub(r"^#+\s*", "", first))
            if f and (f == t or (len(f) >= 6 and (f in t or t in f))):
                lines.pop(0)
                stripped += 1
            else:
                break
        return "\n".join(lines).strip()
    # === [PIPE-SLIDES-HOTFIX-1 HOTFIX-1 F1 END] ===

    # === [PIPE-SLIDES-HOTFIX-1 HOTFIX-1 F4 START] ===
    @staticmethod
    def _normalize_paragraph_breaks(text: str) -> str:
        """段落邊界正規化（pipe-table-safe 單 \\n → \\n\\n）。

        移植 resume PARA-HOTFIX-1 邏輯、pipelines/ 內私有重建（**不跨策略 import**）。
        真因：B 軌還原頁間/三塊間有 \\n\\n（C4）、但正文內部為 Vision 原樣裸單 \\n →
        CommonMark soft break 黏段（本實件多條列未顯症、純文字頁必發）。
        規則：一般行單 \\n 升級 \\n\\n；pipe table（| 開頭連續行）rows 間單 \\n 保留、
        進出 table 補空行邊界（否則 table 渲染破碎）。
        """
        if not text:
            return text
        lines = text.split("\n")
        out_lines = []
        in_table = False
        for line in lines:
            is_table_row = bool(re.match(r"^\s*\|", line))
            if is_table_row:
                if not in_table and out_lines and out_lines[-1].strip():
                    out_lines.append("")
                in_table = True
                out_lines.append(line)
            elif in_table:
                in_table = False
                if line.strip():
                    out_lines.append("")
                out_lines.append(line)
            else:
                out_lines.append(line)
        text = "\n".join(out_lines)
        # === [PIPE-SLIDES-HOTFIX-2 HOTFIX-2 F START] === 單 \n→\n\n 升級追加排除「下一行為條列行」
        # （修 HOTFIX-1 F4 把 tight list 炸成 loose list 之回歸：item 間插空行醜排；
        # 負向前瞻擴充 - / * / + / • / 數字. / 縮排子項 → 條列維持緊湊、段落仍正規化、table 不破）
        return re.sub(
            r"(?<!\|)(?<!\n)\n(?![\n\|]|\s*(?:[-*+•]|\d+[.、])\s|\s*-\s)", "\n\n", text)
        # === [PIPE-SLIDES-HOTFIX-2 HOTFIX-2 F END] ===
    # === [PIPE-SLIDES-HOTFIX-1 HOTFIX-1 F4 END] ===

    # === [PIPE-SLIDES-HOTFIX-2 HOTFIX-2 B START] ===
    @staticmethod
    def _safe_alt(text: str) -> str:
        """alt 文字轉義（HOTFIX-2 B）：CommonMark ![alt](url) 之 alt 內 ] [ ( ) 換行會破壞
        語法 → ① 破圖 ② 文字洩成正文（圖密集頁 figure_description 充滿括號最易中招）。
        中括號/括號轉全形（語意可讀不損）、換行與連續空白合併單空格。"""
        if not text:
            return text
        trans = str.maketrans({"[": "［", "]": "］", "(": "（", ")": "）"})
        return " ".join(text.translate(trans).split())
    # === [PIPE-SLIDES-HOTFIX-2 HOTFIX-2 B END] ===
    # === [PIPE-SLIDES C2 END] ===

    # === [PIPE-SLIDES C3 START] P2 統一六步（U5/U6）===
    def run_phase2(self, ctx: PipelineContext) -> GlossaryReadySpec:
        """P2 統一六步（section=頁）：

        ① 全文摘要（**同呼叫順產 raw_domain**、缺→"" 走 DomainNormalizer 內容判定/general）
        ② 批次每頁摘要（1 次 LLM；**無標題頁同呼叫順產標題**並回填 tiles）
           → key＝**p{頁序:02d}_{原文頁標題}**（頁序物理唯一、§4 接縫契約）
        ③ normalize_to_lcc(raw_domain, context=摘要)
        ④ Glossary 級聯自癒（旗標閘門；query_cascade→缺詞 extract_terms→upsert 冪等；LLM 交易外）
        ⑤ 翻全文摘要（DEEP_THINK、雙用：交付 + ④ 抽詞樣本——extract_terms 簽名所迫、同 resume 必然序）
        ⑥ 全文摘要引導批次翻頁摘要 → section_summaries（繁中）
        三安全鎖：批次有界（①②⑥ 各 1 次）/ 非致命（失敗留空不阻 reading_ready）/ 可量測（performance_metric phase=P2）。
        """
        import time

        import settings
        from processor.domain_normalizer import normalize_to_lcc
        from processor.translator import InjectionContext, TranslateMode, Translator

        t0 = time.perf_counter()
        source_lang = (ctx.ingestion.source_lang if ctx.ingestion else None) or "en"
        tiles = (ctx.ingestion.tiles if ctx.ingestion else []) or []
        full_text = "\n\n".join(
            "\n".join(x for x in (u.get("title"), u.get("content"),
                                  u.get("figure_description")) if x)
            for u in tiles
        )

        # ① 全文摘要 + 順產 raw_domain
        abstract, raw_domain = self._make_summary_and_domain(full_text)
        if not abstract:
            abstract = full_text[:_ABSTRACT_FALLBACK_CHARS]

        # ②/⑤ 批次每頁摘要 + 缺失標題順產回填 → 原文摘要 dict（key=p{N}_{標題}）
        raw_summaries = self._build_page_summaries(tiles)

        # ③ LCC（context=摘要——簡報屬性由內容定、plan 三缺口解）
        lcc = normalize_to_lcc(raw_domain, context_text=abstract) or "general"

        # ⑤ 翻全文摘要（DEEP_THINK、雙用）
        translator = Translator()
        translated_abstract = translator.translate(
            abstract, InjectionContext(lcc=lcc, glossary={}, doc_type="slides"),
            TranslateMode.DEEP_THINK, "abstract",
        )

        # ④ Glossary 級聯自癒（旗標閘門、LLM 交易外、upsert 冪等）
        glossary = {}
        if settings.LLM_USE_GLOSSARY_ALIGN:
            glossary = self._heal_glossary(
                source_lang, _TARGET_LANG, lcc, abstract, translated_abstract)

        # lcc → Domains.name（PK 唯讀免交易）
        domain_name = self._resolve_domain_name(lcc)

        # ⑥ 批次翻頁摘要 → section_summaries（繁中）
        section_summaries = self._translate_page_summaries(
            raw_summaries, abstract) if raw_summaries else {}

        logger.info(
            "[PIPE-SLIDES P2] %s lcc=%r raw_domain=%r glossary=%d "
            "abstract=%dchars section_summaries=%d",
            ctx.paper_id, lcc, raw_domain, len(glossary),
            len(abstract), len(section_summaries),
            extra={"extra_fields": {
                "event": "performance_metric", "phase": "P2", "stage": "six_step",
                "paper_id": ctx.paper_id,
                "duration_seconds": round(time.perf_counter() - t0, 4),
                "pages": len(tiles), "summaries": len(section_summaries),
            }},
        )
        return GlossaryReadySpec(
            abstract=abstract, lcc=lcc, glossary=glossary,
            translated_abstract=translated_abstract,
            section_summaries=section_summaries or None,
            domain_name=domain_name,
        )

    # ── P2 私有群 ──
    @staticmethod
    def page_key(page: int, title: str) -> str:
        """§4 接縫契約：key＝p{頁序:02d}_{原文頁標題}（P2 產／P3 帶／P4 取三方同此基準）。"""
        return f"p{page:02d}_{(title or '').strip()}"

    # === [META-NORM C4 START] ===
    @staticmethod
    def _key_title(u: dict) -> str:
        """page_key / section title 之標題來源：title 空但 subtitle 存在 → 用 subtitle
        （解 D：分隔頁僅次級小標題時防 key 漂移；頁序前綴仍保唯一）。"""
        return (u.get("title") or u.get("subtitle") or "").strip()
    # === [META-NORM C4 END] ===

    def _make_summary_and_domain(self, full_text: str):
        """① 1 次 LLM：全文摘要 + 末行 `domain:` 順產 raw_domain（缺→""、非致命）。"""
        import settings
        from llm.client import LLMClient
        try:
            out = LLMClient.get_instance().chat(
                messages=[{"role": "system", "content": _SUMMARY_DOMAIN_PROMPT},
                          {"role": "user", "content": full_text[:_ABSTRACT_MAX_CHARS]}],
                temperature=0.2, stream=False, model=settings.LLM_DOMAIN_MODEL,
            ) or ""
        except Exception as exc:  # noqa: BLE001 — 非致命（兜底原文截斷 + domain 空）
            logger.warning("[PIPE-SLIDES P2] 摘要生成失敗（兜底）: %s", exc, exc_info=True)
            return "", ""
        m = re.search(r"^domain:\s*(.+)$", out, re.MULTILINE | re.IGNORECASE)
        raw_domain = (m.group(1).strip() if m else "")
        abstract = re.sub(r"^domain:.*$", "", out, flags=re.MULTILINE | re.IGNORECASE).strip()
        return abstract, raw_domain

    def _build_page_summaries(self, tiles: list) -> dict:
        """②/⑤ 1 次批次 LLM：每頁原文摘要 + 無標題頁順產標題（回填 tiles）→ {key: 原文摘要}。

        非致命：失敗回 {}（section_summaries 留空、Strategy B 降級）；標題缺→p{N} 裸序 key 兜底。
        """
        import settings
        from llm.client import LLMClient
        if not tiles:
            return {}
        body = "\n\n".join(
            f"[{u['page']}] title={u.get('title') or ''}\n{(u.get('content') or '')[:800]}"
            for u in tiles
        )
        parsed = {}
        try:
            out = LLMClient.get_instance().chat(
                messages=[{"role": "system", "content": _PAGE_SUMMARY_PROMPT},
                          {"role": "user", "content": body}],
                temperature=0.2, stream=False, model=settings.LLM_DOMAIN_MODEL,
            ) or ""
            m = re.search(r"\[.*\]", out, re.DOTALL)
            for item in (json.loads(m.group(0)) if m else []):
                if isinstance(item, dict) and item.get("i"):
                    parsed[int(item["i"])] = item
        except Exception as exc:  # noqa: BLE001 — 非致命
            logger.warning("[PIPE-SLIDES P2] 頁摘要批次失敗（留空降級）: %s", exc, exc_info=True)
            return {}
        result = {}
        for u in tiles:
            item = parsed.get(u["page"]) or {}
            if not (u.get("title") or "").strip() and (item.get("title") or "").strip():
                u["title"] = item["title"].strip()   # 順產標題回填（P3/P4 同 key 基準）
            summary = (item.get("summary") or "").strip()
            if summary:
                # === [META-NORM C4] === title 空 fallback subtitle（防 key 漂移）
                result[self.page_key(u["page"], self._key_title(u))] = summary
        return result

    @staticmethod
    def _translate_page_summaries(raw: dict, abstract: str) -> dict:
        """⑥ 1 次批次翻繁中（全文摘要引導；逐行 `i. ` 對位；失敗留原文降級）。"""
        import settings
        from llm.client import LLMClient
        keys = list(raw.keys())
        lines = "\n".join(f"{i + 1}. {raw[k]}" for i, k in enumerate(keys))
        try:
            out = LLMClient.get_instance().chat(
                messages=[{"role": "user", "content": _PAGE_TRANSLATE_PROMPT.format(
                    abstract=(abstract or "")[:500], lines=lines)}],
                temperature=0.2, stream=False, model=settings.TRANSLATE_MODEL,
            ) or ""
        except Exception as exc:  # noqa: BLE001 — 非致命（留原文）
            logger.warning("[PIPE-SLIDES P2] 頁摘要翻譯失敗（留原文降級）: %s", exc, exc_info=True)
            return dict(raw)
        zh = {}
        for ln in out.splitlines():
            mm = re.match(r"\s*(\d+)[.、]\s*(.+)", ln)
            if mm and 1 <= int(mm.group(1)) <= len(keys):
                zh[keys[int(mm.group(1)) - 1]] = mm.group(2).strip()
        return {k: zh.get(k) or raw[k] for k in keys}

    @staticmethod
    def _heal_glossary(source_lang, target_lang, lcc, abstract, translated_abstract) -> dict:
        """④ Glossary 級聯查詢 + 缺詞自癒（鏡像 resume：LLM 交易外、upsert 冪等）。"""
        from processor.glossary_extractor import GlossaryManager
        gm = GlossaryManager()
        existing = gm.query_cascade(source_lang, target_lang, domain=lcc)
        if existing:
            return existing
        pairs = gm.extract_terms(
            abstract, translated_abstract, source_lang, target_lang, domain=lcc)
        if pairs:
            gm.upsert_terms(pairs, source_lang, target_lang, domain=lcc)
        return {k: v for k, v in pairs}

    @staticmethod
    def _resolve_domain_name(lcc: str):
        """lcc → Domains.name（PK 唯讀檢索、無寫交易；鏡像 resume、database SOP）。"""
        if not lcc:
            return None
        try:
            from db import SessionLocal
            from models import Domains
            with SessionLocal() as session:   # 唯讀、不開寫交易
                row = session.get(Domains, lcc)
                return row.name if row else None
        except Exception as exc:  # noqa: BLE001
            logger.warning("[PIPE-SLIDES P2] Domains.name 解析失敗（None）: %s",
                           exc, exc_info=True)
            return None
    # === [PIPE-SLIDES C3 END] ===

    # === [PIPE-SLIDES C4 START] P3 Per-Page Translate & Restore（U7-U10）===
    def run_phase3(self, ctx: PipelineContext) -> BilingualMarkdownSpec:
        """P3 逐頁翻譯 + alt 對齊還原 + rag_sections 旁路。

        - 逐頁 InjectionContext（lcc/glossary/zh_summary=P2 譯摘要/domain_name/
          constraints=_SLIDE_CONSTRAINTS/doc_type='slides'）→ Translator NORMAL；
          並行照抄 RESUME-PERF-1（ThreadPool+slot 保序+既有 _api_semaphore+單欄失敗退原文）。
        - 還原（U8 alt 對齊、雙 Caption 物理根除）：`![{alt=description 譯文}](images/page-N.jpg)`
          + 譯文；**嚴禁** `*圖表：*` 獨立段與頁頂重複總述；**不渲染 meta header**（U10、
          封面頁已天然呈現）。
        - rag_sections 旁路（U10/Q3）：每頁一 section、`summary_key=page_key(N,原文標題)`
          （與 P2 ②⑥ 三方同基準）；**同頁短 items 合併**＝content+figure_description 併單
          一 text chunk（策略側、rag_indexer 零改）。
        - zh 來源（SPEC U4）：跳過翻譯（原文≡譯文）、仍建 per-section。
        - 退化 fallback（Q5）：頁數 ≤1 或空頁佔比 >50% → 整檔單發 + 單一容器 section。
        """
        import paper_manager
        import settings
        from processor.translator import InjectionContext, TranslateMode, Translator

        if ctx.glossary_ready is None:
            raise ValueError("PIPE-SLIDES P3：ctx.glossary_ready 缺失（P2 未交付）")
        gspec = ctx.glossary_ready
        tiles = (ctx.ingestion.tiles if ctx.ingestion else []) or []
        source_lang = (ctx.ingestion.source_lang if ctx.ingestion else None) or "en"
        is_zh = source_lang.lower().startswith("zh")

        inj = InjectionContext(
            lcc=gspec.lcc, glossary=gspec.glossary or {},
            zh_summary=gspec.translated_abstract or "",
            domain_name=gspec.domain_name, doc_type="slides",
            constraints=_SLIDE_CONSTRAINTS,
        )
        translator = Translator()

        # Q5 退化判準
        empty = sum(1 for u in tiles if not (u.get("content") or "").strip())
        degraded = len(tiles) <= 1 or (tiles and empty / len(tiles) > _FALLBACK_EMPTY_RATIO)

        if is_zh:
            # SPEC U4：zh 來源跳譯（原文≡譯文）、仍建 per-section（key 天然對齊）
            # === [META-NORM C4] === 4-tuple 對齊 _translate_pages_parallel（含 subtitle）
            zh_fields = {i: (u.get("title") or "", u.get("subtitle") or "",
                             u.get("content") or "", u.get("figure_description") or "")
                         for i, u in enumerate(tiles)}
        elif degraded:
            logger.warning(
                "[PIPE-SLIDES P3] %s 退化 fallback（pages=%d empty=%d）→ 整檔單發",
                ctx.paper_id, len(tiles), empty)
            whole_src = "\n\n".join(self._page_source_md(u) for u in tiles)
            whole_zh = self._translate_whole(whole_src, inj, translator)
            return self._deliver(ctx, gspec, tiles, whole_zh=whole_zh)
        else:
            zh_fields = self._translate_pages_parallel(tiles, inj, translator)

        return self._deliver(ctx, gspec, tiles, zh_fields=zh_fields)

    # ── P3 私有群 ──
    # === [PIPE-SLIDES-HOTFIX-3 HOTFIX-3 START] ===
    @staticmethod
    def _slide_head_html(title, subtitle) -> str:
        """C：標題+副標併入單一 .slide-head 標題塊（raw HTML、底線由 CSS 移整塊下）。

        還原投影片「大標題 + 緊貼副標」一體感；h2 仍為 h2（語意/RAG 不變）、副標降 .slide-sub
        （不再 h3、不觸發 h2 章節分隔線夾在中間 → 一-b 隨之消失）。title/subtitle escape 防破版。
        """
        import html as _html
        t = (title or "").strip()
        s = (subtitle or "").strip()
        if not t and not s:
            return ""
        rows = []
        if t:
            rows.append(f"<h2>{_html.escape(t)}</h2>")
        if s:
            rows.append(f'<p class="slide-sub">{_html.escape(s)}</p>')
        return '<div class="slide-head">\n' + "\n".join(rows) + "\n</div>"

    @staticmethod
    def _promote_subheadings(text: str) -> str:
        """A/B/C：整行純 **X** 之內文子標題 → ### X（升設計內 h3、無底線、有間距）。

        Vision 把投影片內小節標題（A horizon/B horizon…）忠實轉錄為 **bold**；扁平且黏 bullet。
        升 h3（typography 已規範）→ 真子標題擁有自己 bullet 群；前補空行確保 heading 解析。
        """
        out = []
        for line in (text or "").split("\n"):
            # \r? 相容 Windows 換行（split('\n') 殘留 \r 會使 $ 匹配失敗）
            m = re.match(r"^\s*\*\*(.+?)\*\*\s*\r?$", line)
            if m:
                if out and out[-1] != "":          # 前一行非空才補（避免連續多餘空行）
                    out.append("")
                out.append(f"### {m.group(1).strip()}")
            else:
                out.append(line)
        return "\n".join(out)
    # === [PIPE-SLIDES-HOTFIX-3 HOTFIX-3 END] ===

    # === [PIPE-SLIDES-HOTFIX-3c HOTFIX-3c START] ===
    @staticmethod
    def _tighten_point_groups(text: str) -> str:
        """簡報「標題+重點」節奏正規化（保留原始符號、不轉 bullet）。

        ① 連續『行首箭頭 → / ->』行 → 合併為單一段落、行間兩尾隨空格硬換行（<br>）→ tight 群、
           箭頭原樣保留為文字；行中箭頭（如「吸收 NH₄⁺ → 釋放 H⁺」連接詞）不碰。
        ② 『- * + • / 數字.』清單之相鄰項間空行收緊（loose→tight）；清單↔標題/圖/段落 邊界留白。

        殿後於 _normalize_paragraph_breaks（其單 \\n→\\n\\n 不再拆我的硬換行群）。
        只動渲染 body、不碰 rag_sections（RAG 零影響）。\\r? 相容 CRLF（對齊 _promote_subheadings 風格）。
        """
        if not text:
            return text
        lines = text.split("\n")
        ARROW_RE = re.compile(r"^(\s*)(?:→|->)\s+(.+?)\s*\r?$")
        LIST_RE = re.compile(r"^\s*(?:[-*+•]|\d+[.、])\s+")
        # ① 合併連續行首箭頭群（群內空行跳過、遇非箭頭非空行斷群）
        merged = []
        i, n = 0, len(lines)
        while i < n:
            if ARROW_RE.match(lines[i]):
                group = [lines[i].rstrip("\r")]
                j = i + 1
                while j < n:
                    if ARROW_RE.match(lines[j]):
                        group.append(lines[j].rstrip("\r"))
                        j += 1
                    elif lines[j].strip() == "":
                        k = j + 1
                        while k < n and lines[k].strip() == "":
                            k += 1
                        if k < n and ARROW_RE.match(lines[k]):
                            j = k          # 跳過群內空行、續併
                        else:
                            break          # 群尾（下一個非空非箭頭）→ 斷
                    else:
                        break
                # ≥2 行才合併硬換行（單行箭頭保持原樣、屬獨立點）
                merged.append("  \n".join(group) if len(group) >= 2 else group[0])
                i = j
            else:
                merged.append(lines[i])
                i += 1
        # ② 相鄰清單項間空行收緊（兩側皆清單才丟、邊界留白）
        out, m = [], len(merged)
        for idx, line in enumerate(merged):
            if line.strip() == "":
                prev = next((merged[p] for p in range(idx - 1, -1, -1)
                             if merged[p].strip()), "")
                nxt = next((merged[q] for q in range(idx + 1, m)
                            if merged[q].strip()), "")
                if LIST_RE.match(prev) and LIST_RE.match(nxt):
                    continue   # 兩側皆清單 → 丟此空行（tight）
            out.append(line)
        return "\n".join(out)
    # === [PIPE-SLIDES-HOTFIX-3c HOTFIX-3c END] ===

    # === [PIPE-SLIDES-HOTFIX-3d HOTFIX-3d START] ===
    @staticmethod
    def _render_inline_bold(text: str) -> str:
        """行內 **X** → <strong>X</strong>（raw HTML、繞過 CommonMark CJK emphasis 失效）。

        真因：閉合 `**` 前接全形標點、後接中文字（非空白非標點）→ CommonMark 不認 closer →
        字面星號。轉 raw <strong> 後 marked 原樣輸出、不論 CJK 緊貼皆正確粗體。
        於 _promote_subheadings 之後跑（整行 **X** 已升 ### → 此處只剩行內 span）；非貪婪成對匹配、
        落單 `**` 保留原樣。只動渲染 body、不碰 rag_sections。
        """
        if not text:
            return text
        return re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", text)

    @staticmethod
    def _strip_bare_url_lines(text: str) -> str:
        """剝除『整行僅一個 URL』之行（投影片來源/縮圖網址、破版噪聲）。

        僅匹配整行純 URL（前後容空白、容 <...> autolink 括號）；行內 URL（同行有其他文字）
        與 ![alt](images/…) 圖片行（非 http 開頭）一律保留。只動渲染 body、不碰 rag_sections。
        """
        if not text:
            return text
        url_line = re.compile(r"^\s*<?https?://\S+>?\s*\r?$")
        return "\n".join(ln for ln in text.split("\n") if not url_line.match(ln))
    # === [PIPE-SLIDES-HOTFIX-3d HOTFIX-3d END] ===

    @staticmethod
    def _page_source_md(u: dict) -> str:
        """單頁原文 markdown（en 版還原與整檔 fallback 共用；alt=原文 description、單點呈現）。"""
        parts = []
        # === [PIPE-SLIDES-HOTFIX-3 HOTFIX-3 START] === 一-a 圖在上 + C 標題塊 + A/B/C h3
        alt = (u.get("figure_description") or u.get("title") or f"page {u['page']}").strip()
        # alt 轉義防破圖（HOTFIX-2 B 邏輯保留）
        parts.append(f"![{SlidePipeline._safe_alt(alt)}]({u['image_file']})")
        head = SlidePipeline._slide_head_html(u.get("title"), u.get("subtitle"))
        if head:
            parts.append(head)
        if (u.get("content") or "").strip():
            # A/B/C 子標題升 h3 → 段落正規化（HOTFIX-1 F4、zh/en 對稱）
            body = SlidePipeline._promote_subheadings(u["content"].strip())
            # === [PIPE-SLIDES-HOTFIX-3d HOTFIX-3d] === 行內粗體轉 <strong> + 剝除整行裸 URL
            body = SlidePipeline._render_inline_bold(body)
            body = SlidePipeline._strip_bare_url_lines(body)
            body = SlidePipeline._normalize_paragraph_breaks(body)
            # === [PIPE-SLIDES-HOTFIX-3c HOTFIX-3c] === 重點群收緊（殿後、硬換行不被 normalize 拆）
            body = SlidePipeline._tighten_point_groups(body)
            parts.append(body)
        # === [PIPE-SLIDES-HOTFIX-3 HOTFIX-3 END] ===
        return "\n\n".join(parts)

    def _translate_pages_parallel(self, tiles, inj, translator) -> dict:
        """逐頁三欄（title/content/description）受限並行翻譯（RESUME-PERF-1 範式）。

        保序靠 (page_idx, field) 鍵回填；單欄失敗退原文 + warning；
        實際 API 併發受既有 LLMClient._api_semaphore 限流、不新增鎖。
        """
        from concurrent.futures import ThreadPoolExecutor

        from processor.translator import TranslateMode
        from settings import LLM_MAX_CONCURRENT

        tasks = []
        for i, u in enumerate(tiles):
            # === [META-NORM C4] === subtitle 併入並行翻譯（text_type=title）
            for field, ttype in (("title", "title"), ("subtitle", "title"),
                                 ("content", "content"), ("figure_description", "caption")):
                text = (u.get(field) or "").strip()
                if text:
                    tasks.append((i, field, ttype, text))
        results = {}
        if tasks:
            with ThreadPoolExecutor(max_workers=max(1, LLM_MAX_CONCURRENT)) as ex:
                futs = {
                    ex.submit(translator.translate, text, inj,
                              TranslateMode.NORMAL, ttype): (i, field, text)
                    for i, field, ttype, text in tasks
                }
                for fut, (i, field, text) in futs.items():
                    try:
                        results[(i, field)] = (fut.result() or "").strip() or text
                    except Exception as exc:  # noqa: BLE001 — 單欄退原文、不污染其餘
                        logger.warning(
                            "[PIPE-SLIDES P3] 頁 %d %s 翻譯失敗（退原文）: %s",
                            i + 1, field, exc,
                            extra={"extra_fields": {
                                "event": "slide_translate_unit_fallback",
                                "page": i + 1, "field": field}},
                        )
                        results[(i, field)] = text
        # === [META-NORM C4] === 4-tuple：(title, subtitle, content, desc)
        return {
            i: (results.get((i, "title"), ""), results.get((i, "subtitle"), ""),
                results.get((i, "content"), ""), results.get((i, "figure_description"), ""))
            for i in range(len(tiles))
        }

    @staticmethod
    def _translate_whole(text: str, inj, translator) -> str:
        """Q5 整檔單發兜底（失敗退原文、保交付契約）。"""
        from processor.translator import TranslateMode
        try:
            return (translator.translate(text, inj, TranslateMode.NORMAL, "content")
                    or "").strip() or text
        except Exception as exc:  # noqa: BLE001
            logger.warning("[PIPE-SLIDES P3] 整檔翻譯失敗（退原文）: %s", exc)
            return text

    def _deliver(self, ctx, gspec, tiles, zh_fields=None, whole_zh=None):
        """還原雙語 final + rag_sections 旁路 + 寫檔交付（正常/退化共用出口）。"""
        import paper_manager
        import settings

        en_text = "\n\n".join(self._page_source_md(u) for u in tiles)
        if whole_zh is not None:
            # 退化：整檔譯文 + 單一容器 section（size-cap 由 rag_indexer 子切）
            zh_text = whole_zh
            title = (ctx.ingestion.title if ctx.ingestion else "") or "簡報全文"
            ctx.rag_sections = [{
                "title": title, "level": 2,
                "summary_key": self.page_key(1, self._key_title(tiles[0])) if tiles else "p01_",
                "content": [{"type": "text", "content": whole_zh}], "children": [],
            }]
        else:
            zh_pages, sections = [], []
            for i, u in enumerate(tiles):
                # === [META-NORM C4] === 解 4-tuple（含 subtitle）
                zh_title, zh_subtitle, zh_content, zh_desc = zh_fields[i]
                parts = []
                # === [PIPE-SLIDES-HOTFIX-3 HOTFIX-3 START] === 一-a 圖在上 + C 標題塊 + A/B/C h3
                alt = zh_desc or zh_title or f"page {u['page']}"
                # alt 轉義防破圖（HOTFIX-2 B、U8 單點呈現）
                parts.append(f"![{self._safe_alt(alt)}]({u['image_file']})")
                head = self._slide_head_html(zh_title, zh_subtitle)
                if head:
                    parts.append(head)
                if zh_content:
                    # A/B/C 子標題升 h3 → 段落正規化（HOTFIX-1 F4、soft break 黏段根除）
                    body = self._promote_subheadings(zh_content)
                    # === [PIPE-SLIDES-HOTFIX-3d HOTFIX-3d] === 行內粗體轉 <strong> + 剝除整行裸 URL
                    body = self._render_inline_bold(body)
                    body = self._strip_bare_url_lines(body)
                    body = self._normalize_paragraph_breaks(body)
                    # === [PIPE-SLIDES-HOTFIX-3c HOTFIX-3c] === 重點群收緊（殿後、硬換行不被 normalize 拆）
                    body = self._tighten_point_groups(body)
                    parts.append(body)
                # === [PIPE-SLIDES-HOTFIX-3 HOTFIX-3 END] ===
                zh_pages.append("\n\n".join(parts))
                # Q3 同頁短 items 合併：content+description 併單一 text chunk
                merged = "\n\n".join(x for x in (zh_content, zh_desc) if x)
                sections.append({
                    # === [META-NORM C4] === title 空 fallback subtitle（防 key 漂移）
                    "title": zh_title or zh_subtitle or f"page {u['page']}", "level": 2,
                    "summary_key": self.page_key(u["page"], self._key_title(u)),
                    "content": [{"type": "text", "content": merged}], "children": [],
                })
            zh_text = "\n\n".join(zh_pages)          # U10：不渲染 meta header
            ctx.rag_sections = sections
            # === [PIPE-SLIDES-HOTFIX-1 HOTFIX-1 F2 START] === 封面譯題穿旁路（問題 2 選 B、零增量 LLM）
            # web_server 影子寫庫（C8-hotfix/SHADOW-HOTFIX-2）優先讀 ctx.raw_metadata 組
            # metadata_json 並補綴 (測試) → 放入即自動流到 DB、前端列表改顯中文題；web_server 零改。
            cover_zh_title = zh_fields[0][0] if zh_fields else ""
            if cover_zh_title:
                # === [PIPE-SLIDES-HOTFIX-1b START] === 旁路值改三欄 dict（HOTFIX-1 誤塞裸 str →
                # upsert_paper L231 .get('value') / web_server L714 ['value'] 對 str 炸 AttributeError、
                # 影子寫庫掛掉前端不顯示；對齊 metadata_extractor {value,source,confidence} 全鏈契約）
                ctx.raw_metadata["translated_title"] = {
                    "value": cover_zh_title,
                    "source": "slide_pipeline",
                    "confidence": "high",
                }
                # === [PIPE-SLIDES-HOTFIX-1b END] ===
            # === [PIPE-SLIDES-HOTFIX-1 HOTFIX-1 F2 END] ===

        zh_path = paper_manager.article_zh_path(
            settings.OUTPUT_DIR, ctx.owner_id, ctx.paper_id)
        en_path = paper_manager.article_en_path(
            settings.OUTPUT_DIR, ctx.owner_id, ctx.paper_id)
        zh_path.parent.mkdir(parents=True, exist_ok=True)
        zh_path.write_text(zh_text, encoding="utf-8")
        en_path.write_text(en_text, encoding="utf-8")
        logger.info(
            "[PIPE-SLIDES P3] %s 交付 final_zh=%d chars rag_sections=%d degraded=%s",
            ctx.paper_id, len(zh_text), len(ctx.rag_sections), whole_zh is not None)
        return BilingualMarkdownSpec(
            final_zh_path=str(zh_path), final_en_path=str(en_path),
            translated_abstract=gspec.translated_abstract or "",
        )
    # === [PIPE-SLIDES C4 END] ===

    # === [PIPE-SLIDES C5 START] P4 Wire（U11、resume run_phase4 同範式）===
    def run_phase4(self, ctx: PipelineContext) -> RagDbSpec:
        """P4 Async RAG：呼 B 軌共用真理源 `rag_indexer.index` 一站式落庫。

        輸入＝P3 旁路 `ctx.rag_sections` + P2 `section_summaries`（key=page_key 同基準、
        **不餵 reading-view final_zh.md**）；四產物（FAISS+paper_chunks+index_meta+
        rag_tree.json）；`rag_char_threshold=3` 由 doc_type='slides' 於 rag_indexer 內生效。
        錯誤隔離：異常 warning(exc_info) 後**拋出**、交 Orchestrator 標 rag_status='failed'、
        不阻 reading_ready；paper_db_id None → rag_indexer 內部優雅降級。零 A 軌 rag_processor。
        """
        import paper_manager
        import settings
        from processor import rag_indexer  # 惰性 import（B 軌自有、零 rag_processor）

        if ctx.bilingual is None:
            raise ValueError("PIPE-SLIDES P4：ctx.bilingual 缺失（P3 未交付）")

        rag_sections = ctx.rag_sections or []
        section_summaries = (
            ctx.glossary_ready.section_summaries if ctx.glossary_ready else None
        ) or {}
        vectors_dir = paper_manager.vectors_path(
            settings.OUTPUT_DIR, ctx.owner_id, ctx.paper_id)
        rag_tree_path = paper_manager.rag_tree_path(
            settings.OUTPUT_DIR, ctx.owner_id, ctx.paper_id)
        _title = (ctx.ingestion.title if ctx.ingestion else None) or ctx.paper_id
        # === [PIPE-SLIDES-HOTFIX-1 HOTFIX-1 F2 START] === 譯題首選旁路（P3 既有封面譯題、
        # 償還 C5「暫同取」技術債；缺〔退化/zh 路/無封面題〕→ 暫同取向後相容）；
        # 影子後綴對齊：title 已含 (測試)、譯題同綴保 rag_tree 雙題一致
        # === [PIPE-SLIDES-HOTFIX-1b START] === 旁路值已為三欄 dict → 取 value（str 向後相容防呆）
        _raw_tt = (ctx.raw_metadata or {}).get("translated_title")
        _translated = (
            _raw_tt.get("value") if isinstance(_raw_tt, dict) else _raw_tt
        ) or _title
        # === [PIPE-SLIDES-HOTFIX-1b END] ===
        if ctx.paper_id.endswith("_shadow") and not _translated.endswith(" (測試)"):
            _translated = f"{_translated} (測試)"
        # === [PIPE-SLIDES-HOTFIX-1 HOTFIX-1 F2 END] ===
        paper_db_id = paper_manager.get_paper_db_id(ctx.owner_id, ctx.paper_id)
        if paper_db_id is None:
            logger.warning(
                "[PIPE-SLIDES P4] %s paper_db_id 未取得（DB 寫入降級、僅 FAISS + index_meta）",
                ctx.paper_id)

        try:
            spec = rag_indexer.index(
                rag_sections, section_summaries, "slides", vectors_dir,
                paper_db_id=paper_db_id,
                rag_tree_path=str(rag_tree_path),
                # === [PIPE-SLIDES-HOTFIX-1 HOTFIX-1 F2] === translated_title 改帶譯題（原暫同取）
                title=_title, translated_title=_translated,
            )
            logger.info(
                "[PIPE-SLIDES P4] %s RAG 完成 chunks=%d paper_chunks=%d",
                ctx.paper_id, int(spec.index_meta.get("chunks_total", 0)),
                spec.paper_chunk_count)
            return spec
        except Exception as exc:  # noqa: BLE001 — 拋出由 Orchestrator 標 rag_status='failed'
            logger.warning(
                "[PIPE-SLIDES P4] %s RAG 向量化失敗（不阻主鏈、Orchestrator 標 failed）: %s",
                ctx.paper_id, exc, exc_info=True)
            raise
    # === [PIPE-SLIDES C5 END] ===
