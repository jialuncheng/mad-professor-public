# === [PIPE-SLIDES C3 START] === P2 六步測試（mock LLM/Translator/LCC、零真 API/DB 寫）
class _FakeChat:
    """假 LLMClient.chat：依呼叫序回應、記錄 prompts。"""

    def __init__(self, outputs):
        self.outputs = list(outputs)
        self.prompts = []

    def chat(self, messages, **kw):
        self.prompts.append("\n".join(m["content"] for m in messages))
        return self.outputs.pop(0)


def _make_p2_ctx(tiles, paper_id='deck1'):
    from pipelines.context import PipelineContext
    from pipelines.contracts import IngestionMetadataSpec
    ctx = PipelineContext(doc_type='slides', paper_id=paper_id, owner_id=1)
    ctx.ingestion = IngestionMetadataSpec(
        title='T', source_lang='en', tiles=tiles)
    return ctx


def _run_p2(monkeypatch, tiles, chat_outputs, lcc_capture=None):
    """共用 harness：fake chat / Translator / normalize_to_lcc / domain_name。"""
    import llm.client as llm_client
    import pipelines.slide_pipeline as sp
    from pipelines.slide_pipeline import SlidePipeline
    fake = _FakeChat(chat_outputs)
    monkeypatch.setattr(llm_client.LLMClient, 'get_instance',
                        classmethod(lambda cls: fake))

    class _FakeTr:
        def translate(self, text, ictx, mode, text_type="content"):
            return f"譯[{text[:20]}]"
    import processor.translator as tr_mod
    import processor.domain_normalizer as dn_mod
    monkeypatch.setattr(tr_mod, 'Translator', _FakeTr)
    captured = {}

    def _fake_lcc(raw_domain, context_text=None):
        captured['raw_domain'] = raw_domain
        return 'TK'
    monkeypatch.setattr(dn_mod, 'normalize_to_lcc', _fake_lcc)
    monkeypatch.setattr(SlidePipeline, '_resolve_domain_name',
                        staticmethod(lambda lcc: 'Tech'))
    ctx = _make_p2_ctx(tiles)
    spec = SlidePipeline().run_phase2(ctx)
    if lcc_capture is not None:
        lcc_capture.update(captured)
    return spec, ctx, fake


def _tile(page, title, content):
    return {"page": page, "title": title, "content": content,
            "figure_description": "", "image_file": f"images/page-{page:02d}.jpg",
            "is_cover": False}


def test_p2_six_step_spec_and_key_uniqueness(monkeypatch):
    """六步交付完整 + U6 連續同標題頁 key 不撞（p{N}_ 前綴物理唯一）。"""
    tiles = [_tile(1, '財務報表', '- A'), _tile(2, '財務報表', '- B')]
    outputs = [
        "整份摘要內容。\ndomain: Finance",                                   # ①
        '[{"i":1,"title":"財務報表","summary":"sumA"},'
        ' {"i":2,"title":"財務報表","summary":"sumB"}]',                     # ②⑤
        "1. 摘要A\n2. 摘要B",                                                # ⑥
    ]
    spec, _, _ = _run_p2(monkeypatch, tiles, outputs)
    assert spec.abstract == '整份摘要內容。'
    assert spec.lcc == 'TK' and spec.domain_name == 'Tech'
    assert spec.translated_abstract.startswith('譯[')
    keys = sorted(spec.section_summaries.keys())
    assert keys == ['p01_財務報表', 'p02_財務報表']     # 同標題不撞
    assert spec.section_summaries['p01_財務報表'] == '摘要A'


def test_p2_missing_title_generated_and_backfilled(monkeypatch):
    """U5 ②：無標題頁順產標題、回填 tiles、key 含生成標題。"""
    tiles = [_tile(1, '', '- 內容甲')]
    outputs = [
        "摘要。\ndomain: Power",
        '[{"i":1,"title":"產線概覽","summary":"s1"}]',
        "1. 譯s1",
    ]
    spec, ctx, _ = _run_p2(monkeypatch, tiles, outputs)
    assert ctx.ingestion.tiles[0]['title'] == '產線概覽'          # 回填
    assert list(spec.section_summaries.keys()) == ['p01_產線概覽']


def test_p2_raw_domain_extracted_and_fallback(monkeypatch):
    """U5 ①：domain 行順產 → 餵 normalize_to_lcc；缺行 → raw_domain=""（內容判定降級路）。"""
    tiles = [_tile(1, 'A', '- x')]
    cap = {}
    outputs = ["摘要。\ndomain: Power Electronics",
               '[{"i":1,"title":"A","summary":"s"}]', "1. 譯"]
    _run_p2(monkeypatch, tiles, outputs, lcc_capture=cap)
    assert cap['raw_domain'] == 'Power Electronics'
    cap2 = {}
    outputs2 = ["只有摘要、沒有領域行",
                '[{"i":1,"title":"A","summary":"s"}]', "1. 譯"]
    _run_p2(monkeypatch, tiles, outputs2, lcc_capture=cap2)
    assert cap2['raw_domain'] == ''


def test_p2_summaries_nonfatal_degrade(monkeypatch):
    """安全鎖：②批次解析失敗 → section_summaries=None、其餘交付不阻（非致命）。"""
    tiles = [_tile(1, 'A', '- x')]
    outputs = ["摘要。\ndomain: X", "這不是 JSON"]   # ② 壞輸出 → {} → 不呼 ⑥
    spec, _, _ = _run_p2(monkeypatch, tiles, outputs)
    assert spec.section_summaries is None
    assert spec.abstract == '摘要。'
