# === [PIPE-SLIDES-HOTFIX-2 HOTFIX-2 START] === B/E/F 回歸測試
def test_hf2b_alt_brackets_escaped(monkeypatch, tmp_path):
    """B：alt 內 ] [ ( ) → 全形、換行/連續空白→單空格；端到端圖片語法不破。"""
    from pipelines.slide_pipeline import SlidePipeline as S
    a = S._safe_alt("木桶 (barrel)（李比希 [Liebig's minimum]）\n第二行  多空白")
    assert "]" not in a and "[" not in a and "(" not in a and ")" not in a
    assert "\n" not in a and "  " not in a
    assert S._safe_alt("") == ""
    # 端到端：圖密集頁（desc 含括號）→ final_zh 圖片語法完整、無裸 ] 破壞
    import processor.translator as tr_mod

    class _IdTr:
        def translate(self, text, ictx, mode, text_type="content"):
            return text
    monkeypatch.setattr(tr_mod, 'Translator', lambda: _IdTr())
    tiles = [_t4(1, '氮循環', '內容', 'NH4+ (銨 [ammonium]) 與 NO3- (硝酸鹽 [nitrate])'),
             _t4(2, 'B頁', '內容2')]
    ctx = _make_p3_ctx(tmp_path, monkeypatch, tiles, paper_id='deckhf2b')
    spec = S().run_phase3(ctx)
    zh = Path(spec.final_zh_path).read_text(encoding='utf-8')
    assert '![' in zh and '](images/page-01.jpg)' in zh   # 圖片語法完整
    assert '［ammonium］' in zh or '（銨' in zh             # 括號已全形（未破壞 alt）


def test_hf2e_master_date_stripped():
    """E：≥2 頁整行日期（含格式變異）洗除；單頁日期保留；句中日期不動。"""
    from pipelines.slide_pipeline import SlidePipeline as S
    units = [{"content": "4/28/2026\n內容A", "is_cover": False},
             {"content": "2026/4/28\n內容B", "is_cover": False},
             {"content": "活動於 4/28/2026 舉行", "is_cover": False}]   # 句中不剔
    S._strip_master_date(units)
    assert units[0]["content"] == "內容A" and units[1]["content"] == "內容B"
    assert "4/28/2026" in units[2]["content"]              # 句中日期保留
    one = [{"content": "2026/1/1\nx", "is_cover": False}]   # 單頁不洗
    S._strip_master_date(one)
    assert "2026/1/1" in one[0]["content"]


def test_hf2f_list_stays_tight():
    """F：tight bullet/數字 list 不被升級成 loose；純段落仍升級 \\n\\n；table 不破。"""
    from pipelines.slide_pipeline import SlidePipeline as S
    assert S._normalize_paragraph_breaks("- a\n- b\n- c") == "- a\n- b\n- c"       # bullet tight
    assert S._normalize_paragraph_breaks("1. 甲\n2. 乙") == "1. 甲\n2. 乙"          # 數字 tight
    assert S._normalize_paragraph_breaks("第一段\n第二段") == "第一段\n\n第二段"   # 段落仍升級
    assert "| A | 1 |\n| B | 2 |" in S._normalize_paragraph_breaks("| A | 1 |\n| B | 2 |")
# === [PIPE-SLIDES-HOTFIX-2 HOTFIX-2 END] ===


# === [PIPE-SLIDES-HOTFIX-3c HOTFIX-3c] === 簡報「標題+重點」節奏正規化（保 →、硬換行收緊）
def test_hf3c_arrow_group_hardbreak():
    """連續行首箭頭 → 合併單一段落 + 兩空格硬換行；箭頭原樣保留、不轉 bullet。"""
    from pipelines.slide_pipeline import SlidePipeline as S
    out = S._tighten_point_groups("→ 帶正電\n→ 與負電結合\n→ 保留")
    assert out == "→ 帶正電  \n→ 與負電結合  \n→ 保留"   # 行間兩空格硬換行、單一段落
    assert "→" in out and "- " not in out               # 箭頭保留、未轉 bullet


def test_hf3c_arrow_group_skips_blank_lines():
    """箭頭群內空行（Vision 散段落）跳過、仍合併為硬換行群。"""
    from pipelines.slide_pipeline import SlidePipeline as S
    out = S._tighten_point_groups("→ a\n\n→ b\n\n→ c")
    assert out == "→ a  \n→ b  \n→ c"


def test_hf3c_inline_arrow_preserved():
    """行中箭頭（行首非箭頭，如連接詞句）不合併、續段落原樣。"""
    from pipelines.slide_pipeline import SlidePipeline as S
    src = "吸收 NH₄⁺ → 釋放 H⁺ → 土壤酸化"
    assert S._tighten_point_groups(src) == src


def test_hf3c_single_arrow_unchanged():
    """孤行箭頭（群=1）不加硬換行、保持獨立點原樣。"""
    from pipelines.slide_pipeline import SlidePipeline as S
    assert S._tighten_point_groups("→ 它們需要水分與養分") == "→ 它們需要水分與養分"


def test_hf3c_loose_list_tightened():
    """相鄰清單項間空行收緊（loose→tight）、`*`/`•` 符號保留。"""
    from pipelines.slide_pipeline import SlidePipeline as S
    assert S._tighten_point_groups("* a\n\n* b") == "* a\n* b"
    assert S._tighten_point_groups("• x\n\n• y") == "• x\n• y"


def test_hf3c_list_heading_boundary_blank_kept():
    """清單↔標題 邊界空行保留（標題不被吸入清單）。"""
    from pipelines.slide_pipeline import SlidePipeline as S
    assert S._tighten_point_groups("- a\n\n### H") == "- a\n\n### H"


def test_hf3c_crlf_compat():
    """\\r? 相容 CRLF：split('\\n') 殘 \\r 仍正確合併、輸出無 \\r 殘留。"""
    from pipelines.slide_pipeline import SlidePipeline as S
    out = S._tighten_point_groups("→ a\r\n→ b\r")
    assert "\r" not in out
    assert out == "→ a  \n→ b"


def test_hf3c_rag_sections_unaffected(monkeypatch, tmp_path):
    """RAG 隔離：跑真實 P3，rag_sections content（merged）取原始 zh_content、絕不含 tighten 硬換行。"""
    from pipelines.slide_pipeline import SlidePipeline as S
    # 證 transform 確實會對散箭頭產生硬換行（對照組）
    assert "  \n" in S._tighten_point_groups("→ a\n→ b")
    # 跑整條 P3（_deliver 內建 rag_sections）；2 tiles 走正常 per-section 路（避退化）
    tiles = [_t4(1, '氮', '→ a\n→ b'), _t4(2, '磷', '→ c\n→ d')]
    spec, ctx, fake, zh = _run_p3(monkeypatch, tmp_path, tiles)
    for sec in ctx.rag_sections:
        merged = sec['content'][0]['content']
        assert "  \n" not in merged      # rag_sections 未套 tighten（render-only、RAG 零影響）


def test_hf3c_nitrogen_page_end_to_end():
    """頁 B 端到端：標題塊 + 散箭頭 → 渲染含硬換行群、群與下個標題間留白。"""
    from pipelines.slide_pipeline import SlidePipeline as S
    body = S._promote_subheadings("**NH₄⁺**\n\n→ 帶正電\n\n→ 保留\n\n**NO₃⁻**\n\n→ 帶負電")
    body = S._normalize_paragraph_breaks(body)
    body = S._tighten_point_groups(body)
    assert "→ 帶正電  \n→ 保留" in body       # NH₄⁺ 群硬換行 tight
    assert "### NH₄⁺" in body and "### NO₃⁻" in body   # 標題升級保留
    # 群與下個標題間仍有空行（標題非清單、未被吸入）
    assert "→ 保留\n\n### NO₃⁻" in body
