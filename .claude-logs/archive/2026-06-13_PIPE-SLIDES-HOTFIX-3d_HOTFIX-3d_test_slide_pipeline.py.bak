# === [PIPE-SLIDES C5 START] === P4 Wire 測試（mock rag_indexer、零真 Embedding/DB）
def _make_p4_ctx(tmp_path, monkeypatch):
    import settings
    from pipelines.context import PipelineContext
    from pipelines.contracts import (BilingualMarkdownSpec, GlossaryReadySpec,
                                     IngestionMetadataSpec)
    monkeypatch.setattr(settings, 'OUTPUT_DIR', tmp_path)
    ctx = PipelineContext(doc_type='slides', paper_id='deck1', owner_id=1)
    ctx.ingestion = IngestionMetadataSpec(title='封面題', source_lang='en', tiles=[])
    ctx.glossary_ready = GlossaryReadySpec(
        abstract='a', lcc='TK', glossary={}, translated_abstract='譯',
        section_summaries={'p01_X': '頁摘要'}, domain_name='Tech')
    ctx.bilingual = BilingualMarkdownSpec(
        final_zh_path='x', final_en_path='y', translated_abstract='譯')
    ctx.rag_sections = [{"title": "譯X", "level": 2, "summary_key": "p01_X",
                         "content": [{"type": "text", "content": "c"}], "children": []}]
    return ctx


def test_p4_wires_rag_indexer_with_contract_args(monkeypatch, tmp_path):
    """U11：run_phase4 傳 rag_sections+section_summaries+doc_type='slides'+rag_tree_path+title。"""
    import paper_manager
    from processor import rag_indexer
    from pipelines.slide_pipeline import SlidePipeline
    captured = {}

    def _fake_index(sections, section_summaries, doc_type, vectors_dir, **kw):
        captured.update(sections=sections, summaries=section_summaries,
                        doc_type=doc_type, **kw)
        from types import SimpleNamespace
        return SimpleNamespace(index_meta={"chunks_total": 3}, paper_chunk_count=3)
    monkeypatch.setattr(rag_indexer, 'index', _fake_index)
    monkeypatch.setattr(paper_manager, 'get_paper_db_id', lambda o, p: None)
    ctx = _make_p4_ctx(tmp_path, monkeypatch)
    spec = SlidePipeline().run_phase4(ctx)
    assert captured['doc_type'] == 'slides'
    assert captured['sections'][0]['summary_key'] == 'p01_X'   # P3 旁路直餵
    assert captured['summaries'] == {'p01_X': '頁摘要'}          # P2 同 key 基準
    assert 'rag_tree.json' in captured['rag_tree_path']         # HOTFIX-2 四產物
    assert captured['title'] == '封面題'
    assert spec.paper_chunk_count == 3


def test_p4_failure_raises_not_swallowed(monkeypatch, tmp_path):
    """錯誤隔離：rag_indexer 失敗 → warning 後拋出（Orchestrator 標 failed、不吞）。"""
    import paper_manager
    from processor import rag_indexer
    from pipelines.slide_pipeline import SlidePipeline

    def _boom(*a, **k):
        raise RuntimeError("embed down")
    monkeypatch.setattr(rag_indexer, 'index', _boom)
    monkeypatch.setattr(paper_manager, 'get_paper_db_id', lambda o, p: 1)
    ctx = _make_p4_ctx(tmp_path, monkeypatch)
    with pytest.raises(RuntimeError):
        SlidePipeline().run_phase4(ctx)
# === [PIPE-SLIDES C5 END] ===


# === [PIPE-SLIDES C6 START] === 測試補全（§7.2 key-changing 整合 + plan §8.1 缺口）
def test_integration_p2_p3_p4_key_changing(monkeypatch, tmp_path):
    """§7.2 跨 Phase 整合測試（WORKFLOW_SOP 規範、Checkout 必驗）。

    串接：真實 run_phase2（mock LLM）→ 真實 run_phase3（FakeTranslator **真改寫頁標題**＝
    key-changing transform、譯 title≠原文）→ 真實 rag_indexer.build_chunk_markdown（純函式、
    零 Embedding）。接縫不變式：雖然 P3 把頁標題翻成不同字串，P4 chunk 仍經 `p{N}_{原文標題}`
    key 對位取得 P2 頁摘要（Chapter Summary 行存在）——HOTFIX-1 類靜默退化照得出來。
    """
    import llm.client as llm_client
    import processor.translator as tr_mod
    import processor.domain_normalizer as dn_mod
    from processor import rag_indexer
    from pipelines.slide_pipeline import SlidePipeline

    tiles = [_t4(1, 'Power Architecture', '800V rack power delivery details.'),
             _t4(2, 'Power Architecture', 'Vienna rectifier specs and SiC.')]
    ctx = _make_p3_ctx(tmp_path, monkeypatch, tiles)   # 先建 ctx（en）
    # P2：mock chat 三呼叫（摘要+domain / 頁摘要 JSON / 翻頁摘要）
    fake_chat = _FakeChat([
        "Deck about power delivery.\ndomain: Power",
        '[{"i":1,"title":"Power Architecture","summary":"rack power overview"},'
        ' {"i":2,"title":"Power Architecture","summary":"vienna rectifier"}]',
        "1. 機櫃供電總覽\n2. 維也納整流器",
    ])
    monkeypatch.setattr(llm_client.LLMClient, 'get_instance',
                        classmethod(lambda cls: fake_chat))
    monkeypatch.setattr(dn_mod, 'normalize_to_lcc', lambda rd, context_text=None: 'TK')
    monkeypatch.setattr(SlidePipeline, '_resolve_domain_name',
                        staticmethod(lambda lcc: 'Tech'))
    # key-changing transform：FakeTranslator 真改寫（譯 title='譯'+原文 ≠ 原文 key）
    fake_tr = _FakeTranslator()
    monkeypatch.setattr(tr_mod, 'Translator', lambda: fake_tr)

    strategy = SlidePipeline()
    gspec = strategy.run_phase2(ctx)
    ctx.glossary_ready = gspec
    strategy.run_phase3(ctx)

    # 接縫斷言①：P3 旁路 summary_key 與 P2 section_summaries key 同基準（原文、非譯文）
    sec_keys = [s['summary_key'] for s in ctx.rag_sections]
    assert sec_keys == ['p01_Power Architecture', 'p02_Power Architecture']
    assert set(sec_keys) == set(gspec.section_summaries.keys())
    assert ctx.rag_sections[0]['title'] == '譯Power Architecture'   # 譯後 title 確實改變

    # 接縫斷言②：真實 chunk 構建——譯後樹 + P2 摘要 → Chapter Summary 對位成功
    chunks = rag_indexer.build_chunk_markdown(
        ctx.rag_sections, gspec.section_summaries, 'slides')
    assert len(chunks) == 2
    assert any('機櫃供電總覽' in c for c in chunks)      # 頁 1 摘要進 chunk（非靜默退化）
    assert any('維也納整流器' in c for c in chunks)      # 頁 2 摘要進 chunk
    assert all('Chapter Summary' in c for c in chunks)


