# === [PIPE-SLIDES-HOTFIX-3 HOTFIX-3 START] === 排版打磨測試
def test_hf3_image_first_and_slide_head(monkeypatch, tmp_path):
    """一-a + C：圖在 .slide-head 前；標題塊 <div class="slide-head"> 含 <h2>+.slide-sub；無 ##/###。"""
    import processor.translator as tr_mod
    from pipelines.slide_pipeline import SlidePipeline
    monkeypatch.setattr(tr_mod, 'Translator', lambda: _FakeTranslator())
    tiles = [_t4(1, 'Arch', '- x', subtitle='sub'), _t4(2, 'Spec', '- y')]  # 2 tiles 避退化路
    ctx = _make_p3_ctx(tmp_path, monkeypatch, tiles, paper_id='deckhf3a')
    spec = SlidePipeline().run_phase3(ctx)
    zh = Path(spec.final_zh_path).read_text(encoding='utf-8')
    assert zh.index('![') < zh.index('<div class="slide-head">')   # 圖先於標題塊
    assert '<h2>譯Arch</h2>' in zh and '<p class="slide-sub">譯sub</p>' in zh
    assert '## 譯Arch' not in zh and '### 譯sub' not in zh          # 無舊 ##/### 標題


def test_hf3_subheading_promoted_to_h3():
    """A/B/C：整行 **X** → ### X；句中 bold 不動；\\r 相容；不產連續空行。"""
    from pipelines.slide_pipeline import SlidePipeline as S
    assert '### B層' in S._promote_subheadings("* a\n**B層**\n* b")
    assert S._promote_subheadings("這是 **強調** 句") == "這是 **強調** 句"   # 句中 bold 不誤升
    assert '### B層' in S._promote_subheadings("* a\r\n**B層**\r\n* b")        # \r 相容
    assert "\n\n\n" not in S._promote_subheadings("* a\n\n**B層**\n* b")       # 不產連續空行


def test_hf3_slide_head_escapes():
    """C：title/subtitle 含 <>& 須 escape 防破版。"""
    from pipelines.slide_pipeline import SlidePipeline as S
    h = S._slide_head_html("A<b> & C", "x>y")
    assert "&lt;b&gt;" in h and "&amp;" in h
    assert '<p class="slide-sub">' in h and "x&gt;y" in h
    assert S._slide_head_html("", "") == ""                        # 全空回空字串


