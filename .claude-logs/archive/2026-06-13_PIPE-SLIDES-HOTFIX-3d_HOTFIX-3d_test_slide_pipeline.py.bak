def test_hf2_translated_title_wired(monkeypatch, tmp_path):
    """F2：正常路封面譯題入 raw_metadata 旁路；run_phase4 傳譯題 + 影子 (測試) 綴。"""
    import paper_manager
    import processor.translator as tr_mod
    from processor import rag_indexer
    from pipelines.slide_pipeline import SlidePipeline
    tiles = [_t4(1, 'Power Deck', '- a'), _t4(2, 'Spec', '- b')]
    fake_tr = _FakeTranslator()
    monkeypatch.setattr(tr_mod, 'Translator', lambda: fake_tr)
    ctx = _make_p3_ctx(tmp_path, monkeypatch, tiles, paper_id='deckhf2_shadow')
    strategy = SlidePipeline()
    spec3 = strategy.run_phase3(ctx)
    # === [PIPE-SLIDES-HOTFIX-1b START] === 格式契約斷言（HOTFIX-1 盲區：裸 str 曾炸影子寫庫）
    tt = ctx.raw_metadata['translated_title']
    assert isinstance(tt, dict) and tt['value'] == '譯Power Deck'   # 三欄 dict、非裸 str
    assert tt.get('source') == 'slide_pipeline' and tt.get('confidence')
    # === [PIPE-SLIDES-HOTFIX-1b END] ===
    captured = {}

    def _fake_index(sections, summaries, doc_type, vdir, **kw):
        captured.update(kw)
        from types import SimpleNamespace
        return SimpleNamespace(index_meta={"chunks_total": 1}, paper_chunk_count=1)
    monkeypatch.setattr(rag_indexer, 'index', _fake_index)
    monkeypatch.setattr(paper_manager, 'get_paper_db_id', lambda o, p: None)
    ctx.bilingual = spec3
    strategy.run_phase4(ctx)
    assert captured['translated_title'] == '譯Power Deck (測試)'   # 譯題 + 影子綴（非暫同取）


def test_hf4_paragraph_breaks_normalized(monkeypatch, tmp_path):
    """F4：純文字連續行 soft break 升級 \\n\\n；pipe table rows 不拆散；端到端進 final_zh。"""
    import processor.translator as tr_mod
    from pipelines.slide_pipeline import SlidePipeline
    out = SlidePipeline._normalize_paragraph_breaks("今日\nAI 伺服器機櫃\n交流輸入")
    assert out == "今日\n\nAI 伺服器機櫃\n\n交流輸入"
    tbl = SlidePipeline._normalize_paragraph_breaks("| A | 1 |\n| B | 2 |")
    assert "| A | 1 |\n| B | 2 |" in tbl                        # table rows 間單 \n 保留

    class _IdTr:                                                # 譯文=原文（聚焦排版斷言）
        def translate(self, text, ictx, mode, text_type="content"):
            return text
    monkeypatch.setattr(tr_mod, 'Translator', lambda: _IdTr())
    tiles = [_t4(1, 'Arch', '今日\n機櫃標籤'), _t4(2, 'Spec', '- ok')]
    ctx = _make_p3_ctx(tmp_path, monkeypatch, tiles, paper_id='deckhf4')
    spec = SlidePipeline().run_phase3(ctx)
    zh = Path(spec.final_zh_path).read_text(encoding='utf-8')
    assert '今日\n\n機櫃標籤' in zh                              # 渲染路已套用
# === [PIPE-SLIDES-HOTFIX-1 HOTFIX-1 END] ===


# === [PIPE-SLIDES-HOTFIX-1b START] === 寫庫端契約消費測試（堵 HOTFIX-1 測試盲區）
def test_hf1b_meta_dict_upsert_compatible(monkeypatch, tmp_path):
    """F2 旁路值必須能被 upsert_paper 同式 `.get('translated_title', {}).get('value')` 消費。

    HOTFIX-1 主回歸：裸 str 在此式下炸 AttributeError（paper_manager.py:231 實式重演）。
    """
    import processor.translator as tr_mod
    from pipelines.slide_pipeline import SlidePipeline
    fake_tr = _FakeTranslator()
    monkeypatch.setattr(tr_mod, 'Translator', lambda: fake_tr)
    tiles = [_t4(1, 'Power Deck', '- a'), _t4(2, 'Spec', '- b')]
    ctx = _make_p3_ctx(tmp_path, monkeypatch, tiles, paper_id='deckhf1b_shadow')
    SlidePipeline().run_phase3(ctx)
    # 與 paper_manager.upsert_paper L231 完全同式取值——裸 str 會在此 AttributeError
    m_tt = ctx.raw_metadata.get('translated_title', {}).get('value')
    assert m_tt == '譯Power Deck'
    # web_server SHADOW-HOTFIX-2 L714 同式賦值亦須可行（dict 可變）
    ctx.raw_metadata['translated_title']['value'] = f"{m_tt} (測試)"
    assert ctx.raw_metadata['translated_title']['value'].endswith(' (測試)')
# === [PIPE-SLIDES-HOTFIX-1b END] ===


# === [META-NORM C3 START] === P1 開放抽取與封面放寬接線測試
def test_c3_meta_norm_p1_wire(monkeypatch, tmp_path):
    """U6/U7/BS1：旗標 on → 開放 metadata 經飛輪對齊；reserved 回填合約、canonical 三欄 dict 入旁路。"""
    import settings
    import processor.meta_normalizer as mn_mod
    monkeypatch.setattr(settings, 'LLM_USE_META_NORM', True)

    # mock 飛輪：作者/期刊→reserved 標記；課程/講師→canonical
    def _fake_normalize(raw_fields, context=""):
        out = {}
        for k, v in raw_fields.items():
            kl = k.strip().lower()
            if kl in ('作者', 'author'):
                out['__reserved__:authors'] = v
            elif kl in ('期刊', 'venue'):
                out['__reserved__:venue'] = v
            elif kl in ('課程', 'course'):
                out['course'] = v
            elif kl in ('講師', 'instructor'):
                out['instructor'] = v
            else:
                out[kl] = v
        return out
    monkeypatch.setattr(mn_mod, 'normalize_fields', _fake_normalize)

    responses = {
        b'p0': _resp('植物營養', '', '', cover={
            "title": "植物營養", "company": "", "date": "", "authors": [],
            "metadata": {"課程": "普通生物學甲", "講師": "鄭佳宜",
                         "作者": "鄭佳宜", "期刊": "Nature"}}),
        b'p1': _resp('內容', '- x', ''),
    }
    spec, ctx, _ = _run_p1(monkeypatch, tmp_path, responses, paper_id='deckc3')
    # reserved 回填合約
    assert spec.authors == ['鄭佳宜'] and spec.venue == 'Nature'
    # canonical 三欄 dict 入旁路
    assert ctx.raw_metadata['course'] == {
        "value": "普通生物學甲", "source": "meta_normalizer", "confidence": "high"}
    assert ctx.raw_metadata['instructor']['value'] == '鄭佳宜'
    # raw_metadata 不含 reserved（authors/venue/title）
    assert 'authors' not in ctx.raw_metadata and 'venue' not in ctx.raw_metadata


def test_c3_meta_norm_p1_wire_flag_off(monkeypatch, tmp_path):
    """U5/向後相容：旗標 off → 退寫死 company/date 路徑、不呼飛輪。"""
    import settings
    import processor.meta_normalizer as mn_mod
    monkeypatch.setattr(settings, 'LLM_USE_META_NORM', False)

    def _boom(*a, **k):
        raise AssertionError("flag off 不應呼 normalize_fields")
    monkeypatch.setattr(mn_mod, 'normalize_fields', _boom)

    responses = {
        b'p0': _resp('封面', '', '', cover={
            "title": "封面", "company": "ACME", "date": "2026", "authors": [],
            "metadata": {"課程": "X"}}),
        b'p1': _resp('內容', '- y', ''),
    }
    spec, ctx, _ = _run_p1(monkeypatch, tmp_path, responses, paper_id='deckc3off')
    assert ctx.raw_metadata.get('company') == 'ACME' and ctx.raw_metadata.get('date') == '2026'
    assert 'course' not in ctx.raw_metadata          # 飛輪未跑
    assert spec.venue is None and spec.doi is None    # 旗標 off venue/doi 留 None
# === [META-NORM C3 END] ===


# === [META-NORM C4 START] === subtitle 結構化測試
def test_c4_subtitle_extraction_and_rendering(monkeypatch, tmp_path):
    """U8/D：subtitle 翻譯 + EN/ZH 渲染 ### {subtitle}；無大標題頁 key/title fallback subtitle。"""
    import processor.translator as tr_mod

    class _IdTr:                                          # 譯文=原文（聚焦結構）
        def translate(self, text, ictx, mode, text_type="content"):
            return text
    from pipelines.slide_pipeline import SlidePipeline
    monkeypatch.setattr(tr_mod, 'Translator', lambda: _IdTr())

    tiles = [_t4(1, 'Plant Nutrition', '- a', subtitle='availability + accessibility'),
             _t4(2, '', '- b', subtitle='只有小標題')]   # 無大標題頁
    ctx = _make_p3_ctx(tmp_path, monkeypatch, tiles, paper_id='deckc4')
    spec = SlidePipeline().run_phase3(ctx)
    zh = Path(spec.final_zh_path).read_text(encoding='utf-8')
    en = Path(spec.final_en_path).read_text(encoding='utf-8')
    # === [PIPE-SLIDES-HOTFIX-3 HOTFIX-3] === 標題塊：<h2>title</h2> + <p class="slide-sub">subtitle
    assert '<h2>Plant Nutrition</h2>' in zh and '<p class="slide-sub">availability + accessibility' in zh
    assert '<h2>Plant Nutrition</h2>' in en and '<p class="slide-sub">availability + accessibility' in en
    # 無大標題頁 → key/title fallback subtitle（p02_只有小標題、不漂移成 p02_）
    keys = [s['summary_key'] for s in ctx.rag_sections]
    assert keys == ['p01_Plant Nutrition', 'p02_只有小標題']
    assert ctx.rag_sections[1]['title'] == '只有小標題'   # section title fallback subtitle


def test_c4_subtitle_translated_in_parallel(monkeypatch, tmp_path):
    """U8：subtitle 走並行翻譯（text_type=title）、譯文進渲染。"""
    import processor.translator as tr_mod
    from pipelines.slide_pipeline import SlidePipeline
    fake = _FakeTranslator()                              # 譯文='譯'+原文
