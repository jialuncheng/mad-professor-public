# ─────────────────────────────────────────────
# 複製本檔為 .env 後填入實際值。.env 已被 .gitignore 忽略，請勿提交。
# ─────────────────────────────────────────────

# ── Gemini API（LLM 與 Embedding，必填）──
# Google Gemini API 金鑰；未設定時 LLMClient 無法初始化。
GEMINI_API_KEY=
# 翻譯使用的模型名稱（未設定時程式內建預設值）。
LLM_TRANSLATE_MODEL=gemini-3.1-flash-lite
# 問答對話使用的模型名稱（未設定時程式內建預設值）。
LLM_CHAT_MODEL=gemini-3.1-flash-lite
# 向量嵌入模型名稱（未設定時程式內建預設值）。
EMBEDDING_MODEL=gemini-embedding-2
# 主題判斷模型（可選，未設定時用 LLM_CHAT_MODEL）
# 建議 Pro 模型以提高判斷準確度，例如 gemini-2.5-pro
# LLM_DOMAIN_MODEL=
#
# ── 後台處理模型細分（皆可選，未設定時 fallback 到 LLM_CHAT_MODEL）──
# 設計理念：面對使用者的回答（Chat / Web search）用 Pro 顧品質；
# 後台批次處理用 Flash 顧速度與成本（不影響使用者直接體驗）。
# 留空 = 沿用 LLM_CHAT_MODEL，行為與未細分時完全相同。
#
# doc_analyzer 的 heading fix / structure 分析（建議 Flash）
# LLM_DOC_MODEL=
# image_caption 與 slides 的 Vision 辨識（建議 Flash）
# LLM_VISION_MODEL=
# extra_info 章節摘要 / 問題 / 公式解析（建議 Flash）
# LLM_EXTRA_INFO_MODEL=

# ── MinerU PDF 解析服務（部署相關，依環境填寫）──
# MinerU 解析 API 端點；未設定時預設 http://localhost:8000/file_parse。
MINERU_API_URL=http://localhost:8000/file_parse
# MINERU_HOST 留空 = 本地/bind-mount 模式
#   此時 MINERU_OUTPUT_DIR 視為本機可讀路徑（例如 /mnt/mineru-output）
# MINERU_HOST 有值 = 遠端模式
#   透過 scp 從遠端主機抓圖（例如 user@10.0.0.5）
# 兩種模式下圖片複製皆為 best-effort，失敗只 warning、不影響其餘流程。
MINERU_HOST=
MINERU_OUTPUT_DIR=
# MinerU HTTP 請求超時（秒）。書籍 PDF 通常需 10-30 分鐘，建議設 1800 以上。
# 若設為非數字字串，程式自動退回預設 1800 秒（防禦性容錯）。
MINERU_TIMEOUT=1800
# ⚠️  CPU 部署模式下，嚴禁設定 MINERU_VIRTUAL_VRAM_SIZE：
#     設為 8 → 程式嘗試分配 8GB 虛擬 VRAM，導致容器 OOM 崩潰
#     設為 4 → 拖慢 MinerU 推理約 33 秒（CPU 排程頻繁喚起 GPU 路徑）
#     GPU 容器中才設定此變數；CPU 部署一律保持此行被完整移除（不留空值也不留 key）。

# ── 環境 ──
# 環境：development 或 production
# development - 本地測試，允許 HTTP
# production - 上線部署，強制 HTTPS
ENVIRONMENT=development

# ── 登入 / Session（部署到公網必填）──
# 登入帳號（單一帳號）。
AUTH_USERNAME=admin
# 密碼的 bcrypt hash；用 python scripts/generate_password_hash.py 產生後貼上。
# 留空時無法登入（系統視為未設定）。
AUTH_PASSWORD_HASH=
# Session cookie 簽章密鑰，至少 32 字元的隨機字串；
# 例：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 部署到 GCP 時務必重新產生、勿沿用範例值。
SESSION_SECRET=

# ── 資料庫（Phase 0：建設用，預設未接線）──
# 未設定時預設 sqlite:///<專案根>/data/mad-professor.db
# Phase 1 接線後才實際使用；未來換 PostgreSQL 只改此行。
# DATABASE_URL=sqlite:///./data/mad-professor.db

# ── Glossary 術語一致性（GLOSSARY-TERMMAP C5 起預設開啟）──
# 領域術語自癒與一致性注入總開關（DOMAIN-NORM + GLOSSARY-CORE + GLOSSARY-TERMMAP 全鏈）。
# 預設 true：B 軌五路 P2 以 build_termmap 建「事前定案術語表」（切塊 census → 已知∪未知分流
# → 僅未知批次翻譯 → 定案 upsert）、P3 逐翻譯單元注入術語強約束（含「譯名＝原文者免括號」）。
# 關回方式：取消註解下行設為 false（單點回退、不需改代碼）；測試期術語庫壞了可直接清
# GlobalGlossary 表重跑（DB 可丟、定案會重建）。
# LLM_USE_GLOSSARY_ALIGN=false

# 術語 census 切塊字元上限（預設 6000≈2-4 段；塊小召回準、塊大省 LLM 呼叫）。
# GLOSSARY_CENSUS_CHUNK_CHARS=6000

# ── 垃圾圖過濾（IMG-FILTER C1 起預設開啟）──
# 文字攝入路之站台 chrome 垃圾圖確定性過濾（面積/長寬比/報頭位置三規則、零 LLM、fail-open）。
# 關回方式：取消註解下行設為 false（單點回退＝圖片全保留、不需改代碼）。
# IMG_FILTER_ENABLED=false

# 規則①面積下限（低於即濾；預設 100000 依實測校正：垃圾 ≤50.4k / 內容最小 177k）。
# IMG_FILTER_MIN_AREA=100000
# 規則②長寬比上限（超過即濾；預設 4.0：垃圾橫條 5.47 / 內容最大 1.85）。
# IMG_FILTER_MAX_ASPECT=4.0
