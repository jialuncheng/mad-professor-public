/* ============================================================
   THEME · Le Corbusier — Polychromie Architecturale + Béton Brut
   ============================================================
   "Une maison est une machine à habiter."
   "L'architecture est le jeu savant, correct et magnifique
    des volumes assemblés sous la lumière."

   不是 Villa Savoye 那種純白純粹主義；
   也不只是 Unité d'Habitation 的清水模——
   而是兩者並置：Purisme 白牆 + Béton Brut + Polychromie 三原色點綴。

   核心語彙：
     · 清水混凝土的暖中性灰（木紋模板痕跡）
     · Villa Savoye 純粹主義白做為「被照亮的牆面」
     · Polychromie Architecturale (1931 / 1959)：
       Rouge Vermillon、Outremer Pâle、Ocre Jaune、Vert Anglais
     · 重黑結構線（他《Vers une architecture》書封 stencil 手字的厚度）
     · Modulor 模矩 / 黃金比例 — 內容欄寬度與字級階梯
     · 完全無圓角、無漸層、無陰影 — 體積、平面、光

   設計轉譯：
     · 主色：béton brut 暖灰
     · served：whitewash 純粹白（中欄＝被光照到的牆）
     · accent：Rouge Vermillon — 他的簽名色（書脊紅）
     · divider：3px 純黑——本主題的差異化記號
       (Mies 1px / Kahn・Kandinsky・Nara 2px / Corbu 3px)
     · 字：Archivo — 中性 grotesque、重量級階梯飽滿
       h1 / h2 / 大標 用 900 黑體 + 緊縮字距 + 大寫，
       逼近他 stencil 手字的視覺重量
     · figure 佔位：清水模灰 + 木紋模板水平線 + 右下三色 loggia chips
       （Unité d'Habitation 陽台立面暗示）

   依賴主檔（Mad Professor Redesign.html）提供：
     · 結構性間距 token  (--space-*)
     · 按鈕／工具列／rail 尺寸 token
     · --divider-w / --radius-*  ← 此檔覆寫
   ============================================================ */

@import url("https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&display=swap");

:root {
  /* ── 色票：béton brut 暖灰 + 純粹主義白 + Polychromie 三原色 ── */
  --color-bg: #c8c2b3;                   /* béton brut：清水模暖灰（較 Kahn 冷灰更暖、帶土黃調） */
  --color-bg-served: #efece2;            /* whitewash：Villa Savoye 純粹白／被光照到的牆 */
  --color-surface: #b8b2a2;              /* hover / 次級表面 */
  --color-surface-2: #a39d8b;            /* rail / 強表面 */
  --color-border: #8e8775;
  --color-border-strong: #4a463c;
  --color-divider: #0a0a0a;              /* 純黑：stencil 手字、結構柱、書脊 */
  --color-text: #0a0a0a;                 /* 純黑 — 不留呼吸，與分隔線同色 */
  --color-text-muted: #4a463c;
  --color-text-subtle: #6b6657;          /* 4.5:1 on #c8c2b3 — 過 AA */
  --color-accent: #c5301d;               /* Rouge Vermillon —《Vers une architecture》書脊紅 */
  --color-accent-hover: #9a2415;
  --color-danger: #c5301d;               /* 同 accent — Polychromie 紀律：紅只有一種 */

  /* ── 結構厚度與圓角 ── */
  --divider-w: 3px;                      /* Corbu 差異化記號：3px 重黑線——最厚的結構柱 */
  --radius-sm: 0;
  --radius-md: 0;

  /* ── 字體 token ── */
  --font-display: "Archivo", "Helvetica Neue", "Helvetica", "Arial",
                  "PingFang TC", "Microsoft JhengHei", sans-serif;
  --font-body: "Archivo", "Helvetica Neue", "Helvetica", "Arial",
               "PingFang TC", "Microsoft JhengHei", sans-serif;
}

body {
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 500;                      /* 500 而非 400：grotesque 在中性灰底上需稍重才壓得住 */
}
.display-font { font-family: var(--font-display); }

/* 中欄 served：被光照到的純粹主義白牆 */
#content-area { background: var(--color-bg-served); }

/* ── 展示控制條：書脊式重字距 ── */
#demo-bar {
  height: 44px;
  padding: 0 var(--space-5);
  gap: var(--space-5);
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 700;                      /* 700 而非 500：呼應 stencil 手字 */
  text-transform: uppercase;
  letter-spacing: 0.16em;
}
#demo-bar .seg button {
  height: 26px;
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-family: inherit;
  font-weight: 700;
}
#demo-bar .credo {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 13px;
  letter-spacing: 0.02em;
  text-transform: none;
  font-weight: 500;
  color: var(--color-text-muted);
}
#demo-bar .credo::before {
  content: "une maison est une machine à habiter";
}

/* ── 三欄標題：stencil 大寫、寬字距、重黑 ── */
#sidebar h1 .title,
#chat-header > .h-title {
  font-family: var(--font-display);
  font-size: 14px;
  font-weight: 800;                      /* 800：再差一階就頂格——書脊招牌字 */
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--color-text);
}
#content-toolbar h2 {
  font-family: var(--font-display);
  font-size: 36px;
  font-weight: 900;                      /* 900：Corbu 招牌字終態 */
  text-transform: uppercase;
  letter-spacing: -0.005em;               /* 重字稍緊縮：壓實體積感 */
  line-height: 1.15;
  color: var(--color-text);
}

/* ── 文章內容 ──
   max-width 760px = Modulor 模矩之一（接近 113×6.7 黃金比段）。
   ── */
#paper-content {
  max-width: 760px;
  padding: var(--space-6) var(--space-8);
}
#paper-content h1 {
  font-family: var(--font-display);
  font-size: 40px;
  font-weight: 900;                      /* 招牌字：書脊 stencil 重黑 */
  text-transform: uppercase;
  line-height: 1.1;
  letter-spacing: -0.01em;
  margin-bottom: var(--space-5);
  color: var(--color-text);
}
#paper-content h2 {
  font-family: var(--font-display);
  font-size: 24px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  margin: var(--space-6) 0 var(--space-3);
  border-bottom: var(--divider-w) solid var(--color-divider);
  padding-bottom: var(--space-2);
}
#paper-content h3 {
  font-family: var(--font-display);
  font-size: 17px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin: var(--space-5) 0 var(--space-2);
}
#paper-content p {
  font-size: 15px;
  font-weight: 400;                      /* 內文回到 400：與大標的 900 做最大反差 */
  line-height: 1.75;
  margin-bottom: var(--space-4);
}
#paper-content em {
  color: var(--color-text-muted);
  font-size: 14px;
  font-style: italic;
}
#paper-content .byline {
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: var(--color-text-muted);
  margin-bottom: var(--space-6);
  padding-bottom: var(--space-3);
  border-bottom: var(--divider-w) solid var(--color-divider);
}
#paper-content .figure { margin: var(--space-6) 0; }

/* ── figure 佔位：清水模 + 木紋模板 + Unité loggia 三色陽台暗示 ──
   底：清水模灰
   水平淡紋：木紋模板（拆模後留下的條紋——béton brut 名稱來源）
   右下三色色塊：Unité d'Habitation 陽台立面 — 藍/黃/紅（Polychromie 三原色）
   ── */
#paper-content .figure .ph {
  background:
    /* 紅色 loggia chip（最下）*/
    linear-gradient(var(--color-accent), var(--color-accent))
      no-repeat 88% 82% / 36px 14px,
    /* 黃色 loggia chip（中）*/
    linear-gradient(#e8a82a, #e8a82a)
      no-repeat 88% 65% / 36px 14px,
    /* 藍色 loggia chip（最上）*/
    linear-gradient(#1d3a8a, #1d3a8a)
      no-repeat 88% 48% / 36px 14px,
    /* 木紋模板水平淡紋（béton brut 的「brut」來源）*/
    repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 19px,
      rgba(0, 0, 0, 0.045) 19px,
      rgba(0, 0, 0, 0.045) 20px),
    var(--color-surface);
  border: var(--divider-w) solid var(--color-divider);
  font-family: var(--font-display);
  color: var(--color-text);
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.24em;
}
#paper-content .figure figcaption {
  font-size: 13px;
  font-weight: 500;
  color: var(--color-text-muted);
  font-style: italic;
  margin-top: var(--space-3);
  text-align: center;
  line-height: 1.6;
  max-width: 560px;
  margin-inline: auto;
}
