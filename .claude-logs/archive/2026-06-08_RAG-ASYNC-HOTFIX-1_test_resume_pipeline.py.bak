# === [RESUME-P3 C5 START] RESUME-P3 逐 heading 契約與退化測試 ===
def _p3_ctx_with_sections(sections, source_lang="en", translated_abstract="中文摘要"):
    """建 P3 ctx：ingestion(tiles=sections) + glossary_ready。"""
    ctx = _ctx()
    ctx.ingestion = IngestionMetadataSpec(title="x", source_lang=source_lang, tiles=sections)
    ctx.glossary_ready = GlossaryReadySpec(
        abstract="a", lcc="QA", glossary={},
        translated_abstract=translated_abstract, domain_name="CS",
    )
    return ctx


def test_p1_optout_no_tiling_call(tmp_path, monkeypatch):
    """C1 opt-out：履歷 P1 _build_tiles 不呼叫 TilingProcessor（消滅 TextTiling 429 根源）。"""
    monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path)
    _mock_p1_processors(monkeypatch)

    class TripTiling:
        def __init__(self, *a, **k):
            pass

        def process(self, *a, **k):
            raise AssertionError("C1 opt-out：履歷不應呼叫 TilingProcessor")

    monkeypatch.setattr(rp, "TilingProcessor", TripTiling)  # 觸線：被呼叫即失敗
    pdf = tmp_path / "p1.pdf"
    pdf.write_bytes(b"%PDF-1.4 fake")

    s = ResumePipeline()
    spec = s.run_phase1(_ctx(pdf_path=str(pdf)))  # 未拋 = opt-out ✓
    assert len(spec.tiles) == 1                    # tiles 來自 JsonProcessor processed（非 Tiling）


def test_p3_per_section_title_and_text_translated(tmp_path, monkeypatch):
    """C3：逐 section 標題/正文分流翻譯；標題已翻、無整行英文標題殘留。"""
    monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path)
    monkeypatch.setattr(ResumePipeline, "_read_source_text", lambda self, ctx: "EN FULL TEXT")
    captured = {"title": 0, "content": 0}

    class FakeTr:
        def __init__(self, *a, **k):
            pass

        def translate(self, text, ctx, mode, text_type="content"):
            captured[text_type] = captured.get(text_type, 0) + 1
            return "中文譯文"

    monkeypatch.setattr(rp, "Translator", FakeTr)
    sections = [
        {"title": "Experience", "level": 2,
         "content": [{"type": "text", "content": "Senior Engineer at ACME (2020-2024)"}],
         "children": []},
        {"title": "Education", "level": 2,
         "content": [{"type": "text", "content": "PhD in Computer Science, MIT 2016"}],
         "children": []},
    ]
    s = ResumePipeline()
    spec = s.run_phase3(_p3_ctx_with_sections(sections))

    assert captured["title"] == 2                   # 兩標題分流翻譯（text_type="title"）
    assert captured["content"] == 2                 # 兩正文分流翻譯（text_type="content"）
    zh = Path(spec.final_zh_path).read_text(encoding="utf-8")
    assert "## Experience" not in zh and "## Education" not in zh  # 無整行英文標題殘留
    assert "中文譯文" in zh


