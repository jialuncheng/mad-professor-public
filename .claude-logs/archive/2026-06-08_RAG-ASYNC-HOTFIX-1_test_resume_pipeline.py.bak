    assert any("Email" in c for c in inj.constraints)     # 含履歷專屬規則
    # === [RESUME-P3 META-HOTFIX-1] (測試) 後綴現出現在 meta header h1（baron 拍板保留、便於觀察）===
    assert "# 王小明 (測試)" in Path(spec.final_zh_path).read_text(encoding="utf-8")


def test_c5_shadow_write_uses_raw_metadata(tmp_path, monkeypatch):
    """v9-④：C5 影子寫庫——upsert_paper 收到的 meta_dict 沿用 ctx.raw_metadata 整包 +
    title 繼承 (測試)；domain_name 傳入。模擬 run_pipeline_shadow（mock Orchestrator/upsert）。"""
    import asyncio

    import pipelines  # noqa: F401
    import web_server

    monkeypatch.setattr(web_server, "OUTPUT_DIR", tmp_path)
    captured = {}

    def fake_upsert(base, owner, pid, paths, metadata=None, **kw):
        captured["metadata"] = metadata
        captured["domain"] = kw.get("domain")
        captured["original_filename"] = kw.get("original_filename")
        return 1

    monkeypatch.setattr(web_server.paper_manager, "upsert_paper", fake_upsert)

    class FakeOrch:
        def run(self, ctx):
            ctx.raw_metadata = {
                "candidate_name": {"value": "王小明"},
                "domain": {"value": "程式設計"},
                "email": {"value": "john@x.com", "source": "regex"},
            }
            ctx.ingestion = IngestionMetadataSpec(
                title="王小明 (測試)", source_lang="en", tiles=[]
            )
            ctx.glossary_ready = GlossaryReadySpec(
                abstract="a", lcc="QA", glossary={},
                translated_abstract="中文摘要", domain_name="CS",
            )
            ctx.bilingual = BilingualMarkdownSpec(
                final_zh_path=str(tmp_path / "zh.md"),
                final_en_path=str(tmp_path / "en.md"),
                translated_abstract="中文摘要",
            )
            return ctx

    monkeypatch.setattr(pipelines, "Orchestrator", FakeOrch)

    owner, pid = 777002, "pC5"
    try:
        asyncio.run(
            web_server.run_pipeline_shadow(owner, pid, "/tmp/x.pdf", "resume", "x.pdf")
        )
    finally:
        with web_server.tasks_lock:
            web_server.processing_tasks.pop((owner, f"{pid}_shadow"), None)

    meta = captured["metadata"]
    assert meta is not None
    # 整包 raw_metadata 保真（對齊 A 軌 upsert_paper(self._metadata)）
    assert "candidate_name" in meta and "domain" in meta and "email" in meta
    assert meta["title"]["value"] == "王小明 (測試)"      # title 繼承 P1 (測試) 後綴
    assert meta["translated_abstract"]["value"] == "中文摘要"
    assert captured["domain"] == "CS"                      # domain_name 傳入
# === [PIPE-RESUME v9 C6 END] ===


