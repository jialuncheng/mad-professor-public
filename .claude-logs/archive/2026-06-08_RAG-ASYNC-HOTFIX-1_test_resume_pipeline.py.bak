# === [RESUME-P3 HEADING-HOTFIX-1 START] ===
def test_p3_heading_level_by_recursion_depth(tmp_path, monkeypatch):
    """HEADING-HOTFIX-1：標題層級來自遞迴深度（非資料 level 欄）。

    3 層巢狀 section、所有節點 level 欄故意全填 1（複現原短路陷阱）：
    頂層→h2(##)、子層→h3(###)、孫層→h4(####)，證明階層由 children 深度推算、
    不再塌成單一 h1。translate 回顯原文以便定位標題行。
    """
    monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path)
    monkeypatch.setattr(ResumePipeline, "_read_source_text", lambda self, ctx: "EN FULL TEXT")

    class FakeTr:
        def __init__(self, *a, **k):
            pass

        def translate(self, text, ctx, mode, text_type="content"):
            return text                                   # 回顯：便於定位標題與層級

    monkeypatch.setattr(rp, "Translator", FakeTr)
    # 全節點 level=1（恆=1 扁平死欄陷阱）；文字長度均衡避免觸 C4 退化 fallback
    sections = [
        {"title": "TopExperience", "level": 1,
         "content": [{"type": "text", "content": "alpha content text here"}],
         "children": [
             {"title": "MidCompany", "level": 1,
              "content": [{"type": "text", "content": "beta content text here"}],
              "children": [
                  {"title": "LeafRole", "level": 1,
                   "content": [{"type": "text", "content": "gamma content text here"}],
                   "children": []},
              ]},
         ]},
    ]
    s = ResumePipeline()
    spec = s.run_phase3(_p3_ctx_with_sections(sections))
    zh = Path(spec.final_zh_path).read_text(encoding="utf-8")

    # 三層各自的層級由遞迴深度推算（depth 0/1/2 → h2/h3/h4）
    assert "## TopExperience" in zh
    assert "### MidCompany" in zh
    assert "#### LeafRole" in zh
    # 防塌陷：頂層非 h1（不得退回單一層級），且至少存在兩個不同層級
    assert "# TopExperience" not in zh.replace("## TopExperience", "")
    assert ("## " in zh) and ("### " in zh)
# === [RESUME-P3 HEADING-HOTFIX-1 END] ===


# === [RESUME-P3 PARA-HOTFIX-1 START] ===
def test_p3_text_paragraph_blank_line_normalized():
    """PARA-HOTFIX-1：text 段落單 \\n 升級 \\n\\n（空行）、pipe table rows 保留單 \\n。

    直接驗 helper `_normalize_paragraph_breaks`：
    (a) 兩段以單一 \\n 分隔 → 升級為 \\n\\n（CommonMark 才會分段）。
    (b) pipe table 兩 rows 以單 \\n 分隔 → 保留（table 結構不被拆散）。
    """
    raw = "第一段文字\n第二段文字\n\n| 欄位 | 值 |\n| 學歷 | 博士 |"
    out = ResumePipeline._normalize_paragraph_breaks(raw)

    # (a) 一般段落：單 \n 升級成 \n\n
    assert "第一段文字\n\n第二段文字" in out
    assert "第一段文字\n第二段文字" not in out      # 不應殘留單 \n（黏連）
    # (b) pipe table rows：單 \n 保留、不被升級拆散
    assert "| 欄位 | 值 |\n| 學歷 | 博士 |" in out
# === [RESUME-P3 PARA-HOTFIX-1 END] ===


# === [RESUME-P3 META-HOTFIX-1 START] ===
def test_p3_meta_header_rendered(tmp_path, monkeypatch):
    """META-HOTFIX-1：P1 meta 經 run_phase3 組無序列表 header 進 final。

    # 姓名（沿用 title 含 (測試)）+ 領域/機構/電話/Email 各為獨立 list item（一欄一行、
    規範保證、不軟換行）；走現有 ctx.raw_metadata 旁路 + ctx.ingestion.title。
    """
    monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path)
    monkeypatch.setattr(ResumePipeline, "_read_source_text", lambda self, ctx: "EN FULL TEXT")

    class FakeTr:
        def __init__(self, *a, **k):
            pass

        def translate(self, text, ctx, mode, text_type="content"):
            return "中文譯文"

    monkeypatch.setattr(rp, "Translator", FakeTr)
    sections = [
        {"title": "工作經歷", "level": 1,
         "content": [{"type": "text", "content": "alpha text"}], "children": []},
        {"title": "學歷", "level": 1,
         "content": [{"type": "text", "content": "beta text"}], "children": []},
    ]
    ctx = _p3_ctx_with_sections(sections)
    ctx.ingestion = IngestionMetadataSpec(title="王小明 (測試)", source_lang="en", tiles=sections)
    ctx.raw_metadata = {
        "domain": {"value": "IC 設計", "source": "llm", "confidence": "high"},
        "organization": {"value": "聯詠科技", "source": "llm", "confidence": "high"},
        "phone": {"value": "0912-345-678", "source": "regex", "confidence": "high"},
        "email": {"value": "wang@example.com", "source": "regex", "confidence": "high"},
    }
    s = ResumePipeline()
    spec = s.run_phase3(ctx)
    zh = Path(spec.final_zh_path).read_text(encoding="utf-8")

    # (a) 以 # 王小明 (測試) 開頭（沿用 title 原值、後綴保留）
    assert zh.startswith("# 王小明 (測試)")
    # (b) 四欄標籤與值都進 final
    assert "IC 設計" in zh and "聯詠科技" in zh
    assert "0912-345-678" in zh and "wang@example.com" in zh
    # (c) 各欄為獨立無序列表行（一欄一行、防 CommonMark 軟換行）
    assert "\n- **領域**：IC 設計" in zh
    assert "\n- **機構**：聯詠科技" in zh
    assert "\n- **電話**：0912-345-678" in zh
    assert "\n- **Email**：wang@example.com" in zh
# === [RESUME-P3 META-HOTFIX-1 END] ===


# === [RESUME-PERF-1 C3 START] 並行翻譯專屬測試（mock Translator 確定化、不打真 API）===
class _DetTr:
    """確定化 Translator：translate(text) → f'ZH::{text}'（並行 byte 等拍用）。"""
    def __init__(self, *a, **k):
        pass

    def translate(self, text, ctx, mode, text_type="content"):
        return f"ZH::{text}"


def test_p3_parallel_order_byte_equal():
    """C2 並行翻譯保序：多層 section〔title/text/raw/children〕還原與序列預期逐字相同。"""
    sections = [
        {"title": "Top", "level": 1,
         "content": [{"type": "text", "content": "alpha"},
                     {"type": "figure", "content": "![](x.png)"}],
         "children": [
             {"title": "Child", "level": 1,
              "content": [{"type": "text", "content": "beta"}],
              "children": []},
         ]},
    ]
    s = ResumePipeline()
    # inj 由 _DetTr 忽略，傳 None 即可（直接驗 _restore，避開 META header 干擾）
    body = s._restore_sections_markdown(sections, None, _DetTr(), translate=True)
    expected = (
        "## ZH::Top\n\n"
        "ZH::alpha\n\n"
        "![](x.png)\n\n"
        "### ZH::Child\n\n"
        "ZH::beta\n"
    )
    assert body == expected     # 並行版輸出 byte 等於序列預期（保序 + 層級 + raw passthrough）


def test_p3_parallel_concurrency_capped(monkeypatch):
    """C2 受限並行：同時進入翻譯的執行緒峰值 ≤ LLM_MAX_CONCURRENT（patch 為 2）。"""
    import threading
    import time

    monkeypatch.setattr(rp, "LLM_MAX_CONCURRENT", 2)
    state = {"cur": 0, "max": 0}
    lock = threading.Lock()

    class _ConcTr:
        def __init__(self, *a, **k):
            pass

        def translate(self, text, ctx, mode, text_type="content"):
            with lock:
                state["cur"] += 1
                state["max"] = max(state["max"], state["cur"])
            time.sleep(0.02)                       # 製造重疊窗口
            with lock:
                state["cur"] -= 1
            return f"ZH::{text}"

    sections = [
        {"title": f"S{i}", "level": 1,
         "content": [{"type": "text", "content": f"t{i}"}], "children": []}
        for i in range(6)
    ]
    s = ResumePipeline()
    s._restore_sections_markdown(sections, None, _ConcTr(), translate=True)

    assert state["max"] >= 1                        # 確有並行
    assert state["max"] <= 2                        # 受 LLM_MAX_CONCURRENT 限


def test_p3_parallel_unit_error_isolated(tmp_path, monkeypatch):
    """C2 異常隔離：單一單元翻譯拋例外 → 退回原文、其餘正常、BilingualMarkdownSpec 仍交付。"""
    monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path)
    monkeypatch.setattr(ResumePipeline, "_read_source_text", lambda self, ctx: "EN FULL")

    class _ErrTr:
        def __init__(self, *a, **k):
            pass

        def translate(self, text, ctx, mode, text_type="content"):
            if "BOOM" in text:
                raise RuntimeError("unit translate fail")
            return f"ZH::{text}"

    monkeypatch.setattr(rp, "Translator", _ErrTr)
    sections = [
        {"title": "Good", "level": 1,
         "content": [{"type": "text", "content": "alpha"}], "children": []},
        {"title": "Bad", "level": 1,
         "content": [{"type": "text", "content": "BOOM-text"}], "children": []},
    ]
    s = ResumePipeline()
    spec = s.run_phase3(_p3_ctx_with_sections(sections))
    zh = Path(spec.final_zh_path).read_text(encoding="utf-8")

    assert isinstance(spec, BilingualMarkdownSpec)   # 仍交付
    assert "ZH::alpha" in zh                          # 正常單元已翻
    assert "BOOM-text" in zh                          # 失敗單元退回原文
    assert "ZH::BOOM-text" not in zh                  # 失敗單元未被翻譯


def test_p3_parallel_degraded_single_call(tmp_path, monkeypatch):
    """C2 退化路徑不並行：heading 退化 → _translate_whole 整檔單呼叫（calls==1）。"""
    monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path)
    monkeypatch.setattr(ResumePipeline, "_read_source_text", lambda self, ctx: "WHOLE EN")
    captured = {"calls": 0}

    class _WholeTr:
        def __init__(self, *a, **k):
            pass

        def translate(self, text, ctx, mode, text_type="content"):
            captured["calls"] += 1
            return "中文整檔"

    monkeypatch.setattr(rp, "Translator", _WholeTr)
    # 單一巨 section（heading 數 < 2）→ 退化 → 整檔 fallback、不走並行逐 unit
    sections = [{"title": "All", "level": 1,
                 "content": [{"type": "text", "content": "x" * 500}], "children": []}]
    s = ResumePipeline()
    spec = s.run_phase3(_p3_ctx_with_sections(sections))

    assert captured["calls"] == 1                     # 整檔一次、未並行逐 unit
    assert isinstance(spec, BilingualMarkdownSpec)
# === [RESUME-PERF-1 C3 END] ===
# === [PIPE-RESUME C6 END] ===
