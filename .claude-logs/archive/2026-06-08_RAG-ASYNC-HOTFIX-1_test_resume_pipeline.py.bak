def test_p3_degraded_single_giant_section_fallback(tmp_path, monkeypatch):
    """C4：單一巨 section（heading 退化）→ 降級整檔翻譯 fallback、仍交付契約。"""
    monkeypatch.setattr(settings, "OUTPUT_DIR", tmp_path)
    monkeypatch.setattr(ResumePipeline, "_read_source_text", lambda self, ctx: "WHOLE EN RESUME")
    captured = {"calls": 0, "types": []}

    class FakeTr:
        def __init__(self, *a, **k):
            pass

        def translate(self, text, ctx, mode, text_type="content"):
            captured["calls"] += 1
            captured["types"].append(text_type)
            return "中文整檔"

    monkeypatch.setattr(rp, "Translator", FakeTr)
    # 單一巨 section（heading 數 < 2 + 佔比 100%）→ 退化
    sections = [{"title": "All", "level": 1,
                 "content": [{"type": "text", "content": "x" * 500}], "children": []}]
    s = ResumePipeline()
    spec = s.run_phase3(_p3_ctx_with_sections(sections))

    assert captured["calls"] == 1                   # 整檔一次翻譯（非逐 section）
    assert captured["types"] == ["content"]         # fallback 走 content 整檔
    assert isinstance(spec, BilingualMarkdownSpec)
    assert spec.translated_abstract == "中文摘要"     # 契約沿用 P2


