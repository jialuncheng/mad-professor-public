<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<title>MadPro · AI 論文閱讀器</title>
<!-- 簡單 SVG favicon：三條橫線（漢堡圖示，呼應介面 icon 系統） -->
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23111' stroke-width='2' stroke-linecap='round'%3E%3Cpath d='M4 6h16M4 12h16M4 18h16'/%3E%3C/svg%3E">
<!-- === [FE-PERF-2 C1] === marked 9.1.6 自託管（原 CDN 同版換源、離線/GFW 零跨源依賴、比照 KaTeX vendored；defer 屬 C2） -->
<script src="/static/vendor/marked/marked.min.js" defer></script>
<!-- === [SEC-XSS C1] === DOMPurify 3.1.6 自託管（HTML 消毒引擎·marked 輸出防 stored XSS；接線見 SEC-XSS C2/C3） -->
<script src="/static/vendor/dompurify/purify.min.js" defer></script>
<!-- === [RAG-12 C1] === 自託管 KaTeX 0.16.47（前端數學渲染、離線/GFW；接線見 RAG-12 C2/C3） -->
<!-- === [FE-PERF-2 C4] === KaTeX 兩支核心字型 preload（preload scanner 於 CSSOM 建成前即抓、消公式字型 FOUT/版跳；僅此二支、防無公式頁過度預載） -->
<link rel="preload" href="/static/vendor/katex/fonts/KaTeX_Main-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/static/vendor/katex/fonts/KaTeX_Math-Italic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/static/vendor/katex/katex.min.css">
<script src="/static/vendor/katex/katex.min.js" defer></script>
<!-- === [RAG-12 C1 END] === -->
<!-- === [FE-CSS-GOV C1] === CSS 治理拆檔：inline <style> 等價遷出至 static/css/ 7 關注點檔（載入序＝原 source 序、cascade 等價；@layer 化屬 C2、#theme-link 仍殿後） -->
<link rel="stylesheet" href="/static/css/globals.css">
<link rel="stylesheet" href="/static/css/overlays.css">
<link rel="stylesheet" href="/static/css/layout.css">
<link rel="stylesheet" href="/static/css/sidebar.css">
<link rel="stylesheet" href="/static/css/content.css">
<link rel="stylesheet" href="/static/css/chat.css">
<link rel="stylesheet" href="/static/css/print.css">
<!-- 主題版型：切換 href 即可換主題。可選：themes/mies.css、themes/kahn.css。
     置於 7 個 static/css/ link 之後是刻意安排：CSS 後出者勝，讓主題 :root 覆寫主檔 fallback
     （FE-CSS-GOV C1 更新註：原述「置於 </style> 之後」；C2 @layer 化後改由 unlayered>layered 語意保證主題必贏）。-->
<link rel="stylesheet" id="theme-link" href="/static/themes/kahn.css">
</head>
<body>

<!-- ────────── Tooltip 與 Modal 容器 ────────── -->
<div id="tooltip" role="tooltip"></div>

<!-- 系統介紹（Help）Modal — 點 #help-btn 開啟，點遮罩或「了解了」關閉 -->
<div id="help-modal" class="modal-mask">
  <div id="help-box" class="modal-box" role="dialog" aria-labelledby="help-title">
    <h3 id="help-title">文件上傳流程</h3>
    <ol>
      <li>點擊「上傳」icon，選擇 PDF 檔案</li>
      <li>選擇文件類型（學術論文、簡報、書籍等）</li>
      <li>點擊「確認，開始處理」</li>
      <li>等待處理完成（含翻譯、建立向量索引）</li>
      <li>完成後論文出現在左側列表</li>
    </ol>
    <p class="step-note">每次只能上傳一份文件；如選多份會出現提示；上傳期間可繼續上傳下一份</p>
    <p class="step-note">僅支援 PDF 格式</p>
    <p class="step-note">檔案大小上限：100 MB</p>
    <p class="step-note">支援類型：學術論文、書籍、技術文件、簡報、新聞、網頁存檔</p>
    <p class="step-note">問答使用 Ctrl+Enter 送出</p>
    <div class="modal-actions">
      <button id="help-close-btn" class="modal-btn primary">了解了</button>
    </div>
  </div>
</div>

<!-- 切換風格 Modal — 點 #theme-btn 開啟 -->
<div id="theme-modal" class="modal-mask">
  <div id="theme-box" class="modal-box" role="dialog" aria-labelledby="theme-title">
    <h3 id="theme-title">切換風格</h3>
    <p>選擇介面美學風格，切換後立即生效</p>
    <div class="dropdown" id="theme-dropdown" data-value="kandinsky">
      <button type="button" class="dropdown-trigger" aria-haspopup="listbox" aria-expanded="false">
        <span class="dropdown-value">Kandinsky · Bauhaus</span>
        <svg viewBox="0 0 24 24" class="dropdown-chevron"><path d="M6 9l6 6 6-6"/></svg>
      </button>
    </div>
    <!-- 上傳自訂主題 CSS 按鈕（後端 endpoint /api/themes/upload 已 ship） -->
    <input type="file" id="theme-upload-input" accept=".css" style="display:none">
    <div class="modal-actions">
      <button id="theme-upload-btn" class="modal-btn">上傳 CSS</button>
      <button id="theme-ok-btn" class="modal-btn primary">確認切換</button>
    </div>
  </div>
</div>

<!-- tag 編輯 Modal — 點 #edit-tags-btn 開啟、寫入 metadata_json.user_tags 陣列 -->
<div id="tag-modal" class="modal-mask">
  <div id="tag-box" class="modal-box" role="dialog" aria-labelledby="tag-title">
    <h3 id="tag-title">編輯標籤</h3>
    <p>輸入 hashtag、以空格分隔；# 可有可無；輸入後將自動 lowercase 標準化</p>
    <input type="text" id="tag-input" class="modal-input"
           placeholder="#plant #complex_system"
           autocomplete="off">
    <div class="modal-actions">
      <button id="tag-cancel-btn" class="modal-btn">取消</button>
      <button id="tag-save-btn" class="modal-btn primary">儲存</button>
    </div>
  </div>
</div>

<!-- 文件類型確認 Modal
     OPTIMIZE-1 C2 Phase-Shift：ESC / 遮罩關閉已解鎖（Cancel 路徑零網路請求）。
     data-no-esc="false" / data-no-mask-close="false" 允許 ESC 與遮罩關閉 Modal。 -->
<div id="confirm-modal" class="modal-mask" data-no-esc="false" data-no-mask-close="false">
  <div id="confirm-box" class="modal-box" role="dialog" aria-labelledby="confirm-title">
    <h3 id="confirm-title">選擇文件類型</h3>
    <p id="confirm-desc">請選擇文件類型，系統將根據類型選擇最佳解析方式。</p>
    <div class="dropdown" id="doc-type-dropdown" data-value="academic">
      <button type="button" class="dropdown-trigger" aria-haspopup="listbox" aria-expanded="false">
        <span class="dropdown-value">學術論文</span>
        <svg viewBox="0 0 24 24" class="dropdown-chevron"><path d="M6 9l6 6 6-6"/></svg>
      </button>
    </div>
    <div class="modal-actions">
      <button id="confirm-cancel-btn" class="modal-btn">取消</button>
      <button id="confirm-ok-btn" class="modal-btn primary">確認，開始處理</button>
    </div>
  </div>
</div>

<!-- 通用確認 Modal — 取代瀏覽器原生 confirm()；由 customConfirm() 動態填內容 -->
<div id="action-modal" class="modal-mask">
  <div id="action-box" class="modal-box" role="dialog" aria-labelledby="action-title">
    <h3 id="action-title">確認</h3>
    <p id="action-body"></p>
    <div class="modal-actions">
      <button id="action-cancel" class="modal-btn">取消</button>
      <button id="action-ok" class="modal-btn primary">確定</button>
    </div>
  </div>
</div>

<!-- 通用提示 Modal — 取代瀏覽器原生 alert()；由 customAlert() 動態填內容 -->
<div id="notice-modal" class="modal-mask">
  <div id="notice-box" class="modal-box" role="dialog" aria-labelledby="notice-title">
    <h3 id="notice-title">提示</h3>
    <p id="notice-body"></p>
    <div class="modal-actions">
      <button id="notice-ok" class="modal-btn primary">知道了</button>
    </div>
  </div>
</div>

<!-- BUG-F4 A3（ui-fixes-batch A3.1）：通用輸入 Modal — 取代瀏覽器原生 prompt()
     跟 v2 BUG-F2 A6 ESC handler 自動相容（modal-mask 走通用 ESC 邏輯：先 popup 再 modal）。
     #prompt-input 套用 BUG-F3 ship 的 .modal-input CSS 樣式（同 .modal-box select 規格）。 -->
<div id="prompt-modal" class="modal-mask">
  <div id="prompt-box" class="modal-box" role="dialog" aria-labelledby="prompt-title">
    <h3 id="prompt-title">輸入</h3>
    <p id="prompt-body"></p>
    <input type="text" id="prompt-input" class="modal-input">
    <div class="modal-actions">
      <button id="prompt-cancel" class="modal-btn">取消</button>
      <button id="prompt-ok" class="modal-btn primary">確定</button>
    </div>
  </div>
</div>

<!-- ──────────────  三欄主版面  ────────────── -->
<div id="app">

  <!-- ──── 左欄 ──── -->
  <aside id="sidebar">
    <h1>
      <span class="title">文件列表</span>
      <div class="toolbar-actions">
        <button id="new-folder-btn" class="icon-only" data-tip="新資料夾">
          <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
        </button>
        <button id="sidebar-toggle" class="icon-only" data-tip="收合本欄">
          <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </h1>

    <div id="folder-tree"></div>

    <div id="paper-list"></div>

    <div id="sidebar-bottom">
      <div class="sb-row">
        <button id="logout-btn" class="icon-only" data-tip="退出系統">
          <svg viewBox="0 0 24 24"><path d="M15 12H4M9 7l-4 4a1.5 1.5 0 0 0 0 2l4 4M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4"/></svg>
        </button>
        <button id="cleanup-btn" class="icon-only" data-tip="清除殘檔">
          <svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
        </button>
        <button id="help-btn" class="icon-only" data-tip="系統介紹">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9.2 9.5a2.8 2.8 0 0 1 5.4.5c0 2-2.6 2-2.6 4"/><circle cx="12" cy="17" r="0.6" fill="currentColor" stroke="none"/></svg>
        </button>
        <button id="theme-btn" class="icon-only" data-tip="切換風格">
          <!-- 三個並排矩形：palette swatch；元素數 = 3，與漢堡密度相當 -->
          <svg viewBox="0 0 24 24"><rect x="3" y="6" width="5" height="12"/><rect x="9.5" y="6" width="5" height="12"/><rect x="16" y="6" width="5" height="12"/></svg>
        </button>
        <button id="upload-btn" class="icon-only" data-tip="上傳文件">
          <svg viewBox="0 0 24 24"><path d="M5 20h14M12 16V5M7 9l4-4a1.5 1.5 0 0 1 2 0l4 4"/></svg>
        </button>
      </div>
    </div>
  </aside>

  <!-- ──── 中欄 ──── -->
  <main id="content-area">
    <div id="content-toolbar">
      <!-- title 區放 toolbar 內、取 flex:1 槽位（多行可自然展開）。
           沒 paper 時走 innerHTML='' 清空、不用 hidden 屬性（hidden 會 display:none
           退出 flex layout、actions 會滑左）；元素永遠佔 flex:1 槽位 -->
      <header id="current-title"></header>
      <div class="toolbar-actions">
        <button id="lang-toggle" class="icon-only" data-tip="語言切換">
          <!-- 切換符號：水平 ⇄；兩條短橫線錯位、不重疊 -->
          <svg viewBox="0 0 24 24"><path d="M17 4l3 3-3 3M20 7H10"/><path d="M7 14l-3 3 3 3M4 17h10"/></svg>
        </button>
        <button id="print-btn" class="icon-only" data-tip="列印文件">
          <svg viewBox="0 0 24 24"><path d="M7 9V3h10v6"/><path d="M7 18H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2"/><path d="M7 14h10v7H7z"/></svg>
        </button>
        <!-- # 標籤編輯按鈕（toolbar-actions 末尾、極小 icon-only、開啟 #tag-modal） -->
        <button id="edit-tags-btn" class="icon-only" data-tip="編輯標籤">
          <svg viewBox="0 0 24 24"><path d="M4 9h16M4 15h16M10 3L8 21M16 3l-2 18"/></svg>
        </button>
      </div>
    </div>
    <div id="abstract-toolbar" style="display:none"></div>
    <!-- BUG-F4 A2（ui-fixes-batch A2）：預設顯示反轉——empty-state 預設顯示、paper-content 預設 hide
         既有 loadPaper 內 toggle 邏輯不變（hide empty / show paper）；
         初始無 paper 時中欄顯示「從左側選擇文件」、不再空白 -->
    <div id="empty-state">
      <svg width="16" height="16" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-6-6a1.5 1.5 0 0 1 0-2l6-6"/></svg>
      從左側選擇文件
    </div>
    <div id="paper-content" style="display:none"></div>
  </main>

  <!-- ──── 右欄 ──── -->
  <aside id="chat-panel">
    <div id="chat-header">
      <span class="h-title">AI 問答</span>
      <div id="chat-header-actions">
        <button id="web-search-toggle" class="icon-only active" type="button" disabled data-tip="Search 開關">
          <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.3-4.3"/></svg>
        </button>
        <button id="export-btn" class="icon-only" data-tip="下載 MD">
          <svg viewBox="0 0 24 24"><path d="M12 4v12M7 11l4 4a1.5 1.5 0 0 0 2 0l4-4M5 20h14"/></svg>
        </button>
        <button id="chat-toggle" class="icon-only" data-tip="收合本欄">
          <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
    <div id="chat-messages"></div>
    <div id="chat-input-area">
      <!-- chat-input：contenteditable div（取代 textarea）、支援 inline hashtag token
           plan v2 §3.3.2 + §3.3.5 四點防護；data-placeholder 配對 CSS :empty::before -->
      <div id="chat-input"
           contenteditable="false"
           role="textbox"
           aria-multiline="true"
           aria-label="對話輸入"
           data-placeholder="輸入問題（Ctrl+Enter 送出）&#10;輸入 # 可加入 hashtag 跨文獻搜尋"></div>
      <!-- Autocomplete dropdown：定位錨點綁容器（§3.3.5-#4）、非綁 cursor -->
      <!-- BUG-F2 Bug 11（P2-3 latent fix）：移除 .ctx-popup class、避免被 closePopups() 永久 .remove()。
           .hashtag-popup 為 standalone 完整定義（position / background / border / box-shadow 全有、
           不依賴 .ctx-popup base style、見 #hashtag-autocomplete.hashtag-popup CSS L1042-1057）。 -->
      <div id="hashtag-autocomplete" class="hashtag-popup" hidden>
        <!-- 動態填入 .hashtag-popup-item；最後一筆若超過 10 個顯示 .hashtag-popup-more -->
      </div>
    </div>
  </aside>
</div>

<script>
// === [FE-PERF-2 C2] === DOMContentLoaded 包裹 START（marked/katex 已 defer；deferred script 保證先於 DOMContentLoaded 執行、marked.use 安全；既有內文縮排維持原樣不重排）
document.addEventListener('DOMContentLoaded', () => {
  // 關閉 GFM strikethrough（~~text~~ 與單 ~ 撞線）
  //
  // 為何：marked.js 預設啟用 GFM strikethrough、單 ~ 也會匹配。論文 / 履歷
  //       常見「100~500 人」「2003/8~ 仍在職」這類數值範圍會被誤判為刪除線。
  // 何時可移除：marked.js 升到能精準區分「波浪號範圍」與「strikethrough」之後；
  //             或全文清掃確認無合法 ~~text~~ 用法時。
  // 全域 override 所有 marked.parse 呼叫
  marked.use({
    extensions: [{
      name: 'del',
      level: 'inline',
      start() { return -1; },        // 從不主動匹配
      tokenizer() { return false; }, // 永不產生 del token
      renderer() { return ''; }
    }]
  });

  // === [RAG-12 C2 START] === 核心數學渲染管線（三階段順序佔位 + 自託管 KaTeX）
  // 依 plan_v7 §2.1 七步 + §2-5 無 lookbehind texmath 正則 + 步驟 7 ESC 還原。
  // 佔位符鐵律：math 佔位**穿透 marked.parse**，故不可用 `__x__`（marked GFM 雙底線→<strong>，
  //   實測 `__MATH_PLACEHOLDER_0__`→`<strong>...`、步驟 7 撈不到）→ 改用 Unicode PUA 哨兵
  //   `{idx}`（不可見、零 markdown 語意、零撞內容；marked block/inline 皆原樣穿透）。
  //   code/ESC 佔位於步驟 5（marked.parse 前）即還原、不穿透 marked，故維持 `__x__` 可。
  function renderMarkdownWithMath(raw) {
    if (raw == null) raw = '';
    const MO = '\uE000', MC = '\uE001';     // math 佔位哨兵（Unicode PUA、marked 原樣穿透）
    const codeBlocks = [], mathBlocks = [], imgBlocks = [];
    let t = String(raw);
    // 1. 抽 code（fenced + inline）→ 佔位（步驟 5 還原、不穿透 marked）
    t = t.replace(/(```[\s\S]*?```|`[^`\n]+?`)/g, function (m) {
      codeBlocks.push(m); return '__CODE_PLACEHOLDER_' + (codeBlocks.length - 1) + '__';
    });
    // === [RAG-12-HOTFIX-1 START] === 1.5 抽 markdown 圖片整段 → 佔位（步驟 5 還原、marked.parse 前）
    //   真因：圖說（figure_description）整段塞進 ![alt](url) 之 alt；alt 內若含 $...$（如氮循環圖
    //   $N_2$/$\text{NH}_4^+$），步驟 4 會抽成 math 佔位 → 步驟 7 把 katex.renderToString 的
    //   <span class="katex">…（含 " 與 <>）回填進 alt="…" → 引號提前閉合、<img> 標籤炸穿、
    //   後續 HTML 全被吞 →「後續排版全部錯誤」。保護圖片整段使 alt 內 $ 永不進 math 管線
    //   （步驟 5 marked.parse 前還原；alt 留字面 $、不可見、無害）。
    t = t.replace(/!\[[^\]]*\]\([^)]*\)/g, function (m) {
      imgBlocks.push(m); return '__IMG_PLACEHOLDER_' + (imgBlocks.length - 1) + '__';
    });
    // === [RAG-12-HOTFIX-1 END] ===
    // 2. 護跳脫 \$（split 法、無 lookbehind）→ 使步驟 3/4 之 $ 必為真 math
    t = t.split('\\$').join('__ESC_DOLLAR__');
    // 3. 抽 block math（$$ 先於 $；[\s\S] 跨行、不用 dotAll s 旗標）→ PUA 佔位
    t = t.replace(/\$\$([\s\S]+?)\$\$/g, function (m, f) {
      mathBlocks.push({ formula: f, displayMode: true }); return MO + (mathBlocks.length - 1) + MC;
    });
    // 4. 抽 inline math（texmath：開 $ 後非空白、閉 $ 前非空白且後非數字；僅 lookahead、無 lookbehind）
    t = t.replace(/\$([^\s$](?:[^$]*?[^\s$])?)\$(?!\d)/g, function (m, f) {
      mathBlocks.push({ formula: f, displayMode: false }); return MO + (mathBlocks.length - 1) + MC;
    });
    // 5. 還原 code 與 \$（僅 tempText；math 仍佔位）
    t = t.replace(/__CODE_PLACEHOLDER_(\d+)__/g, function (m, i) { return codeBlocks[i]; });
    t = t.split('__ESC_DOLLAR__').join('\\$');
    // === [RAG-12-HOTFIX-1] === 還原圖片（marked.parse 前；alt 內 $ 已不在 math 佔位、留字面、不被步驟 7 注入）
    t = t.replace(/__IMG_PLACEHOLDER_(\d+)__/g, function (m, i) { return imgBlocks[i]; });
    // 6. marked.parse（math PUA 佔位穿透）
    let html = marked.parse(t);
    // === [SEC-XSS C2] === 6.5 輸出消毒：marked 產出 HTML 經 DOMPurify 過濾（防 stored XSS、
    // 一處覆蓋全部 6 個 markdown innerHTML sink）。置於 KaTeX 回填「前」：
    // PUA 哨兵（MO/MC）為純文字節點、sanitize 原樣保留 → 步驟 7 回填正則照常；
    // KaTeX 為可信產出、於消毒後插入不被過濾（含 MathML/樣式標籤）。
    html = DOMPurify.sanitize(html);
    // 7. 回填 math：先還原公式內 __ESC_DOLLAR__→\$（步驟 7 鐵律），再 katex 渲染、壞式優雅降級
    html = html.replace(new RegExp(MO + '(\\d+)' + MC, 'g'), function (m, i) {
      const item = mathBlocks[i];
      if (!item) return m;
      const clean = item.formula.replace(/__ESC_DOLLAR__/g, '\\$');
      try {
        return katex.renderToString(clean, { displayMode: item.displayMode, throwOnError: false });
      } catch (e) {
        return '<span class="katex-error" style="color:#cc0000">' + clean + '</span>';
      }
    });
    return html;
  }
  // === [RAG-12 C2 END] ===

  // === [FE-PERF-2 C3] === 串流渲染節流器（plan v4 U1/Q1/Q2）
  // rAF + 最小間隔 160ms：sentence 高頻抵達時每 ~160ms 才全量重排一次（穩態 ≤6-7 次/秒），
  // 消除「每 token renderMarkdownWithMath + innerHTML + 讀 scrollHeight」之 O(n²) 熱路徑。
  // 出口契約（U1 收尾不變式·恰一次）：主串流 done/catch → flush()〔原碼 done 不渲染〕；
  // replay done/onerror → cancel()〔原碼 done 自帶收尾渲染、嚴禁再 flush 防雙渲染〕。
  // paintFn 按站點封裝（replay 含 cursor 語意）；scrollTop 於 paintFn 內與渲染同幀（Q2）。
  function makeThrottledRenderer(paintFn) {
    let latest = null, timer = 0, raf = 0, last = 0;
    const MIN = 160; // ms（Q1 定案）
    function paintNow() {
      raf = 0;
      last = performance.now();
      if (latest !== null) { const t = latest; latest = null; paintFn(t); }
    }
    function schedule() {
      if (raf) return;
      const wait = Math.max(0, MIN - (performance.now() - last));
      if (wait === 0) {
        raf = requestAnimationFrame(paintNow);
      } else if (!timer) {
        timer = setTimeout(() => { timer = 0; raf = requestAnimationFrame(paintNow); }, wait);
      }
    }
    return {
      update(t) { latest = t; schedule(); },
      flush() {
        if (timer) { clearTimeout(timer); timer = 0; }
        if (raf) { cancelAnimationFrame(raf); raf = 0; }
        if (latest !== null) { const t = latest; latest = null; last = performance.now(); paintFn(t); }
      },
      cancel() {
        if (timer) { clearTimeout(timer); timer = 0; }
        if (raf) { cancelAnimationFrame(raf); raf = 0; }
        latest = null;
      }
    };
  }
  // === [FE-PERF-2 C3 END] ===

  // ── 三欄收合 toggle ─────────────────────────
  const sidebar = document.getElementById('sidebar');
  const chatPanel = document.getElementById('chat-panel');
  // BUG-F5 B3（ui-fixes-batch B3）：原 prototype 控制條的狀態指示按鈕邏輯整段刪除
  //   HTML markup 早已移除、querySelectorAll 永遠回空 NodeList、forEach NOP；
  //   CSS 已隨上方 #demo-bar 區塊同步清除；toggle handler 內對應呼叫一併刪除。

  document.getElementById('sidebar-toggle').addEventListener('click', () => {
    sidebar.classList.toggle('collapsed');
    syncCollapseTips();
  });
  document.getElementById('chat-toggle').addEventListener('click', () => {
    chatPanel.classList.toggle('collapsed');
    syncCollapseTips();
  });

  // 漢堡 tooltip 隨展開／收合狀態切換文字
  function syncCollapseTips() {
    document.getElementById('sidebar-toggle').setAttribute(
      'data-tip', sidebar.classList.contains('collapsed') ? '展開本欄' : '收合本欄');
    document.getElementById('chat-toggle').setAttribute(
      'data-tip', chatPanel.classList.contains('collapsed') ? '展開本欄' : '收合本欄');
  }
  syncCollapseTips();

  // ── popup（per-item / folder）— 以 item 為錨點 ────
  function closePopups() {
    document.querySelectorAll('.ctx-popup').forEach(p => p.remove());
  }
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.ctx-popup') &&
        !e.target.closest('.paper-menu-btn') &&
        !e.target.closest('.folder-item .menu-btn')) {
      closePopups();
    }
  });

  // 開 popup：以按鈕為錨點，浮到 body，靠右對齊 item 右緣、垂直貼齊按鈕下方
  // 若視窗下方空間不足則往上翻
  function openPopupAt(anchorBtn, anchorItem, html) {
    closePopups();
    const pop = document.createElement('div');
    pop.className = 'ctx-popup';
    pop.innerHTML = html;
    document.body.appendChild(pop);

    const margin = 8;
    const itemRect = anchorItem.getBoundingClientRect();
    const btnRect = anchorBtn.getBoundingClientRect();
    const popRect = pop.getBoundingClientRect();

    // 水平：靠右對齊 item 右緣（再內縮 4px 視覺呼吸）
    let left = itemRect.right - popRect.width - 4;
    left = Math.max(margin, Math.min(left, window.innerWidth - popRect.width - margin));

    // 垂直：預設貼齊按鈕下緣 +4px；若下方放不下，改放按鈕上緣 -4px
    let top = btnRect.bottom + 4;
    if (top + popRect.height + margin > window.innerHeight) {
      top = btnRect.top - popRect.height - 4;
      if (top < margin) top = Math.max(margin, window.innerHeight - popRect.height - margin);
    }

    pop.style.left = left + 'px';
    pop.style.top = top + 'px';
    return pop;
  }

  const PAPER_POPUP_HTML = `
    <button class="danger">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
      刪除文件
    </button>
    <button class="has-sub">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8a2 2 0 0 1 2-2h4l2 2h9a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
      移動到資料夾
    </button>
    <button disabled>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3.3-6.9M21 4v3a2 2 0 0 1-2 2h-3"/></svg>
      刪除對話
    </button>
  `;
  const FOLDER_POPUP_HTML = `
    <button>改名</button>
    <button>新增子資料夾</button>
    <button class="danger">刪除</button>
  `;

  document.querySelectorAll('.paper-menu-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const item = btn.closest('.paper-item');
      // 若已有 popup（任何位置）就關掉，視為 toggle
      if (document.querySelector('.ctx-popup')) { closePopups(); return; }
      openPopupAt(btn, item, PAPER_POPUP_HTML);
    });
  });

  document.querySelectorAll('.folder-item .menu-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const item = btn.closest('.folder-item');
      if (document.querySelector('.ctx-popup')) { closePopups(); return; }
      openPopupAt(btn, item, FOLDER_POPUP_HTML);
    });
  });

  // popup 開啟期間捲動 / 縮放視窗就關閉，避免錨點失準
  window.addEventListener('scroll', (e) => {
    // 🟢 RAG-13-HOTFIX-1：若滾動源自彈出選單內部，則忽略，防止誤判關閉
    if (e.target.closest && e.target.closest('.ctx-popup')) return;
    closePopups();
  }, { capture: true, passive: true }); // [FE-PERF-2 C4] passive（handler 無 preventDefault、不阻塞合成滾動）
  window.addEventListener('resize', closePopups);

  // ── 點論文 item 切 active ─────────────────────
  document.querySelectorAll('.paper-item').forEach(it => {
    it.addEventListener('click', (e) => {
      if (e.target.closest('.paper-menu-btn')) return;
      document.querySelectorAll('.paper-item').forEach(x => x.classList.remove('active'));
      it.classList.add('active');
    });
  });

  // ── 點資料夾 item 切 active ───────────────────
  document.querySelectorAll('.folder-item').forEach(it => {
    it.addEventListener('click', (e) => {
      if (e.target.closest('.menu-btn') || e.target.closest('.chevron')) return;
      document.querySelectorAll('.folder-item').forEach(x => x.classList.remove('active'));
      it.classList.add('active');
    });
  });

  // ── chevron 展開摺疊（純視覺）───────────────
  document.querySelectorAll('.folder-item .chevron:not(.empty)').forEach(c => {
    c.addEventListener('click', (e) => {
      e.stopPropagation();
      c.closest('.folder-item').classList.toggle('open');
    });
  });

  // ── 搜尋 toggle ──────────────────────────────
  // 切換 .active；同步 placeholder 提示「搜尋模式」
  // chat-input 改 contenteditable div、
  // 改寫 data-placeholder（非 placeholder 屬性、配對 CSS :empty::before）
  // BUG-F1 Bug 3：data-placeholder 內 `；` → `\n` 換行（HTML 用 &#10;、JS 字面用 \n、各符語境）
  document.getElementById('web-search-toggle').addEventListener('click', function() {
    this.classList.toggle('active');
    const on = this.classList.contains('active');
    document.getElementById('chat-input').setAttribute(
      'data-placeholder',
      on ? '（搜尋模式）輸入問題（Ctrl+Enter 送出）\n輸入 # 可加入 hashtag 跨文獻搜尋'
         : '輸入問題（Ctrl+Enter 送出）\n輸入 # 可加入 hashtag 跨文獻搜尋');
  });
  // 初始同步（HTML 上預設 .active）
  (function syncSearchPlaceholder() {
    const on = document.getElementById('web-search-toggle').classList.contains('active');
    document.getElementById('chat-input').setAttribute(
      'data-placeholder',
      on ? '（搜尋模式）輸入問題（Ctrl+Enter 送出）\n輸入 # 可加入 hashtag 跨文獻搜尋'
         : '輸入問題（Ctrl+Enter 送出）\n輸入 # 可加入 hashtag 跨文獻搜尋');
  })();

  // ── Tooltip：data-tip 觸發 ─────────────────────────
  // · 顯示延遲 200ms（hover 滿 200ms 才出現）
  // · 顯示後 400ms 自動消失（即使仍 hover 在 icon 上）
  // · 自動消失後，停留同一 icon **不**重新顯示，須先離開再回來
  // · mouseout 後 100ms 才隱藏；100ms 內移到其他 [data-tip] → 立即接力顯示
  (function setupTooltip() {
    const tip = document.getElementById('tooltip');
    const SHOW_DELAY = 200;        // hover 多久才顯示
    const VISIBLE_DURATION = 800;  // 顯示後多久自動消失
    const HIDE_DELAY = 100;        // mouseout 後多久隱藏

    let showTimer = null;
    let autoHideTimer = null;
    let hideTimer = null;
    let visibleEl = null;          // 當前顯示中的目標
    let dismissedEl = null;        // 已自動消失的目標（停留期間不再顯示）

    function position(el) {
      const r = el.getBoundingClientRect();
      const tr = tip.getBoundingClientRect();
      const gap = 8;
      let left = r.left - tr.width - gap;
      let top = r.top + r.height / 2 - tr.height / 2;
      if (left < 4) left = r.right + gap;
      top = Math.max(4, Math.min(top, window.innerHeight - tr.height - 4));
      tip.style.left = left + 'px';
      tip.style.top = top + 'px';
    }
    function show(el) {
      if (showTimer) { clearTimeout(showTimer); showTimer = null; }
      if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
      if (autoHideTimer) { clearTimeout(autoHideTimer); autoHideTimer = null; }
      tip.textContent = el.getAttribute('data-tip') || '';
      tip.classList.add('visible');
      position(el);
      visibleEl = el;
      autoHideTimer = setTimeout(() => {
        tip.classList.remove('visible');
        dismissedEl = visibleEl;   // 記住已自動消失，停同一處不重觸發
        visibleEl = null;
        autoHideTimer = null;
      }, VISIBLE_DURATION);
    }
    function hideNow() {
      if (autoHideTimer) { clearTimeout(autoHideTimer); autoHideTimer = null; }
      if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
      tip.classList.remove('visible');
      visibleEl = null;
    }
    document.addEventListener('mouseover', (e) => {
      const el = e.target.closest('[data-tip]');
      if (!el) return;
      // 同一目標、已自動消失中 → 不重觸發
      if (el === dismissedEl) return;
      // 取消尚未觸發的 hide（從另一 icon 100ms 緩衝期內接力）
      if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
      if (visibleEl === el) return;
      if (visibleEl) {
        // 已有 tooltip 顯示中 → 立即切到新目標
        show(el);
      } else {
        // 當前無顯示 → 排程 SHOW_DELAY 後顯示
        if (showTimer) clearTimeout(showTimer);
        showTimer = setTimeout(() => {
          showTimer = null;
          if (document.contains(el)) show(el);
        }, SHOW_DELAY);
      }
    });
    document.addEventListener('mouseout', (e) => {
      const el = e.target.closest('[data-tip]');
      if (!el) return;
      // 仍在自己內部（移到子元素）→ 不處理
      if (e.relatedTarget && el.contains(e.relatedTarget)) return;
      // 真的離開該 icon
      dismissedEl = null;
      if (showTimer) { clearTimeout(showTimer); showTimer = null; }
      if (visibleEl === el) {
        // 排程 100ms 後隱藏；期間移到其他 [data-tip] 會被 mouseover 取消
        if (hideTimer) clearTimeout(hideTimer);
        hideTimer = setTimeout(() => {
          hideTimer = null;
          hideNow();
        }, HIDE_DELAY);
      }
    });
    window.addEventListener('scroll', hideNow, { capture: true, passive: true }); // [FE-PERF-2 C4] passive
    window.addEventListener('blur', hideNow);
  })();

  // ── Modal 系統：ESC 關閉、Tab 焦點循環、遮罩點擊關閉 ────────────
  // · data-no-esc 屬性 → ESC 不關閉（如 confirm-modal 強制流程）
  // · data-no-mask-close 屬性 → 點遮罩不關閉
  // · 開啟時記住觸發元素，關閉時還原焦點
  const modalReturnFocus = new WeakMap();    // modal → 觸發按鈕

  function openModal(id) {
    const m = document.getElementById(id);
    if (!m) return;
    modalReturnFocus.set(m, document.activeElement);
    m.classList.add('show');
    // 自動聚焦到第一個 primary 按鈕（或第一個 focusable）
    const first = m.querySelector('.modal-btn.primary, button, [tabindex]:not([tabindex="-1"])');
    if (first) setTimeout(() => first.focus(), 0);
  }
  function closeModal(id) {
    const m = (typeof id === 'string') ? document.getElementById(id) : id;
    if (!m) return;
    m.classList.remove('show');
    const prev = modalReturnFocus.get(m);
    if (prev && typeof prev.focus === 'function') prev.focus();
  }

  // 點遮罩關閉（除非 data-no-mask-close）
  document.querySelectorAll('.modal-mask').forEach(mask => {
    mask.addEventListener('click', (e) => {
      if (e.target !== mask) return;
      if (mask.dataset.noMaskClose === 'true') return;
      closeModal(mask);
    });
  });

  // ESC + Tab 焦點循環
  // BUG-F2 A6：ESC 先處理 popup（含 dropdown 展開的 list、.ctx-popup）、再處理 modal、一次只關一層
  //   Bug 11 已修保護 hashtag-autocomplete（移除 .ctx-popup class、不會被 closePopups 誤刪）
  // Tab 焦點循環邏輯不變
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const hasPopup = document.querySelector('.ctx-popup');
      if (hasPopup) {
        e.preventDefault();
        closePopups();
        return;   // 一次 ESC 只關一層 popup、不順帶關 modal
      }
      const open = [...document.querySelectorAll('.modal-mask.show')].pop();
      if (open && open.dataset.noEsc !== 'true') {
        e.preventDefault();
        closeModal(open);
        return;
      }
    }
    if (e.key === 'Tab') {
      const open = [...document.querySelectorAll('.modal-mask.show')].pop();
      if (!open) return;
      const focusables = open.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault(); last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault(); first.focus();
      }
    }
  });

  document.getElementById('help-btn').addEventListener('click', () => openModal('help-modal'));
  document.getElementById('help-close-btn').addEventListener('click', () => closeModal('help-modal'));
  document.getElementById('confirm-ok-btn').addEventListener('click', () => closeModal('confirm-modal'));
  // ── customConfirm / customAlert：取代瀏覽器原生 confirm() / alert() ──
  // 用 Promise，介面與原生 confirm() / alert() 等價
  function customConfirm({ title = '確認', body = '', okLabel = '確定', cancelLabel = '取消', danger = false } = {}) {
    return new Promise(resolve => {
      document.getElementById('action-title').textContent = title;
      document.getElementById('action-body').textContent = body;
      const okBtn = document.getElementById('action-ok');
      const cancelBtn = document.getElementById('action-cancel');
      okBtn.textContent = okLabel;
      cancelBtn.textContent = cancelLabel;
      okBtn.classList.toggle('danger', !!danger);
      const cleanup = () => {
        okBtn.onclick = null;
        cancelBtn.onclick = null;
        closeModal('action-modal');
      };
      okBtn.onclick = () => { cleanup(); resolve(true); };
      cancelBtn.onclick = () => { cleanup(); resolve(false); };
      openModal('action-modal');
    });
  }
  function customAlert({ title = '提示', body = '', okLabel = '知道了' } = {}) {
    return new Promise(resolve => {
      document.getElementById('notice-title').textContent = title;
      document.getElementById('notice-body').textContent = body;
      const okBtn = document.getElementById('notice-ok');
      okBtn.textContent = okLabel;
      okBtn.onclick = () => { closeModal('notice-modal'); resolve(); };
      openModal('notice-modal');
    });
  }
  // BUG-F4 A3（ui-fixes-batch A3.1）：customPrompt 取代瀏覽器 prompt()
  // Promise-based、含 validate hook（驗證錯時用 customAlert 顯示錯誤）
  // 配對 #prompt-modal DOM（在 #notice-modal 之後新增）
  function customPrompt({ title = '輸入', body = '', defaultValue = '',
                          okLabel = '確定', cancelLabel = '取消',
                          validate = null } = {}) {
    return new Promise(resolve => {
      document.getElementById('prompt-title').textContent = title;
      document.getElementById('prompt-body').textContent = body;
      const input = document.getElementById('prompt-input');
      input.value = defaultValue;
      const okBtn = document.getElementById('prompt-ok');
      const cancelBtn = document.getElementById('prompt-cancel');
      okBtn.textContent = okLabel;
      cancelBtn.textContent = cancelLabel;
      const cleanup = () => {
        okBtn.onclick = null;
        cancelBtn.onclick = null;
        input.onkeydown = null;
        closeModal('prompt-modal');
      };
      const submit = () => {
        const v = input.value;
        if (validate) {
          const err = validate(v);
          if (err) { customAlert({ title: '輸入錯誤', body: err }); return; }
        }
        cleanup(); resolve(v);
      };
      okBtn.onclick = submit;
      cancelBtn.onclick = () => { cleanup(); resolve(null); };
      input.onkeydown = (e) => { if (e.key === 'Enter') submit(); };
      openModal('prompt-modal');
      setTimeout(() => input.focus(), 0);
    });
  }

  // 暴露成全域，供其他模組（如 sb-row 按鈕）呼叫
  window.customConfirm = customConfirm;
  window.customAlert = customAlert;
  window.customPrompt = customPrompt;


  // ── 切換風格 modal + 套用 ────────────────────
  // localStorage 持久化（key: 'madpro-theme'），重整後自動還原
  // ─── BUG-F2 A5【第一段】TDZ-aware 拆分：dropdownAPI IIFE 之前 ───
  //   只立即套用 themeLink、避免頁面渲染前閃 fallback；
  //   dropdown 顯示值同步延後到【第三段】（IIFE 之後）執行；
  //   L1811 outer labels 已刪除、統一由 dropdownAPI IIFE 內 themeLabels 管理。
  const THEME_KEY = 'madpro-theme';
  const savedTheme = localStorage.getItem(THEME_KEY);
  if (savedTheme) {
    document.getElementById('theme-link').href = `/static/themes/${savedTheme}.css`;
    // dropdown 顯示值同步：見【第三段】（緊接 dropdownAPI IIFE 之後）
  }
  document.getElementById('theme-btn').addEventListener('click', () => openModal('theme-modal'));
  document.getElementById('theme-ok-btn').addEventListener('click', () => {
    const dd = document.getElementById('theme-dropdown');
    const theme = dd.dataset.value;   // 'mies' | 'kahn' | 'kandinsky' | 'nara'
    document.getElementById('theme-link').href = `/static/themes/${theme}.css`;
    localStorage.setItem(THEME_KEY, theme);
    closeModal('theme-modal');
  });

  // theme upload 連動（依 POST /api/themes/upload）
  // BUG-F2 A5 順序註記：click 觸發 input、無 dropdownAPI 依賴、留原位安全。
  document.getElementById('theme-upload-btn').addEventListener('click', () => {
    document.getElementById('theme-upload-input').click();
  });
  // BUG-F2 A5 順序註記：theme-upload-input 'change' handler 已搬到 dropdownAPI IIFE
  // 下方（見 L~1980 之後 BUG-F2 A5【upload handler】區塊）、保險防 TDZ。

  // # 標籤編輯 Modal + PATCH /api/papers/{uuid} 串接
  document.getElementById('edit-tags-btn').addEventListener('click', () => {
    if (!currentPaperId) return;
    const p = allPapers.find(x => x.id === currentPaperId);
    if (!p) return;
    // BUG-F1 Bug 1：fallback chain 防禦——API 回 p.metadata.user_tags（_to_dict shape）、
    // 但 PATCH 後 local 寫 p.metadata_json.user_tags（既有 R2 寫入路徑）；雙鍵都讀、無遺漏
    // 跟 P2-3 collectAllUserTags (L2736-2737) 同 pattern
    const existing = (p.metadata && p.metadata.user_tags) ||
                     (p.metadata_json && p.metadata_json.user_tags) || [];
    document.getElementById('tag-input').value =
      existing.map(t => `#${t}`).join(' ');
    openModal('tag-modal');
    setTimeout(() => document.getElementById('tag-input').focus(), 30);
  });
  document.getElementById('tag-cancel-btn').addEventListener('click',
    () => closeModal('tag-modal'));
  document.getElementById('tag-save-btn').addEventListener('click', async () => {
    if (!currentPaperId) return;
    const raw = document.getElementById('tag-input').value || '';
    // parse：以空白分隔、移除 # 前綴；後端 _normalize_tag 會 lowercase + dedup
    const tags = raw.split(/\s+/)
      .map(s => s.trim().replace(/^#/, ''))
      .filter(Boolean);
    try {
      const res = await fetch(`/api/papers/${currentPaperId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tags }),
      });
      if (!res.ok) {
        const err = await res.json().catch(() => ({ detail: 'Save failed' }));
        throw new Error(err.detail || 'Save failed');
      }
      const data = await res.json();
      // 用後端回傳的 normalized tags 更新 in-memory + 重繪
      // BUG-F1 Bug 1：雙鍵同寫——舊路徑 metadata_json + API shape metadata、
      // 確保 in-memory 一致；後續 renderTitleHeader / collectAllUserTags 任一鍵都能讀到
      const p = allPapers.find(x => x.id === currentPaperId);
      if (p) {
        p.metadata_json = p.metadata_json || {};
        p.metadata_json.user_tags = data.tags || [];
        p.metadata = p.metadata || {};
        p.metadata.user_tags = data.tags || [];
        renderTitleHeader(p);
      }
      closeModal('tag-modal');
    } catch (err) {
      customAlert({ title: '儲存失敗', body: err.message });
    }
  });

  // ── 自訂 dropdown：用 .ctx-popup 風格清單 ────────────
  // ─── BUG-F2 A5【第二段】TDZ-aware：dropdownAPI IIFE（原 setupDropdown 重構） ───
  //   暴露 addTheme / getThemeLabel API；THEMES 陣列 push 透過 closure 對 setupOne 仍生效；
  //   themeLabels = Object.fromEntries(THEMES) 統一管理 label、取代既有 L1811 outer labels duplicate。
  const dropdownAPI = (() => {
    // === doc_type-registry ===
    // 新增 doc_type 須同步更新此處。詳見 docs/HOW_TO_ADD_DOC_TYPE.md
    const DOC_TYPES = [
      ['academic', '學術論文'],
      ['book', '書籍'],
      ['technical', '技術文件'],
      ['slides', '簡報'],
      ['web', '網頁存檔'],
      ['news', '新聞文章'],
      ['resume', '履歷'],
    ];
    // 主題英文化（依 design/docs/copywriting.md）
    const THEMES = [
      ['mies', 'Mies van der Rohe'],
      ['kahn', 'Kahn · Kimbell Art Museum'],
      ['kandinsky', 'Kandinsky · Bauhaus'],
      ['nara', 'Yoshitomo Nara'],
      // 未來主題依 ui-fixes-batch A5 範例可加 apple / google 等
      // （需先準備對應 .css 檔；ui-fixes-batch 列 6 主題為期望狀態、目前 codebase 僅 4 個）
    ];
    const themeLabels = Object.fromEntries(THEMES);
    setupOne(document.getElementById('doc-type-dropdown'), DOC_TYPES);
    setupOne(document.getElementById('theme-dropdown'), THEMES);

    function setupOne(dd, items) {
      if (!dd) return;
      const trigger = dd.querySelector('.dropdown-trigger');
      const valueEl = dd.querySelector('.dropdown-value');
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        if (document.querySelector('.ctx-popup.dropdown-popup')) { closePopups(); return; }
        closePopups();
        const pop = document.createElement('div');
        pop.className = 'ctx-popup dropdown-popup';
        const currentVal = dd.dataset.value;
        let hasCustomHeader = false;
        items.forEach(([val, label]) => {
          if (dd.id === 'theme-dropdown' && !['mies', 'kahn', 'kandinsky', 'nara'].includes(val) && !hasCustomHeader) {
            hasCustomHeader = true;
            const hr = document.createElement('div');
            hr.className = 'dropdown-separator';
            hr.style.height = '1px';
            hr.style.background = 'var(--color-divider, var(--color-border))';
            hr.style.margin = '4px 0';
            pop.appendChild(hr);
            const header = document.createElement('div');
            header.textContent = '自訂主題';
            header.style.fontSize = '10px';
            header.style.color = 'var(--color-text-subtle)';
            header.style.padding = '4px 12px';
            header.style.pointerEvents = 'none';
            pop.appendChild(header);
          }
          const b = document.createElement('button');
          b.textContent = label;
          if (val === currentVal) b.style.fontWeight = '600';
          b.onclick = (ev) => {
            ev.stopPropagation();
            dd.dataset.value = val;
            valueEl.textContent = label;
            closePopups();
            trigger.setAttribute('aria-expanded', 'false');
          };
          pop.appendChild(b);
        });
        document.body.appendChild(pop);
        const r = trigger.getBoundingClientRect();
        pop.style.minWidth = r.width + 'px';
        pop.style.left = r.left + 'px';
        pop.style.top = (r.bottom - 1) + 'px';
        trigger.setAttribute('aria-expanded', 'true');
      });

      const obs = new MutationObserver(() => {
        if (!document.querySelector('.ctx-popup.dropdown-popup')) {
          trigger.setAttribute('aria-expanded', 'false');
        }
      });
      obs.observe(document.body, { childList: true });
    }

    return {
      addTheme(name, label) {
        label = label || name;
        if (themeLabels[name]) return;
        themeLabels[name] = label;
        THEMES.push([name, label]);  // closure 持有相同 reference、下次點開 dropdown 即生效
      },
      getThemeLabel(name) { return themeLabels[name] || name; },
      setThemes(themesList) {
        // RAG-13：動態覆寫選單資料（清空 + 重建 THEMES 陣列與 themeLabels map）
        THEMES.length = 0;
        for (const k in themeLabels) delete themeLabels[k];
        themesList.forEach(t => {
          THEMES.push([t.name, t.label]);
          themeLabels[t.name] = t.label;
        });
      },
    };
  })();
  window.dropdownAPI = dropdownAPI;

  // ─── BUG-F2 A5【第三段】TDZ-aware：dropdownAPI IIFE 之後 ───
  //   savedTheme 同步 dropdown 顯示值；此時 dropdownAPI 已 init、addTheme/getThemeLabel 可安全呼叫；
  //   自訂 theme（非預設 4 主題）會在 reload 時自動 register 進 dropdown。
  if (savedTheme) {
    dropdownAPI.addTheme(savedTheme);   // 若是自訂 theme 動態註冊
    const dd = document.getElementById('theme-dropdown');
    dd.dataset.value = savedTheme;
    dd.querySelector('.dropdown-value').textContent = dropdownAPI.getThemeLabel(savedTheme);
  }

  // ─── RAG-13：動態讀取自訂主題清單並渲染 ───
  async function loadThemesFromServer() {
    try {
      const res = await fetch('/api/themes');
      if (!res.ok) throw new Error('Failed to fetch themes');
      const themesList = await res.json();

      const builtInOrder = ['mies', 'kahn', 'kandinsky', 'nara'];
      const builtInThemes = themesList.filter(t => !t.custom)
        .sort((a, b) => builtInOrder.indexOf(a.name) - builtInOrder.indexOf(b.name));
      const customThemes = themesList.filter(t => t.custom)
        .sort((a, b) => b.updated_at - a.updated_at);

      const sortedThemes = [...builtInThemes, ...customThemes];
      dropdownAPI.setThemes(sortedThemes);

      const currentTheme = localStorage.getItem(THEME_KEY) || 'kahn';
      const dd = document.getElementById('theme-dropdown');
      dd.dataset.value = currentTheme;
      dd.querySelector('.dropdown-value').textContent = dropdownAPI.getThemeLabel(currentTheme);
    } catch (err) {
      console.error('[Theme Load Error]', err);
    }
  }

  loadThemesFromServer();

  // === [META-NORM C5 START] === 動態 metadata 欄位映射快取（seed 離線兜底 + fetch 更新）
  window.metaFields = window.metaFields || {
    course: { label_zh: '課程', label_en: 'Course', sort_weight: 10 },
    instructor: { label_zh: '講師', label_en: 'Instructor', sort_weight: 20 },
    organization: { label_zh: '組織/機構', label_en: 'Organization', sort_weight: 30 },
    date: { label_zh: '日期', label_en: 'Date', sort_weight: 40 },
    venue: { label_zh: '發表地點/期刊', label_en: 'Venue', sort_weight: 50 },
    doi: { label_zh: 'DOI', label_en: 'DOI', sort_weight: 60 },
  };
  (async function loadMetaFields() {
    try {
      const res = await fetch('/api/meta-fields');
      if (!res.ok) throw new Error('Failed to fetch meta-fields');
      const data = await res.json();
      if (data && typeof data === 'object') {
        window.metaFields = Object.assign({}, window.metaFields, data);  // 合併、保 seed 兜底
      }
    } catch (err) {
      console.error('[MetaFields Load Error]', err);  // 失敗保留 seed、不阻前端
    }
  })();
  // === [META-NORM C5 END] ===

  // ─── BUG-F2 A5【upload handler】TDZ-aware：dropdownAPI IIFE 之後 ───
  //   原 L1831 已搬到此處（保險防 TDZ）；handler body 內呼叫 dropdownAPI.addTheme + getThemeLabel
  document.getElementById('theme-upload-input').addEventListener('change', async (e) => {
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    if (!file.name.toLowerCase().endsWith('.css')) {
      customAlert({ title: '只接受 .css 檔案', body: '請選擇副檔名為 .css 的檔案' });
      return;
    }
    const fd = new FormData();
    fd.append('file', file);
    try {
      const res = await fetch('/api/themes/upload', { method: 'POST', body: fd });
      if (!res.ok) {
        const err = await res.json().catch(() => ({ detail: 'Upload failed' }));
        throw new Error(err.detail || 'Upload failed');
      }
      const data = await res.json();
      // 立即套用新主題 + 寫 localStorage
      const themeName = data.filename.replace(/\.css$/, '');
      document.getElementById('theme-link').href = data.url;
      localStorage.setItem(THEME_KEY, themeName);
      // RAG-13：重新從伺服器讀取最新主題清單（含新上傳的自訂主題）
      await loadThemesFromServer();
      closeModal('theme-modal');
    } catch (err) {
      customAlert({ title: '上傳失敗', body: err.message });
    } finally {
      // reset input 讓相同檔案可重複上傳
      e.target.value = '';
    }
  });

  // ── AI 訊息動作：copy / regenerate（事件委派、未來動態插入也適用）──
  document.getElementById('chat-messages').addEventListener('click', async (e) => {
    const copy = e.target.closest('.msg-copy');
    const regen = e.target.closest('.msg-regen');
    if (copy) {
      const aiMsg = copy.closest('.msg-ai');
      // 抓泡泡內容文字（排除動作按鈕、來源列）
      const clone = aiMsg.cloneNode(true);
      clone.querySelectorAll('.msg-ai-actions, .msg-sources').forEach(n => n.remove());
      const text = clone.innerText.trim();
      try {
        await navigator.clipboard.writeText(text);
        copy.classList.add('copied');
        setTimeout(() => copy.classList.remove('copied'), 1500);
      } catch {
        customAlert({ title: '複製失敗', body: '瀏覽器拒絕了剪貼簿存取，請手動選取訊息複製' });
      }
    } else if (regen) {
      // 示範用：實作後會重發最後一句 user query
      customAlert({ title: '重新生成', body: '示範用：實際接 API 後會丟回最後一個提問重產 AI 回應' });
    }
  });

  // chat-input 改 contenteditable div、自然撐高
  // 舊 textarea autosize listener 已移除（plan v2 §3.3.5-#3 grep 替換清單）
  // 容器 max-height:240px + overflow-y:auto 處理上限

  /* ════════════════════════════════════════════════════════════
     業務 JS（自 design/old/index.html 行 599–1356 原樣搬入）
     BUG-F4 A4：closeBizPopups 已刪除、統一走 prototype closePopups
     ════════════════════════════════════════════════════════════ */
const API = '';
let currentPaperId = null;
let currentLang = 'zh';
let isProcessing = false;
let useWebSearch = false;
// paperId -> 'reading_ready'（md_restore 完成、可閱讀）| 'done'（全部完成、可問答）
// 不在 map 中 = 來自 papers_index 的既有論文，視為 done。重整頁面後清空靠此規則重建。
const paperReadiness = new Map();
// ── 資料夾狀態（Phase 3.2，filter 模型）──
let currentFolderId = 'all';   // 'all' | 'uncategorized' | folder_id(int)
let folders = [];              // server flat list
let allPapers = [];            // GET /api/papers 快取（client-side filter）
let foldersOpen = new Set();   // 展開的 folder id（localStorage 持久化）
try {
  const _sv = localStorage.getItem('foldersOpen');
  if (_sv) foldersOpen = new Set(JSON.parse(_sv));
} catch (e) {}
// 插入 .paper-item.uploading 占位列（components §7.3 + dom-reference §3.2 + interaction §9）
function insertUploadingRow(paperId, filename) {
  const list = document.getElementById('paper-list');
  const row = document.createElement('div');
  row.className = 'paper-item uploading';
  row.dataset.uploadId = paperId;
  row.innerHTML = `
    <div class="paper-item-header">
      <div class="paper-item-titles">
        <div class="paper-title-zh"></div>
        <div class="paper-progress">
          <span class="paper-progress-dot" aria-hidden="true"></span>
          <span class="paper-progress-text">等待開始</span>
        </div>
      </div>
    </div>
    <div class="paper-progress-bar" aria-hidden="true">
      <div class="paper-progress-fill" style="width:0%"></div>
    </div>`;
  // filename 用 textContent 避免 XSS（檔名可能含 < > & 特殊字元）
  row.querySelector('.paper-title-zh').textContent = filename;
  list.insertBefore(row, list.firstChild);
  return row;
}

function removeUploadingRow(paperId) {
  const row = document.querySelector(
    `.paper-item.uploading[data-upload-id="${paperId}"]`
  );
  if (row) row.remove();
}

function setBusy(busy) {
  // upload-btn 不受 setBusy 控制：上傳期間使用者可繼續上傳下一份
  // （後端 thread pool 並行 OK）。upload-btn 的 disabled 由各 handler
  // 短期 lock（選檔 → upload API 回應期間）。
  isProcessing = busy;
  document.getElementById('cleanup-btn').disabled = busy;
}

// ── 資料夾 API 包裝 ──
async function loadFolders() {
  try {
    const res = await fetch(`${API}/api/folders`, { credentials: 'include' });
    folders = res.ok ? await res.json() : [];
  } catch (e) { folders = []; }
  renderFolderTree();
}
async function createFolderApi(name, parentId = null) {
  const res = await fetch(`${API}/api/folders`, {
    method: 'POST', credentials: 'include',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ name, parent_id: parentId })
  });
  if (!res.ok) throw new Error((await res.json()).detail || '建立失敗');
  return res.json();
}
async function updateFolderApi(id, patches) {
  const res = await fetch(`${API}/api/folders/${id}`, {
    method: 'PATCH', credentials: 'include',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(patches)
  });
  if (!res.ok) throw new Error((await res.json()).detail || '更新失敗');
  return res.json();
}
async function deleteFolderApi(id) {
  const res = await fetch(`${API}/api/folders/${id}`, {
    method: 'DELETE', credentials: 'include'
  });
  if (!res.ok) throw new Error((await res.json()).detail || '刪除失敗');
  return res.json();
}
async function setPaperFolderApi(paperUuid, folderId) {
  const res = await fetch(`${API}/api/papers/${paperUuid}`, {
    method: 'PATCH', credentials: 'include',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ folder_id: folderId })
  });
  if (!res.ok) throw new Error((await res.json()).detail || '移動失敗');
  return res.json();
}

// ── 樹建構 / 子孫 ──
function buildTree(list) {
  const map = new Map(list.map(f => [f.id, { ...f, children: [] }]));
  const roots = [];
  map.forEach(node => {
    if (node.parent_id != null && map.has(node.parent_id)) {
      map.get(node.parent_id).children.push(node);
    } else {
      roots.push(node);
    }
  });
  (function sortRec(ns) {
    ns.sort((a, b) => (a.sort_order - b.sort_order) || (a.id - b.id));
    ns.forEach(n => sortRec(n.children));
  })(roots);
  return roots;
}
function folderDescendants(id) {
  const ids = new Set([id]);
  let added = true;
  while (added) {
    added = false;
    folders.forEach(f => {
      if (f.parent_id != null && ids.has(f.parent_id) && !ids.has(f.id)) {
        ids.add(f.id); added = true;
      }
    });
  }
  return ids;
}

// ── popup（改名/刪除/新增子；移動論文 picker）──
// BUG-F4 A4（ui-fixes-batch A4）：刪除 closeBizPopups 函式 + 第二個 document click listener
//   原 closeBizPopups (L2275) 跟 prototype closePopups (L1518) 邏輯完全一致
//   (都 querySelectorAll('.ctx-popup').forEach(p => p.remove()))；保留兩個會：
//   (a) 每次點擊 body 跑兩次 close（雖然第二次 NOP、但是 dead code 增加維護成本）
//   (b) 未來修一邊忘了另一邊、行為不一致
//   統一改走 closePopups（prototype 區既有定義）+ 既有 click listener（L1521）已涵蓋
function openPopup(x, y, items) {
  closePopups();
  const pop = document.createElement('div');
  pop.className = 'ctx-popup';
  items.forEach(it => {
    const b = document.createElement('button');
    b.textContent = it.label;
    if (it.danger) b.style.color = 'var(--color-danger)';
    if (it.disabled) {
      b.disabled = true;
      b.style.color = 'var(--color-text-subtle)';
      b.style.cursor = 'not-allowed';
      if (it.title) b.title = it.title;
    } else {
      b.onclick = (ev) => { ev.stopPropagation(); closePopups(); it.action(); };
    }
    pop.appendChild(b);
  });
  document.body.appendChild(pop);
  const r = pop.getBoundingClientRect();
  pop.style.left = Math.min(x, window.innerWidth - r.width - 8) + 'px';
  pop.style.top = Math.min(y, window.innerHeight - r.height - 8) + 'px';
}

// ── 資料夾樹渲染 ──
function renderFolderTree() {
  const box = document.getElementById('folder-tree');
  box.innerHTML = '';
  const fixed = [
    { key: 'all', name: '全部' },
    { key: 'uncategorized', name: '未分類' },
  ];
  fixed.forEach(fx => {
    const row = document.createElement('div');
    row.className = 'folder-item' + (currentFolderId === fx.key ? ' active' : '');
    row.innerHTML = `<span class="chevron"></span><span class="fname"></span>`;
    row.querySelector('.fname').textContent = fx.name;
    row.onclick = () => selectFolder(fx.key);
    box.appendChild(row);
  });
  const tree = buildTree(folders);
  const render = (node, depth) => {
    const hasChildren = node.children.length > 0;
    const open = foldersOpen.has(node.id);
    const row = document.createElement('div');
    row.className = 'folder-item' + (currentFolderId === node.id ? ' active' : '');
    row.style.paddingLeft = (12 + depth * 12) + 'px';
    const chev = hasChildren ? (open ? '▾' : '▸') : '';
    row.innerHTML =
      `<span class="chevron">${chev}</span>` +
      `<span class="fname"></span>` +
      `<button class="menu-btn" data-tip="資料夾選單"><svg viewBox="0 0 24 24"><circle cx="5" cy="12" r="1" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/><circle cx="19" cy="12" r="1" fill="currentColor" stroke="none"/></svg></button>`;
    row.querySelector('.fname').textContent = node.name;
    row.querySelector('.chevron').onclick = (e) => {
      if (!hasChildren) return;
      e.stopPropagation();
      if (open) foldersOpen.delete(node.id); else foldersOpen.add(node.id);
      localStorage.setItem('foldersOpen', JSON.stringify([...foldersOpen]));
      renderFolderTree();
    };
    row.querySelector('.menu-btn').onclick = (e) => {
      e.stopPropagation();
      const rb = e.target.getBoundingClientRect();
      openPopup(rb.left, rb.bottom, [
        { label: '改名', action: () => folderRename(node) },
        { label: '新增子資料夾', action: () => folderCreateSub(node.id) },
        { label: '刪除', action: () => folderDelete(node) },
      ]);
    };
    row.onclick = () => selectFolder(node.id);
    box.appendChild(row);
    if (hasChildren && open) node.children.forEach(c => render(c, depth + 1));
  };
  tree.forEach(n => render(n, 0));
}

function selectFolder(key) {
  currentFolderId = key;
  renderFolderTree();
  renderPapers();
}

// ── 資料夾操作（prompt/confirm）──
// BUG-F4 A3.2（ui-fixes-batch A3.2）：folder CRUD 三個 native dialog 全替換為 custom*
async function folderCreate(parentId) {
  const name = await customPrompt({
    title: '新增資料夾',
    body: '輸入資料夾名稱（1–50 字元）',
    validate: (v) => {
      const n = (v || '').trim();
      if (!n || n.length > 50) return '名稱需 1–50 字元';
      return null;
    },
  });
  if (name == null) return;
  try { await createFolderApi(name.trim(), parentId); await loadFolders(); }
  catch (e) { customAlert({ title: '建立失敗', body: e.message }); }
}
function folderCreateSub(pid) { folderCreate(pid); }
async function folderRename(node) {
  const name = await customPrompt({
    title: '改名',
    body: '輸入新名稱',
    defaultValue: node.name,
    validate: (v) => {
      const n = (v || '').trim();
      if (!n || n.length > 50) return '名稱需 1–50 字元';
      return null;
    },
  });
  if (name == null) return;
  try { await updateFolderApi(node.id, { name: name.trim() }); await loadFolders(); }
  catch (e) { customAlert({ title: '更新失敗', body: e.message }); }
}
async function folderDelete(node) {
  const ok = await customConfirm({
    title: '刪除資料夾',
    body: `刪除「${node.name}」？子資料夾會一併刪除，內部論文回到未分類`,
    okLabel: '確定刪除',
    danger: true,
  });
  if (!ok) return;
  try {
    await deleteFolderApi(node.id);
    if (currentFolderId === node.id) currentFolderId = 'all';
    await loadFolders();
    await loadPapers();
  } catch (e) { customAlert({ title: '刪除失敗', body: e.message }); }
}

// ── 論文清單（filter 模型）──
function papersInCurrentFolder() {
  if (currentFolderId === 'all') return allPapers;
  if (currentFolderId === 'uncategorized')
    return allPapers.filter(p => p.folder_id == null);
  const ids = folderDescendants(currentFolderId);
  return allPapers.filter(p => p.folder_id != null && ids.has(p.folder_id));
}
// title fallback 鏈（中文優先）。歷史曾把 metadata.title (英文原文) 放前面、
// 導致 paper-item 全變英文；現中文優先以維持側欄一致性。
function stripPdfExt(s) {
  if (!s) return '';
  return s.toLowerCase().endsWith('.pdf') ? s.slice(0, -4) : s;
}
function resolveDisplayTitle(p) {
  const m = p.metadata || {};
  // resume 特判：candidate_name 通常不翻譯，優先用
  if (p.doc_type === 'resume' && m.candidate_name && m.candidate_name.value)
    return m.candidate_name.value;
  // 中文優先序：metadata.translated_title → DB.translated_title →
  //            metadata.title → DB.title → original_filename(去 .pdf) → 「未命名文件」
  return (m.translated_title && m.translated_title.value)
      || p.translated_title
      || (m.title && m.title.value)
      || p.title
      || stripPdfExt(p.original_filename)
      || '未命名文件';
}
function resolveDisplaySubtitle(p) {
  if (p.doc_type === 'resume') return '';
  const m = p.metadata || {};
  // displayTitle 已是中文時，副標顯示原文 title；已是原文時副標留空避免重複
  if ((m.translated_title && m.translated_title.value) || p.translated_title) {
    return (m.title && m.title.value) || p.title || '';
  }
  return '';
}
// 依 doc_type 分支渲染 #current-title 擴充標題區。
// 取代原 renderMetadataHero（hero block 已移除）。缺項靜默省略；
// title 是 always-show（同 resolveDisplayTitle fallback 鏈）。
// HTML escape 防 XSS（metadata 值可能包含 PDF 內任意字串）。
function _esc(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function renderTitleHeader(p) {
  const el = document.getElementById('current-title');
  const abstractToolbar = document.getElementById('abstract-toolbar');
  if (!el) return;
  // 沒 paper 時清空 innerHTML 但保留元素（占 toolbar flex:1 槽位、
  // 避免 actions 滑到左邊）。不再用 hidden 屬性。並清空隱藏摘要列。
  if (!p) {
    el.innerHTML = '';
    if (abstractToolbar) {
      abstractToolbar.innerHTML = '';
      abstractToolbar.style.display = 'none';
    }
    return;
  }
  const m = p.metadata || {};
  const v = (k) => (m[k] && m[k].value) || null;
  const isResume = p.doc_type === 'resume';

  // title-zh：同 resolveDisplayTitle 中文優先；title-en：原文（避免重複）
  const titleZh = resolveDisplayTitle(p);
  const titleEnRaw = isResume ? '' : (v('title') || p.title || '');
  const titleEn = (titleEnRaw && titleEnRaw !== titleZh) ? titleEnRaw : '';

  const parts = [`<h1 class="title-zh">${_esc(titleZh)}</h1>`];
  if (titleEn) parts.push(`<p class="title-en">${_esc(titleEn)}</p>`);

  // 渲染獨立滿寬摘要容器（#abstract-toolbar）
  if (abstractToolbar) {
    if (isResume) {
      abstractToolbar.innerHTML = '';
      abstractToolbar.style.display = 'none';
    } else {
      // 雙語摘要 fallback（中文模式優先取 translated_abstract、缺則 fallback 英文 abstract）
      // 繁中優先 → translated_abstract、無中譯則防禦性回退至英文 abstract
      const abstractEn = v('abstract');
      const abstractZh = v('translated_abstract') || abstractEn;
      const abstract = currentLang === 'zh' ? abstractZh : abstractEn;
      if (abstract) {
        abstractToolbar.innerHTML =
          `<details class="title-abstract">`
          + `<summary>顯示摘要</summary>`
          + `<div class="abstract-body">${_esc(abstract)}</div>`
          + `</details>`;
        abstractToolbar.style.display = 'block';
      } else {
        abstractToolbar.innerHTML = '';
        abstractToolbar.style.display = 'none';
      }
    }
  }

  // tag-pill 渲染（半透明磨砂玻璃、依 components.md §11 規範）
  // BUG-F1 Bug 1：fallback chain 防禦（同 tag-modal 載入、PATCH 後 local 寫 metadata_json、API 回 metadata）
  const userTags = (p.metadata && p.metadata.user_tags) ||
                   (p.metadata_json && p.metadata_json.user_tags) || [];
  if (Array.isArray(userTags) && userTags.length) {
    const pills = userTags.map(t => `<span class="tag-pill">#${_esc(t)}</span>`).join('');
    parts.push(`<div class="paper-tags">${pills}</div>`);
  }

  // === [META-NORM C5 START] === 動態 metadata 通用渲染（飛輪 canonical 欄）
  // 排除集（BS2）：已由既有寫死路徑渲染之 key，不重複顯示。
  const _EXCLUDE = new Set(['title', 'authors', 'venue', 'doi',
    'translated_abstract', 'translated_title', 'abstract', 'user_tags']);
  const mf = window.metaFields || {};
  const dynItems = [];
  Object.keys(m).forEach((k) => {
    if (_EXCLUDE.has(k)) return;
    const val = (m[k] && typeof m[k] === 'object') ? m[k].value : m[k];
    if (val === undefined || val === null || String(val).trim() === '') return;
    const def = mf[k] || {};
    const label = (currentLang === 'zh' ? def.label_zh : def.label_en) || def.label_zh || def.label_en || k;
    const weight = (typeof def.sort_weight === 'number') ? def.sort_weight : 999;
    dynItems.push({ key: k, label, value: String(val), weight });
  });
  if (dynItems.length) {
    // 排序（BS7）：sort_weight 升序、tie 則 canonical_key 字母序 fallback。
    dynItems.sort((a, b) => (a.weight - b.weight) || a.key.localeCompare(b.key));
    const rows = dynItems.map(it =>
      `<div class="dynamic-meta-item"><span class="meta-label">${_esc(it.label)}</span>`
      + `<span class="meta-value">${_esc(it.value)}</span></div>`).join('');
    parts.push(`<div class="paper-dynamic-meta">${rows}</div>`);
  }
  // === [META-NORM C5 END] ===
  el.innerHTML = parts.join('');
}
function renderPapers() {
  const list = document.getElementById('paper-list');
  // 保留 .paper-item.uploading 占位列（不受 folder filter 影響、永遠頂端）
  const uploadingRows = Array.from(list.querySelectorAll('.paper-item.uploading'));
  list.innerHTML = '';
  uploadingRows.forEach(r => list.appendChild(r));  // 頂端（list 已空）
  papersInCurrentFolder().forEach(p => {
    const item = document.createElement('div');
    item.className = 'paper-item';
    item.dataset.id = p.id;
    const displayTitle = resolveDisplayTitle(p);
    const displaySubtitle = resolveDisplaySubtitle(p);
    item.innerHTML = `
      <div class="paper-item-header">
        <div class="paper-item-titles">
          <div class="paper-title-zh">${displayTitle}</div>
          <div class="paper-title-en">${displaySubtitle}</div>
        </div>
        <button class="paper-menu-btn icon-only" data-tip="文件選單"><svg viewBox="0 0 24 24"><circle cx="5" cy="12" r="1" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/><circle cx="19" cy="12" r="1" fill="currentColor" stroke="none"/></svg></button>
      </div>
    `;
    const openMovePicker = (rb) => {
      const flat = [];
      const walk = (ns, d) => ns.forEach(n => {
        flat.push({ id: n.id, label: '　'.repeat(d) + n.name });
        walk(n.children, d + 1);
      });
      walk(buildTree(folders), 0);
      openPopup(rb.left, rb.bottom, [
        { label: '未分類', action: () => movePaper(p.id, null) },
        ...flat.map(f => ({
          label: f.label, action: () => movePaper(p.id, f.id)
        })),
      ]);
    };
    item.querySelector('.paper-menu-btn').onclick = (e) => {
      e.stopPropagation();
      const rb = e.target.getBoundingClientRect();
      openPopup(rb.left, rb.bottom, [
        { label: '刪除文件', danger: true,
          action: () => deletePaper(p.id, displayTitle) },
        { label: '移動到資料夾 ▸',
          action: () => openMovePicker(rb) },
        { label: '刪除對話', disabled: true,
          title: '即將上線（Phase 3.4）' },
      ]);
    };
    item.onclick = () => loadPaper(p.id, displayTitle);
    if (p.id === currentPaperId) item.classList.add('active');
    list.appendChild(item);
  });
}
async function movePaper(uuid, folderId) {
  try {
    await setPaperFolderApi(uuid, folderId);
    await loadPapers();
  } catch (e) { customAlert({ title: '移動失敗', body: e.message }); }
}

// 載入論文列表（fetch → 快取 → 依當前資料夾渲染）
async function loadPapers() {
  const res = await fetch(`${API}/api/papers`);
  allPapers = await res.json();
  renderPapers();
}

// 載入論文內容
async function loadPaper(paperId, title) {
  currentPaperId = paperId;

  // 切 paper 時關閉舊 EventSource attach（避免 stream broker 串流互相污染）
  if (currentEventSource) {
    try { currentEventSource.close(); } catch (e) {}
    currentEventSource = null;
  }

  document.querySelectorAll('.paper-item').forEach(el => {
    el.classList.toggle('active', el.dataset.id === paperId);
  });

  document.getElementById('content-toolbar').style.display = 'flex';
  document.getElementById('empty-state').style.display = 'none';
  document.getElementById('paper-content').style.display = 'block';
  document.getElementById('paper-content').innerHTML = '<p style="color:#94a3b8">載入中...</p>';
  // 立即清空 chat-messages（不等 loadChatHistory 回應、避免切 paper 時舊對話殘留）
  // 切走的舊 paper user query + 閃爍泡泡會殘留到 loadChatHistory 跑完才清；
  // 切 paper 是用戶意圖、UI 應該瞬間反映、不該卡在前一個 paper 的訊息
  document.getElementById('chat-messages').innerHTML = '';
  // 渲染 #current-title 擴充標題區（多 row：title-zh / title-en / meta / abstract / tags）
  renderTitleHeader(allPapers.find(p => p.id === paperId));

  await fetchContent(paperId, currentLang);

  const chatPanel = document.getElementById('chat-panel');
  const status = paperReadiness.get(paperId);
  if (status === 'reading_ready') {
    // 內容可讀，但 RAG 尚未就緒：收合並鎖住問答，顯示等候訊息
    chatPanel.classList.add('collapsed');
    disableChat();
    showReadingReadyMessage();
  } else {
    // 'done' 或不在 map（既有 papers_index 論文，視為 done）：展開、解鎖
    chatPanel.classList.remove('collapsed');
    removeReadingReadyMessage();
    enableChat();
    await loadChatHistory(paperId);
  }
}

// 取得論文 Markdown 內容
async function fetchContent(paperId, lang) {
  const res = await fetch(`${API}/api/papers/${paperId}/content?lang=${lang}`);
  const data = await res.json();

  // 把圖片路徑換成 API 路徑
  const content = data.content.replace(
    /!\[([^\]]*)\]\(images\/([^)]+)\)/g,
    `![$1](/api/papers/${paperId}/images/$2)`
  );

  document.getElementById('paper-content').innerHTML = renderMarkdownWithMath(content); // [RAG-12 C3] 數學渲染接線
  normalizeAcademicHeader(); // FE-AESTHETICS HOTFIX-1：學術扉頁自癒
}

function normalizeAcademicHeader() {
  const metaEl = document.querySelector('#paper-content .paper-header-meta');
  if (!metaEl) return;
  // 🟢 Guard：若已含新格式 class divs（C1 後端正確渲染），直接跳過，防止誤傷
  if (metaEl.querySelector('.header-authors, .header-venue-date, .header-doi, .header-keywords')) return;
  const rawText = metaEl.textContent.trim();
  function extractField(text, labels) {
    for (const label of labels) {
      const pattern = new RegExp(
        label + '\\s*[:：]\\s*([\\s\\S]*?)(?=\\s*(?:作者|Authors|日期|Date|出處|Venue|DOI|關鍵字|Keywords|$))',
        'i'
      );
      const match = text.match(pattern);
      if (match) return match[1].trim().replace(/^[:：]\s*/, '').trim();
    }
    return '';
  }
  const authorsVal  = extractField(rawText, ['作者', 'Authors']);
  const dateVal     = extractField(rawText, ['日期', 'Date']);
  const venueVal    = extractField(rawText, ['出處', 'Venue']);
  const doiVal      = extractField(rawText, ['DOI']);
  const keywordsVal = extractField(rawText, ['關鍵字', 'Keywords']);
  if (!authorsVal && !dateVal && !venueVal && !doiVal && !keywordsVal) return;
  const htmlBits = [];
  if (authorsVal) htmlBits.push(`  <div class="header-authors">${authorsVal}</div>`);
  const venueDateBits = [];
  if (venueVal) venueDateBits.push(venueVal);
  if (dateVal)  venueDateBits.push(dateVal);
  if (venueDateBits.length) htmlBits.push(`  <div class="header-venue-date">${venueDateBits.join(' · ')}</div>`);
  if (doiVal)      htmlBits.push(`  <div class="header-doi">DOI: ${doiVal}</div>`);
  if (keywordsVal) {
    const isZh = rawText.includes('關鍵字') || keywordsVal.includes('、');
    htmlBits.push(`  <div class="header-keywords">${isZh ? '關鍵字：' : 'Keywords: '}${keywordsVal}</div>`);
  }
  metaEl.innerHTML = htmlBits.join('\n');
}

// 列印
document.getElementById('print-btn').onclick = () => {
  const original = document.title;
  // #current-title 為 multi-row、僅讀 .title-zh 當瀏覽器
  // 列印標題（避免 .textContent 把 authors / abstract 全串進來）
  const titleEl = document.querySelector('#current-title .title-zh');
  const title = titleEl ? titleEl.textContent.trim() : '';
  if (title) document.title = title;
  window.print();
  document.title = original;
};

// 切換語言
document.getElementById('lang-toggle').onclick = async () => {
  currentLang = currentLang === 'zh' ? 'en' : 'zh';
  // icon-only：以 title 提示下一步動作（取代原 textContent，避免覆蓋 SVG）
  document.getElementById('lang-toggle').title = currentLang === 'zh' ? '切換英文' : '切換中文';
  if (currentPaperId) {
    await fetchContent(currentPaperId, currentLang);
    // 切語言後重繪 toolbar、雙語摘要無縫聯動
    renderTitleHeader(allPapers.find(p => p.id === currentPaperId));
  }
};// 聊天功能
let isStreaming = false;

function enableChat() {
  // chat-input 改 contenteditable div、
  // disabled 屬性對 div 無效 → 改用 contenteditable="true"/"false"
  document.getElementById('chat-input').setAttribute('contenteditable', 'true');
  document.getElementById('web-search-toggle').disabled = false;
  document.getElementById('export-btn').style.display = 'block';
}

function disableChat() {
  document.getElementById('chat-input').setAttribute('contenteditable', 'false');
  document.getElementById('web-search-toggle').disabled = true;
}

function showReadingReadyMessage() {
  const messages = document.getElementById('chat-messages');
  if (!messages || document.getElementById('reading-ready-msg')) return;
  const m = document.createElement('div');
  m.className = 'msg-system';
  m.id = 'reading-ready-msg';
  m.textContent = '內容已可閱讀，AI 問答準備中…';
  messages.innerHTML = '';
  messages.appendChild(m);
}

function removeReadingReadyMessage() {
  const m = document.getElementById('reading-ready-msg');
  if (m) m.remove();
}

document.getElementById('export-btn').onclick = async () => {  // CHAT-EXPORT-HOTFIX-1: fetch 需 async
  if (!currentPaperId) return;
  // 對話為空時擋下載（避免後端回空檔 / 錯誤）
  const realMessages = document.querySelectorAll(
    '#chat-messages .msg-user, #chat-messages .msg-ai'
  );
  if (realMessages.length === 0) {
    customAlert({ title: '目前沒有對話內容可下載', body: '請先進行對話後再下載' });
    return;
  }
  // === [CHAT-EXPORT-HOTFIX-1 START] ===
  // Dia 等瀏覽器對「主框架導覽去 attachment URL」收尾異常（download chip 卡 8/8 不關）；
  // 改 fetch→blob→<a download> 不依賴導覽語意、瀏覽器無關（Safari/Chrome/Dia 全收尾）。
  try {
    const res = await fetch(`/api/papers/${currentPaperId}/chat/export`);
    if (!res.ok) {
      customAlert({
        title: '下載失敗',
        body: res.status === 404 ? '沒有對話紀錄' : `伺服器錯誤（${res.status}）`,
      });
      return;
    }
    const blob = await res.blob();
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${currentPaperId}_chat.md`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  } catch (e) {
    customAlert({ title: '下載失敗', body: '網路或瀏覽器錯誤，請重試' });
  }
  // === [CHAT-EXPORT-HOTFIX-1 END] ===
};

// BUG-F4 A3.2（ui-fixes-batch A3.2）：chat-input focus listener 整段移除
// 既有 contenteditable="false"（P2-3 ship + BUG-F2 enableChat/disableChat）已防護、
// disabled state 下 div 不接收 focus、此 listener 是 textarea 時代遺留 dead code。
// （原邏輯：!currentPaperId 時 alert + blur；contenteditable="false" 已涵蓋此防護）

// 載入對話紀錄
async function deletePaper(paperId, title) {
  // BUG-F4 A3.2（ui-fixes-batch A3.2）：confirm + alert 替換為 customConfirm / customAlert
  const ok = await customConfirm({
    title: '刪除文件',
    body: `確定刪除「${title}」？此操作無法還原`,
    okLabel: '確定刪除',
    danger: true,
  });
  if (!ok) return;
  try {
    const res = await fetch(`/api/papers/${paperId}`, { method: 'DELETE' });
    if (!res.ok) throw new Error('刪除失敗');
    if (currentPaperId === paperId) {
      currentPaperId = null;
      document.getElementById('content-toolbar').style.display = 'none';
      const delAbstractToolbar = document.getElementById('abstract-toolbar');
      if (delAbstractToolbar) {
        delAbstractToolbar.innerHTML = '';
        delAbstractToolbar.style.display = 'none';
      }
      document.getElementById('empty-state').style.display = 'flex';
      document.getElementById('paper-content').style.display = 'none';
      document.getElementById('chat-messages').innerHTML = '<div class="chat-empty">選擇文件後開始提問</div>';
      document.getElementById('chat-input').setAttribute('contenteditable', 'false');
    }
    await loadPapers();
  } catch(e) {
    customAlert({ title: '刪除失敗', body: e.message });
  }
}

// 在 AI 訊息泡泡後渲染來源區塊
function renderSources(aiMsg, sources) {
  if (!sources || !sources.length) return;
  const div = document.createElement('div');
  div.className = 'msg-sources';
  div.innerHTML = '來源：' + sources.map(s =>
    `<a href="${s.uri}" target="_blank" rel="noopener">${s.title}</a>`
  ).join('、');
  aiMsg.appendChild(div);
}

// 當前 paper 的 EventSource attach（切 paper 時關閉、避免互相污染）
let currentEventSource = null;

async function loadChatHistory(paperId) {
  const messages = document.getElementById('chat-messages');
  messages.innerHTML = '';
  try {
    const res = await fetch(`/api/papers/${paperId}/chat/history`);
    const data = await res.json();

    // 後端回應協議：無 in_progress 時回 list、有則回 dict { papers, in_progress }
    const history = Array.isArray(data) ? data : (data.messages || []);
    const in_progress = (!Array.isArray(data) && data.in_progress)
      ? data.in_progress : null;

    if (!history.length && !in_progress) {
      messages.innerHTML = '<div class="chat-empty">針對文件提問</div>';
      return;
    }

    let currentGroup = null;  // qa-group 容器，history.forEach + in_progress 共用（C2 RAG-14）
    history.forEach(msg => {
      const div = document.createElement('div');
      if (msg.role === 'user') {
        // 每個 user message 建立新的 qa-group 容器（C2 RAG-14）
        currentGroup = document.createElement('div');
        currentGroup.className = 'qa-group';
        messages.appendChild(currentGroup);
        div.className = 'msg-user';
        div.textContent = msg.content;
      } else {
        div.className = 'msg-ai';
        const formatted = msg.content.replace(/\n(?!\n)/g, '\n\n');
        div.innerHTML = renderMarkdownWithMath(formatted); // [RAG-12 C3] 數學渲染接線
        if (msg.grounding_sources && msg.grounding_sources.length > 0) {
          div.dataset.groundingSources = JSON.stringify(msg.grounding_sources);
          renderSources(div, msg.grounding_sources);
        }
      }
      // div 掛到 currentGroup；無 group 時 fallback 直掛 messages（C2 RAG-14）
      if (currentGroup) currentGroup.appendChild(div);
      else messages.appendChild(div);
    });

    // in_progress 處理：reload 時把進行中 paper 接回（解邊角 bug）
    // 17-1 後端進入時已寫 user query 進 DB、history 內已含 in_progress.query；
    // 不重複 render user msg、只 render ai msg + partial、再 EventSource attach
    // 接續 broker 的 SSE。
    if (in_progress) {
      const aiMsg = document.createElement('div');
      aiMsg.className = 'msg-ai';
      const partial = in_progress.partial || '';
      const formatted = partial.replace(/\n(?!\n)/g, '\n\n');
      aiMsg.innerHTML = renderMarkdownWithMath(formatted || ''); // [RAG-12 C3] 數學渲染接線
      const cursor = document.createElement('span');
      cursor.textContent = '▋';
      cursor.className = 'cursor-blink';
      aiMsg.appendChild(cursor);
      // in_progress aiMsg 掛到 currentGroup（與 history 內的 user msg 同組）；
      // 後端已在 history 寫入 in_progress.query，不重複 render user msg（C2 RAG-14）
      if (currentGroup) {
        currentGroup.appendChild(aiMsg);
      } else {
        messages.appendChild(aiMsg);
      }

      attachToStream(paperId, aiMsg, partial);
    }

    messages.scrollTop = messages.scrollHeight;
  } catch(e) {
    console.error('[loadChatHistory] error:', e);
    messages.innerHTML = '<div class="chat-empty">針對文件提問</div>';
  }
}

// attach EventSource 到後端 broker 的進行中 stream。
// alreadyRenderedPartial：loadChatHistory 已渲染的 partial 字串；replay
// chunk 的累積字數若仍在此範圍內則 skip（避免雙重 render）。
function attachToStream(paperId, aiMsg, alreadyRenderedPartial) {
  if (currentEventSource) {
    try { currentEventSource.close(); } catch (e) {}
    currentEventSource = null;
  }
  const es = new EventSource(`/api/papers/${paperId}/chat/attach`);
  currentEventSource = es;

  let accumulated = alreadyRenderedPartial || '';
  let replayCharsSeen = 0;
  const baselineLen = (alreadyRenderedPartial || '').length;

  const removeCursor = () => {
    const c = aiMsg.querySelector('.cursor-blink');
    if (c) c.remove();
  };
  const appendCursor = () => {
    const c = document.createElement('span');
    c.textContent = '▋';
    c.className = 'cursor-blink';
    aiMsg.appendChild(c);
  };

  // [FE-PERF-2 C3] replay 專用節流器（paintFn 含 cursor 語意、按站點封裝；
  // done 走 cancel()+原碼收尾渲染、嚴禁 flush 防雙渲染——plan v4 U1 收尾不變式）
  const r = makeThrottledRenderer((t) => {
    removeCursor();
    aiMsg.innerHTML = renderMarkdownWithMath(t); // [RAG-12 C3] 數學渲染接線
    appendCursor();
    const msgsEl = document.getElementById('chat-messages');
    msgsEl.scrollTop = msgsEl.scrollHeight;
  });

  es.onmessage = (ev) => {
    try {
      const chunk = JSON.parse(ev.data);

      if (chunk.replay) {
        // replay chunk：累計到 baselineLen 為止都 skip（已在初始 partial 內）
        const before = replayCharsSeen;
        replayCharsSeen += (chunk.sentence || '').length;
        if (replayCharsSeen <= baselineLen) return;
        // 部分溢出（理論上 broker 回放與 baseline 應對齊；保險處理）
        const overflow = (chunk.sentence || '').slice(baselineLen - before);
        if (!overflow) return;
        accumulated += overflow;
      } else if (chunk.sentence) {
        accumulated += chunk.sentence;
      }

      if (chunk.sentence) {
        const formatted = accumulated.replace(/\n(?!\n)/g, '\n\n');
        r.update(formatted); // [FE-PERF-2 C3] 節流（cursor/渲染/scrollTop 全移入 paintFn 同幀）
      }

      if (chunk.done) {
        r.cancel(); // [FE-PERF-2 C3] U1 收尾不變式：原碼 done 自帶收尾渲染 → cancel 讓位、嚴禁 flush（防雙渲染）
        removeCursor();
        const formatted = accumulated.replace(/\n(?!\n)/g, '\n\n');
        aiMsg.innerHTML = renderMarkdownWithMath(formatted); // [RAG-12 C3] 數學渲染接線
        if (chunk.grounding_sources && chunk.grounding_sources.length > 0) {
          aiMsg.dataset.groundingSources = JSON.stringify(chunk.grounding_sources);
          renderSources(aiMsg, chunk.grounding_sources);
        }
        es.close();
        if (currentEventSource === es) currentEventSource = null;
      }
    } catch (e) {
      console.error('[attachToStream] parse error:', e);
    }
  };

  es.onerror = (e) => {
    // EventSource 預設會自動重連、但這裡 close 後阻止；保留已收的 partial
    console.warn('[attachToStream] EventSource error:', e);
    es.close();
    if (currentEventSource === es) currentEventSource = null;
    r.cancel(); // [FE-PERF-2 C3] 錯誤出口：取消 pending 渲染（防 stream 死後殘留重繪把 cursor 加回）
    removeCursor();
  };
}

// saveChatHistory 函式已刪除：DB 寫入改由
// 後端 chat endpoint 自身負責（進入時寫 user query、stream finally
// 寫 assistant 完整回答）；前端不再整包 POST、避免切走切回時 currentPaperId
// 變化導致誤覆寫到別的 paper。POST /chat/history endpoint 暫保留供舊
// 瀏覽器快取兼容、17-4 才移除。

/* ═══════════════════════════════════════════════════════════════
   chat-input hashtag token UI 模組（P2-3）
   依 plan §3.3.2（核心 UX）+ §3.3.5 四點防護 + Q7-Q14
   - 來源 (Q9)：allPapers.metadata_json.user_tags 前端 cache
   - 限制 (Q8)：autocomplete 顯示前 10 筆 + 「...更多」
   - IME (Q12)：compositionstart/end + e.isComposing 雙重防護
   - Token 刪除 (Q13)：一次 Backspace 直接刪、不二次確認
   - Hover tooltip (Q10)：不展開、保留首版簡單
   設計：以 IIFE 形式封裝、暴露 hashtagAutocomplete 物件給 keydown 用
   ═══════════════════════════════════════════════════════════════ */
const hashtagAutocomplete = (() => {
  const input = document.getElementById('chat-input');
  const popup = document.getElementById('hashtag-autocomplete');
  const MAX_VISIBLE = 10;       // Q8 限制 10 筆
  let isComposing = false;      // Q12 IME 組字旗標
  let activeIndex = -1;
  let currentMatches = [];      // 當前 dropdown 顯示的 tags
  let currentPrefix = '';       // 當前掃描到的 #<prefix>
  let savedRange = null;        // 觸發 popup 時的 selection、用於 confirm 時刪 prefix

  function collectAllUserTags() {
    // Q9：直接讀前端 cache allPapers user_tags（不開新 API）
    // 防禦兩種既有 field shape（Phase 1 既有 inconsistency）：
    //   - /api/papers 回傳：p.metadata.user_tags（_to_dict key='metadata'）
    //   - PATCH 後 local 寫入：p.metadata_json.user_tags（既有 tag-modal handler）
    // 兩個都讀、union 後 dedup
    const set = new Set();
    function push(arr) {
      if (Array.isArray(arr)) {
        for (const t of arr) if (typeof t === 'string' && t) set.add(t);
      }
    }
    for (const p of (allPapers || [])) {
      if (p.metadata && p.metadata.user_tags) push(p.metadata.user_tags);
      if (p.metadata_json && p.metadata_json.user_tags) push(p.metadata_json.user_tags);
    }
    // 後端 _normalize_tag 已 lowercase；前端只負責收集 + 字母順排
    return Array.from(set).sort();
  }

  function detectHashtagContext() {
    // 在 cursor 前向後掃描到空白或開頭、若是 `#<word>` pattern → 回 prefix + range
    const sel = window.getSelection();
    if (!sel || sel.rangeCount === 0) return null;
    const range = sel.getRangeAt(0);
    if (!input.contains(range.startContainer)) return null;
    if (range.startContainer.nodeType !== Node.TEXT_NODE) return null;
    const text = range.startContainer.textContent || '';
    const offset = range.startOffset;
    // 向左掃描、找最近的 # 或空白
    let hashIdx = -1;
    for (let i = offset - 1; i >= 0; i--) {
      const ch = text[i];
      if (ch === '#') { hashIdx = i; break; }
      if (ch === ' ' || ch === ' ' || ch === '\n') break;
    }
    if (hashIdx < 0) return null;
    const prefix = text.substring(hashIdx + 1, offset);
    // # 後面若已含空白、視為已 confirmed、不再彈
    if (/\s/.test(prefix)) return null;
    return {
      prefix: prefix.toLowerCase(),
      textNode: range.startContainer,
      hashIdx,
      endOffset: offset,
    };
  }

  function open(matches, ctx) {
    currentMatches = matches.slice(0, MAX_VISIBLE);
    const overflow = matches.length > MAX_VISIBLE;
    currentPrefix = ctx.prefix;
    savedRange = ctx;
    activeIndex = currentMatches.length > 0 ? 0 : -1;

    if (currentMatches.length === 0) {
      close();
      return;
    }

    popup.innerHTML = '';
    currentMatches.forEach((tag, i) => {
      const item = document.createElement('div');
      item.className = 'hashtag-popup-item' + (i === activeIndex ? ' active' : '');
      item.textContent = '#' + tag;
      item.dataset.tag = tag;
      item.addEventListener('mousedown', (e) => {
        // mousedown 而非 click、避免 input 失焦先觸發 close
        e.preventDefault();
        activeIndex = i;
        confirm();
      });
      popup.appendChild(item);
    });
    if (overflow) {
      const more = document.createElement('div');
      more.className = 'hashtag-popup-more';
      more.textContent = `...更多 (${matches.length - MAX_VISIBLE} 筆)`;
      popup.appendChild(more);
    }
    popup.hidden = false;
  }

  function close() {
    popup.hidden = true;
    popup.innerHTML = '';
    currentMatches = [];
    activeIndex = -1;
    savedRange = null;
  }

  function move(delta) {
    if (currentMatches.length === 0) return;
    activeIndex = (activeIndex + delta + currentMatches.length) % currentMatches.length;
    const items = popup.querySelectorAll('.hashtag-popup-item');
    items.forEach((el, i) => el.classList.toggle('active', i === activeIndex));
  }

  function confirm() {
    if (activeIndex < 0 || !savedRange) {
      close();
      return;
    }
    const tag = currentMatches[activeIndex];
    const { textNode, hashIdx, endOffset } = savedRange;
    // 刪掉 textNode 上 `#<prefix>` 那一段、用 Range
    const range = document.createRange();
    range.setStart(textNode, hashIdx);
    range.setEnd(textNode, endOffset);
    range.deleteContents();

    // 插入 token span + 後綴空格
    const token = document.createElement('span');
    token.className = 'hashtag-token';
    token.setAttribute('contenteditable', 'false');
    token.dataset.tag = tag;

    const label = document.createElement('span');
    label.className = 'hashtag-token-label';
    label.textContent = '#' + tag;
    token.appendChild(label);

    const removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'hashtag-token-remove';
    removeBtn.setAttribute('aria-label', `移除 ${tag} 標籤`);
    removeBtn.textContent = '×';
    removeBtn.addEventListener('mousedown', (e) => {
      e.preventDefault();
      token.remove();
      input.focus();
    });
    token.appendChild(removeBtn);

    range.insertNode(token);

    // 插一個空格、讓 cursor 落在 token 之後（不會被吸進 token）
    const space = document.createTextNode(' ');
    token.parentNode.insertBefore(space, token.nextSibling);

    // cursor 落到空格之後
    const sel = window.getSelection();
    sel.removeAllRanges();
    const newRange = document.createRange();
    newRange.setStartAfter(space);
    newRange.collapse(true);
    sel.addRange(newRange);

    close();
  }

  // input 事件：判斷是否要開 popup
  input.addEventListener('input', () => {
    if (isComposing) return;          // Q12 組字中、不觸發
    const ctx = detectHashtagContext();
    if (!ctx) {
      if (!popup.hidden) close();
      return;
    }
    const tags = collectAllUserTags();
    const matches = tags.filter(t => t.startsWith(ctx.prefix));
    open(matches, ctx);
  });

  // IME 組字旗標
  input.addEventListener('compositionstart', () => { isComposing = true; });
  input.addEventListener('compositionend', () => {
    isComposing = false;
    // 組字結束、補一次偵測（用戶可能用 IME 打 # 後的英文 prefix）
    const ctx = detectHashtagContext();
    if (ctx) {
      const tags = collectAllUserTags();
      const matches = tags.filter(t => t.startsWith(ctx.prefix));
      open(matches, ctx);
    }
  });

  // 失焦關閉（mousedown 攔截已防止點 popup 失焦）
  input.addEventListener('blur', () => {
    setTimeout(close, 100);
  });

  // 點 popup 外、關閉
  document.addEventListener('mousedown', (e) => {
    if (popup.hidden) return;
    if (input.contains(e.target) || popup.contains(e.target)) return;
    close();
  });

  return {
    isOpen: () => !popup.hidden,
    move,
    confirm,
    close,
    // 測試用 hook（不對外文件化）
    _collect: collectAllUserTags,
    _detect: detectHashtagContext,
  };
})();

async function sendMessage() {
  const input = document.getElementById('chat-input');
  // textarea → contenteditable div（P2-3 §3.3.5-#3）
  // - .value → .textContent.trim()（token 已是 #tag 字串、後端 parse_query_hashtag 解析）
  // - .value = '' → .innerHTML = ''（清掉純文字 + 所有 .hashtag-token）
  // - 不再 dispatchEvent('input')（autosize listener 已移除）
  // × 按鈕過濾：clone node → 移除 .hashtag-token-remove → 取 textContent（C1 RAG-14）
  const _tmpDiv = input.cloneNode(true);
  _tmpDiv.querySelectorAll('.hashtag-token-remove').forEach(btn => btn.remove());
  const query = (_tmpDiv.textContent || '').trim();
  if (!query || isStreaming || !currentPaperId) return;

  input.innerHTML = '';
  isStreaming = true;

  // 顯示用戶訊息（包裝在 qa-group 容器內，配合 CSS sticky 效果）（C2 RAG-14）
  const messages = document.getElementById('chat-messages');
  const qaGroup = document.createElement('div');
  qaGroup.className = 'qa-group';
  messages.appendChild(qaGroup);

  const userMsg = document.createElement('div');
  userMsg.className = 'msg-user';
  userMsg.style.whiteSpace = 'pre-wrap';
  userMsg.textContent = query;
  qaGroup.appendChild(userMsg);

  // 建立 AI 訊息泡泡（同組）（C2 RAG-14）
  const aiMsg = document.createElement('div');
  aiMsg.className = 'msg-ai';
  aiMsg.textContent = '▋';
  qaGroup.appendChild(aiMsg);
  messages.scrollTop = messages.scrollHeight;

  // [FE-PERF-2 C3] 主串流節流器（paintFn＝渲染+捲底同幀；定義於 try 外、catch 亦可安全 flush）
  const r = makeThrottledRenderer((t) => {
    aiMsg.innerHTML = renderMarkdownWithMath(t); // [RAG-12 C3] 數學渲染接線
    messages.scrollTop = messages.scrollHeight;
  });

  // SSE 串流
  try {
    const res = await fetch(`/api/papers/${currentPaperId}/chat`, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({query, paper_id: currentPaperId, use_web_search: useWebSearch})
    });

    const reader = res.body.getReader();
    const decoder = new TextDecoder();
    let accumulated = '';

    while (true) {
      const {done, value} = await reader.read();
      if (done) break;

      const text = decoder.decode(value);
      const lines = text.split('\n');
      for (const line of lines) {
        if (!line.startsWith('data: ')) continue;
        try {
          const chunk = JSON.parse(line.slice(6));
          if (chunk.sentence) {
            accumulated += chunk.sentence;
            // 把單換行轉成 Markdown 段落（兩個換行）
            const formatted = accumulated.replace(/\n(?!\n)/g, '\n\n');
            r.update(formatted); // [FE-PERF-2 C3] rAF+160ms 節流（原每 sentence 全量渲染；渲染+scrollTop 移入 paintFn 同幀）
          }
          if (chunk.done) {
            r.flush(); // [FE-PERF-2 C3] U1 收尾不變式：主串流原碼 done 不渲染 → flush 補最終全量（恰一次）
            isStreaming = false;
            if (chunk.grounding_sources && chunk.grounding_sources.length > 0) {
              aiMsg.dataset.groundingSources = JSON.stringify(chunk.grounding_sources);
              renderSources(aiMsg, chunk.grounding_sources);
            }
            // 移除 saveChatHistory(currentPaperId) 呼叫
            // 呼叫。DB 寫入由後端 chat endpoint finally 區自行 append。
          }
        } catch {}
      }
    }
  } catch (e) {
    r.flush(); // [FE-PERF-2 C3] 斷線出口：保留異常前最後一批已收內容
    isStreaming = false;
  }
}

// 衝突 3.1：web-search 開關以 prototype 已 toggle 的 .active 為單一真源，
// 業務僅在 prototype 之後讀取（同元素 addEventListener 依註冊序，業務晚註冊故後執行）
(() => {
  const wsBtn = document.getElementById('web-search-toggle');
  wsBtn.addEventListener('click', () => {
    useWebSearch = wsBtn.classList.contains('active');
  });
  useWebSearch = wsBtn.classList.contains('active');
})();
// keydown 含 Ctrl+Enter 送出 + 中文 IME 防護 + autocomplete 導覽（P2-3）
// 注意：使用 addEventListener 而非 onkeydown=...、避免覆寫掉本檔內其他綁定
document.getElementById('chat-input').addEventListener('keydown', (e) => {
  // §3.3.5-#3 + Q12：IME 組字中（如中文輸入法）→ 完全不攔截
  if (e.isComposing || e.keyCode === 229) return;

  // 1. autocomplete 開啟中、優先處理導覽鍵
  if (hashtagAutocomplete.isOpen()) {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      hashtagAutocomplete.move(1);
      return;
    }
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      hashtagAutocomplete.move(-1);
      return;
    }
    if (e.key === 'Enter' || e.key === 'Tab') {
      e.preventDefault();
      hashtagAutocomplete.confirm();
      return;
    }
    if (e.key === 'Escape') {
      e.preventDefault();
      hashtagAutocomplete.close();
      return;
    }
  }

  // 2. Ctrl+Enter 送出（既有行為、不變）
  if (e.key === 'Enter' && e.ctrlKey) {
    e.preventDefault();
    sendMessage();
  }
});

// 上傳論文（Phase-Shift — OPTIMIZE-1 C2：先選類型，再選檔，一字步 UX）
// Step B1: upload-btn click → 顯示 #confirm-modal（挪用既有 modal，零新增 CSS）
// Step B2: 取消/ESC/遮罩關閉 → 零網路請求
// Step B3: 確定 → 讀取 doc_type → 動態建立 file input → FormData POST（file + doc_type）
document.getElementById('upload-btn').addEventListener('click', (e) => {
  e.stopImmediatePropagation();
  const modal = document.getElementById('confirm-modal');
  const dropdown = document.getElementById('doc-type-dropdown');

  // 重設 dropdown 預設值為 academic（每次開 Modal 重置）
  dropdown.dataset.value = 'academic';
  const valueEl = dropdown.querySelector('.dropdown-value');
  if (valueEl) valueEl.textContent = DOC_TYPE_LABELS.academic;
  document.getElementById('confirm-desc').textContent = '請選擇文件類型，系統將根據類型選擇最佳解析方式。';

  // Step B2: 取消路徑 — 僅關閉 Modal，零網路請求（onclick 覆寫確保單一 handler）
  document.getElementById('confirm-cancel-btn').onclick = () => {
    modal.classList.remove('show');
  };

  // Step B3: 確定路徑 — 讀取 doc_type → 動態建立 <input type="file"> → FormData POST
  document.getElementById('confirm-ok-btn').onclick = () => {
    const docType = document.querySelector('#doc-type-dropdown').dataset.value;
    modal.classList.remove('show');

    const input = document.createElement('input');
    input.type = 'file';
    input.accept = '.pdf';
    input.onchange = async (ev) => {
      const files = ev.target.files;
      if (!files || files.length === 0) return;  // 使用者取消選檔
      if (files.length > 1) {
        customAlert({ title: '一次只能上傳一份文件', body: '請選擇單一 PDF 檔案' });
        return;
      }
      const file = files[0];
      const btn = document.getElementById('upload-btn');
      btn.disabled = true;
      setBusy(true);

      const form = new FormData();
      form.append('file', file);
      form.append('doc_type', docType);

      try {
        const res = await fetch('/api/papers/upload', { method: 'POST', body: form });
        const data = await res.json();
        // upload API 回應後立刻 unlock upload-btn，允許使用者上傳下一份
        btn.disabled = false;
        setBusy(false);
        // 插入左欄占位列並開始 SSE 追蹤（pipeline 已在後端直接啟動）
        insertUploadingRow(data.paper_id, file.name);
        trackProgress(data.paper_id, btn);
      } catch (err) {
        btn.disabled = false;
        setBusy(false);
        customAlert({ title: '上傳失敗', body: err.message });
      }
    };
    input.click();
  };

  modal.classList.add('show');
});

// 追蹤處理進度（更新左欄 .paper-item.uploading 占位列；按鈕僅切 disabled）
function trackProgress(paperId, btn) {
  const evtSource = new EventSource(`/api/papers/${paperId}/status`);

  evtSource.onmessage = (e) => {
    const data = JSON.parse(e.data);

    if (data.status === 'processing') {
      const p = data.progress;
      // 更新占位列文字 + 進度條（interaction §9）
      const row = document.querySelector(
        `.paper-item.uploading[data-upload-id="${paperId}"]`
      );
      if (row) {
        row.querySelector('.paper-progress-text').textContent =
          `${p.stage_name} ${p.progress}%`;
        row.querySelector('.paper-progress-fill').style.width = `${p.progress}%`;
      }
      // index >= 10（extra_info=10, rag=11）代表 md_restore 已完成、中文版可讀
      if (p && p.index >= 10) {
        const r = paperReadiness.get(paperId);
        if (r !== 'reading_ready' && r !== 'done') {
          paperReadiness.set(paperId, 'reading_ready');
          // 只在使用者沒在看別篇時自動開啟（不打斷正在閱讀的論文）
          if (currentPaperId === null || currentPaperId === paperId) {
            loadPaper(paperId, '（內容已就緒，AI 問答準備中）');
          }
        }
      }
    } else if (data.status === 'done') {
      evtSource.close();
      removeUploadingRow(paperId);
      btn.disabled = false;
      setBusy(false);
      paperReadiness.set(paperId, 'done');
      loadPapers().then(() => {
        // BUG-F4 A1（ui-fixes-batch A1）：用 renderTitleHeader 重繪整個 multi-row 結構
        // 既有 `current-title.textContent = el.textContent` 會把 <header> 內含的
        // h1.title-zh / p.title-en / p.title-meta / details.title-abstract / .paper-tags
        // 清成單行字串、清空 multi-row 排版。
        if (currentPaperId === paperId) {
          const p = allPapers.find(p => p.id === paperId);
          if (p) renderTitleHeader(p);
        }
      });
      if (currentPaperId === paperId) {
        document.getElementById('chat-panel').classList.remove('collapsed');
        removeReadingReadyMessage();
        enableChat();
        loadChatHistory(paperId);
      }
    } else if (data.status === 'error') {
      evtSource.close();
      removeUploadingRow(paperId);
      btn.disabled = false;
      setBusy(false);
      customAlert({ title: '處理失敗', body: data.error || '未知錯誤' });
    }
  };

  evtSource.onerror = () => {
    evtSource.close();
    removeUploadingRow(paperId);
    btn.disabled = false;
    setBusy(false);
  };
}

// 文件類型確認
// === doc_type-registry ===
// 新增 doc_type 須同步更新此處。詳見 docs/HOW_TO_ADD_DOC_TYPE.md
const DOC_TYPE_LABELS = {
  academic: '學術論文',
  book: '書籍',
  technical: '技術文件',
  slides: '簡報',
  web: '網頁存檔',
  news: '新聞文章',
  resume: '履歷'
};

function showConfirmModal(paperId, detection, btn, filename) {
  const modal = document.getElementById('confirm-modal');
  // 衝突 B：prototype 改用自訂 #doc-type-dropdown（無 native select）。
  // 預設選偵測值（無則 academic）：寫 dataset.value + .dropdown-value 文字
  const dropdown = document.getElementById('doc-type-dropdown');
  const defType = detection || 'academic';
  dropdown.dataset.value = defType;
  const valueEl = dropdown.querySelector('.dropdown-value');
  if (valueEl) valueEl.textContent = DOC_TYPE_LABELS[defType] || DOC_TYPE_LABELS.academic;

  const desc = document.getElementById('confirm-desc');
  if (detection === 'slides') {
    desc.textContent = '系統偵測為簡報，已預設選『簡報』，可手動調整';
  } else {
    desc.textContent = '請選擇文件類型，系統將根據類型選擇最佳解析方式。';
  }

  modal.classList.add('show');

  document.getElementById('confirm-ok-btn').onclick = async () => {
    const selectedType = document.getElementById('doc-type-dropdown').dataset.value;
    modal.classList.remove('show');
    // 不再 btn.disabled = true；上傳階段已在 upload
    // handler 結束、使用者可獨立操作下一份

    try {
      await fetch(`/api/papers/${paperId}/confirm_type`, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({doc_type: selectedType})
      });
      // 依 interaction §9：confirm_type 成功後才插入占位列、再 SSE 追進度
      insertUploadingRow(paperId, filename);
      trackProgress(paperId, btn);
    } catch(e) {
      btn.disabled = false;
      setBusy(false);
      customAlert({ title: '確認失敗', body: e.message });
    }
  };
}

// 清理殘餘檔案
// BUG-F4 A3.2（ui-fixes-batch A3.2）：confirm + 3 條 alert 替換為 customConfirm / customAlert
document.getElementById('cleanup-btn').addEventListener('click', async (e) => {
  e.stopImmediatePropagation();
  if (isProcessing) return;
  const ok = await customConfirm({
    title: '清除殘檔',
    body: '確定要清理殘餘檔案？此操作會刪除所有不在論文列表中的目錄',
    okLabel: '確定清除',
    danger: true,
  });
  if (!ok) return;
  try {
    const res = await fetch('/api/cleanup', { method: 'POST' });
    const data = await res.json();
    if (data.count === 0) {
      customAlert({ title: '清理結果', body: '沒有殘餘檔案需要清理' });
    } else {
      customAlert({
        title: '清理結果',
        body: `已清理 ${data.count} 個殘餘目錄：\n${data.removed.join('\n')}`
      });
    }
  } catch(e) {
    customAlert({ title: '清理失敗', body: e.message });
  }
});

// 說明框
document.getElementById('help-btn').onclick = () => {
  document.getElementById('help-modal').classList.add('show');
};
document.getElementById('help-close-btn').onclick = () => {
  document.getElementById('help-modal').classList.remove('show');
};
document.getElementById('help-modal').onclick = (e) => {
  if (e.target === document.getElementById('help-modal')) {
    document.getElementById('help-modal').classList.remove('show');
  }
};

// 初始化：先載資料夾樹再載論文（filter 依賴 folders 建子孫集）
(async () => { await loadFolders(); await loadPapers(); })();

// 新增資料夾：當前選中為某資料夾則建在其下，否則建在根
document.getElementById('new-folder-btn').onclick = () => {
  folderCreate(typeof currentFolderId === 'number' ? currentFolderId : null);
};

// 登出
document.getElementById('logout-btn').addEventListener('click', async (e) => {
  e.stopImmediatePropagation();
  try {
    await fetch('/logout', { method: 'POST' });
  } catch (e) { /* 忽略，仍導向登入頁 */ }
  location.href = '/login';
});
}); // === [FE-PERF-2 C2] === DOMContentLoaded 包裹 END
</script>
</body>
</html>
