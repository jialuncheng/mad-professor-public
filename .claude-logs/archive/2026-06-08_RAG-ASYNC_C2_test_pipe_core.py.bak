"""PIPE-CORE 契約測試（plan v2 §6.1）。

OP-1：合約與狀態層——四份凍結合約 frozen 斷言、交接點① R1.1 禁欄位攔截、
必填欄位驗證、PipelineContext 預設與 Phase 推進。
（OP-2 工廠/策略、OP-3 Orchestrator DAG 測試於後續 OP 追加至本檔。）
"""

import sys
from pathlib import Path

import pytest
from pydantic import ValidationError

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from pipelines.context import PhaseEnum, PipelineContext  # noqa: E402
from pipelines.contracts import (  # noqa: E402
    BilingualMarkdownSpec,
    GlossaryReadySpec,
    IngestionMetadataSpec,
    RagDbSpec,
)


# ── 交接點① R1.1：IngestionMetadataSpec 禁含 Abstract/LCC/Glossary ──

def test_ingestion_valid_construct():
    spec = IngestionMetadataSpec(title="T", source_lang="en", authors=["A"])
    assert spec.title == "T"
    assert spec.tiles == []


def test_ingestion_rejects_abstract_lcc_glossary():
    # extra='forbid' → 任一禁欄位混入即 ValidationError（P1 越界攔截）
    for forbidden in ({"abstract": "x"}, {"lcc": "BF"}, {"glossary": {}}):
        with pytest.raises(ValidationError):
            IngestionMetadataSpec(title="T", source_lang="en", **forbidden)


# ── 交接點② 必填欄位 ──

def test_glossary_ready_requires_translated_abstract():
    with pytest.raises(ValidationError):
        GlossaryReadySpec(abstract="a", lcc="BF", glossary={})  # 缺 translated_abstract


def test_glossary_ready_valid():
    spec = GlossaryReadySpec(
        abstract="原文摘要", lcc="BF", glossary={"k": "v"},
        translated_abstract="譯文摘要",
    )
    assert spec.translated_abstract == "譯文摘要"
    assert spec.chapter_summaries is None


# ── 合約凍結（frozen）斷言 ──

def test_contracts_are_frozen():
    ing = IngestionMetadataSpec(title="T", source_lang="en")
    with pytest.raises(ValidationError):
        ing.title = "changed"  # frozen → 不可變
    bil = BilingualMarkdownSpec(
        final_zh_path="a_zh.md", final_en_path="a_en.md", translated_abstract="x"
    )
    with pytest.raises(ValidationError):
        bil.final_zh_path = "y"
    rag = RagDbSpec(vectors_path="vectors/")
    with pytest.raises(ValidationError):
        rag.vectors_path = "z"


# ── PipelineContext 狀態載體 ──

def test_context_defaults():
    ctx = PipelineContext(doc_type="academic", paper_id="p1")
    assert ctx.phase is PhaseEnum.P1
    assert ctx.reading_ready is False
    assert ctx.rag_status == "pending"
    assert ctx.shadow is False
    # 四合約欄位寫入前為 None
    assert ctx.ingestion is None
    assert ctx.glossary_ready is None
    assert ctx.bilingual is None
    assert ctx.rag is None


def test_context_carries_frozen_contract_and_phase_advances():
    ctx = PipelineContext(doc_type="resume", paper_id="p2", shadow=True)
    ctx.ingestion = IngestionMetadataSpec(title="T", source_lang="en")
    ctx.phase = PhaseEnum.P2
    assert ctx.shadow is True
    assert ctx.ingestion.title == "T"
    assert ctx.phase is PhaseEnum.P2
    # 承載的合約子模型仍凍結
    with pytest.raises(ValidationError):
        ctx.ingestion.title = "x"


def test_rag_status_rejects_invalid_literal():
    with pytest.raises(ValidationError):
        PipelineContext(doc_type="academic", paper_id="p", rag_status="bogus")


# ══════════════════════════════════════════════════════════════════════
# OP-2：工廠與策略基類（PipelineFactory + DocumentStrategy ABC + NullStrategy）
# ══════════════════════════════════════════════════════════════════════

from pipelines.base_strategy import DocumentStrategy, NullStrategy  # noqa: E402
from pipelines.factory import PipelineFactory  # noqa: E402


@pytest.fixture
def clean_registry():
    """隔離 PipelineFactory._registry（測試前後快照還原，避免污染）。"""
    snapshot = dict(PipelineFactory._registry)
    PipelineFactory._registry.clear()
    yield
    PipelineFactory._registry.clear()
    PipelineFactory._registry.update(snapshot)


class _StubStrategy(DocumentStrategy):
    """測試用 stub：四 Phase 回最小合法合約。"""

    rag_char_threshold = 7

    def run_phase1(self, ctx):
        return IngestionMetadataSpec(title="stub", source_lang="en")

    def run_phase2(self, ctx):
        return GlossaryReadySpec(abstract="a", lcc="BF", glossary={}, translated_abstract="b")

    def run_phase3(self, ctx):
        return BilingualMarkdownSpec(
            final_zh_path="zh.md", final_en_path="en.md", translated_abstract="b"
        )

    def run_phase4(self, ctx):
        return RagDbSpec(vectors_path="vectors/")


def test_factory_hit_returns_registered_strategy(clean_registry):
    PipelineFactory.register_strategy("academic", _StubStrategy)
    s = PipelineFactory.get_strategy("academic")
    assert isinstance(s, _StubStrategy)
    assert s.rag_char_threshold == 7


def test_factory_decorator_register(clean_registry):
    @PipelineFactory.register("resume")
    class _RS(_StubStrategy):
        pass

    assert isinstance(PipelineFactory.get_strategy("resume"), _RS)


def test_factory_unknown_falls_back_to_litedoc(clean_registry):
    PipelineFactory.register_strategy("litedoc", _StubStrategy)
    s = PipelineFactory.get_strategy("totally_unknown_type")
    assert isinstance(s, _StubStrategy)  # 降級 LiteDoc（SPEC §3.3）


def test_factory_no_strategy_returns_nullstrategy(clean_registry):
    # 空註冊表 + 無 litedoc → NullStrategy 哨兵
    s = PipelineFactory.get_strategy("anything")
    assert isinstance(s, NullStrategy)


def test_nullstrategy_four_phases_raise(clean_registry):
    s = PipelineFactory.get_strategy("anything")  # NullStrategy
    ctx = PipelineContext(doc_type="anything", paper_id="p")
    for runner in (s.run_phase1, s.run_phase2, s.run_phase3, s.run_phase4):
        with pytest.raises(NotImplementedError):
            runner(ctx)


def test_stub_strategy_phases_return_valid_contracts(clean_registry):
    s = _StubStrategy()
    ctx = PipelineContext(doc_type="academic", paper_id="p")
    assert isinstance(s.run_phase1(ctx), IngestionMetadataSpec)
    assert isinstance(s.run_phase2(ctx), GlossaryReadySpec)
    assert isinstance(s.run_phase3(ctx), BilingualMarkdownSpec)
    assert isinstance(s.run_phase4(ctx), RagDbSpec)


# ══════════════════════════════════════════════════════════════════════
# OP-3：Orchestrator 四 Phase DAG 調度
# ══════════════════════════════════════════════════════════════════════

from pipelines.orchestrator import Orchestrator, OrchestratorError  # noqa: E402


class _RecordingStrategy(_StubStrategy):
    """記錄四 Phase 呼叫順序的 stub。"""

    def __init__(self):
        self.calls = []

    def run_phase1(self, ctx):
        self.calls.append("P1")
        return super().run_phase1(ctx)

    def run_phase2(self, ctx):
        self.calls.append("P2")
        return super().run_phase2(ctx)

    def run_phase3(self, ctx):
        self.calls.append("P3")
        return super().run_phase3(ctx)

    def run_phase4(self, ctx):
        self.calls.append("P4")
        return super().run_phase4(ctx)


def test_orchestrator_dag_order_and_unlocks(clean_registry):
    strat = _RecordingStrategy()
    PipelineFactory._registry["academic"] = lambda: strat  # 注入單一實例工廠（共享 strat 以查呼叫序）
    ctx = PipelineContext(doc_type="academic", paper_id="p1")
    out = Orchestrator().run(ctx)
    assert strat.calls == ["P1", "P2", "P3", "P4"]  # DAG 順序
    assert out.reading_ready is True                # P3 後解鎖
    assert out.rag_status == "ready"                # P4 成功
    assert out.phase is PhaseEnum.P4
    assert out.ingestion is not None and out.glossary_ready is not None
    assert out.bilingual is not None and out.rag is not None


def test_orchestrator_handoff_validation_blocks(clean_registry):
    class _BadP1(_StubStrategy):
        def run_phase1(self, ctx):
            return {"not": "a spec"}  # 錯型別 → 交接點① 攔截

    PipelineFactory._registry["academic"] = _BadP1
    ctx = PipelineContext(doc_type="academic", paper_id="p")
    with pytest.raises(OrchestratorError) as ei:
        Orchestrator().run(ctx)
    assert ei.value.phase is PhaseEnum.P1
    assert ctx.reading_ready is False  # 中止、未解鎖


def test_orchestrator_p4_failure_does_not_block_reading(clean_registry):
    class _BadP4(_StubStrategy):
        def run_phase4(self, ctx):
            raise RuntimeError("RAG 向量化炸了")

    PipelineFactory._registry["academic"] = _BadP4
    ctx = PipelineContext(doc_type="academic", paper_id="p")
    out = Orchestrator().run(ctx)  # P4 失敗不向上拋（R4.2）
    assert out.reading_ready is True       # 閱讀器仍解鎖
    assert out.rag_status == "failed"      # 僅標記失敗


def test_orchestrator_shadow_naming_propagates(clean_registry):
    PipelineFactory._registry["academic"] = _StubStrategy
    ctx = PipelineContext(doc_type="academic", paper_id="p9", shadow=True)
    out = Orchestrator().run(ctx)
    assert out.paper_id.endswith("_shadow")  # 影子命名貫穿


def test_orchestrator_early_emit_and_checkpoint_hooks(clean_registry):
    PipelineFactory._registry["academic"] = _StubStrategy
    emitted, checkpoints = [], []
    orch = Orchestrator(
        early_emit_hook=lambda c: emitted.append(c.phase),
        checkpoint_hook=lambda c: checkpoints.append(c.phase),
    )
    orch.run(PipelineContext(doc_type="academic", paper_id="p"))
    assert emitted == [PhaseEnum.P1]                       # Early Emit 僅 P1 後
    assert checkpoints == [PhaseEnum.P1, PhaseEnum.P2, PhaseEnum.P3]  # 每 Phase 邊界


def test_orchestrator_nullstrategy_raises(clean_registry):
    # 無任何策略 + 無 litedoc → NullStrategy → run_phase1 NotImplementedError
    ctx = PipelineContext(doc_type="unknown", paper_id="p")
    with pytest.raises(NotImplementedError):
        Orchestrator().run(ctx)
